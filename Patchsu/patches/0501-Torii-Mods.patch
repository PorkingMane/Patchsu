+// Copyright (c) ppy Pty Ltd <contact@ppy.sh>. Licensed under the MIT Licence.
+// See the LICENCE file in the repository root for full licence text.
+
+using osu.Framework.Bindables;
+using osu.Framework.Graphics;
+using osu.Framework.Graphics.Containers;
+using osu.Framework.Graphics.Sprites;
+using osu.Game.Graphics;
+using osu.Game.Graphics.Sprites;
+using osu.Game.Rulesets.Mods;
+using osuTK;
+using osuTK.Graphics;
+
+namespace osu.Game.Overlays.Mods
+{
+    /// <summary>
+    /// The "from Torii" plaque in the top-right corner of a mod panel (Patchsu patch 0501).
+    /// </summary>
+    public static class ToriiModPlaque
+    {
+        // Torii gate vermillion.
+        private static readonly Color4 torii_red = new Color4(255, 80, 60, 255);
+        private static readonly Color4 torii_badge_active = new Color4(70, 20, 35, 255);
+
+        private const double transition_duration = 150;
+
+        public static void TryAttach(Mod mod, Container target, IBindable<bool> active)
+        {
+            if (mod is not IToriiExclusiveMod)
+                return;
+
+            var icon = new SpriteIcon
+            {
+                Icon = FontAwesome.Solid.ToriiGate,
+                Size = new Vector2(12),
+                Anchor = Anchor.CentreLeft,
+                Origin = Anchor.CentreLeft,
+                Colour = torii_red,
+            };
+
+            var text = new OsuSpriteText
+            {
+                Text = "from Torii",
+                Font = OsuFont.Default.With(size: 9, weight: FontWeight.SemiBold),
+                Colour = torii_red,
+                Anchor = Anchor.CentreLeft,
+                Origin = Anchor.CentreLeft,
+            };
+
+            target.Add(new Container
+            {
+                Anchor = Anchor.TopRight,
+                Origin = Anchor.TopRight,
+                AutoSizeAxes = Axes.Both,
+                Margin = new MarginPadding { Right = 6, Top = 5 },
+                Shear = -OsuGame.SHEAR,
+                Child = new FillFlowContainer
+                {
+                    AutoSizeAxes = Axes.Both,
+                    Direction = FillDirection.Horizontal,
+                    Spacing = new Vector2(3, 0),
+                    Children = new Drawable[] { icon, text },
+                },
+            });
+
+            var activeCopy = active.GetBoundCopy();
+            activeCopy.BindValueChanged(a =>
+            {
+                Color4 colour = a.NewValue ? torii_badge_active : torii_red;
+                icon.FadeColour(colour, transition_duration, Easing.OutQuint);
+                text.FadeColour(colour, transition_duration, Easing.OutQuint);
+            }, true);
+        }
+    }
+}
