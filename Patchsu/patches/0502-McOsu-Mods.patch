+        /// </summary>
+        private (IBeatmap Beatmap, double Time)? gameplayStartTime;
+
+        /// <summary>
+        /// Mods that animate objects over time, move them, depend on the approach circles or the preempt time, or turn the playfield.
+        /// The pictures can't follow any of that.
+        /// </summary>
+        public override Type[] IncompatibleMods => new[]
+        {
+            typeof(IRequiresApproachCircles),
+            typeof(OsuModHidden),
+            typeof(OsuModFreezeFrame),
+            typeof(OsuModTransform),
+            typeof(OsuModWiggle),
+            typeof(OsuModSpinIn),
+            typeof(OsuModObjectScaleTween),
+            typeof(OsuModMagnetised),
+            typeof(OsuModRepel),
+            typeof(OsuModDepth),
+            typeof(OsuModBarrelRoll),
+        };
+
+        public double ApplyToGameplayStartTime(double gameplayStartTime, IBeatmap beatmap, IReadOnlyList<Mod> mods)
+        {
+            if (this.gameplayStartTime is var (memoBeatmap, memoTime) && memoBeatmap == beatmap)
+                return Math.Min(gameplayStartTime, memoTime);
+
+            var objects = beatmap.HitObjects.OfType<OsuHitObject>().Where(h => h is not Spinner).OrderBy(h => h.StartTime).ToList();
+
+            if (objects.Count == 0)
+                return gameplayStartTime;
+
+            double rate = ModUtils.CalculateRateWithMods(mods);
+            double prepareTime = PictureCache.HasPlay(GetPlayKey(beatmap, objects, mods)) ? RETRY_PREPARE_TIME : PREPARE_TIME;
+            double time = GetAppearTime(objects, rate) - prepareTime * rate;
+
+            this.gameplayStartTime = (beatmap, time);
+            return Math.Min(gameplayStartTime, time);
+        }
+
+        /// <summary>
+        /// Identifies a play's objects as drawn: the beatmap, where its objects are, and the mods (except this one's settings, which
+        /// don't change the pictures).
+        /// </summary>
+        public static string GetPlayKey(IBeatmap beatmap, IReadOnlyList<OsuHitObject> objects, IEnumerable<Mod> mods)
+        {
+            var hash = new HashCode();
+
+            foreach (var h in objects)
+            {
+                hash.Add(h.StartTime);
+                hash.Add(h.StackedPosition);
+                hash.Add(h.Scale);
+                hash.Add(h.ComboIndexWithOffsets);
+            }
+
+            string modsKey = string.Join(",", mods.Where(m => m is not OsuModMafham).OrderBy(m => m.Acronym).Select(m => JsonConvert.SerializeObject(new APIMod(m))));
+
+            return $"{beatmap.BeatmapInfo.MD5Hash}|{objects.Count}|{hash.ToHashCode()}|{modsKey}";
+        }
+
+        /// <summary>
+        /// Forgets the kept pictures (tests).
+        /// </summary>
+        public static void ClearPictureCache() => PictureCache.Clear();
+
+        /// <summary>
+        /// Whether the play is a replay (or autoplay), where Mafham's icon switches it.
+        /// </summary>
+        private bool isReplay;
+
+        /// <summary>
+        /// Whether Mafham is switched on (it can be switched off while watching a replay).
+        /// </summary>
+        public bool EffectsEnabled { get; private set; } = true;
+
+        public void ApplyToPlayer(Player player) => isReplay = player is ReplayPlayer;
+
+        public void ApplyToHUD(HUDOverlay overlay)
+        {
+            if (isReplay)
+                overlay.Add(new ReplayToggle(this, overlay));
+        }
+
+        /// <summary>
+        /// Switches Mafham on or off while watching a replay. Off, the objects that aren't playable yet fade to
+        /// <see cref="REPLAY_OFF_OPACITY"/>, so the replay looks like it has the normal approach rate (without approach circles); each
+        /// object fades in when it becomes playable. Only what is seen changes.
+        /// </summary>
+        public void SetEffectsEnabled(bool enabled)
+        {
+            if (EffectsEnabled == enabled)
+                return;
+
+            EffectsEnabled = enabled;
+            layer?.SetPictureOpacity(enabled ? 1 : REPLAY_OFF_OPACITY);
+            layer?.RefreshLiveObjects();
+        }
+
+        /// <summary>
+        /// When every object appears: <see cref="VIEW_TIME"/> before the first object, or at its normal approach start if that's earlier.
+        /// </summary>
+        /// <param name="objects">The objects (no spinners).</param>
+        /// <param name="rate">The play's rate (so the times are real time).</param>
+        /// <remarks>Unchanged by <see cref="ApplyPreempt"/> with this time.</remarks>
+        public static double GetAppearTime(IReadOnlyList<OsuHitObject> objects, double rate)
+            => Math.Min(objects.Min(h => h.StartTime - h.TimePreempt), objects.Min(h => h.StartTime) - VIEW_TIME * rate);
+
+        public void ApplyToDrawableRuleset(DrawableRuleset<OsuHitObject> drawableRuleset)
+        {
+            var osuRuleset = (DrawableOsuRuleset)drawableRuleset;
+
+            osuRuleset.Playfield.FollowPoints.Hide();
+            osuRuleset.KeyBindingInputManager.Add(layer = new MafhamLayer(this, osuRuleset));
+        }
+
+        public void ApplyToDrawableHitObject(DrawableHitObject drawable)
+        {
+            if (drawable is DrawableOsuHitObject osuDrawable)
+                osuDrawable.DimUntilHittable = false;
+
+            drawable.ApplyCustomUpdateState += (d, state) =>
+            {
+                if (d is DrawableHitCircle circle)
+                {
+                    circle.ApproachCircle.ClearTransforms();
+                    circle.ApproachCircle.Alpha = 0;
+                }
+
+                // A slider's parts (head, tail, repeats) each get their own call.
+                if (d is not DrawableSlider && d is not DrawableSpinner)
+                    disableKiaiFlash(d);
+
+                // Brightens (and fades in, while switched off in a replay) from the pictures' look when it comes alive. (Frozen copies
+                // come alive when the map appears, so they're at full brightness when drawn; the layer darkens and fades the pictures.)
+                float brightness = FarObjectBrightness.Value;
+                float opacity = EffectsEnabled ? 1 : REPLAY_OFF_OPACITY;
+
+                if (state == ArmedState.Idle && (brightness < 1 || opacity < 1) && FrozenObject.CanCopy(d))
+                {
+                    using (d.BeginAbsoluteSequence(d.LifetimeStart))
+                        d.FadeColour(new Color4(brightness, brightness, brightness, opacity)).FadeColour(Color4.White, BRIGHTEN_DURATION);
+                }
+            };
+        }
+
+        /// <summary>
+        /// Turns off the flashing in kiai sections of circles, slider ends and repeats (all skins). The pictures can't flash, so an
+        /// object would start flashing when its drawable takes over, and a picture drawn during kiai could catch a flash.
+        /// </summary>
+        private static void disableKiaiFlash(Drawable drawable)
+        {
+            // The default and argon circles flash a child of KiaiFlash; legacy circles flash a second copy of the circle sprite.
+            foreach (var flash in drawable.ChildrenOfType<KiaiFlash>())
+                flash.Alpha = 0;
+
+            foreach (var flash in drawable.ChildrenOfType<LegacyKiaiFlashingDrawable>())
+                flash.FlashingDrawable.Scale = Vector2.Zero;
+        }
+
+        /// <summary>
+        /// Lengthens the preempt of every object except spinners (and their nested objects, recursively),
+        /// so that every drawable is fully faded in from <paramref name="appearTime"/> on.
+        /// </summary>
+        public static void ApplyPreempt(OsuHitObject hitObject, double appearTime)
+        {
+            if (hitObject is Spinner)
+                return;
+
+            hitObject.TimePreempt = Math.Max(hitObject.TimePreempt, hitObject.StartTime - appearTime);
+
+            foreach (var nested in hitObject.NestedHitObjects.OfType<OsuHitObject>())
+                ApplyPreempt(nested, appearTime);
+        }
+
+        /// <summary>
+        /// Draws the objects whose drawable hit objects aren't alive yet.
+        /// </summary>
+        /// <remarks>
+        /// <para>
+        /// Pages: consecutive objects drawn once into a cached frame buffer. A page is drawn from frozen copies (<see cref="FrozenObject"/>:
+        /// drawable hit objects on a stopped clock). Page sizes are counted in cost (<see cref="CostOf"/>: a slider costs as much as
+        /// three circles to update and draw). The front page (the next objects) costs at most <see cref="FRONT_PAGE_COST"/>, so taking
+        /// an object out redraws only a few. Later pages are bigger (doubling up to <see cref="MAX_PAGE_COST"/>), which keeps
+        /// the page count low; when a big page becomes the front one it's split again the same way.
+        /// </para>
+        /// <para>
