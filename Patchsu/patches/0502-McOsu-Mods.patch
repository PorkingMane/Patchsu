+namespace osu.Game.Rulesets.Osu.Mods
+{
+    /// <summary>
+    /// Patchsu patch 502: McOsu's "Mafham". Approach rate is set to negative infinity: every object (except spinners) is on screen
+    /// from the moment the first one appears, without approach circles, follow points or the "not hittable yet" dim.
+    /// </summary>
+    /// <remarks>
+    /// Only what is seen changes. Hit windows, stacking, star rating, PP and the autoplay replay stay as they are: the longer preempt
+    /// is set on the gameplay copy of the beatmap only, after the autoplay replay was made, and the playfield's drawable hit objects
+    /// still come alive at the normal approach rate. Like McOsu, the map appears a few seconds before the first object
+    /// (<see cref="VIEW_TIME"/>), and the lead-in is longer still (<see cref="PREPARE_TIME"/>) to draw the map before it appears.
+    ///
+    /// Keeping a thousand live drawable hit objects on screen costs thousands of draw calls and about a megabyte of renderer memory
+    /// per slider. Like McOsu, objects that aren't close yet are drawn into cached frame buffers instead (<see cref="MafhamLayer"/>),
+    /// so a frame only draws a few textured quads for them, and most of the time only the pictures are kept in memory.
