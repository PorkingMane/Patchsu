+
+            /// <summary>
+            /// The pictures' opacity (not counting the map's fade-in).
+            /// </summary>
+            public float PictureOpacity => pageContainer.Alpha;
+
+            /// <summary>
+            /// The pictures' colour (their brightness).
+            /// </summary>
