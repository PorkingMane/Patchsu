+
+            /// <summary>
+            /// When an object's picture is taken out: when its drawable comes alive.
+            /// </summary>
+            public double GetRemovalTime(OsuHitObject hitObject) => liveTimes[hitObject];
+
+            // The copies are only pictures; clicks belong to the real objects.
+            public override bool PropagatePositionalInputSubTree => false;
+            public override bool PropagateNonPositionalInputSubTree => false;
+
+            [BackgroundDependencyLoader]
+            private void load(IRenderer renderer, SkinManager? skins, OsuConfigManager? config)
+            {
+                drawing = renderer is not DummyRenderer;
+
+                // This runs while the drawable ruleset loads, before it adds its hit objects (see LoadComplete for their lifetimes).
+                var objects = drawableRuleset.Beatmap.HitObjects.OfType<OsuHitObject>().Where(h => h is not Spinner).OrderBy(h => h.StartTime).ToList();
+
+                var pictures = drawableRuleset.CreatePlayfieldAdjustmentContainer();
+                pictures.Children = new Drawable[]
+                {
+                    pageContainer = new Container<Page>
+                    {
+                        RelativeSizeAxes = Axes.Both,
+                        Colour = new Color4(mod.FarObjectBrightness.Value, mod.FarObjectBrightness.Value, mod.FarObjectBrightness.Value, 1),
+                    },
+                    snapshotContainer = new Container<Snapshot>
+                    {
+                        RelativeSizeAxes = Axes.Both,
+                    },
+                };
+                InternalChild = pictures;
+
+                if (objects.Count == 0)
+                    return;
+
+                // Before the preempt changes (the key doesn't use it, but stays the same work as in ApplyToGameplayStartTime).
+                playKey = GetPlayKey(drawableRuleset.Beatmap, objects, drawableRuleset.Mods);
+                pictureKey = $"{playKey}|{skins?.CurrentSkinInfo.Value.ID}|{config?.Get<bool>(OsuSetting.BeatmapSkins)}|{config?.Get<bool>(OsuSetting.BeatmapColours)}"
+                             + $"|{config?.Get<float>(OsuSetting.ComboColourNormalisationAmount)}";
+
+                appearTime = GetAppearTime(objects, ModUtils.CalculateRateWithMods(drawableRuleset.Mods));
+
+                var frozen = new List<OsuHitObject>();
+
+                foreach (var h in objects)
+                {
+                    liveTimes[h] = h.StartTime - h.TimePreempt;
+                    ApplyPreempt(h, appearTime);
+
+                    if (FrozenObject.CanCopy(h))
+                        frozen.Add(h);
+                }
+
+                var sizes = getPageSizes(frozen);
+                usedCache = PictureCache.Acquire(pictureKey, playKey, sizes);
+
+                if (usedCache != null)
+                {
+                    // A retry: pages made from the kept pictures, without copies (the first pages load theirs in the background).
+                    captureDone = true;
+
+                    int start = 0;
+
+                    for (int i = 0; i < sizes.Count; i++)
+                    {
+                        var page = new Page(frozen.GetRange(start, sizes[i]), new List<FrozenObject>(), prepareLater: true);
+                        page.UseSnapshot(usedCache.Snapshots[i]);
+                        insertPage(i, page);
+                        start += sizes[i];
+                    }
+                }
+                else
+                    insertPages(0, frozen, null, prepareLater: true);
+            }
+
+            protected override void LoadComplete()
+            {
+                base.LoadComplete();
+
+                pageContainer.Alpha = pictureOpacity;
+
+                // The playfield made its entries with the longer preempt, which would bring every drawable alive at once.
+                // They get their normal lifetimes back. (This runs before the playfield's first update, so none is alive yet.)
+                foreach (var entry in drawableRuleset.Playfield.HitObjectContainer.Entries)
+                {
+                    if (liveTimes.TryGetValue(entry.HitObject, out double liveTime))
+                        entry.LifetimeStart = liveTime;
+                }
+            }
+
+            protected override void Update()
+            {
+                base.Update();
+
+                double now = Time.Current;
+
+                // Rewinding (replays): objects taken out later than now are drawn by pages again.
+                if (passed.Count > 0 && passed.Peek().Time > now)
+                {
+                    var returning = new List<OsuHitObject>();
+
+                    while (passed.Count > 0 && passed.Peek().Time > now)
+                        returning.Add(passed.Pop().HitObject);
+
+                    returnObjects(returning);
+                }
+
+                // Objects whose drawables have come alive are taken out of the pages (the playfield shows them from this frame on).
