+// Added by Patchsu
+
+using System.Collections.Generic;
+using osu.Game.Beatmaps;
+
+namespace osu.Game.Rulesets.Mods
+{
+    /// <summary>
+    /// Patchsu: a mod that changes when gameplay starts (the lead-in before the first object).
+    /// Used by patch 502's Mafham, which needs a few seconds to draw the whole map before it appears.
+    /// </summary>
+    public interface IApplicableToGameplayStartTime : IApplicableMod
+    {
+        /// <param name="gameplayStartTime">The time gameplay would start at.</param>
+        /// <param name="beatmap">The playable beatmap.</param>
+        /// <param name="mods">The play's mods.</param>
+        /// <returns>The time gameplay starts at.</returns>
+        double ApplyToGameplayStartTime(double gameplayStartTime, IBeatmap beatmap, IReadOnlyList<Mod> mods);
+    }
+}
