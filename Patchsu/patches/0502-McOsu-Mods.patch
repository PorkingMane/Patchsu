+            private static int costOf(IEnumerable<OsuHitObject> objects) => objects.Sum(CostOf);
+
+            /// <summary>
+            /// How many pages at the front keep their frozen copies (the front page, and the next one getting ready).
+            /// </summary>
+            public const int WARM_PAGES = 2;
+
+            /// <summary>
+            /// How many pages are drawn for the first time at once (each first drawing takes renderer buffers for its slider bodies).
+            /// </summary>
+            private const int max_preparing_pages = 1;
+
+            /// <summary>
+            /// How many frames the layer's place on screen must stay the same before the first pages are drawn (so they aren't drawn
+            /// during the tail end of the player's opening animation, a fraction of a pixel off).
+            /// </summary>
+            private const int stable_frames_before_drawing = 10;
+
+            private readonly OsuModMafham mod;
+            private readonly DrawableOsuRuleset drawableRuleset;
+
+            /// <summary>
+            /// Pages in time order (the front page first).
+            /// </summary>
+            private readonly List<Page> pages = new List<Page>();
+
+            /// <summary>
+            /// Objects taken out of the pages (their drawables came alive) and when, latest last. For rewinding replays.
+            /// </summary>
+            private readonly Stack<(OsuHitObject HitObject, double Time)> passed = new Stack<(OsuHitObject, double)>();
