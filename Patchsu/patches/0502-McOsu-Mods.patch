+                // Pages are only drawn again at a new size while the map plays (not in the fail animation, which shrinks the playfield).
+                bool canRefresh = Time.Elapsed > 0 && gameplayState?.HasFailed != true;
+
+                bool stable = stableFrames >= stable_frames_before_drawing;
+
+                // Pages are prepared in time order (only the ones made when the play loaded are), so counting as we go is enough.
+                // Pages made from kept pictures don't count: each is a single quad.
+                int preparing = 0;
+                bool allShown = true;
+
+                for (int i = 0; i < pages.Count; i++)
