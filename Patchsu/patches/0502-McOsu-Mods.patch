+                            loadCopies(page);
+                        else if (preparing < max_preparing_pages && page.CopiesWarm)
+                            page.Prepare();
+                    }
+
+                    if (page.Preparing && !page.HasSnapshot)
+                        preparing++;
+
+                    allShown &= page.Shown;
+
+                    bool refresh = canRefresh && page.NeedsRefresh;
+
+                    if (refresh && page.HasSnapshot && !page.SnapshotFits)
+                        page.DropSnapshot();
+
+                    if (refresh && page.CanRedraw)
+                        page.Refresh();
+
+                    bool warm = i < WARM_PAGES || (refresh && !page.CanRedraw);
+
+                    if (warm && !page.HasCopies)
+                        loadCopies(page);
+                    else if (!warm && page.HasCopies && page.Shown && page.IsDrawn)
+                        page.Bake();
+                }
+
+                warmCopies();
+                updateAlpha(now, allShown);
+                updateCapture();
+            }
+
+            /// <summary>
+            /// How much of a frame (in milliseconds) goes to the copies' first updates.
+            /// </summary>
+            private const double warm_budget = 3;
+
+            private readonly System.Diagnostics.Stopwatch warmWatch = new System.Diagnostics.Stopwatch();
+
+            /// <summary>
+            /// Gives copies their first update, a few per frame, front pages first (see <see cref="FrozenObject.Warm"/>).
+            /// </summary>
+            private void warmCopies()
+            {
+                warmWatch.Restart();
+
+                foreach (var page in pages)
+                {
+                    if (!page.HasCopies)
+                        continue;
+
+                    if (!page.WarmCopies(warmWatch, warm_budget))
+                        return;
+                }
+            }
+
+            /// <summary>
+            /// Applies the state again to the drawables that are alive (after Mafham was switched on or off), like a replay seek would.
+            /// </summary>
+            public void RefreshLiveObjects()
+            {
+                foreach (var drawable in drawableRuleset.Playfield.AllHitObjects)
+                    drawable.RefreshStateTransforms();
+            }
+
+            /// <summary>
+            /// Makes the pictures (not the playable objects) more or less visible (replays with Mafham switched off).
+            /// </summary>
+            public void SetPictureOpacity(float opacity)
+            {
+                pictureOpacity = opacity;
+
+                // Straight away: a fade wouldn't move while the replay is paused.
+                if (IsLoaded)
+                    pageContainer.Alpha = opacity;
+            }
+
+            /// <summary>
+            /// Once every page is drawn, copies the pictures into snapshots and keeps them for a retry.
+            /// </summary>
+            private void updateCapture()
+            {
+                if (captureDone || pictureKey == null || readyTime == null)
+                    return;
+
+                // Only the pictures as they were first drawn are kept (an object taken out changes a page).
+                if (passed.Count > 0)
+                {
+                    abortCapture();
+                    return;
+                }
+
+                if (capturing == null)
+                {
+                    capturing = pages.Select(p => new Snapshot(p, drawing)).ToList();
+                    snapshotContainer.AddRange(capturing);
+                    return;
+                }
+
+                foreach (var snapshot in capturing)
+                {
+                    if (!snapshot.IsDrawn)
+                        return;
+                }
+
+                foreach (var snapshot in capturing)
+                {
+                    snapshotContainer.Remove(snapshot, false);
+                    snapshot.ReleaseSource();
+                }
+
+                PictureCache.Store(new PictureCache(pictureKey, playKey!, capturing, pages.Select(p => p.Objects.Count).ToList()));
+
+                capturing = null;
+                captureDone = true;
+            }
+
+            private void abortCapture()
+            {
+                captureDone = true;
+
+                if (capturing == null)
+                    return;
+
+                foreach (var snapshot in capturing)
+                    snapshotContainer.Remove(snapshot, true);
+
+                capturing = null;
+            }
+
+            /// <summary>
+            /// The map appears all at once: it fades in at <see cref="appearTime"/>, or shows straight away when the pages are all drawn
+            /// if that's later (a slow computer, or a seek during the lead-in).
+            /// </summary>
+            private void updateAlpha(double now, bool allShown)
+            {
+                if (allShown && readyTime == null)
+                    readyTime = now;
+
+                if (readyTime is not double ready)
+                    Alpha = 0;
+                else if (ready > appearTime)
+                    Alpha = now >= ready ? 1 : 0;
+                else
+                    Alpha = (float)Math.Clamp((now - appearTime) / FADE_IN_DURATION, 0, 1);
+            }
+
+            private void updateStableSize()
+            {
+                RectangleF screenRect = ScreenSpaceDrawQuad.AABBFloat;
+
+                if (Vector2.Distance(screenRect.TopLeft, lastScreenRect.TopLeft) > 0.01f || Vector2.Distance(screenRect.Size, lastScreenRect.Size) > 0.01f)
+                    stableFrames = 0;
+                else
+                    stableFrames++;
+
+                lastScreenRect = screenRect;
+            }
+
+            private void removeObject(int pageIndex, OsuHitObject hitObject)
+            {
+                var page = pages[pageIndex];
+
+                // Normally its copies were loaded in the background long before; this is only for jumps (seeking).
+                if (!page.HasCopies)
+                    page.AddCopies(createCopies(page.Objects));
+
+                page.Remove(hitObject);
+                passed.Push((hitObject, Time.Current));
+
+                if (page.Objects.Count == 0)
+                {
+                    pages.RemoveAt(pageIndex);
+                    pageContainer.Remove(page, true);
+                }
+            }
+
+            private List<FrozenObject> createCopies(IEnumerable<OsuHitObject> objects) =>
+                objects.Select(h => new FrozenObject(h, liveTimes[h], appearTime, drawableRuleset.Mods)).ToList();
+
+            private void loadCopies(Page page)
+            {
+                if (page.LoadingCopies)
+                    return;
+
+                page.LoadingCopies = true;
+
+                var copies = createCopies(page.Objects);
+
+                LoadComponentsAsync(copies, loaded =>
+                {
+                    page.LoadingCopies = false;
+
+                    // The page is gone, or got copies some other way in the meantime.
+                    if (!pages.Contains(page) || page.HasCopies)
+                    {
+                        DisposeInBackground(loaded);
+                        return;
+                    }
+
+                    page.AddCopies(loaded.ToList());
+                });
+            }
+
+            /// <summary>
+            /// Puts objects back into the pages (rewinding).
+            /// </summary>
+            /// <remarks>
+            /// A replay rewinds in small steps, a few objects at a time, normally all earlier than the front page. They join the front
+            /// page while it's small, otherwise they start a new one, and neighbouring pages at the front are merged while the first isn't
+            /// smaller than the second (like a binary counter). So each copy is redrawn only a few times and there are never many pages.
+            /// </remarks>
+            private void returnObjects(List<OsuHitObject> returning)
+            {
+                var copies = createCopies(returning);
+
+                // Returning objects are normally all earlier than the front page; if not, they're merged in time order.
+                bool mergeFront = pages.Count > 0 && returning.Max(h => h.StartTime) > pages[0].Objects[0].StartTime;
+
+                if (mergeFront || (pages.Count > 0 && costOf(pages[0].Objects) + costOf(returning) <= FRONT_PAGE_COST))
+                {
+                    if (!pages[0].HasCopies)
+                        pages[0].AddCopies(createCopies(pages[0].Objects));
+
+                    var (frontObjects, frontCopies) = takePage(0);
+                    returning.AddRange(frontObjects);
+                    copies.AddRange(frontCopies);
+                }
+
+                var sorted = returning.Zip(copies).OrderBy(p => p.First.StartTime).ToList();
+                returning = sorted.Select(p => p.First).ToList();
+                copies = sorted.Select(p => p.Second).ToList();
+
+                if (costOf(returning) > FRONT_PAGE_COST)
+                {
+                    insertPages(0, returning, copies);
+                    return;
+                }
+
+                insertPage(0, new Page(returning, copies));
+
+                while (pages.Count >= 2 && pages[0].HasCopies && pages[1].HasCopies
+                       && costOf(pages[0].Objects) >= costOf(pages[1].Objects)
+                       && costOf(pages[0].Objects) + costOf(pages[1].Objects) <= MAX_PAGE_COST)
+                {
+                    var (firstObjects, firstCopies) = takePage(0);
+                    var (secondObjects, secondCopies) = takePage(0);
+
+                    insertPage(0, new Page(firstObjects.Concat(secondObjects).ToList(), firstCopies.Concat(secondCopies).ToList()));
+                }
+            }
+
+            /// <summary>
+            /// Removes a page and returns its objects and copies (the copies aren't disposed).
+            /// </summary>
+            private (List<OsuHitObject> Objects, List<FrozenObject> Copies) takePage(int index)
+            {
+                var page = pages[index];
+
+                pages.RemoveAt(index);
+                pageContainer.Remove(page, false);
+
+                var result = (page.Objects.ToList(), page.TakeCopies());
+                page.Dispose();
+                return result;
+            }
+
+            private void insertPage(int index, Page page)
+            {
+                page.WaitsForDraw = drawing;
+                pages.Insert(index, page);
+                pageContainer.Add(page);
+            }
+
+            /// <summary>
+            /// Puts objects (in time order) into new pages at <paramref name="index"/> (see <see cref="getPageSizes"/>).
+            /// </summary>
+            /// <param name="index">Where the new pages go.</param>
+            /// <param name="objects">The objects.</param>
+            /// <param name="copies">Their copies, or null to make new ones.</param>
+            /// <param name="prepareLater">
+            /// Whether the pages are drawn later, while invisible, a few at a time. Otherwise they're shown right away: their copies are
+            /// updated before they're first drawn, in the same frame.
+            /// </param>
+            private void insertPages(int index, List<OsuHitObject> objects, List<FrozenObject>? copies, bool prepareLater = false)
+            {
+                copies ??= createCopies(objects);
+
+                int start = 0;
+
+                foreach (int count in getPageSizes(objects))
+                {
+                    insertPage(index++, new Page(objects.GetRange(start, count), copies.GetRange(start, count), prepareLater));
+                    start += count;
+                }
+            }
+
+            /// <summary>
+            /// How many objects each page gets, in order: pages cost up to <see cref="FRONT_PAGE_COST"/> twice, then doubling up to
+            /// <see cref="MAX_PAGE_COST"/> (a page always gets at least one object).
+            /// </summary>
+            private static List<int> getPageSizes(IReadOnlyList<OsuHitObject> objects)
+            {
+                var sizes = new List<int>();
+
+                int limit = FRONT_PAGE_COST;
+                bool first = true;
+                int index = 0;
+
+                while (index < objects.Count)
+                {
+                    int count = 0;
+                    int cost = 0;
+
+                    while (index < objects.Count && (count == 0 || cost + CostOf(objects[index]) <= limit))
+                    {
+                        cost += CostOf(objects[index]);
+                        count++;
+                        index++;
+                    }
+
+                    sizes.Add(count);
+
+                    if (!first)
+                        limit = Math.Min(limit * 2, MAX_PAGE_COST);
+
+                    first = false;
+                }
+
+                return sizes;
+            }
+
+            protected override void Dispose(bool isDisposing)
+            {
+                base.Dispose(isDisposing);
+
+                // (Snapshots still being drawn are children, disposed with the layer.)
+                usedCache?.Release();
+                usedCache = null;
+            }
+
+            /// <summary>
+            /// Consecutive objects drawn into a cached frame buffer, sized to just cover them.
+            /// </summary>
+            internal partial class Page : PictureBuffer
+            {
+                /// <summary>
+                /// How the copies are drawn into the frame buffer: the usual blending for colours, but with correct coverage
+                /// (o!f's default adds up alpha, which would make overlapping semi-transparent pieces opaque and hide what's behind the page).
+                /// The frame buffer then holds premultiplied colours.
+                /// </summary>
+                public static BlendingParameters ContentBlending => new BlendingParameters
+                {
+                    Source = BlendingType.SrcAlpha,
+                    Destination = BlendingType.OneMinusSrcAlpha,
+                    SourceAlpha = BlendingType.One,
+                    DestinationAlpha = BlendingType.OneMinusSrcAlpha,
+                    RGBEquation = BlendingEquation.Add,
+                    AlphaEquation = BlendingEquation.Add,
+                };
+
+                /// <summary>
+                /// How many frames a new place on screen must last before the page is drawn again there.
+                /// </summary>
+                private const int refresh_stable_frames = 30;
+
+                /// <summary>
+                /// The objects drawn by this page, in time order.
+                /// </summary>
+                public readonly List<OsuHitObject> Objects;
+
+                /// <summary>
+                /// Their frozen copies (in the same order), or none when the page is baked (only its picture is kept).
+                /// </summary>
+                private readonly List<FrozenObject> copies;
+
+                private readonly Container content;
+                private readonly DrawProbe probe;
+
+                /// <summary>
+                /// The area the objects cover, in playfield coordinates.
+                /// </summary>
+                private readonly RectangleF bounds;
+
+                /// <summary>
+                /// Frames left in which the page is redrawn. (A copy is updated in the same frame, before it's drawn. Each extra redraw
+                /// would give every slider body another draw node, with its own megabyte of renderer buffers.)
+                /// </summary>
+                private int redrawFrames;
+
+                /// <summary>
+                /// The page's rectangle on screen (in whole pixels) when its picture was last drawn, or null if it hasn't been drawn yet.
+                /// </summary>
+                private RectangleI? drawnScreenRect;
+
+                private RectangleI lastScreenRect;
+                private int rectStableFrames;
+
+                public bool LoadingCopies;
+
+                /// <summary>
+                /// Whether <see cref="IsDrawn"/> waits for the draw thread (false when nothing is drawn).
+                /// </summary>
+                public bool WaitsForDraw = true;
+
+                public bool WaitingToPrepare { get; private set; }
+                public bool Preparing { get; private set; }
+
+                /// <summary>
+                /// Whether the page should be drawn again, because its place on screen has changed for good (the window was resized).
+                /// </summary>
+                public bool NeedsRefresh { get; private set; }
+
+                public Page(List<OsuHitObject> objects, List<FrozenObject> copies, bool prepareLater = false)
+                {
+                    Objects = objects;
+                    this.copies = copies;
+
+                    bounds = FrozenObject.ComputeBounds(objects[0]);
+
+                    foreach (var h in objects)
+                        bounds = RectangleF.Union(bounds, FrozenObject.ComputeBounds(h));
+
+                    // Placed on whole screen pixels when it's drawn (see alignToPixels).
+                    Position = bounds.TopLeft;
+                    Size = bounds.Size;
+
+                    // Earlier objects are drawn above later ones.
+                    Depth = (float)objects[0].StartTime;
+
+                    InternalChild = content = new Container
+                    {
+                        Blending = ContentBlending,
+                        Position = -bounds.TopLeft,
+                        Size = OsuPlayfield.BASE_SIZE,
+                        Child = probe = new DrawProbe { Position = bounds.TopLeft },
+                    };
+
+                    content.AddRange(copies);
+
+                    if (prepareLater)
+                    {
+                        Alpha = 0;
+                        WaitingToPrepare = true;
+                    }
+                    else
+                        redrawFrames = 1;
+                }
+
+                public int CopyCount => copies.Count;
+
+                public bool HasCopies => copies.Count > 0;
+
+                /// <summary>
+                /// Shows a kept picture (<see cref="Snapshot"/>), drawn into this page's frame buffer instead of copies until the page gets
+                /// copies or the picture doesn't fit anymore.
+                /// </summary>
+                private BufferedContainerView<Drawable>? snapshotView;
+
+                /// <summary>
+                /// Where the kept picture was drawn on screen.
+                /// </summary>
+                private RectangleI snapshotRect;
+
+                /// <summary>
+                /// Where the page's picture was last drawn on screen (in whole pixels), or null if it hasn't been drawn yet.
+                /// </summary>
+                public RectangleI? DrawnScreenRect => drawnScreenRect;
+
+                public bool HasSnapshot => snapshotView != null;
+
+                /// <summary>
+                /// Whether the kept picture would be drawn exactly where it was drawn from (otherwise it'd be stretched).
+                /// </summary>
+                public bool SnapshotFits => snapshotView != null && computeScreenRect() == snapshotRect;
+
+                /// <summary>
+                /// Whether the page's picture can be drawn (again) now.
+                /// </summary>
+                public bool CanRedraw => HasCopies || HasSnapshot;
+
+                public void UseSnapshot(Snapshot snapshot)
+                {
+                    snapshotRect = snapshot.ScreenRect;
+
+                    AddInternal(snapshotView = snapshot.CreateView().With(v => v.RelativeSizeAxes = Axes.Both));
+                }
+
+                public void DropSnapshot()
+                {
+                    if (snapshotView == null)
+                        return;
+
+                    RemoveInternal(snapshotView, true);
+                    snapshotView = null;
+                }
+
+                public bool Shown => !WaitingToPrepare && !Preparing;
+
+                /// <summary>
+                /// Whether the picture has been drawn since the last change.
+                /// </summary>
+                public bool IsDrawn => redrawFrames == 0 && (!WaitsForDraw || probe.DrawnVersion >= probe.Version);
+
+                /// <summary>
+                /// Draws the page while it's still invisible.
+                /// </summary>
+                public void Prepare()
+                {
+                    WaitingToPrepare = false;
+                    Preparing = true;
+                    AlwaysPresent = true;
+                    redrawFrames = 1;
+                }
+
+                public void FinishPreparing()
+                {
+                    Preparing = false;
+                    AlwaysPresent = false;
+                    Alpha = 1;
+                }
+
+                public void Remove(OsuHitObject hitObject)
+                {
+                    int index = Objects.IndexOf(hitObject);
+
+                    Objects.RemoveAt(index);
+
+                    var copy = copies[index];
+                    copies.RemoveAt(index);
+                    content.Remove(copy, false);
+                    DisposeInBackground(new[] { copy });
+
+                    redrawFrames = Math.Max(redrawFrames, 1);
+                }
+
+                public List<FrozenObject> TakeCopies()
+                {
+                    var all = copies.ToList();
+
+                    foreach (var copy in all)
+                        content.Remove(copy, false);
+
+                    copies.Clear();
+                    return all;
+                }
+
+                public void AddCopies(List<FrozenObject> newCopies)
+                {
+                    copies.AddRange(newCopies);
+                    content.AddRange(newCopies);
+
+                    // Same picture as before, so it isn't redrawn (the layer asks for a refresh if needed). The layer warms the copies
+                    // a few per frame, so they're ready when the next redraw comes.
+                }
+
+                /// <summary>
+                /// Whether every copy has had its first update (see <see cref="FrozenObject.Warm"/>).
+                /// </summary>
+                public bool CopiesWarm
+                {
+                    get
+                    {
+                        foreach (var copy in copies)
+                        {
+                            if (!copy.IsWarm)
+                                return false;
+                        }
+
+                        return true;
+                    }
+                }
+
+                /// <summary>
+                /// Gives copies their first update until <paramref name="watch"/> passes <paramref name="budget"/> milliseconds.
+                /// </summary>
+                /// <returns>Whether every copy is warm.</returns>
+                public bool WarmCopies(System.Diagnostics.Stopwatch watch, double budget)
+                {
+                    foreach (var copy in copies)
+                    {
+                        if (copy.IsWarm)
+                            continue;
+
+                        if (watch.Elapsed.TotalMilliseconds >= budget)
+                            return false;
+
+                        copy.Warm();
+                    }
+
+                    return true;
+                }
+
+                /// <summary>
+                /// Draws the picture again at the page's current size on screen.
+                /// </summary>
+                public void Refresh()
+                {
+                    NeedsRefresh = false;
+                    redrawFrames = Math.Max(redrawFrames, 1);
+                }
+
+                /// <summary>
+                /// Disposes the copies and keeps only the picture.
+                /// </summary>
+                public void Bake() => DisposeInBackground(TakeCopies());
+
+
+
+                protected override void Update()
+                {
+                    RectangleI screenRect = computeScreenRect();
+
+                    // Copies take over from a kept picture (they're needed when an object is taken out), and a kept picture is only drawn
+                    // where it was drawn from.
+                    if (redrawFrames > 0 && snapshotView != null && (HasCopies || screenRect != snapshotRect))
+                        DropSnapshot();
+
+                    bool redraw = redrawFrames > 0 && CanRedraw;
+
+                    // Before the buffered container's update, which sees the new size and redraws in this frame too.
+                    if (redraw)
+                        alignToPixels(screenRect);
+
+                    base.Update();
+
+                    if (redraw)
+                    {
+                        redrawFrames--;
+                        probe.Request();
+                        ForceRedraw();
+                        drawnScreenRect = screenRect;
+                    }
+
+                    // The window was resized: once the new place has lasted a moment, the picture is drawn again there.
+                    // (Not while it keeps changing, like during the player's open/close animation.)
+                    if (screenRect != lastScreenRect)
+                        rectStableFrames = 0;
+                    else
+                        rectStableFrames++;
+
+                    lastScreenRect = screenRect;
+
+                    if (drawnScreenRect is RectangleI drawn && !NeedsRefresh && rectStableFrames >= refresh_stable_frames && screenRect != drawn)
+                        NeedsRefresh = true;
+                }
+
+                /// <summary>
+                /// The objects' area on screen, widened to whole pixels.
+                /// </summary>
+                private RectangleI computeScreenRect()
+                {
+                    var parent = (Drawable)Parent!;
+
+                    Vector2 a = parent.ToScreenSpace(bounds.TopLeft);
+                    Vector2 b = parent.ToScreenSpace(bounds.BottomRight);
+
+                    int left = (int)MathF.Floor(MathF.Min(a.X, b.X));
+                    int top = (int)MathF.Floor(MathF.Min(a.Y, b.Y));
+                    int right = (int)MathF.Ceiling(MathF.Max(a.X, b.X));
+                    int bottom = (int)MathF.Ceiling(MathF.Max(a.Y, b.Y));
+
+                    return new RectangleI(left, top, right - left, bottom - top);
+                }
+
+                /// <summary>
+                /// Puts the page exactly on <paramref name="screenRect"/>. A frame buffer is as big as its drawable's size on screen,
+                /// rounded up, and is drawn back over that (fractional) area with nearest filtering. On fractional pixels the picture
+                /// would be shifted by up to a pixel and lose a row and column of pixels somewhere (looking compressed next to the live
+                /// objects); on whole pixels each of its pixels lands on the screen pixel it was drawn for.
+                /// </summary>
+                private void alignToPixels(RectangleI screenRect)
+                {
+                    var parent = (Drawable)Parent!;
+
+                    // A hair smaller than the whole pixels, so rounding errors never make the frame buffer a pixel bigger.
+                    Vector2 topLeft = parent.ToLocalSpace(new Vector2(screenRect.Left, screenRect.Top));
+                    Vector2 bottomRight = parent.ToLocalSpace(new Vector2(screenRect.Right - 0.01f, screenRect.Bottom - 0.01f));
+
+                    Position = topLeft;
+                    Size = bottomRight - topLeft;
+                    content.Position = -topLeft;
+                }
+            }
+        }
+
+        /// <summary>
+        /// Lets the viewer of a replay click Mafham's icons (the HUD's, and a skin's own mod display) to switch it on and off
+        /// (<see cref="SetEffectsEnabled"/>). A switched-off icon is greyed out.
+        /// </summary>
+        /// <remarks>
+        /// The icons aren't Mafham's to change, so the toggle puts its own clickable areas over them. It looks for them twice a second
+        /// (mod displays make their icons when they load, and again when the skin changes) and follows them every frame.
+        /// </remarks>
+        public partial class ReplayToggle : CompositeDrawable
+        {
+            private const double scan_interval = 500;
+
+            private readonly OsuModMafham mod;
+            private readonly Drawable hud;
+
+            private readonly List<ModIcon> icons = new List<ModIcon>();
+            private readonly List<ClickArea> areas = new List<ClickArea>();
+
+            private double nextScan;
+
+            public ReplayToggle(OsuModMafham mod, Drawable hud)
+            {
+                this.mod = mod;
+                this.hud = hud;
+
+                RelativeSizeAxes = Axes.Both;
+
+                // Above everything else in the HUD, so it gets the click before the icon does.
+                Depth = float.MinValue;
+            }
+
+            /// <summary>
+            /// The icons being followed (tests).
+            /// </summary>
+            public IReadOnlyList<ModIcon> Icons => icons;
+
+            /// <summary>
+            /// Clicks an icon's area (tests).
+            /// </summary>
+            public void Toggle() => mod.SetEffectsEnabled(!mod.EffectsEnabled);
+
+            protected override void Update()
+            {
+                base.Update();
+
+                if (Time.Current >= nextScan)
+                {
+                    nextScan = Time.Current + scan_interval;
+                    scan();
+                }
+
+                for (int i = 0; i < icons.Count; i++)
+                {
+                    var icon = icons[i];
+                    var area = areas[i];
+
+                    bool shown = icon.IsAlive && icon.IsPresent && icon.Parent != null;
+                    area.Active = shown;
+
+                    if (!shown)
+                        continue;
+
+                    var rect = icon.ScreenSpaceDrawQuad.AABBFloat;
+                    Vector2 topLeft = ToLocalSpace(rect.TopLeft);
+                    Vector2 bottomRight = ToLocalSpace(rect.BottomRight);
+
+                    area.Position = topLeft;
+                    area.Size = bottomRight - topLeft;
+
+                    icon.Colour = mod.EffectsEnabled ? Color4.White : Color4.Gray;
+                }
+            }
+
+            private void scan()
+            {
+                icons.Clear();
+                icons.AddRange(hud.ChildrenOfType<ModIcon>().Where(i => i.Mod is OsuModMafham));
+
+                while (areas.Count < icons.Count)
+                {
+                    var area = new ClickArea(Toggle);
+                    areas.Add(area);
+                    AddInternal(area);
+                }
+
+                for (int i = icons.Count; i < areas.Count; i++)
+                    areas[i].Active = false;
+            }
+
+            /// <summary>
+            /// An invisible area that switches Mafham when clicked.
+            /// </summary>
+            private partial class ClickArea : Drawable
+            {
+                private readonly Action onClick;
+
+                /// <summary>
+                /// Whether it's over a shown icon (only then it takes clicks).
+                /// </summary>
+                public bool Active;
+
+                public ClickArea(Action onClick)
+                {
+                    this.onClick = onClick;
+
+                    // Invisible, but takes clicks (an alpha of 0 would make it not present, so it'd get none).
+                    AlwaysPresent = true;
+                }
+
+                public override bool ReceivePositionalInputAt(Vector2 screenSpacePos) => Active && base.ReceivePositionalInputAt(screenSpacePos);
+
+                protected override bool OnClick(ClickEvent e)
+                {
+                    onClick();
+                    return true;
+                }
+            }
+        }
+
+        /// <summary>
+        /// A cached frame buffer that holds premultiplied colours (see <see cref="MafhamLayer.Page.ContentBlending"/>) and is drawn as such.
+        /// </summary>
+        public abstract partial class PictureBuffer : BufferedContainer, IBufferedDrawable
+        {
+            protected PictureBuffer()
+                : base(pixelSnapping: true, cachedFrameBuffer: true)
+            {
+                // A scaled picture (e.g. the player's open/close animation) is shown stretched instead of being redrawn every frame.
+                RedrawOnScale = false;
+
+                // Otherwise semi-transparent parts (slider bodies, many skins' circles) would look darker than live. A view of the picture
+                // (BufferedContainerView) draws it with this blending too, so drawing a view onto a clear frame buffer copies the picture.
+                EffectBlending = new BlendingParameters
+                {
+                    Source = BlendingType.One,
+                    Destination = BlendingType.OneMinusSrcAlpha,
+                    SourceAlpha = BlendingType.One,
+                    DestinationAlpha = BlendingType.OneMinusSrcAlpha,
+                    RGBEquation = BlendingEquation.Add,
+                    AlphaEquation = BlendingEquation.Add,
+                };
+            }
+
+            /// <summary>
+            /// The colour the picture is drawn with: premultiplied too (scaled with its alpha), since the picture is. Otherwise a fading
+            /// picture (e.g. the player fading out) would be added onto what's behind it, glaring white where many objects overlap.
+            /// Changing it doesn't redraw the picture (unlike <see cref="BufferedContainer{T}.EffectColour"/>).
+            /// </summary>
+            DrawColourInfo? IBufferedDrawable.FrameBufferDrawColour
+            {
+                get
+                {
+                    var info = FrameBufferDrawColour!.Value;
+                    var colour = info.Colour;
+
+                    if (colour.HasSingleColour)
+                        colour = ColourInfo.SingleColour(premultiply(colour.TopLeft));
+                    else
+                    {
+                        colour.TopLeft = premultiply(colour.TopLeft);
+                        colour.TopRight = premultiply(colour.TopRight);
+                        colour.BottomLeft = premultiply(colour.BottomLeft);
+                        colour.BottomRight = premultiply(colour.BottomRight);
+                    }
+
+                    return new DrawColourInfo(colour, info.Blending);
+                }
+            }
+
+            private static SRGBColour premultiply(SRGBColour colour)
+            {
+                Color4 c = colour.SRGB;
+                return new SRGBColour { SRGB = new Color4(c.R * c.A, c.G * c.A, c.B * c.A, c.A) };
+            }
+        }
+
+        /// <summary>
+        /// A copy of a page's picture as first drawn, kept after the play for a retry (<see cref="PictureCache"/>).
+        /// </summary>
+        /// <remarks>
+        /// Drawn once next to its page (same place on screen), from a view of the page's frame buffer, then taken out of the draw tree:
+        /// its frame buffer stays as long as it isn't disposed, and pages of later plays draw views of it.
+        /// </remarks>
+        public sealed partial class Snapshot : PictureBuffer
+        {
+            /// <summary>
+            /// Where the picture was drawn on screen.
+            /// </summary>
+            public readonly RectangleI ScreenRect;
+
+            private readonly DrawProbe probe;
+            private readonly bool waitsForDraw;
+
+            internal Snapshot(MafhamLayer.Page page, bool waitsForDraw)
+            {
+                this.waitsForDraw = waitsForDraw;
+
+                ScreenRect = page.DrawnScreenRect ?? default;
+                Position = page.Position;
+                Size = page.Size;
+
+                // Its frame buffer is drawn, but it's never shown itself (its colour is scaled with its alpha).
+                Alpha = 0;
+                AlwaysPresent = true;
+
+                InternalChildren = new Drawable[]
+                {
+                    page.CreateView().With(v => v.RelativeSizeAxes = Axes.Both),
+                    probe = new DrawProbe(),
+                };
+            }
+
+            protected override void LoadComplete()
+            {
+                base.LoadComplete();
+                probe.Request();
+            }
+
+            public bool IsDrawn => !waitsForDraw || (probe.Version > 0 && probe.DrawnVersion >= probe.Version);
+
+            /// <summary>
+            /// Lets go of the page once the picture is copied (and the snapshot is out of the draw tree, so it isn't drawn again).
+            /// </summary>
+            public void ReleaseSource()
+            {
+                AlwaysPresent = false;
+                ClearInternal();
+            }
+        }
+
+        /// <summary>
+        /// The pictures of the last map played with Mafham (one <see cref="Snapshot"/> per page), so a retry doesn't draw them again.
+        /// </summary>
+        /// <remarks>
+        /// Only one map's pictures are kept (about as much GPU memory as the play's pages). They're disposed when another map's pictures
+        /// are kept and no play uses them anymore.
+        /// </remarks>
+        public sealed class PictureCache
+        {
+            private static readonly object gate = new object();
+            private static PictureCache? current;
+
+            /// <summary>
+            /// The kept pictures, if any.
+            /// </summary>
+            public static PictureCache? Current
+            {
+                get
+                {
+                    lock (gate)
+                        return current;
+                }
+            }
+
+            /// <summary>
+            /// The play, skin and settings the pictures were drawn with.
+            /// </summary>
+            public readonly string Key;
+
+            /// <summary>
+            /// The play the pictures were drawn for (see <see cref="GetPlayKey"/>).
+            /// </summary>
+            public readonly string PlayKey;
+
+            public readonly IReadOnlyList<Snapshot> Snapshots;
+
+            /// <summary>
+            /// How many objects each page held.
+            /// </summary>
+            public readonly IReadOnlyList<int> PageSizes;
+
+            private int users;
+            private bool retired;
+
+            public PictureCache(string key, string playKey, IReadOnlyList<Snapshot> snapshots, IReadOnlyList<int> pageSizes)
+            {
+                Key = key;
+                PlayKey = playKey;
+                Snapshots = snapshots;
+                PageSizes = pageSizes;
+            }
+
+            /// <summary>
+            /// Whether pictures are kept for a play (they may still not fit, e.g. after a skin change).
+            /// </summary>
+            public static bool HasPlay(string playKey)
+            {
+                lock (gate)
+                    return current?.PlayKey == playKey;
+            }
+
+            /// <summary>
+            /// The kept pictures for a play with these pages, or null. Each acquired cache must be released.
+            /// </summary>
+            public static PictureCache? Acquire(string key, string playKey, IReadOnlyList<int> pageSizes)
+            {
+                lock (gate)
+                {
+                    if (current == null || current.Key != key || current.PlayKey != playKey || !current.PageSizes.SequenceEqual(pageSizes))
+                        return null;
+
+                    current.users++;
+                    return current;
+                }
+            }
+
+            public void Release()
+            {
+                lock (gate)
+                {
+                    users--;
+
+                    if (retired && users == 0)
+                        dispose();
+                }
+            }
+
+            /// <summary>
+            /// Keeps new pictures (the previous ones go once no play uses them).
+            /// </summary>
+            public static void Store(PictureCache cache)
+            {
+                lock (gate)
+                {
+                    retire();
+                    current = cache;
+                }
+            }
+
+            public static void Clear()
+            {
+                lock (gate)
+                {
+                    retire();
+                    current = null;
+                }
+            }
+
+            private static void retire()
+            {
+                if (current == null)
+                    return;
+
+                current.retired = true;
+
+                if (current.users == 0)
+                    current.dispose();
+            }
+
+            private void dispose()
+            {
+                foreach (var snapshot in Snapshots)
+                    snapshot.Dispose();
+            }
+        }
+
+        /// <summary>
+        /// Tells when the draw thread has drawn the page it's in (it's drawn only when the page's frame buffer is redrawn).
+        /// </summary>
+        public partial class DrawProbe : Drawable
+        {
+            /// <summary>
+            /// The latest requested version (update thread).
+            /// </summary>
+            public long Version { get; private set; }
+
+            private long drawnVersion;
+
+            /// <summary>
+            /// The latest version the draw thread has drawn.
+            /// </summary>
+            public long DrawnVersion => Interlocked.Read(ref drawnVersion);
+
+            public DrawProbe()
+            {
+                Size = Vector2.One;
+            }
+
+            public void Request()
+            {
+                Version++;
+                Invalidate(Invalidation.DrawNode);
+            }
+
+            protected override DrawNode CreateDrawNode() => new ProbeDrawNode(this);
+
+            private class ProbeDrawNode : DrawNode
+            {
+                private new DrawProbe Source => (DrawProbe)base.Source;
+
+                private long version;
+
+                public ProbeDrawNode(DrawProbe source)
+                    : base(source)
+                {
+                }
+
+                public override void ApplyState()
+                {
+                    base.ApplyState();
+                    version = Source.Version;
+                }
+
+                protected override void Draw(IRenderer renderer)
+                {
+                    base.Draw(renderer);
+
+                    long current;
+
+                    do
+                    {
+                        current = Interlocked.Read(ref Source.drawnVersion);
+
+                        if (current >= version)
+                            return;
+                    } while (Interlocked.CompareExchange(ref Source.drawnVersion, version, current) != current);
+                }
+            }
+        }
+
+        /// <summary>
+        /// Disposes drawables (already out of the draw tree) on o!f's background disposal thread. Disposing a frozen slider copy takes
+        /// a few milliseconds of the update thread otherwise (each of its skinned parts unsubscribes from skin changes, one by one):
+        /// a page of 64 sliders made a frame of up to 200 ms.
+        /// </summary>
+        public static void DisposeInBackground(IEnumerable<Drawable> drawables)
+        {
+            // ClearInternal hands its children to the disposal queue (Remove(…, true) would dispose right away).
+            var bin = new Container();
+
+            foreach (var drawable in drawables)
+                bin.Add(drawable);
+
+            bin.Clear(true);
+        }
+
+        /// <summary>
+        /// A drawable hit object on a stopped clock: the object as it looks when its real drawable comes alive.
+        /// </summary>
+        public partial class FrozenObject : Container
+        {
+            public readonly OsuHitObject HitObject;
+
+            private readonly DrawableOsuHitObject drawable;
+            private readonly IReadOnlyList<Mod> mods;
+            private bool modsApplied;
+
+            /// <summary>
+            /// Whether the object can have a copy. Others show up when their drawables come alive.
+            /// Exact types only: objects added by other patches may look different from the ones they derive from.
+            /// </summary>
+            public static bool CanCopy(HitObject hitObject) => hitObject.GetType() == typeof(HitCircle) || hitObject.GetType() == typeof(Slider);
+
+            /// <summary>
+            /// Whether a drawable is the top-level drawable of an object that can have a copy.
+            /// </summary>
+            public static bool CanCopy(DrawableHitObject drawable) => drawable.GetType() == typeof(DrawableHitCircle) || drawable.GetType() == typeof(DrawableSlider);
+
+            /// <param name="hitObject">The object (see <see cref="CanCopy(HitObject)"/>).</param>
+            /// <param name="liveTime">When the object's real drawable comes alive.</param>
+            /// <param name="appearTime">When all objects appear.</param>
+            /// <param name="mods">The play's mods, applied to the copy like to the playfield's drawables.</param>
+            public FrozenObject(OsuHitObject hitObject, double liveTime, double appearTime, IReadOnlyList<Mod> mods)
+            {
+                HitObject = hitObject;
+                this.mods = mods;
+
+                drawable = hitObject is Slider slider ? new DrawableSlider(slider) : new DrawableHitCircle((HitCircle)hitObject);
+
+                RelativeSizeAxes = Axes.Both;
+
+                // Earlier objects are drawn above later ones.
+                Depth = (float)hitObject.StartTime;
+
+                // Shown as of the moment the real drawable comes alive, but never mid fade-in (slider ticks settle 600 ms after appearing).
+                double frozenTime = Math.Max(liveTime, appearTime + 600);
+                Clock = new FramedClock(new ManualClock { CurrentTime = frozenTime, IsRunning = false });
+
+                // Same order as the playfield's pooled objects: mods first, then the object is applied (when loaded).
+                applyMods(drawable);
+
+                Child = drawable;
+            }
+
+            /// <summary>
+            /// Whether the copy has had its first update (when its nested objects get the mods and its state is applied again).
+            /// </summary>
+            public bool IsWarm => modsApplied;
+
+            /// <summary>
+            /// Gives the copy its first update now. It's the costly one (about half a millisecond for a slider: its path, nested objects
+            /// and their state), so the layer does this a few copies per frame before their page is drawn, instead of all of a page's
+            /// copies in the frame it's drawn.
+            /// </summary>
+            public void Warm()
+            {
+                if (!modsApplied)
+                    UpdateSubTree();
+            }
+
+            private void applyMods(DrawableHitObject d)
+            {
+                foreach (var mod in mods.OfType<IApplicableToDrawableHitObject>())
+                    mod.ApplyToDrawableHitObject(d);
+            }
+
+
+            protected override void UpdateAfterChildren()
+            {
+                base.UpdateAfterChildren();
+
+                if (modsApplied)
+                    return;
+
+                // Nested objects are created when the object is applied. They get the mods like pooled nested objects do, and
+                // their state is applied again so the mods take effect.
+                modsApplied = true;
+
+                foreach (var nested in drawable.NestedHitObjects)
+                {
+                    applyMods(nested);
+                    nested.RefreshStateTransforms();
+                }
+
+                drawable.RefreshStateTransforms();
+            }
+
+            /// <summary>
+            /// The area an object covers, in playfield coordinates (with a margin for skins that draw outside the circle).
+            /// </summary>
+            public static RectangleF ComputeBounds(OsuHitObject hitObject)
+            {
+                float radius = (float)(OsuHitObject.OBJECT_RADIUS * hitObject.Scale * 1.6);
+                Vector2 min = hitObject.StackedPosition;
+                Vector2 max = hitObject.StackedPosition;
+
+                if (hitObject is Slider slider)
+                {
+                    var path = new List<Vector2>();
+                    slider.Path.GetPathToProgress(path, 0, 1);
+
+                    foreach (var point in path)
+                    {
+                        Vector2 p = slider.StackedPosition + point;
+                        min = Vector2.ComponentMin(min, p);
+                        max = Vector2.ComponentMax(max, p);
+                    }
+                }
+
+                return new RectangleF(min.X - radius, min.Y - radius, max.X - min.X + radius * 2, max.Y - min.Y + radius * 2);
+            }
+        }
+    }
+}
