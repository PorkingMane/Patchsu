diff --git a/osu.Game/Overlays/Mods/AttributeExponentCounter.cs b/osu.Game/Overlays/Mods/AttributeExponentCounter.cs
new file mode 100644
index 0000000000..767cafd070
--- /dev/null
+++ b/osu.Game/Overlays/Mods/AttributeExponentCounter.cs
@@ -0,0 +1,52 @@
+// Added by Patchsu
+
+using System;
+using System.Globalization;
+using osu.Framework.Graphics.Sprites;
+using osu.Framework.Localisation;
+using osu.Game.Graphics.Sprites;
+using osu.Game.Graphics.UserInterface;
+
+namespace osu.Game.Overlays.Mods
+{
+    /// <summary>
+    /// Patchsu (patch 502): the small exponent after a beatmap attribute's value (Mafham's far objects brightness: −∞^.5).
+    /// Rolls from one value to the next like the value itself; 1 (or none) shows nothing.
+    /// </summary>
+    public partial class AttributeExponentCounter : RollingCounter<double>
+    {
+        private readonly FontUsage font;
+
+        protected override double RollingDuration => 250;
+
+        public AttributeExponentCounter(FontUsage font)
+        {
+            this.font = font;
+            Current.Value = 1;
+            DisplayedCount = 1;
+        }
+
+        /// <summary>
+        /// Sets the exponent to roll to (null: none).
+        /// </summary>
+        public void SetExponent(float? exponent) => Current.Value = exponent ?? 1;
+
+        public override double DisplayedCount
+        {
+            get => base.DisplayedCount;
+            set
+            {
+                base.DisplayedCount = value;
+                // Hidden (and out of the parent's layout) while there's nothing to show.
+                Alpha = isShown(value) ? 1 : 0;
+            }
+        }
+
+        protected override LocalisableString FormatCount(double count)
+            => isShown(count) ? $@"^{count.ToString(@"#.##", CultureInfo.InvariantCulture)}" : string.Empty;
+
+        private static bool isShown(double count) => Math.Round(count, 2) < 1;
+
+        protected override OsuSpriteText CreateSpriteText() => new OsuSpriteText { Font = font };
+    }
+}
