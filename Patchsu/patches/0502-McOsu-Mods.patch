new file mode 100644
index 0000000000..b701a82c50
--- /dev/null
+++ b/osu.Game/Rulesets/Judgements/ExtraJudgement.cs
@@ -0,0 +1,20 @@
+// Added by Patchsu
+
+using osu.Game.Rulesets.Scoring;
+
+namespace osu.Game.Rulesets.Judgements
+{
+    /// <summary>
+    /// Patchsu: a judgement that isn't part of the beatmap, added on top of it during play
+    /// (patch 502: Click Control's miss for an unnecessary click).
+    /// </summary>
+    /// <remarks>
+    /// Its results are scored like any other (combo, accuracy, health, statistics), but they don't count towards
+    /// <see cref="JudgementProcessor.JudgedHits"/>, so they can't end the map early or keep it from ending.
+    /// The beatmap's maximum statistics (and so its maximum combo) come from the autoplay simulation and stay as they are.
+    /// </remarks>
+    public class ExtraJudgement : Judgement
+    {
+        public override HitResult MaxResult => HitResult.Great;
+    }
+}
