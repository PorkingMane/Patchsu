@@ -0,0 +1,379 @@
+// Added by Patchsu
+
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using osu.Framework.Allocation;
+using osu.Framework.Graphics;
+using osu.Framework.Graphics.Containers;
+using osu.Framework.Graphics.Sprites;
+using osu.Framework.Input.Bindings;
+using osu.Framework.Input.Events;
+using osu.Framework.Localisation;
+using osu.Framework.Testing;
+using osu.Game.Audio;
+using osu.Game.Beatmaps.Timing;
+using osu.Game.Graphics;
+using osu.Game.Rulesets.Judgements;
+using osu.Game.Rulesets.Mods;
+using osu.Game.Rulesets.Objects;
+using osu.Game.Rulesets.Objects.Drawables;
+using osu.Game.Rulesets.Objects.Legacy;
+using osu.Game.Rulesets.Osu.Objects;
+using osu.Game.Rulesets.Osu.Objects.Drawables;
+using osu.Game.Rulesets.Osu.UI;
+using osu.Game.Rulesets.Scoring;
+using osu.Game.Rulesets.UI;
+using osu.Game.Scoring;
+using osu.Game.Screens.Play;
+using osu.Game.Skinning;
+using osuTK;
+
+namespace osu.Game.Rulesets.Osu.Mods
+{
+    /// <summary>
+    /// Patchsu patch 502: McOsu's "Jigsaw 1". A click (key or mouse button press) that doesn't judge any object counts as a miss.
+    /// </summary>
+    /// <remarks>
+    /// Like in McOsu, such a miss breaks combo, lowers accuracy and health, counts in the miss statistic and can fail the play
+    /// (Sudden Death / Perfect too). There's no limit, so a play can have more misses than the map has objects. The map's maximum
+    /// combo doesn't change, and the miss isn't shown on hit error meters.
+    /// A click doesn't count:
+    /// - when it judges something (a circle or slider head, including a miss from clicking it too early),
+    /// - the first time it's pressed while a spinner is on screen (McOsu lets a spinner take one click),
+    /// - before the first object has ended, after the last one has ended, during breaks and in other long gaps
+    ///   (more than 5 seconds until the next object, as in McOsu),
+    /// - when it's the click that resumed gameplay after a pause.
+    /// A click on a circle that's locked (notelock shake) or outside every hit window counts, same as McOsu.
+    /// Replays recreate the misses from the recorded clicks, and rewinding a replay takes them back.
+    /// </remarks>
+    public partial class OsuModClickControl : Mod, IApplicableToDrawableRuleset<OsuHitObject>, IApplicableToScoreProcessor, IApplicableToHealthProcessor, IMcOsuMod
+    {
+        /// <summary>
+        /// A gap without objects that is longer than this doesn't count clicks (McOsu's osu_skip_time).
+        /// </summary>
+        public const double SKIPPABLE_GAP = 5000;
+
+        public override string Name => "Click Control";
+        public override string Acronym => "CC";
+        public override IconUsage? Icon => OsuIcon.ModClickControl;
+        public override LocalisableString Description => "Click only when needed, or else...";
+        public override ModType Type => ModType.DifficultyIncrease;
+
+        public override Type[] IncompatibleMods => new[] { typeof(OsuModRelax), typeof(InputBlockingMod) };
+
+        private ScoreProcessor? scoreProcessor;
+        private HealthProcessor? healthProcessor;
+
+        public void ApplyToScoreProcessor(ScoreProcessor scoreProcessor) => this.scoreProcessor = scoreProcessor;
+
+        public ScoreRank AdjustRank(ScoreRank rank, double accuracy) => rank;
+
+        public void ApplyToHealthProcessor(HealthProcessor healthProcessor) => this.healthProcessor = healthProcessor;
+
+        public void ApplyToDrawableRuleset(DrawableRuleset<OsuHitObject> drawableRuleset)
+        {
+            var osuRuleset = (DrawableOsuRuleset)drawableRuleset;
+            var tracker = new ClickTracker(this, osuRuleset);
+
+            // The tracker is first in line for key binding presses, so it sees every press before hit objects handle it.
+            // The fence is updated first after input was handled, i.e. after a frame's presses were judged and before hit objects update.
+            osuRuleset.KeyBindingInputManager.Add(tracker);
+            osuRuleset.KeyBindingInputManager.Add(new Fence(tracker));
+        }
+
+        /// <summary>
+        /// Gives the play an extra miss. Returns false when no score/health processor is attached (e.g. outside a player).
+        /// </summary>
+        private bool applyResult(JudgementResult result)
+        {
+            if (scoreProcessor == null || healthProcessor == null)
+                return false;
+
+            // Same order as Player: health first, so the score knows whether the play had failed.
+            healthProcessor.ApplyResult(result);
+            scoreProcessor.ApplyResult(result);
+            return true;
+        }
+
+        private void revertResult(JudgementResult result)
+        {
+            healthProcessor?.RevertResult(result);
+            scoreProcessor?.RevertResult(result);
+        }
+
+        /// <summary>
+        /// The object an extra miss belongs to. It's not part of the beatmap and isn't drawn.
+        /// </summary>
+        public class ClickControlMiss : OsuHitObject
+        {
+            public ClickControlMiss(double time, Vector2 position)
+            {
+                StartTime = time;
+                Position = position;
+                // Keeps the miss off hit error meters and timing statistics.
+                HitWindows = HitWindows.Empty;
+            }
+
+            public override Judgement CreateJudgement() => new ExtraJudgement();
+
+            protected override HitWindows CreateHitWindows() => HitWindows.Empty;
+        }
+
+        private partial class Fence : Component
+        {
+            private readonly ClickTracker tracker;
+
+            public Fence(ClickTracker tracker)
+            {
+                this.tracker = tracker;
+                Depth = float.MaxValue;
+            }
+
+            protected override void Update()
+            {
+                base.Update();
+                tracker.ProcessPresses();
+            }
+        }
+
+        private partial class ClickTracker : CompositeDrawable, IKeyBindingHandler<OsuAction>
+        {
+            private readonly OsuModClickControl mod;
+            private readonly DrawableOsuRuleset drawableRuleset;
+
+            private readonly double firstObjectEndTime = double.MaxValue;
+            private readonly double lastObjectEndTime = double.MinValue;
+
+            /// <summary>
+            /// Start times of the top-level objects, sorted (for the "long gap" check).
+            /// </summary>
+            private readonly double[] startTimes;
+
+            /// <summary>
+            /// The latest end time among the objects up to each index of <see cref="startTimes"/>.
+            /// </summary>
+            private readonly double[] endTimesSoFar;
+
+            private readonly Spinner[] spinners;
+            private readonly BreakPeriod[] breaks;
+
+            private readonly List<Press> pendingPresses = new List<Press>();
+            private Press? dispatchingPress;
+
+            private readonly Stack<JudgementResult> appliedMisses = new Stack<JudgementResult>();
+            private readonly Stack<(double Time, Spinner Spinner)> spinnerClicks = new Stack<(double, Spinner)>();
+            private readonly HashSet<Spinner> clickedSpinners = new HashSet<Spinner>();
+
+            private OsuResumeOverlay.OsuResumeOverlayInputBlocker? resumeInputBlocker;
+
+            private JudgementContainer<DrawableOsuJudgement> judgementLayer = null!;
+            private JudgementPooler<DrawableOsuJudgement> judgementPooler = null!;
+            private Container missArea = null!;
+            private PausableSkinnableSound missSound = null!;
+
+            [Resolved(CanBeNull = true)]
+            private GameplayState? gameplayState { get; set; }
+
+            public ClickTracker(OsuModClickControl mod, DrawableOsuRuleset drawableRuleset)
+            {
+                this.mod = mod;
+                this.drawableRuleset = drawableRuleset;
+
+                RelativeSizeAxes = Axes.Both;
+                Depth = float.MinValue;
+
+                var objects = drawableRuleset.Beatmap.HitObjects.OrderBy(h => h.StartTime).ToArray();
+
+                startTimes = new double[objects.Length];
+                endTimesSoFar = new double[objects.Length];
+
+                double latestEnd = double.MinValue;
+
+                for (int i = 0; i < objects.Length; i++)
+                {
+                    startTimes[i] = objects[i].StartTime;
+                    latestEnd = Math.Max(latestEnd, objects[i].GetEndTime());
+                    endTimesSoFar[i] = latestEnd;
+                }
+
+                if (objects.Length > 0)
+                {
+                    firstObjectEndTime = objects[0].GetEndTime();
+                    lastObjectEndTime = latestEnd;
+                }
+
+                spinners = objects.OfType<Spinner>().ToArray();
+                breaks = drawableRuleset.Beatmap.Breaks.ToArray();
+            }
+
+            [BackgroundDependencyLoader]
+            private void load()
+            {
+                InternalChildren = new Drawable[]
+                {
+                    judgementPooler = new JudgementPooler<DrawableOsuJudgement>(new[] { HitResult.Miss }),
+                    drawableRuleset.CreatePlayfieldAdjustmentContainer().WithChild(missArea = new Container
+                    {
+                        RelativeSizeAxes = Axes.Both,
+                        Child = judgementLayer = new JudgementContainer<DrawableOsuJudgement> { RelativeSizeAxes = Axes.Both },
+                    }),
+                    missSound = new PausableSkinnableSound(new SampleInfo("Gameplay/combobreak")),
+                };
+            }
+
+            protected override void LoadComplete()
+            {
+                base.LoadComplete();
+
+                drawableRuleset.Playfield.NewResult += onNewResult;
+                resumeInputBlocker = drawableRuleset.Playfield.ChildrenOfType<OsuResumeOverlay.OsuResumeOverlayInputBlocker>().FirstOrDefault();
+            }
+
+            public bool OnPressed(KeyBindingPressEvent<OsuAction> e)
+            {
+                if (e.Action != OsuAction.LeftButton && e.Action != OsuAction.RightButton)
+                    return false;
+
+                // A press that's only part of seeking backwards in a replay.
+                if (Time.Elapsed < 0)
+                    return false;
+
+                // The click that resumed gameplay; the playfield's input blocker swallows it.
+                if (resumeInputBlocker?.BlockNextPress == true)
+                    return false;
+
+                dispatchingPress = new Press(Time.Current, e.ScreenSpaceMousePosition);
+                pendingPresses.Add(dispatchingPress);
+                return false;
+            }
+
+            public void OnReleased(KeyBindingReleaseEvent<OsuAction> e)
+            {
+            }
+
+            private void onNewResult(DrawableHitObject judgedObject, JudgementResult result)
+            {
+                // Results that come while a press is being handled are that press's. (Objects judged by time come
+                // later in the frame, from their own update, when there's no press being handled anymore.)
+                if (dispatchingPress != null)
+                    dispatchingPress.Judged = true;
+            }
+
+            /// <summary>
+            /// Called once per (frame-stable) frame, after the frame's presses were handled and before hit objects update.
+            /// </summary>
+            public void ProcessPresses()
+            {
+                dispatchingPress = null;
+
+                while (appliedMisses.TryPeek(out var miss) && miss.TimeAbsolute > Time.Current)
+                    mod.revertResult(appliedMisses.Pop());
+
+                while (spinnerClicks.TryPeek(out var click) && click.Time > Time.Current)
+                    clickedSpinners.Remove(spinnerClicks.Pop().Spinner);
+
+                foreach (var press in pendingPresses)
+                {
+                    if (press.Judged || !countsAt(press.Time) || takenBySpinner(press.Time))
+                        continue;
+
+                    addMiss(press);
+                }
+
+                pendingPresses.Clear();
+            }
+
+            private bool countsAt(double time)
+            {
+                if (time < firstObjectEndTime || time > lastObjectEndTime)
+                    return false;
+
+                foreach (var b in breaks)
+                {
+                    if (b.Contains(time))
+                        return false;
+                }
+
+                // Long gaps (McOsu's skippable sections): more than SKIPPABLE_GAP until the next object, after the previous one ended.
+                int next = Array.BinarySearch(startTimes, time);
+                next = next < 0 ? ~next : next + 1;
+
+                if (next < startTimes.Length && next > 0)
+                {
+                    if (startTimes[next] - time > SKIPPABLE_GAP && time > endTimesSoFar[next - 1])
+                        return false;
+                }
+
+                return true;
+            }
+
+            private bool takenBySpinner(double time)
+            {
+                foreach (var spinner in spinners)
+                {
+                    if (spinner.StartTime - spinner.TimePreempt > time)
+                        break;
+
+                    if (time > spinner.EndTime || clickedSpinners.Contains(spinner))
+                        continue;
+
+                    clickedSpinners.Add(spinner);
+                    spinnerClicks.Push((time, spinner));
+                    return true;
+                }
+
+                return false;
+            }
+
+            private void addMiss(Press press)
+            {
+                Vector2 position = missArea.ToLocalSpace(press.ScreenSpacePosition);
+                var result = new JudgementResult(new ClickControlMiss(press.Time, position), new ExtraJudgement()) { Type = HitResult.Miss };
+
+                int comboBefore = mod.scoreProcessor?.Combo.Value ?? 0;
+
+                if (!mod.applyResult(result))
+                    return;
+
+                appliedMisses.Push(result);
+                gameplayState?.ApplyResult(result);
+
+                // McOsu always plays the miss sound for these; the HUD only plays it when a combo above 20 breaks.
+                if (comboBefore <= 20)
+                    missSound.Play();
+
+                if (!drawableRuleset.Playfield.DisplayJudgements.Value)
+                    return;
+
+                var judgement = judgementPooler.Get(HitResult.Miss, j => j.Apply(result, null));
+
+                if (judgement == null)
+                    return;
+
+                judgement.Position = position;
+                judgement.Scale = new Vector2(LegacyRulesetExtensions.CalculateScaleFromCircleSize(drawableRuleset.Beatmap.Difficulty.CircleSize, true));
+                judgementLayer.Add(judgement);
+            }
+
+            protected override void Dispose(bool isDisposing)
+            {
+                base.Dispose(isDisposing);
+                drawableRuleset.Playfield.NewResult -= onNewResult;
+            }
+
+            private class Press
+            {
+                public readonly double Time;
+                public readonly Vector2 ScreenSpacePosition;
+                public bool Judged;
+
+                public Press(double time, Vector2 screenSpacePosition)
+                {
+                    Time = time;
+                    ScreenSpacePosition = screenSpacePosition;
+                }
+            }
+        }
+    }
+}
