diff --git a/osu.Game/LocalPriority/LocalPerformanceExclusions.cs b/osu.Game/LocalPriority/LocalPerformanceExclusions.cs
new file mode 100644
index 0000000000..c5ad425535
--- /dev/null
+++ b/osu.Game/LocalPriority/LocalPerformanceExclusions.cs
@@ -0,0 +1,144 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using osu.Framework.Graphics.UserInterface;
+using osu.Game.Beatmaps;
+using osu.Game.Graphics.UserInterface;
+using osu.Game.Scoring;
+
+namespace osu.Game.LocalPriority
+{
+    /// <summary>
+    /// Plays, beatmaps and beatmap sets that never give PP on local profiles (e.g. maps made for skill testing).
+    /// Excluded plays still show in recent scores and count towards play count and most played beatmaps.
+    /// </summary>
+    public class LocalPerformanceExclusions
+    {
+        public List<Guid> Scores { get; set; } = new List<Guid>();
+        public List<Guid> Beatmaps { get; set; } = new List<Guid>();
+        public List<Guid> BeatmapSets { get; set; } = new List<Guid>();
+
+        public LocalPerformanceExclusions Clone() => new LocalPerformanceExclusions
+        {
+            Scores = new List<Guid>(Scores ?? new List<Guid>()),
+            Beatmaps = new List<Guid>(Beatmaps ?? new List<Guid>()),
+            BeatmapSets = new List<Guid>(BeatmapSets ?? new List<Guid>()),
+        };
+
+        /// <returns>Why the score is excluded from PP, or null when it isn't.</returns>
+        public string? GetReason(ScoreInfo score)
+        {
+            if (Scores.Contains(score.ID))
+                return @"This play is excluded from PP.";
+
+            if (score.BeatmapInfo != null && Beatmaps.Contains(score.BeatmapInfo.ID))
+                return @"This beatmap is excluded from PP.";
+
+            if (score.BeatmapInfo?.BeatmapSet != null && BeatmapSets.Contains(score.BeatmapInfo.BeatmapSet.ID))
+                return @"This beatmap set is excluded from PP.";
+
+            return null;
+        }
+
+        /// <summary>
+        /// The same check for many scores in a row (statistics): hash sets instead of lists, and nothing read from the score when nothing is excluded.
+        /// </summary>
+        public Matcher CreateMatcher() => new Matcher(this);
+
+        public sealed class Matcher
+        {
+            private readonly HashSet<Guid> scores;
+            private readonly HashSet<Guid> beatmaps;
+            private readonly HashSet<Guid> beatmapSets;
+            private readonly bool empty;
+
+            public Matcher(LocalPerformanceExclusions exclusions)
+            {
+                scores = exclusions.Scores.ToHashSet();
+                beatmaps = exclusions.Beatmaps.ToHashSet();
+                beatmapSets = exclusions.BeatmapSets.ToHashSet();
+                empty = scores.Count == 0 && beatmaps.Count == 0 && beatmapSets.Count == 0;
+            }
+
+            /// <inheritdoc cref="LocalPerformanceExclusions.GetReason"/>
+            public string? GetReason(ScoreInfo score)
+            {
+                if (empty)
+                    return null;
+
+                if (scores.Contains(score.ID))
+                    return @"This play is excluded from PP.";
+
+                if (score.BeatmapInfo != null && beatmaps.Contains(score.BeatmapInfo.ID))
+                    return @"This beatmap is excluded from PP.";
+
+                if (score.BeatmapInfo?.BeatmapSet != null && beatmapSets.Contains(score.BeatmapInfo.BeatmapSet.ID))
+                    return @"This beatmap set is excluded from PP.";
+
+                return null;
+            }
+        }
+
+        /// <summary>
+        /// Right-click a score (song select leaderboard, profile page): exclude / include the play, its difficulty or its beatmap set.
+        /// </summary>
+        public static MenuItem CreateScoreMenuItem(LocalProfileManager manager, ScoreInfo score)
+        {
+            var exclusions = manager.Store.PerformanceExclusions;
+            var items = new List<MenuItem>
+            {
+                toggle(exclusions.Scores.Contains(score.ID), @"this play", v => manager.SetExcludedFromPerformance(LocalPerformanceExclusionKind.Score, score.ID, v)),
+            };
+
+            if (score.BeatmapInfo != null)
+            {
+                Guid beatmapId = score.BeatmapInfo.ID;
+                items.Add(toggle(exclusions.Beatmaps.Contains(beatmapId), @"this difficulty",
+                    v => manager.SetExcludedFromPerformance(LocalPerformanceExclusionKind.Beatmap, beatmapId, v)));
+
+                if (score.BeatmapInfo.BeatmapSet != null)
+                {
+                    Guid setId = score.BeatmapInfo.BeatmapSet.ID;
+                    items.Add(toggle(exclusions.BeatmapSets.Contains(setId), @"the whole beatmap set",
+                        v => manager.SetExcludedFromPerformance(LocalPerformanceExclusionKind.BeatmapSet, setId, v)));
+                }
+            }
+
+            return new OsuMenuItem(@"Exclude from PP", MenuItemType.Standard) { Items = items.ToArray() };
+        }
+
+        /// <summary>
+        /// Right-click a difficulty in song select.
+        /// </summary>
+        public static OsuMenuItem CreateBeatmapMenuItem(LocalProfileManager manager, BeatmapInfo beatmap)
+        {
+            Guid id = beatmap.ID;
+            bool excluded = manager.Store.PerformanceExclusions.Beatmaps.Contains(id);
+
+            return new OsuMenuItem(excluded ? @"Include this difficulty in PP again" : @"Exclude this difficulty from PP", MenuItemType.Standard,
+                () => manager.SetExcludedFromPerformance(LocalPerformanceExclusionKind.Beatmap, id, !excluded));
+        }
+
+        /// <summary>
+        /// Right-click a beatmap set in song select.
+        /// </summary>
+        public static OsuMenuItem CreateBeatmapSetMenuItem(LocalProfileManager manager, BeatmapSetInfo beatmapSet)
+        {
+            Guid id = beatmapSet.ID;
+            bool excluded = manager.Store.PerformanceExclusions.BeatmapSets.Contains(id);
+
+            return new OsuMenuItem(excluded ? @"Include this beatmap set in PP again" : @"Exclude this beatmap set from PP", MenuItemType.Standard,
+                () => manager.SetExcludedFromPerformance(LocalPerformanceExclusionKind.BeatmapSet, id, !excluded));
+        }
+
+        private static MenuItem toggle(bool excluded, string what, Action<bool> set) =>
+            new OsuMenuItem(excluded ? $@"Include {what} again" : $@"Exclude {what}", MenuItemType.Standard, () => set(!excluded));
+    }
+
+    public enum LocalPerformanceExclusionKind
+    {
+        Score,
+        Beatmap,
+        BeatmapSet,
+    }
+}
diff --git a/osu.Game/LocalPriority/LocalPriorityDiagnostics.cs b/osu.Game/LocalPriority/LocalPriorityDiagnostics.cs
new file mode 100644
index 0000000000..7e8f4483a0
--- /dev/null
+++ b/osu.Game/LocalPriority/LocalPriorityDiagnostics.cs
@@ -0,0 +1,65 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using osu.Framework.Logging;
+
+namespace osu.Game.LocalPriority
+{
+    /// <summary>
+    /// Switches to turn Patchsu features off one by one at launch, to find which one costs performance
+    /// (compare the debug graphs with clean osu!lazer). Set before starting the game, comma separated:
+    /// <code>OSU_LOCAL_DISABLE=tags,autoswitch</code> (or use local-priority/osu-local-diagnose.sh / .cmd).
+    /// </summary>
+    public static class LocalPriorityDiagnostics
+    {
+        public const string ENVIRONMENT_VARIABLE = @"OSU_LOCAL_DISABLE";
+
+        /// <summary>
+        /// Every switch, with what it turns off.
+        /// </summary>
+        public static readonly IReadOnlyDictionary<string, string> FEATURES = new Dictionary<string, string>
+        {
+            [@"tags"] = @"local beatmap tags (song select details row and search)",
+            [@"autoswitch"] = @"profile auto-switching on beatmap changes",
+            [@"avatars"] = @"local profile pictures on leaderboards / results",
+            [@"modrules"] = @"profile mod rules (enforcing, greying out mods, settings reset at play start)",
+            [@"leaderboard"] = @"forcing the Local leaderboard while the network is off",
+            [@"switcher-menu"] = @"the full-screen right-click menu layer around the profile switcher",
+            [@"profile-ui"] = @"the local profile page and the profile switcher (not loaded at all)",
+            [@"toolbar"] = @"the top bar's local profile name / picture updates",
+            [@"recording"] = @"recording plays for local profile statistics",
+        };
+
+        private static readonly HashSet<string> disabled = parse();
+
+        private static HashSet<string> parse()
+        {
+            string value = Environment.GetEnvironmentVariable(ENVIRONMENT_VARIABLE) ?? string.Empty;
+
+            var set = value.Split(new[] { ',', ';', ' ' }, StringSplitOptions.RemoveEmptyEntries)
+                           .Select(s => s.Trim().ToLowerInvariant())
+                           .ToHashSet();
+
+            if (set.Contains(@"all"))
+                set.UnionWith(FEATURES.Keys);
+
+            return set;
+        }
+
+        /// <summary>
+        /// Whether a feature was turned off with <see cref="ENVIRONMENT_VARIABLE"/>.
+        /// </summary>
+        public static bool IsDisabled(string feature) => disabled.Contains(feature);
+
+        /// <summary>
+        /// Written to the log at startup, so a test run shows what was off.
+        /// </summary>
+        public static void LogState()
+        {
+            if (disabled.Count == 0)
+                return;
+
+            Logger.Log($@"Patchsu diagnostics: turned off: {string.Join(@", ", disabled.OrderBy(d => d))}", LoggingTarget.Runtime, LogLevel.Important);
+        }
+    }
+}
diff --git a/osu.Game/LocalPriority/LocalPriorityPolicy.Profiles.cs b/osu.Game/LocalPriority/LocalPriorityPolicy.Profiles.cs
new file mode 100644
index 0000000000..28204fd2e2
--- /dev/null
+++ b/osu.Game/LocalPriority/LocalPriorityPolicy.Profiles.cs
@@ -0,0 +1,243 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using osu.Framework.Logging;
+using osu.Game.Beatmaps;
+using osu.Game.Online.API.Requests.Responses;
+using osu.Game.Rulesets.Mods;
+using osu.Game.Scoring;
+
+namespace osu.Game.LocalPriority
+{
+    /// <summary>
+    /// Local profiles: who is playing, and how much of the network they may use.
+    /// </summary>
+    /// <remarks>
+    /// A local profile sends nothing to osu! servers, unless Settings → Patchsu → "Use the online account for lookups" is on:
+    /// then the same read-only requests go out with the signed-in online account (the local profile stays the player; nothing is submitted).
+    /// </remarks>
+    public static partial class LocalPriorityPolicy
+    {
+        /// <summary>
+        /// Local profiles use negative user IDs at or below this value, so they can never collide with real osu! accounts.
+        /// </summary>
+        public const int LOCAL_PROFILE_ID_CEILING = -2;
+
+        private static volatile bool localProfileActive;
+
+        /// <summary>
+        /// Whether a local profile is currently active. While true, no network traffic to osu! is allowed at all
+        /// (unless <see cref="LocalProfilesUseOnlineAccount"/> is on).
+        /// </summary>
+        public static bool OfflineProfileActive
+        {
+            get => localProfileActive;
+            internal set
+            {
+                if (localProfileActive == value)
+                    return;
+
+                localProfileActive = value;
+                Logger.Log(value ? "Local profile active." : "Online account active: read-only osu! network access.", LoggingTarget.Network);
+            }
+        }
+
+        private static volatile bool localProfilesUseOnlineAccount;
+
+        /// <summary>
+        /// Settings → Patchsu: while a local profile is active, the signed-in online account may still be used for the read-only
+        /// requests (beatmap lookup / download, tags, leaderboards). Off by default.
+        /// </summary>
+        public static bool LocalProfilesUseOnlineAccount
+        {
+            get => localProfilesUseOnlineAccount;
+            internal set
+            {
+                if (localProfilesUseOnlineAccount == value)
+                    return;
+
+                localProfilesUseOnlineAccount = value;
+                Logger.Log(value
+                    ? "Local profiles may use the online account for read-only lookups."
+                    : "Local profiles are fully offline.", LoggingTarget.Network);
+            }
+        }
+
+        /// <summary>
+        /// Whether the active player (online account, or a local profile with online lookups on) may reach osu! servers at all.
+        /// </summary>
+        public static bool NetworkAllowed => !OfflineProfileActive || LocalProfilesUseOnlineAccount;
+
+        /// <summary>
+        /// The signed-in online account, kept while a local profile is shown as the player (for supporter / team checks on leaderboards).
+        /// </summary>
+        public static APIUser? OnlineAccountUser { get; internal set; }
+
+        /// <summary>
+        /// Whether the given user is a local, offline-only profile.
+        /// </summary>
+        public static bool IsOfflineProfileUser(APIUser? user) => user != null && user.Id <= LOCAL_PROFILE_ID_CEILING;
+
+        #region Per-profile ranking options (active local profile only; always off for the online account)
+
+        /// <summary>
+        /// The active local profile counts every play as if it was set on a ranked / approved beatmap with ranked mods,
+        /// and the "unranked" notices are hidden. Beatmaps themselves (and the song list) are never changed.
+        /// </summary>
+        public static bool CountAllAsRanked { get; internal set; }
+
+        /// <summary>
+        /// The active local profile counts Relax / Autopilot plays towards PP.
+        /// </summary>
+        public static bool CountRelaxAutopilot { get; internal set; }
+
+        /// <summary>
+        /// The active local profile ignores mods' "unranked" status (Relax / Autopilot still follow <see cref="CountRelaxAutopilot"/>).
+        /// </summary>
+        public static bool IgnoreUnrankedMods { get; internal set; }
+
+        public static bool IsRelaxOrAutopilot(IMod mod) => mod.Acronym is @"RX" or @"AP";
+
+        /// <summary>
+        /// Settings → Patchsu "Count LOCAL maps towards PP": beatmaps changed in the editor can give PP (when counted as ranked).
+        /// </summary>
+        public static bool LocalMapsGivePerformance { get; internal set; }
+
+        /// <summary>
+        /// Whether a beatmap status gives PP, taking <see cref="CountAllAsRanked"/> and <see cref="LocalMapsGivePerformance"/> into account.
+        /// </summary>
+        public static bool GrantsPerformance(BeatmapOnlineStatus status) =>
+            status.GrantsPerformancePoints() || (CountAllAsRanked && (status != BeatmapOnlineStatus.LocallyModified || LocalMapsGivePerformance));
+
+        /// <summary>
+        /// Whether a mod counts as ranked, taking the active profile's options into account.
+        /// </summary>
+        public static bool IsModRanked(Mod mod) => isModRanked(mod, CountAllAsRanked, CountRelaxAutopilot, IgnoreUnrankedMods);
+
+        /// <summary>
+        /// Same rule as the results screen: classic mod on legacy (imported) scores doesn't make a score unranked.
+        /// </summary>
+        public static bool HasUnrankedMods(ScoreInfo score, bool countAllAsRanked, bool countRelaxAutopilot, bool ignoreUnrankedMods = false) =>
+            // Counting everything as ranked: no need to build the score's mods at all.
+            !countAllAsRanked && HasUnrankedMods(score.Mods, score.IsLegacyScore, false, countRelaxAutopilot, ignoreUnrankedMods);
+
+        /// <inheritdoc cref="HasUnrankedMods(ScoreInfo, bool, bool, bool)"/>
+        public static bool HasUnrankedMods(IEnumerable<Mod> mods, bool isLegacyScore, bool countAllAsRanked, bool countRelaxAutopilot, bool ignoreUnrankedMods = false) =>
+            !countAllAsRanked && mods.Where(m => !(isLegacyScore && m is ModClassic))
+                                     .Any(m => !isModRanked(m, false, countRelaxAutopilot, ignoreUnrankedMods));
+
+        private static bool isModRanked(IMod mod, bool countAllAsRanked, bool countRelaxAutopilot, bool ignoreUnrankedMods)
+        {
+            if (countAllAsRanked)
+                return true;
+
+            if (IsRelaxOrAutopilot(mod))
+                return countRelaxAutopilot;
+
+            return ignoreUnrankedMods || mod.Ranked;
+        }
+
+        #endregion
+
+        #region Estimated global rank
+
+        // PP-to-rank curve as used by Ritsu (copied there from Modosu by Azuuryy, derived from MOsu by p-720, GPL-3.0),
+        // attributed to a September 2026 sample of 10,000 osu! profiles. Standard (osu!) mode only. Offline estimate, not an official rank.
+        private static readonly (double PP, int Rank)[] rank_curve =
+        {
+            (2.11, 2852394), (45.65, 2142296), (139.97, 1750230), (375.42, 1336787),
+            (721.22, 1020639), (1148.03, 779960), (1621.4, 595532), (2125.51, 454565),
+            (2708.02, 335739), (3302.75, 247883), (3978.95, 177279), (4665.01, 126882),
+            (5403.43, 87234), (6164.53, 58191), (6911.02, 39304), (7677.87, 26024),
+            (8519.1, 16828), (9518.04, 9896), (10741.3, 4951), (11762, 2910),
+            (13010.5, 1549), (15002.6, 553), (17051.7, 211), (18305.4, 120),
+        };
+
+        /// <summary>
+        /// Estimated global rank for a total PP value, by linear interpolation along a sampled PP-to-rank curve.
+        /// Past the curve's best sample, the rank keeps falling at the rate of its last two samples (exponentially, down to #1).
+        /// </summary>
+        public static int EstimateGlobalRank(double pp)
+        {
+            if (pp <= rank_curve[0].PP)
+                return rank_curve[0].Rank;
+            if (pp >= rank_curve[^1].PP)
+                return Math.Max(1, (int)Math.Round(rank_curve[^1].Rank * Math.Exp(top_rank_decay * (pp - rank_curve[^1].PP))));
+
+            for (int i = 1; i < rank_curve.Length; i++)
+            {
+                if (pp > rank_curve[i].PP)
+                    continue;
+
+                var previous = rank_curve[i - 1];
+                var next = rank_curve[i];
+                double progress = (pp - previous.PP) / (next.PP - previous.PP);
+                return (int)Math.Round(previous.Rank + (next.Rank - previous.Rank) * progress);
+            }
+
+            return rank_curve[^1].Rank;
+        }
+
+        /// <summary>
+        /// How fast ln(rank) falls per PP above the curve's best sample (from its last two samples).
+        /// </summary>
+        private static readonly double top_rank_decay =
+            Math.Log((double)rank_curve[^1].Rank / rank_curve[^2].Rank) / (rank_curve[^1].PP - rank_curve[^2].PP);
+
+        /// <summary>
+        /// The least whole PP whose <see cref="EstimateGlobalRank"/> is <paramref name="rank"/> or better (the inverse of the estimate).
+        /// </summary>
+        public static double EstimatePPForRank(int rank)
+        {
+            rank = Math.Max(1, rank);
+
+            // Any PP at all gets the lowest estimated rank.
+            if (rank >= rank_curve[0].Rank)
+                return 1;
+
+            double pp;
+
+            if (rank <= rank_curve[^1].Rank)
+                pp = rank_curve[^1].PP + Math.Log((rank + 0.5) / rank_curve[^1].Rank) / top_rank_decay;
+            else
+            {
+                int i = 1;
+                while (rank_curve[i].Rank > rank)
+                    i++;
+
+                var previous = rank_curve[i - 1];
+                var next = rank_curve[i];
+                pp = previous.PP + (next.PP - previous.PP) * (previous.Rank - rank) / (previous.Rank - next.Rank);
+            }
+
+            // The estimate rounds the rank, so settle on the first whole PP that really gets there.
+            pp = Math.Max(Math.Ceiling(pp), 1);
+            while (pp > 1 && EstimateGlobalRank(pp - 1) <= rank)
+                pp--;
+            while (EstimateGlobalRank(pp) > rank)
+                pp++;
+
+            return pp;
+        }
+
+        #endregion
+
+        private static APIUser? initialLocalUser;
+
+        /// <summary>
+        /// Set before the API is created, so that a game started in a local profile never touches the network, not even briefly.
+        /// </summary>
+        internal static void SetInitialLocalUser(APIUser? user)
+        {
+            initialLocalUser = user;
+            OfflineProfileActive = user != null;
+        }
+
+        internal static APIUser? TakeInitialLocalUser()
+        {
+            var user = initialLocalUser;
+            initialLocalUser = null;
+            return user;
+        }
+    }
+}
diff --git a/osu.Game/LocalPriority/LocalPriorityPolicy.cs b/osu.Game/LocalPriority/LocalPriorityPolicy.cs
