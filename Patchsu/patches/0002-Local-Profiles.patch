+                return;
+
+            localPlayRecorded = true;
+
+            try
+            {
+                int userId = score.ScoreInfo.UserID;
+
+                if (localProfiles == null || userId > LocalPriorityPolicy.LOCAL_PROFILE_ID_CEILING)
