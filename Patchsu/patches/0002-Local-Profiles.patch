+        private void updateGlow()
+        {
+            var mode = opened && loadedProfile != null ? loadedProfile.DeathMode : LocalDeathMode.None;
+
+            setGlow(mode switch
+            {
+                LocalDeathMode.SuddenDeath => sudden_death_glow,
+                LocalDeathMode.PerfectDeath => perfect_death_glow,
+                _ => null,
+            });
