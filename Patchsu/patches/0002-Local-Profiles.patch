+                    rank = value;
+                else
+                    problem = @"Rank must be #1 or lower.";
+            }
+            else
+            {
+                if (double.TryParse(number, NumberStyles.None, CultureInfo.InvariantCulture, out double value) && value > 0)
+                    pp = value;
+                else
+                    problem = @"PP must be a number above 0.";
+            }
+
+            return problem == null;
+        }
