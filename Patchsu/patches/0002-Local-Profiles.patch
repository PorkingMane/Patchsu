+            profileSections = profileSections.OrderBy(orderOf).ToArray();
+
+            for (int i = 0; i < profileSections.Length; i++)
+            {
+                sections.Add(profileSections[i]);
+                sections.SetLayoutPosition(profileSections[i], i);
+            }
