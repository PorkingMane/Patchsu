+        private LocalUnfinishedPlays? unfinishedPlays;
+
+        /// <summary>
+        /// Failed and quit plays from the last day, for the profiles' Recent Plays (patchsu-osu/unfinished-plays.json, read when first needed).
+        /// </summary>
+        public LocalUnfinishedPlays UnfinishedPlays
+        {
