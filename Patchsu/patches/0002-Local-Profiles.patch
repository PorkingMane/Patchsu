diff --git a/osu.Game/LocalPriority/LocalAutoSwitchCondition.cs b/osu.Game/LocalPriority/LocalAutoSwitchCondition.cs
new file mode 100644
index 0000000000..8d00dcadab
--- /dev/null
+++ b/osu.Game/LocalPriority/LocalAutoSwitchCondition.cs
@@ -0,0 +1,177 @@
+// Patched for fun and personal needs. I suggest playing osu!lazer instead of this client. All modifications are done with AI from personal interest.
+// Peppy openly stated that he does not like using AI and we completely respect it. I only do it for research purposes and to see what features I would love in lazer.
+// To use it you'll need to compile it on your PC using provided .sh / .cmd files.
+// This client modification does not break any osu! rules or terms of service and do not conflict with osu! rules for account banning
+// However, I do not take any liablity if your account will be banned for accessing beatmap, leaderboard and metadata downloading
+// Use responsibly and preferably local-only.
+
+using System;
+using System.Collections.Generic;
+using System.Globalization;
+using System.Linq;
+using System.Text.RegularExpressions;
+
+namespace osu.Game.LocalPriority
+{
+    /// <summary>
+    /// The text conditions of an auto-switch rule.
+    /// <para>
+    /// Every field is a comma-separated list, and the field matches when ANY of its entries matches ("180, 190" = 180 BPM or 190 BPM, nothing else).
+    /// </para>
+    /// <para>
+    /// A number entry is "6" / "=6", "&lt;7", "&lt;=7", "&gt;5", "&gt;=5", "5-7", "5+" or "-7". Several comparisons in one entry all have to hold
+    /// ("&gt;5 &lt;7" = above 5 and below 7). Decimals use a dot ("5.5"), since the comma separates entries.
+    /// </para>
+    /// </summary>
+    public static class LocalAutoSwitchCondition
+    {
+        private enum Op
+        {
+            Equal,
+            Less,
+            LessOrEqual,
+            Greater,
+            GreaterOrEqual,
+        }
+
+        /// <summary>
+        /// The entries of a comma-separated field, trimmed, without empty ones.
+        /// </summary>
+        public static List<string> Split(string? text) =>
+            (text ?? string.Empty).Split(',', StringSplitOptions.RemoveEmptyEntries).Select(s => s.Trim()).Where(s => s.Length > 0).ToList();
+
+        /// <summary>
+        /// Whether a text field (mapper, name) matches: any of its entries is a part of one of the texts.
+        /// An empty field always matches.
+        /// </summary>
+        public static bool MatchesText(string? condition, params string?[] texts)
+        {
+            var parts = Split(condition);
+
+            return parts.Count == 0
+                   || parts.Any(part => texts.Any(t => t?.Contains(part, StringComparison.OrdinalIgnoreCase) == true));
+        }
+
+        /// <summary>
+        /// Whether a number field matches <paramref name="value"/>. An empty field always matches; one that can't be read never does.
+        /// </summary>
+        public static bool MatchesNumber(string? condition, double value)
+        {
+            if (Split(condition).Count == 0)
+                return true;
+
+            if (!tryParse(condition!, out var alternatives, out _))
+                return false;
+
+            return alternatives.Any(all => all.All(c => test(c.op, c.value, value)));
+        }
+
+        /// <summary>
+        /// Checks a number field and tidies the commas ("&gt;=5 ,180" → "&gt;=5, 180"). Returns false with the entry that can't be read.
+        /// </summary>
+        public static bool TryNormaliseNumber(string? text, out string normalised, out string? badEntry)
+        {
+            normalised = string.Empty;
+
+            if (!tryParse(text ?? string.Empty, out var alternatives, out badEntry))
+                return false;
+
+            // Keep the way each entry was written ("5-7" stays "5-7"), only the spacing around the commas is tidied.
+            normalised = string.Join(@", ", Split(text));
+            return true;
+        }
+
+        /// <summary>
+        /// The old min/max range as a number field: "5-7", "&gt;=5", "&lt;=7", "6" or "".
+        /// </summary>
+        public static string FromRange(double? min, double? max)
+        {
+            if (min != null && max != null)
+                return min == max ? f(min.Value) : $@"{f(min.Value)}-{f(max.Value)}";
+            if (min != null)
+                return $@">={f(min.Value)}";
+            if (max != null)
+                return $@"<={f(max.Value)}";
+
+            return string.Empty;
+        }
+
+        private static string f(double v) => v.ToString(@"0.##", CultureInfo.InvariantCulture);
+
+        private static bool test(Op op, double target, double value) => op switch
+        {
+            Op.Less => value < target,
+            Op.LessOrEqual => value <= target,
+            Op.Greater => value > target,
+            Op.GreaterOrEqual => value >= target,
+            _ => Math.Abs(value - target) < 1e-9,
+        };
+
+        // "5-7" (a range, also with an en dash), or one comparison: optional operator, then a number, optionally followed by "+".
+        private static readonly Regex range_regex = new Regex(@"^(\d+(?:\.\d+)?)\s*[-–]\s*(\d+(?:\.\d+)?)$", RegexOptions.Compiled);
+
+        private static readonly Regex comparison_regex = new Regex(@"\G\s*(<=|>=|≤|≥|=<|=>|<|>|=|[-–])?\s*(\d+(?:\.\d+)?)(\+)?\s*", RegexOptions.Compiled);
+
+        private static bool tryParse(string text, out List<List<(Op op, double value)>> alternatives, out string? badEntry)
+        {
+            alternatives = new List<List<(Op, double)>>();
+            badEntry = null;
+
+            foreach (string entry in Split(text))
+            {
+                var all = new List<(Op, double)>();
+
+                var range = range_regex.Match(entry);
+
+                if (range.Success)
+                {
+                    double a = num(range.Groups[1].Value), b = num(range.Groups[2].Value);
+                    all.Add((Op.GreaterOrEqual, Math.Min(a, b)));
+                    all.Add((Op.LessOrEqual, Math.Max(a, b)));
+                    alternatives.Add(all);
+                    continue;
+                }
+
+                int position = 0;
+
+                while (position < entry.Length)
+                {
+                    var m = comparison_regex.Match(entry, position);
+
+                    if (!m.Success || m.Length == 0)
+                    {
+                        badEntry = entry;
+                        return false;
+                    }
+
+                    string op = m.Groups[1].Value;
+                    bool plus = m.Groups[3].Success;
+                    double value = num(m.Groups[2].Value);
+
+                    if (plus && op.Length > 0)
+                    {
+                        badEntry = entry;
+                        return false;
+                    }
+
+                    all.Add((plus ? Op.GreaterOrEqual : op switch
+                    {
+                        "<" => Op.Less,
+                        "<=" or "=<" or "≤" or "-" or "–" => Op.LessOrEqual,
+                        ">" => Op.Greater,
+                        ">=" or "=>" or "≥" => Op.GreaterOrEqual,
+                        _ => Op.Equal,
+                    }, value));
+
+                    position += m.Length;
+                }
+
+                alternatives.Add(all);
+            }
+
+            return true;
+        }
+
+        private static double num(string s) => double.Parse(s, NumberStyles.Float, CultureInfo.InvariantCulture);
+    }
+}
diff --git a/osu.Game/LocalPriority/LocalAutoSwitchPopover.cs b/osu.Game/LocalPriority/LocalAutoSwitchPopover.cs
new file mode 100644
index 0000000000..a90058c7db
--- /dev/null
+++ b/osu.Game/LocalPriority/LocalAutoSwitchPopover.cs
@@ -0,0 +1,260 @@
+using System;
+using System.Linq;
+using osu.Framework.Allocation;
+using osu.Framework.Extensions;
+using osu.Framework.Graphics;
+using osu.Framework.Graphics.Containers;
+using osu.Game.Graphics;
+using osu.Game.Graphics.Containers;
+using osu.Game.Graphics.Sprites;
+using osu.Game.Graphics.UserInterface;
+using osu.Game.Graphics.UserInterfaceV2;
+using osu.Game.Overlays;
+using osuTK;
+
+namespace osu.Game.LocalPriority
+{
+    /// <summary>
+    /// "Auto-switch rules" of a profile (right-click its chip on the profile page): which beatmaps make it active by itself.
+    /// </summary>
+    public partial class LocalAutoSwitchPopover : OsuPopover
+    {
+        private readonly LocalProfile profile;
+        private readonly LocalProfileManager manager;
+
+        private OsuTextBox tags = null!;
+        private OsuTextBox stars = null!;
+        private OsuTextBox bpm = null!;
+        private OsuTextBox length = null!;
+        private OsuTextBox mapper = null!;
+        private OsuTextBox name = null!;
+        private OsuSpriteText error = null!;
+        private RoundedButton modsButton = null!;
+
+        /// <summary>
+        /// The mods condition as last picked (kept until "Save").
+        /// </summary>
+        private LocalAutoSwitchRules modsCondition = null!;
+
+        [Resolved]
+        private IOverlayManager? overlays { get; set; }
+
+        [Resolved]
+        private LocalProfileOverlay? profileOverlay { get; set; }
+
+        public LocalAutoSwitchPopover(LocalProfile profile, LocalProfileManager manager)
+        {
+            this.profile = profile;
+            this.manager = manager;
+        }
+
+        [BackgroundDependencyLoader]
+        private void load(OsuColour colours)
+        {
+            var rules = profile.AutoSwitch ?? new LocalAutoSwitchRules();
+            modsCondition = rules.Clone();
+
+            Child = new FillFlowContainer
+            {
+                Width = 360,
+                AutoSizeAxes = Axes.Y,
+                Direction = FillDirection.Vertical,
+                Spacing = new Vector2(0, 8),
+                Children = new Drawable[]
+                {
+                    new OsuSpriteText
+                    {
+                        Text = $@"Auto-switch to ""{profile.Name}""",
+                        Font = OsuFont.GetFont(size: 18, weight: FontWeight.Bold),
+                    },
+                    new OsuTextFlowContainer(t => t.Font = OsuFont.GetFont(size: 12))
+                    {
+                        RelativeSizeAxes = Axes.X,
+                        AutoSizeAxes = Axes.Y,
+                        Alpha = 0.75f,
+                        Text = @"Whenever all of those rules are true - will automatically switch to this profile with a small delay in carousel and instantly when entering matching for rules beatmap (configurable in settings). "
+                               + @"Profile will automatically switch back to previous one active when no rules are true."
+                               + "\n"
+                               + @"You can separate values with commas, profile will switch when either of them are true (""180, 190"" = 180 OR 190 BPM).",
+                    },
+                    field(@"Tags (any of them; local, voted or mapper tags)", tags = box(string.Join(@", ", rules.Tags), @"skillset/jumps, jumps/cross-screen")),
+                    field(@"Star rating", stars = box(rules.Stars, @"5-7 or >6.5")),
+                    field(@"BPM", bpm = box(rules.Bpm, @"180, 190 or >=200")),
+                    field(@"Length in seconds", length = box(rules.Length, @"<90 or 60-240")),
+                    field(@"Mapper (part of the name; any of them)", mapper = box(rules.Mapper, @"Sotarks, Monstrata")),
+                    field(@"Title, artist or difficulty (part of it; any of them)", name = box(rules.Name, string.Empty)),
+                    field(@"Selected mods", modsButton = new RoundedButton
+                    {
+                        RelativeSizeAxes = Axes.X,
+                        Action = pickMods,
+                    }),
+                    error = new OsuSpriteText
+                    {
+                        Font = OsuFont.GetFont(size: 12, weight: FontWeight.SemiBold),
+                        Colour = colours.Red1,
+                        Alpha = 0,
+                    },
+                    new FillFlowContainer
+                    {
+                        RelativeSizeAxes = Axes.X,
+                        AutoSizeAxes = Axes.Y,
+                        Direction = FillDirection.Horizontal,
+                        Spacing = new Vector2(8, 0),
+                        Children = new Drawable[]
+                        {
+                            new RoundedButton
+                            {
+                                Width = 176,
+                                Text = @"Save",
+                                Action = save,
+                            },
+                            new RoundedButton
+                            {
+                                Width = 176,
+                                Text = @"Remove rules",
+                                BackgroundColour = colours.Red3,
+                                Action = () =>
+                                {
+                                    manager.SetAutoSwitch(profile.Id, null);
+                                    this.HidePopover();
+                                },
+                            },
+                        },
+                    },
+                },
+            };
+        }
+
+        protected override void LoadComplete()
+        {
+            base.LoadComplete();
+            updateModsButton();
+        }
+
+        private void updateModsButton() => modsButton.Text = modsCondition.Mods.Count == 0 ? @"Any mods (click to pick mods)" : modsCondition.DescribeMods();
+
+        /// <summary>
+        /// Opens the mod rules picker for this rule's mods. The profile page makes room for it, so what is filled in here is saved first
+        /// (when it is valid), and the page comes back with this editor open afterwards.
+        /// </summary>
+        private void pickMods()
+        {
+            if (overlays == null)
+                return;
+
+            var current = tryBuildRules(out string? problem);
+
+            if (current == null)
+            {
+                showError(problem!);
+                return;
+            }
+
+            if (current.HasAnyCondition)
+                manager.SetAutoSwitch(profile.Id, current);
+
+            Guid id = profile.Id;
+
+            LocalProfileModRulesOverlay.PickAutoSwitchMods(overlays, current, $@"auto-switch mods for {profile.Name}",
+                picked => manager.SetAutoSwitch(id, picked.HasAnyCondition ? picked : null),
+                () => profileOverlay?.ShowAutoSwitchRules(id),
+                () =>
+                {
+                    this.HidePopover();
+                    profileOverlay?.Hide();
+                });
+        }
+
+        private static OsuTextBox box(string text, string placeholder) => new OsuTextBox
+        {
+            RelativeSizeAxes = Axes.X,
+            Text = text,
+            PlaceholderText = placeholder,
+            CommitOnFocusLost = true,
+        };
+
+        private static Drawable field(string label, Drawable control) => new FillFlowContainer
+        {
+            RelativeSizeAxes = Axes.X,
+            AutoSizeAxes = Axes.Y,
+            Direction = FillDirection.Vertical,
+            Spacing = new Vector2(0, 2),
+            Children = new[]
+            {
+                new OsuSpriteText
+                {
+                    Text = label,
+                    Font = OsuFont.GetFont(size: 12, weight: FontWeight.SemiBold),
+                },
+                control,
+            },
+        };
+
+        /// <summary>
+        /// The rule as filled in, or null (with the reason) when a number field can't be read.
+        /// </summary>
+        private LocalAutoSwitchRules? tryBuildRules(out string? problem)
+        {
+            problem = null;
+
+            var rules = new LocalAutoSwitchRules
+            {
+                Tags = tags.Text.Split(',', StringSplitOptions.RemoveEmptyEntries).Select(LocalBeatmapTags.Normalise).Where(t => t.Length > 0).Distinct().ToList(),
+                Mapper = string.Join(@", ", LocalAutoSwitchCondition.Split(mapper.Text)),
+                Name = string.Join(@", ", LocalAutoSwitchCondition.Split(name.Text)),
+                Mods = modsCondition.Clone().Mods,
+                ModMatch = modsCondition.ModMatch,
+                ExactModSettings = modsCondition.ExactModSettings,
+            };
+
+            if ((problem = number(stars, @"Star rating", @"5-7, >6.5 or 4, 6", out string starsCondition)) != null)
+                return null;
+
+            if ((problem = number(bpm, @"BPM", @"180, 190, >=200 or 180-220", out string bpmCondition)) != null)
+                return null;
+
+            if ((problem = number(length, @"Length", @"<90, 60-240 or >=120 (seconds)", out string lengthCondition)) != null)
+                return null;
+
+            rules.Stars = starsCondition;
+            rules.Bpm = bpmCondition;
+            rules.Length = lengthCondition;
+
+            return rules;
+        }
+
+        /// <summary>
+        /// Reads a number field into <paramref name="condition"/>; returns what's wrong with it, or null when it's fine.
+        /// </summary>
+        private static string? number(OsuTextBox box, string label, string examples, out string condition) =>
+            LocalAutoSwitchCondition.TryNormaliseNumber(box.Text, out condition, out string? bad)
+                ? null
+                : $@"{label}: can't read ""{bad}"". Use e.g. {examples}.";
+
+        private void save()
+        {
+            var rules = tryBuildRules(out string? problem);
+
+            if (rules == null)
+            {
+                showError(problem!);
+                return;
+            }
+
+            if (!rules.HasAnyCondition)
+            {
+                showError(@"Fill in at least one condition (or use ""Remove rules"").");
+                return;
+            }
+
+            manager.SetAutoSwitch(profile.Id, rules);
+            this.HidePopover();
+        }
+
+        private void showError(string text)
+        {
+            error.Text = text;
+            error.FadeIn(100);
+        }
+    }
+}
diff --git a/osu.Game/LocalPriority/LocalAutoSwitchRules.cs b/osu.Game/LocalPriority/LocalAutoSwitchRules.cs
new file mode 100644
index 0000000000..50f8c7b30d
--- /dev/null
+++ b/osu.Game/LocalPriority/LocalAutoSwitchRules.cs
@@ -0,0 +1,242 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Runtime.Serialization;
+using Newtonsoft.Json;
+using osu.Game.Beatmaps;
+using osu.Game.Online.API;
+using osu.Game.Rulesets;
+using osu.Game.Rulesets.Mods;
+using osu.Game.Scoring;
+using osu.Game.Utils;
+
+namespace osu.Game.LocalPriority
+{
+    /// <summary>
+    /// How the selected mods have to line up with an auto-switch rule's mods.
+    /// </summary>
+    public enum LocalAutoSwitchModMatch
+    {
+        /// <summary>
+        /// Every one of the rule's mods is selected (other mods may be selected too).
+        /// </summary>
+        All,
+
+        /// <summary>
+        /// At least one of the rule's mods is selected.
+        /// </summary>
+        Any,
+
+        /// <summary>
+        /// Exactly the rule's mods are selected, nothing more and nothing less.
+        /// </summary>
+        Exact,
+    }
+
+    /// <summary>
+    /// When a profile becomes active by itself: selecting a beatmap in song select that matches every condition that is filled in.
+    /// Every field is a comma-separated list that matches when any of its entries does (see <see cref="LocalAutoSwitchCondition"/>).
+    /// </summary>
+    public class LocalAutoSwitchRules
+    {
+        /// <summary>
+        /// The beatmap needs at least one of these tags (local tags, voted tags or the mapper's tags), e.g. "skillset/jumps".
+        /// </summary>
+        public List<string> Tags { get; set; } = new List<string>();
+
+        /// <summary>
+        /// Star rating condition, e.g. "5-7", "&gt;6.5" or "4, 6".
+        /// </summary>
+        public string Stars { get; set; } = string.Empty;
+
+        /// <summary>
+        /// BPM condition, e.g. "180, 190" or "&gt;=200".
+        /// </summary>
+        public string Bpm { get; set; } = string.Empty;
+
+        /// <summary>
+        /// Length condition in seconds, e.g. "&lt;90" or "60-240".
+        /// </summary>
+        public string Length { get; set; } = string.Empty;
+
+        /// <summary>
+        /// Parts of the mapper's name (any of them).
+        /// </summary>
+        public string Mapper { get; set; } = string.Empty;
+
+        /// <summary>
+        /// Parts of the title, artist or difficulty name (any of them).
+        /// </summary>
+        public string Name { get; set; } = string.Empty;
+
+        // Rules saved before the conditions were text kept min/max numbers. They are read once and turned into the text fields.
+        [JsonProperty]
+        private double? MinStars { set => legacyStars.min = value; }
+
+        [JsonProperty]
+        private double? MaxStars { set => legacyStars.max = value; }
+
+        [JsonProperty]
+        private double? MinBpm { set => legacyBpm.min = value; }
+
+        [JsonProperty]
+        private double? MaxBpm { set => legacyBpm.max = value; }
+
+        [JsonProperty]
+        private double? MinLength { set => legacyLength.min = value; }
+
+        [JsonProperty]
+        private double? MaxLength { set => legacyLength.max = value; }
+
+        private (double? min, double? max) legacyStars, legacyBpm, legacyLength;
+
+        [OnDeserialized]
+        private void onDeserialized(StreamingContext context)
+        {
+            static string upgrade(string current, (double? min, double? max) old) =>
+                string.IsNullOrWhiteSpace(current) ? LocalAutoSwitchCondition.FromRange(old.min, old.max) : current;
+
+            Stars = upgrade(Stars, legacyStars);
+            Bpm = upgrade(Bpm, legacyBpm);
+            Length = upgrade(Length, legacyLength);
+            legacyStars = legacyBpm = legacyLength = default;
+        }
+
+        /// <summary>
+        /// Mods that have to be selected (picked in the mod rules picker; how they have to match: <see cref="ModMatch"/>).
+        /// </summary>
+        public List<APIMod> Mods { get; set; } = new List<APIMod>();
+
+        public LocalAutoSwitchModMatch ModMatch { get; set; } = LocalAutoSwitchModMatch.All;
+
+        /// <summary>
+        /// The mods only count when their settings are exactly the picked ones (e.g. Double Time at 1.3x only).
+        /// </summary>
+        public bool ExactModSettings { get; set; }
+
+        public bool HasAnyCondition =>
+            Tags.Count > 0 || !string.IsNullOrWhiteSpace(Stars) || !string.IsNullOrWhiteSpace(Bpm) || !string.IsNullOrWhiteSpace(Length)
+            || !string.IsNullOrWhiteSpace(Mapper) || !string.IsNullOrWhiteSpace(Name) || Mods.Count > 0;
+
+        /// <param name="beatmap">The selected beatmap.</param>
+        /// <param name="selectedMods">The selected mods (only needed for rules with mods).</param>
+        /// <param name="ruleset">The current ruleset, to read the rule's mods with (only needed for rules with mods).</param>
+        public bool Matches(BeatmapInfo beatmap, IReadOnlyList<Mod> selectedMods, Ruleset? ruleset)
+        {
+            if (!HasAnyCondition)
+                return false;
+
+            if (Mods.Count > 0 && !modsMatch(selectedMods, ruleset))
+                return false;
+
+            if (Tags.Count > 0)
+            {
+                var beatmapTags = (LocalBeatmapTags.Current?.Get(beatmap) ?? Array.Empty<string>())
+                                  .Concat(beatmap.Metadata.UserTags)
+                                  .Concat(beatmap.Metadata.Tags.Split(' ', StringSplitOptions.RemoveEmptyEntries))
+                                  .Select(LocalBeatmapTags.Normalise)
+                                  .ToHashSet();
+
+                if (!Tags.Any(t => beatmapTags.Contains(LocalBeatmapTags.Normalise(t))))
+                    return false;
+            }
+
+            // Compared the way song select shows them: stars to two decimals, whole BPM, whole seconds.
+            if (!LocalAutoSwitchCondition.MatchesNumber(Stars, Math.Round(beatmap.StarRating, 2)))
+                return false;
+
+            if (!LocalAutoSwitchCondition.MatchesNumber(Bpm, FormatUtils.RoundBPM(beatmap.BPM)))
+                return false;
+
+            if (!LocalAutoSwitchCondition.MatchesNumber(Length, Math.Floor(beatmap.Length / 1000)))
+                return false;
+
+            if (!LocalAutoSwitchCondition.MatchesText(Mapper, beatmap.Metadata.Author.Username))
+                return false;
+
+            if (!LocalAutoSwitchCondition.MatchesText(Name, beatmap.Metadata.Title, beatmap.Metadata.TitleUnicode,
+                    beatmap.Metadata.Artist, beatmap.Metadata.ArtistUnicode, beatmap.DifficultyName))
+                return false;
+
+            return true;
+        }
+
+        private bool modsMatch(IReadOnlyList<Mod> selectedMods, Ruleset? ruleset)
+        {
+            if (ruleset == null)
+                return false;
+
+            // Autoplay / Cinema (Ctrl+Enter) and system mods never decide anything.
+            var selected = selectedMods.Where(m => m is not ModAutoplay && m.Type != ModType.System).ToArray();
+
+            // Mods this ruleset doesn't have can never be selected.
+            var wanted = Mods.Select(m => m.ToMod(ruleset)).ToArray();
+
+            bool isSelected(Mod want)
+            {
+                if (want is UnknownMod)
+                    return false;
+
+                var found = selected.FirstOrDefault(s => s.GetType() == want.GetType());
+                return found != null && (!ExactModSettings || new APIMod(found).Equals(new APIMod(want)));
+            }
+
+            switch (ModMatch)
+            {
+                case LocalAutoSwitchModMatch.Any:
+                    return wanted.Any(isSelected);
+
+                case LocalAutoSwitchModMatch.Exact:
+                    return wanted.All(isSelected) && selected.Length == wanted.Select(w => w.GetType()).Distinct().Count();
+
+                default:
+                    return wanted.All(isSelected);
+            }
+        }
+
+        /// <summary>
+        /// "all of HD, HR", "any of HD, HR" or "exactly HD, HR", plus "(exact settings)".
+        /// </summary>
+        public string DescribeMods()
+        {
+            if (Mods.Count == 0)
+                return @"no mods";
+
+            string mods = string.Join(@", ", Mods.Select(m => m.Acronym));
+            string match = ModMatch switch
+            {
+                LocalAutoSwitchModMatch.Any => Mods.Count == 1 ? mods : $@"any of {mods}",
+                LocalAutoSwitchModMatch.Exact => $@"exactly {mods}",
+                _ => Mods.Count == 1 ? mods : $@"all of {mods}",
+            };
+
+            return ExactModSettings ? $@"{match} (exact settings)" : match;
+        }
+
+        /// <summary>
+        /// Short description, e.g. "tags skillset/jumps · 5–7★".
+        /// </summary>
+        public string Describe()
+        {
+            var parts = new List<string>();
+
+            if (Tags.Count > 0) parts.Add($@"tags {string.Join(@", ", Tags)}");
+            if (!string.IsNullOrWhiteSpace(Stars)) parts.Add($@"{Stars}★");
+            if (!string.IsNullOrWhiteSpace(Bpm)) parts.Add($@"{Bpm} BPM");
+            if (!string.IsNullOrWhiteSpace(Length)) parts.Add($@"{Length}s");
+            if (!string.IsNullOrWhiteSpace(Mapper)) parts.Add($@"mapper ""{Mapper}""");
+            if (!string.IsNullOrWhiteSpace(Name)) parts.Add($@"name ""{Name}""");
+            if (Mods.Count > 0) parts.Add($@"mods {DescribeMods()}");
+
+            return parts.Count == 0 ? @"no conditions" : string.Join(@" · ", parts);
+        }
+
+        public LocalAutoSwitchRules Clone()
+        {
+            var clone = (LocalAutoSwitchRules)MemberwiseClone();
+            clone.Tags = new List<string>(Tags);
+            clone.Mods = Mods.Select(m => new APIMod { Acronym = m.Acronym, Settings = new Dictionary<string, object>(m.Settings) }).ToList();
+            return clone;
+        }
+    }
+}
diff --git a/osu.Game/LocalPriority/LocalBeatmapTags.cs b/osu.Game/LocalPriority/LocalBeatmapTags.cs
new file mode 100644
index 0000000000..1d0f4325f0
--- /dev/null
+++ b/osu.Game/LocalPriority/LocalBeatmapTags.cs
@@ -0,0 +1,147 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using Newtonsoft.Json;
+using osu.Framework.Logging;
+using osu.Framework.Platform;
+using osu.Game.Beatmaps;
+
+namespace osu.Game.LocalPriority
+{
+    /// <summary>
+    /// Tags you give beatmaps yourself (instead of the stripped online tag voting), per difficulty.
+    /// Kept in "patchsu-osu/beatmap-tags.json", so the shared database is never changed.
+    /// They show in song select's beatmap details, can be searched like voted tags (tag="jumps/cross-screen"! or plain text),
+    /// and profiles can switch automatically on them.
+    /// </summary>
+    public class LocalBeatmapTags
+    {
+        private const string file = LocalProfileStore.DIRECTORY + @"/beatmap-tags.json";
+
+        /// <summary>
+        /// The tags of the running game (song select's filtering runs on background threads and reads them from here).
+        /// </summary>
+        public static LocalBeatmapTags? Current { get; internal set; }
+
+        /// <summary>
+        /// Invoked (on any thread) when tags change.
+        /// </summary>
+        public event Action? Changed;
+
+        private readonly Storage storage;
+        private readonly object sync = new object();
+
+        /// <summary>
+        /// Replaced (never changed in place) on every change, so song select's filtering reads it without locking.
+        /// </summary>
+        private volatile Dictionary<string, string[]> tags;
+
+        public LocalBeatmapTags(Storage storage)
+        {
+            this.storage = storage;
+            tags = read() ?? new Dictionary<string, string[]>();
+        }
+
+        /// <summary>
+        /// The local tags of a beatmap difficulty (keyed by its MD5 hash).
+        /// </summary>
+        public IReadOnlyList<string> Get(IBeatmapInfo? beatmap)
+        {
+            string? key = beatmap?.MD5Hash;
+
+            if (string.IsNullOrEmpty(key))
+                return Array.Empty<string>();
+
+            // Called for every beatmap while song select filters: no copying and no lock (the dictionary and its arrays are never changed, only replaced).
+            var current = tags;
+            return current.Count > 0 && current.TryGetValue(key, out string[]? list) ? list : Array.Empty<string>();
+        }
+
+        public static string Normalise(string tag) => string.Join(' ', (tag ?? string.Empty).Trim().ToLowerInvariant().Split(' ', StringSplitOptions.RemoveEmptyEntries));
+
+        public void Add(IBeatmapInfo beatmap, string tag)
+        {
+            tag = Normalise(tag);
+
+            if (string.IsNullOrEmpty(tag) || string.IsNullOrEmpty(beatmap.MD5Hash))
+                return;
+
+            lock (sync)
+            {
+                string[] list = tags.GetValueOrDefault(beatmap.MD5Hash) ?? Array.Empty<string>();
+
+                if (list.Contains(tag))
+                    return;
+
+                tags = new Dictionary<string, string[]>(tags) { [beatmap.MD5Hash] = list.Append(tag).ToArray() };
+                save();
+            }
+
+            Changed?.Invoke();
+        }
+
+        public void Remove(IBeatmapInfo beatmap, string tag)
+        {
+            lock (sync)
+            {
+                if (string.IsNullOrEmpty(beatmap.MD5Hash) || !tags.TryGetValue(beatmap.MD5Hash, out string[]? list) || !list.Contains(tag))
+                    return;
+
+                string[] remaining = list.Where(t => t != tag).ToArray();
+                var changed = new Dictionary<string, string[]>(tags);
+
+                if (remaining.Length == 0)
+                    changed.Remove(beatmap.MD5Hash);
+                else
+                    changed[beatmap.MD5Hash] = remaining;
+
+                tags = changed;
+                save();
+            }
+
+            Changed?.Invoke();
+        }
+
+        /// <summary>
+        /// Every local tag used so far (for suggestions).
+        /// </summary>
+        public IReadOnlyList<string> AllTags()
+        {
+            return tags.Values.SelectMany(t => t).Distinct().OrderBy(t => t).ToArray();
+        }
+
+        private Dictionary<string, string[]>? read()
+        {
+            try
+            {
+                if (!storage.Exists(file))
+                    return null;
+
+                using (var stream = storage.GetStream(file, FileAccess.Read, FileMode.Open))
+                using (var reader = new StreamReader(stream))
+                    return JsonConvert.DeserializeObject<Dictionary<string, string[]>>(reader.ReadToEnd());
+            }
+            catch (Exception e)
+            {
+                Logger.Error(e, $@"Patchsu: could not read {file}; starting without local beatmap tags.");
+                return null;
+            }
+        }
+
+        private void save()
+        {
+            try
+            {
+                using (var stream = storage.CreateFileSafely(file))
+                using (var writer = new StreamWriter(stream))
+                using (var json = new JsonTextWriter(writer))
+                    JsonSerializer.CreateDefault(new JsonSerializerSettings { Formatting = Formatting.Indented }).Serialize(json, tags);
+            }
+            catch (Exception e)
+            {
+                Logger.Error(e, $@"Patchsu: could not save {file}.");
+            }
+        }
+    }
+}
diff --git a/osu.Game/LocalPriority/LocalBeatmapTagsDisplay.cs b/osu.Game/LocalPriority/LocalBeatmapTagsDisplay.cs
new file mode 100644
index 0000000000..8d2a45c6f5
--- /dev/null
+++ b/osu.Game/LocalPriority/LocalBeatmapTagsDisplay.cs
@@ -0,0 +1,302 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using osu.Framework.Allocation;
+using osu.Framework.Bindables;
+using osu.Framework.Extensions;
+using osu.Framework.Extensions.Color4Extensions;
+using osu.Framework.Graphics;
+using osu.Framework.Graphics.Containers;
+using osu.Framework.Graphics.Cursor;
+using osu.Framework.Graphics.Shapes;
+using osu.Framework.Graphics.Sprites;
+using osu.Framework.Graphics.UserInterface;
+using osu.Framework.Input.Events;
+using osu.Game.Beatmaps;
+using osu.Game.Graphics;
+using osu.Game.Graphics.Containers;
+using osu.Game.Graphics.Sprites;
+using osu.Game.Graphics.UserInterface;
+using osu.Game.Graphics.UserInterfaceV2;
+using osu.Game.Overlays;
+using osuTK;
+using osuTK.Graphics;
+
+namespace osu.Game.LocalPriority
+{
+    /// <summary>
+    /// "Local tags" in song select's beatmap details: tags given to this difficulty locally.
+    /// Click a tag to search for it, × to remove it, "+ add" to tag the beatmap (several at once with commas).
+    /// </summary>
+    public partial class LocalBeatmapTagsDisplay : FillFlowContainer
+    {
+        private readonly IBindable<WorkingBeatmap> beatmap;
+        private readonly Action<string> search;
+
+        private FillFlowContainer tagsFlow = null!;
+        private LocalBeatmapTags? tags;
+
+        public LocalBeatmapTagsDisplay(IBindable<WorkingBeatmap> beatmap, Action<string> search)
+        {
+            this.beatmap = beatmap.GetBoundCopy();
+            this.search = search;
+
+            RelativeSizeAxes = Axes.X;
+            AutoSizeAxes = Axes.Y;
+            Direction = FillDirection.Vertical;
+            Spacing = new Vector2(0, 4);
+            Padding = new MarginPadding { Right = 10 };
+        }
+
+        [BackgroundDependencyLoader]
+        private void load()
+        {
+            tags = LocalBeatmapTags.Current;
+
+            Children = new Drawable[]
+            {
+                new OsuSpriteText
+                {
+                    Text = @"Local tags",
+                    Font = OsuFont.Style.Caption1.With(weight: FontWeight.SemiBold),
+                },
+                tagsFlow = new FillFlowContainer
+                {
+                    RelativeSizeAxes = Axes.X,
+                    AutoSizeAxes = Axes.Y,
+                    Direction = FillDirection.Full,
+                    Spacing = new Vector2(5),
+                },
+            };
+        }
+
+        protected override void LoadComplete()
+        {
+            base.LoadComplete();
+
+            beatmap.BindValueChanged(_ => Scheduler.AddOnce(refresh), true);
+
+            if (tags != null)
+                tags.Changed += onTagsChanged;
+        }
+
+        private void onTagsChanged() => Scheduler.AddOnce(refresh);
+
+        /// <summary>
+        /// The tags currently shown (the store hands out the same array until a beatmap's tags change, and one shared empty array).
+        /// </summary>
+        private IReadOnlyList<string>? shownTags;
+
+        private AddTagButton? addButton;
+
+        /// <summary>
+        /// Song select changes beatmaps constantly while scrolling: the drawables are only rebuilt when the shown tags actually change,
+        /// and the "+ add" button is created once (it always adds to the beatmap selected at that moment).
+        /// </summary>
+        private void refresh()
+        {
+            var info = beatmap.Value?.BeatmapInfo;
+            var current = tags == null || info == null || string.IsNullOrEmpty(info.MD5Hash) ? null : tags.Get(info);
+
+            if (current != null && addButton == null)
+            {
+                tagsFlow.Add(addButton = new AddTagButton(text =>
+                {
+                    var target = beatmap.Value?.BeatmapInfo;
+
+                    if (target == null || tags == null)
+                        return;
+
+                    foreach (string part in text.Split(',', StringSplitOptions.RemoveEmptyEntries))
+                        tags.Add(target, part);
+                }));
+
+                tagsFlow.SetLayoutPosition(addButton, float.MaxValue);
+            }
+
+            addButton?.FadeTo(current != null ? 1 : 0);
+
+            if (ReferenceEquals(current, shownTags))
+                return;
+
+            shownTags = current;
+
+            foreach (var chip in tagsFlow.OfType<TagChip>().ToArray())
+                tagsFlow.Remove(chip, true);
+
+            if (current == null || info == null || tags == null)
+                return;
+
+            foreach (string tag in current)
+            {
+                string t = tag;
+                tagsFlow.Add(new TagChip(t, () => search($@"tag=""{t}""!"), () => tags.Remove(info, t)));
+            }
+        }
+
+        protected override void Dispose(bool isDisposing)
+        {
+            if (tags != null)
+                tags.Changed -= onTagsChanged;
+
+            base.Dispose(isDisposing);
+        }
+
+        private partial class TagChip : CompositeDrawable
+        {
+            private readonly string tag;
+            private readonly Action onSearch;
+            private readonly Action onRemove;
+
+            public TagChip(string tag, Action onSearch, Action onRemove)
+            {
+                this.tag = tag;
+                this.onSearch = onSearch;
+                this.onRemove = onRemove;
+
+                AutoSizeAxes = Axes.Both;
+                Masking = true;
+                CornerRadius = 4;
+            }
+
+            [BackgroundDependencyLoader]
+            private void load(OsuColour colours)
+            {
+                InternalChildren = new Drawable[]
+                {
+                    new Box
+                    {
+                        RelativeSizeAxes = Axes.Both,
+                        Colour = colours.Lime1.Darken(0.6f),
+                    },
+                    new FillFlowContainer
+                    {
+                        AutoSizeAxes = Axes.Both,
+                        Direction = FillDirection.Horizontal,
+                        Children = new Drawable[]
+                        {
+                            new OsuHoverContainer
+                            {
+                                AutoSizeAxes = Axes.Both,
+                                Action = onSearch,
+                                TooltipText = @"Search for this tag",
+                                Child = new OsuSpriteText
+                                {
+                                    Text = tag,
+                                    Font = OsuFont.Style.Caption1.With(weight: FontWeight.SemiBold),
+                                    Margin = new MarginPadding { Left = 6, Right = 4, Vertical = 2 },
+                                },
+                            },
+                            new OsuHoverContainer
+                            {
+                                AutoSizeAxes = Axes.Both,
+                                Action = onRemove,
+                                TooltipText = @"Remove this local tag",
+                                Child = new SpriteIcon
+                                {
+                                    Icon = FontAwesome.Solid.Times,
+                                    Size = new Vector2(8),
+                                    Margin = new MarginPadding { Right = 6, Left = 2, Vertical = 5 },
+                                },
+                            },
+                        },
+                    },
+                };
+            }
+        }
+
+        private partial class AddTagButton : OsuClickableContainer, IHasPopover
+        {
+            private readonly Action<string> add;
+
+            public AddTagButton(Action<string> add)
+            {
+                this.add = add;
+
+                AutoSizeAxes = Axes.Both;
+                Masking = true;
+                CornerRadius = 4;
+                TooltipText = @"Tag this beatmap locally (searchable, and usable for profile auto-switching)";
+                Action = this.ShowPopover;
+            }
+
+            [BackgroundDependencyLoader]
+            private void load()
+            {
+                Children = new Drawable[]
+                {
+                    new Box
+                    {
+                        RelativeSizeAxes = Axes.Both,
+                        Colour = Color4.White.Opacity(0.15f),
+                    },
+                    new OsuSpriteText
+                    {
+                        Text = @"+ add",
+                        Font = OsuFont.Style.Caption1.With(weight: FontWeight.SemiBold),
+                        Margin = new MarginPadding { Horizontal = 6, Vertical = 2 },
+                    },
+                };
+            }
+
+            public Popover GetPopover() => new AddTagPopover(add);
+        }
+
+        private partial class AddTagPopover : OsuPopover
+        {
+            private readonly Action<string> add;
+            private OsuTextBox textBox = null!;
+
+            public AddTagPopover(Action<string> add)
+            {
+                this.add = add;
+            }
+
+            [BackgroundDependencyLoader]
+            private void load()
+            {
+                string[] known = LocalBeatmapTags.Current?.AllTags().Take(12).ToArray() ?? Array.Empty<string>();
+
+                Child = new FillFlowContainer
+                {
+                    Width = 280,
+                    AutoSizeAxes = Axes.Y,
+                    Direction = FillDirection.Vertical,
+                    Spacing = new Vector2(0, 6),
+                    Children = new Drawable[]
+                    {
+                        textBox = new OsuTextBox
+                        {
+                            RelativeSizeAxes = Axes.X,
+                            PlaceholderText = @"e.g. jumps/cross-screen, skillset/aim",
+                            CommitOnFocusLost = false,
+                        },
+                        new OsuTextFlowContainer(t => t.Font = OsuFont.GetFont(size: 12))
+                        {
+                            RelativeSizeAxes = Axes.X,
+                            AutoSizeAxes = Axes.Y,
+                            Alpha = 0.7f,
+                            Text = known.Length > 0
+                                ? $@"Enter adds (commas for several). Used before: {string.Join(@", ", known)}"
+                                : @"Enter adds (commas for several).",
+                        },
+                    },
+                };
+
+                textBox.OnCommit += (_, _) =>
+                {
+                    if (!string.IsNullOrWhiteSpace(textBox.Text))
+                        add(textBox.Text);
+
+                    this.HidePopover();
+                };
+            }
+
+            protected override void LoadComplete()
+            {
+                base.LoadComplete();
+                ScheduleAfterChildren(() => GetContainingFocusManager()?.ChangeFocus(textBox));
+            }
+        }
+    }
+}
