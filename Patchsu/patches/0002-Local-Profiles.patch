+        public LocalProfile CreateSpeedrunProfile(LocalSpeedrun goal)
+        {
+            string name;
+            int n;
+
+            lock (sync)
+            {
+                n = data.SpeedrunProfilesCreated + 1;
+
+                while (data.Profiles.Any(p => string.Equals(p.Name, $@"SP Profile {n}", StringComparison.OrdinalIgnoreCase)))
+                    n++;
+                name = $@"SP Profile {n}";
+            }
