new file mode 100644
index 0000000000..887ff0d388
--- /dev/null
+++ b/osu.Game/LocalPriority/LocalProfileDragReorder.cs
@@ -0,0 +1,69 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using osu.Framework.Graphics;
+using osu.Framework.Graphics.Containers;
+using osuTK;
+
+namespace osu.Game.LocalPriority
+{
+    /// <summary>
+    /// Drag-and-drop reordering of profile items (chips on the profile page, rows in the switcher) inside a fill flow.
+    /// Items that can be reordered implement <see cref="IReorderableProfileItem"/>; other items (online account, "+" buttons) keep their place.
+    /// </summary>
+    public static class LocalProfileDragReorder
+    {
+        /// <summary>
+        /// Moves <paramref name="dragged"/> to the place of the reorderable item under the cursor, live while dragging.
+        /// </summary>
+        public static void DragTo(FillFlowContainer flow, Drawable dragged, Vector2 screenSpaceMouse)
+        {
+            var items = reorderable(flow).ToList();
+
+            int from = items.IndexOf(dragged);
+            if (from < 0)
+                return;
+
+            var target = items.FirstOrDefault(i => i != dragged && i.ScreenSpaceDrawQuad.Contains(screenSpaceMouse));
+            if (target == null)
+                return;
+
+            int to = items.IndexOf(target);
+
+            // Items of different widths: only move once the cursor is past the middle of the target (no flickering back and forth).
+            var quad = target.ScreenSpaceDrawQuad;
+            bool vertical = flow.Direction == FillDirection.Vertical;
+            float middle = vertical ? quad.Centre.Y : quad.Centre.X;
+            float cursor = vertical ? screenSpaceMouse.Y : screenSpaceMouse.X;
+
+            if ((to > from && cursor < middle) || (to < from && cursor > middle))
+                return;
+
+            items.RemoveAt(from);
+            items.Insert(to, dragged);
+
+            // Keep the reorderable items in the same layout slots as before, just in the new order.
+            var slots = items.Select(flow.GetLayoutPosition).OrderBy(p => p).ToArray();
+
+            for (int i = 0; i < items.Count; i++)
+                flow.SetLayoutPosition(items[i], slots[i]);
+        }
+
+        /// <summary>
+        /// The profile ids in the flow, in their current (dragged) order.
+        /// </summary>
+        public static IReadOnlyList<Guid> CurrentOrder(FillFlowContainer flow) =>
+            reorderable(flow).Select(d => ((IReorderableProfileItem)d).ProfileId!.Value).ToArray();
+
+        private static IEnumerable<Drawable> reorderable(FillFlowContainer flow) =>
+            flow.FlowingChildren.Where(d => d is IReorderableProfileItem { ProfileId: not null });
+    }
+
+    /// <summary>
+    /// A profile chip / row that can be dragged to reorder profiles.
+    /// </summary>
+    public interface IReorderableProfileItem
+    {
+        Guid? ProfileId { get; }
+    }
+}
diff --git a/osu.Game/LocalPriority/LocalProfileManager.BanchoImport.cs b/osu.Game/LocalPriority/LocalProfileManager.BanchoImport.cs
new file mode 100644
index 0000000000..ec273665ab
--- /dev/null
+++ b/osu.Game/LocalPriority/LocalProfileManager.BanchoImport.cs
@@ -0,0 +1,939 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Threading;
+using System.Threading.Tasks;
+using Newtonsoft.Json;
+using osu.Framework.Allocation;
+using osu.Framework.Graphics.Sprites;
+using osu.Framework.Logging;
+using osu.Game.Beatmaps;
+using osu.Game.Configuration;
+using osu.Game.Online.API;
+using osu.Game.Online.API.Requests;
+using osu.Game.Online.API.Requests.Responses;
+using osu.Game.Overlays;
+using osu.Game.Overlays.Dialog;
+using osu.Game.Overlays.Notifications;
+using osu.Game.Rulesets;
+using osu.Game.Scoring;
+using Realms;
+
+namespace osu.Game.LocalPriority
+{
+    /// <summary>
+    /// "Fetch top plays from osu!": the best plays of the osu! player with the profile's name are added to the profile. Beatmaps they
+    /// need are downloaded (after asking); each play is added once its beatmap is imported. Then the replays osu! has are downloaded
+    /// and take their plays' places. Everything runs under one notification.
+    /// </summary>
+    public partial class LocalProfileManager
+    {
+        /// <summary>
+        /// How many best plays osu! lists per player and mode (two pages of 100).
+        /// </summary>
+        public const int BANCHO_TOP_PLAYS = 200;
+
+        private const int bancho_page_size = 100;
+
+        [Resolved]
+        private RulesetStore rulesetStore { get; set; } = null!;
+
+        [Resolved(canBeNull: true)]
+        private OsuConfigManager? osuConfig { get; set; }
+
+        /// <summary>
+        /// Looked up when needed: the dialog overlay is made by the game after this manager is loaded.
+        /// </summary>
+        private IDialogOverlay? dialogOverlay => game?.Dependencies.Get<IDialogOverlay>();
+
+        /// <summary>
+        /// A fetch or its beatmap downloads are running (only one at a time).
+        /// </summary>
+        private volatile bool banchoImportRunning;
+
+        /// <summary>
+        /// Asks osu! for the best plays (in the current mode) of the player named like the profile and adds them to the profile.
+        /// Needs the online account signed in and, while a local profile is active, Settings → Patchsu → "Use your online account…".
+        /// </summary>
+        public void FetchBanchoTopPlays(Guid profileId)
+        {
+            var profile = Store.GetProfile(profileId);
+            var ruleset = gameRuleset.Value;
+
+            if (profile == null || ruleset == null)
+                return;
+
+            if (banchoImportRunning)
+            {
+                postBanchoMessage(@"Top plays are already being fetched. Wait for it to finish (or cancel it in the notifications).");
+                return;
+            }
+
+            if (api.State.Value != APIState.Online)
+            {
+                postBanchoMessage(IsLocalProfileActive && !LocalProfilesUseOnlineAccount.Value
+                    ? @"Fetching top plays needs your online account: sign in to it and turn on ""Use your online account for beatmap and leaderboard requests"" in Settings → Patchsu → Patch 2."
+                    : @"Fetching top plays needs your online account. Sign in first.");
+                return;
+            }
+
+            banchoImportRunning = true;
+
+            var notification = new BanchoFetchNotification
+            {
+                Text = $@"Looking for ""{profile.Name}"" on osu! ({ruleset.Name})...",
+                State = ProgressNotificationState.Active,
+            };
+
+            var cancellation = new CancellationTokenSource();
+
+            notification.CancelRequested += () =>
+            {
+                cancellation.Cancel();
+                return true;
+            };
+
+            PostNotification?.Invoke(notification);
+
+            Task.Run(async () =>
+            {
+                try
+                {
+                    var plays = await fetchBanchoTopPlays(profile.Name, ruleset, notification, cancellation.Token).ConfigureAwait(false);
+
+                    if (plays == null)
+                        return;
+
+                    var tcs = new TaskCompletionSource<bool>();
+                    Schedule(() => prepareBanchoImport(profile, ruleset, plays, notification, cancellation, tcs));
+                    await tcs.Task.ConfigureAwait(false);
+                }
+                catch (OperationCanceledException)
+                {
+                    notification.State = ProgressNotificationState.Cancelled;
+                }
+                catch (Exception e)
+                {
+                    Logger.Error(e, $@"Patchsu: could not fetch the top plays of ""{profile.Name}"".");
+                    notification.Text = @"Could not fetch the top plays. Check logs for more information.";
+                    notification.State = ProgressNotificationState.Cancelled;
+                }
+                finally
+                {
+                    banchoImportRunning = false;
+                }
+            });
+        }
+
+        private void postBanchoMessage(string text) => PostNotification?.Invoke(new SimpleNotification
+        {
+            Text = text,
+            Icon = FontAwesome.Solid.Trophy,
+        });
+
+        /// <summary>
+        /// The player's best plays in the mode, or null (with the notification closed / telling why) if there are none.
+        /// </summary>
+        private async Task<List<SoloScoreInfo>?> fetchBanchoTopPlays(string name, RulesetInfo ruleset, ProgressNotification notification, CancellationToken token)
+        {
+            var user = await performBanchoRequest<APIUser>(new GetUserRequest(name, ruleset), token).ConfigureAwait(false);
+
+            if (user == null || user.Id <= 1)
+            {
+                notification.Text = $@"There is no osu! player named ""{name}"".";
+                notification.State = ProgressNotificationState.Cancelled;
+                return null;
+            }
+
+            notification.Text = $@"Fetching the top plays of {user.Username} ({ruleset.Name})...";
+
+            var plays = new List<SoloScoreInfo>();
+
+            for (int offset = 0; offset < BANCHO_TOP_PLAYS; offset += bancho_page_size)
+            {
+                var page = await performBanchoRequest<List<SoloScoreInfo>>(
+                    new GetUserScoresRequest(user.Id, ScoreType.Best, new PaginationParameters(offset, bancho_page_size), ruleset), token).ConfigureAwait(false);
+
+                if (page == null || page.Count == 0)
+                    break;
+
+                plays.AddRange(page);
+                notification.Progress = (float)plays.Count / BANCHO_TOP_PLAYS;
+
+                if (page.Count < bancho_page_size)
+                    break;
+            }
+
+            // Plays without their beatmap's details can't be matched to a beatmap.
+            plays.RemoveAll(p => p.Beatmap == null || p.RulesetID != ruleset.OnlineID);
+
+            if (plays.Count == 0)
+            {
+                notification.Text = $@"{user.Username} has no top plays in {ruleset.Name}.";
+                notification.State = ProgressNotificationState.Cancelled;
+                return null;
+            }
+
+            return plays;
+        }
+
+        /// <summary>
+        /// Queues the request and waits for its response (null when it failed; cancelling the token cancels it).
+        /// </summary>
+        private async Task<T?> performBanchoRequest<T>(APIRequest<T> request, CancellationToken token)
+            where T : class
+        {
+            var tcs = new TaskCompletionSource<T?>(TaskCreationOptions.RunContinuationsAsynchronously);
+
+            request.Success += response => tcs.TrySetResult(response);
+            request.Failure += e =>
+            {
+                if (e is OperationCanceledException)
+                    tcs.TrySetCanceled();
+                else
+                {
+                    Logger.Log($@"Patchsu: {request.GetType().Name} failed: {e.Message}");
+                    tcs.TrySetResult(null);
+                }
+            };
+
+            await using (token.Register(request.Cancel))
+            {
+                api.Queue(request);
+                var result = await tcs.Task.ConfigureAwait(false);
+                token.ThrowIfCancellationRequested();
+                return result;
+            }
+        }
+
+        /// <summary>
+        /// Adds the plays whose beatmaps are imported, then asks whether to download the others' beatmaps. Runs on the update thread.
+        /// </summary>
+        private void prepareBanchoImport(LocalProfile profile, RulesetInfo ruleset, List<SoloScoreInfo> plays, ProgressNotification notification,
+                                         CancellationTokenSource cancellation, TaskCompletionSource<bool> done)
+        {
+            var run = new BanchoImportRun(profile, ruleset, plays, cancellation.Token, done);
+            var found = findBanchoBeatmaps(plays);
+
+            var ready = plays.Where(p => found.ContainsKey(p)).ToList();
+            addBanchoScores(run, ready, found);
+
+            var missing = plays.Where(p => !found.ContainsKey(p)).ToList();
+
+            // Without its set's details a beatmap can't be downloaded.
+            run.Unavailable += missing.RemoveAll(p => p.Beatmap!.BeatmapSet == null);
+
+            // One download per beatmap set; the set's details come with each play (the first play of a set is enough).
+            var sets = missing.GroupBy(p => p.Beatmap!.BeatmapSet!.OnlineID)
+                              .Select(g => g.First().Beatmap!.BeatmapSet!)
+                              .ToList();
+
+            if (sets.Count == 0 || beatmapManager == null)
+            {
+                run.Unavailable += missing.Count;
+                finishBanchoImport(run, notification);
+                return;
+            }
+
+            notification.Text = $@"{missing.Count:N0} top plays of {profile.Name} are on beatmaps you don't have.";
+
+            void download() => Task.Run(async () =>
+            {
+                try
+                {
+                    await downloadBanchoBeatmaps(run, sets, missing, notification, cancellation.Token).ConfigureAwait(false);
+                }
+                catch (Exception e)
+                {
+                    done.TrySetException(e);
+                }
+            });
+
+            void skip()
+            {
+                run.Skipped += missing.Count;
+                finishBanchoImport(run, notification);
+            }
+
+            var dialogs = dialogOverlay;
+
+            if (dialogs == null)
+            {
+                download();
+                return;
+            }
+
+            dialogs.Push(new BanchoDownloadDialog(profile.Name, ready.Count, missing.Count, sets.Count, download, skip));
+        }
+
+        /// <summary>
+        /// How many beatmap sets are downloaded at once.
+        /// </summary>
+        private const int bancho_parallel_downloads = 2;
+
+        /// <summary>
+        /// Downloads and imports the beatmap sets (a couple at a time) under the fetch's one notification, which counts how many are
+        /// downloaded and how many are left. Imports are quiet (no notification per beatmap); each set's plays are added as soon as it's imported.
+        /// </summary>
+        private async Task downloadBanchoBeatmaps(BanchoImportRun run, List<APIBeatmapSet> sets, List<SoloScoreInfo> missing, ProgressNotification notification,
+                                                  CancellationToken token)
+        {
+            bool noVideo = osuConfig?.Get<bool>(OsuSetting.PreferNoVideo) ?? true;
+            var playsBySet = missing.GroupBy(p => p.Beatmap!.BeatmapSet!.OnlineID).ToDictionary(g => g.Key, g => g.ToList());
+            var progress = new float[sets.Count];
+            int downloaded = 0;
+            int failed = 0;
+            int next = -1;
+            int handled = 0;
+
+            void updateNotification()
+            {
+                int done = Volatile.Read(ref downloaded);
+                int bad = Volatile.Read(ref failed);
+                int left = sets.Count - done - bad;
+
+                notification.Text = $@"Downloading beatmaps for the top plays of {run.Profile.Name}: {done:N0} downloaded, {left:N0} left"
+                                    + (bad > 0 ? $@" ({bad:N0} failed)" : string.Empty);
+                notification.Progress = progress.Sum() / sets.Count;
+            }
+
+            updateNotification();
+
+            async Task worker()
+            {
+                int i;
+
+                while ((i = Interlocked.Increment(ref next)) < sets.Count && !token.IsCancellationRequested)
+                {
+                    var set = sets[i];
+                    var plays = playsBySet[set.OnlineID];
+                    int index = i;
+                    bool imported = false;
+
+                    try
+                    {
+                        imported = await downloadBanchoBeatmapSet(set, noVideo, p =>
+                        {
+                            progress[index] = p;
+                            updateNotification();
+                        }, token).ConfigureAwait(false);
+                    }
+                    catch (OperationCanceledException)
+                    {
+                        return;
+                    }
+                    catch (Exception e)
+                    {
+                        Logger.Error(e, $@"Patchsu: importing beatmap set {set.OnlineID} failed.");
+                    }
+
+                    progress[index] = 1;
+                    Interlocked.Increment(ref imported ? ref downloaded : ref failed);
+                    Interlocked.Add(ref handled, plays.Count);
+                    updateNotification();
+
+                    // Counted and added on the update thread (the run's counters are only changed there).
+                    var added = new TaskCompletionSource<bool>(TaskCreationOptions.RunContinuationsAsynchronously);
+
+                    Schedule(() =>
+                    {
+                        if (!imported)
+                        {
+                            run.Unavailable += plays.Count;
+                            added.TrySetResult(true);
+                            return;
+                        }
+
+                        var found = findBanchoBeatmaps(plays);
+                        addBanchoScores(run, plays.Where(found.ContainsKey).ToList(), found);
+                        // A beatmap changed since the play was set (or left out of the download) has nothing to attach the play to.
+                        run.Unavailable += plays.Count(p => !found.ContainsKey(p));
+                        added.TrySetResult(true);
+                    });
+
+                    await added.Task.ConfigureAwait(false);
+                }
+            }
+
+            await Task.WhenAll(Enumerable.Range(0, Math.Min(bancho_parallel_downloads, sets.Count)).Select(_ => Task.Run(worker))).ConfigureAwait(false);
+
+            // Cancelled: the plays whose beatmaps weren't downloaded are skipped.
+            int skipped = missing.Count - Volatile.Read(ref handled);
+
+            var finished = new TaskCompletionSource<bool>(TaskCreationOptions.RunContinuationsAsynchronously);
+
+            Schedule(() =>
+            {
+                run.Skipped += skipped;
+                finishBanchoImport(run, notification);
+                finished.TrySetResult(true);
+            });
+
+            await finished.Task.ConfigureAwait(false);
+        }
+
+        /// <summary>
+        /// Downloads one beatmap set and imports it without a notification of its own. True once imported, false if the download failed.
+        /// A set that already is imported isn't downloaded again.
+        /// </summary>
+        private async Task<bool> downloadBanchoBeatmapSet(APIBeatmapSet set, bool noVideo, Action<float> progressed, CancellationToken token)
+        {
+            int id = set.OnlineID;
+
+            if (realm.Run(r => r.All<BeatmapSetInfo>().Any(s => s.OnlineID == id && !s.DeletePending)))
+                return true;
+
+            var request = new DownloadBeatmapSetRequest(set, noVideo);
+            request.DownloadProgressed += progressed;
+
+            var tcs = new TaskCompletionSource<string?>(TaskCreationOptions.RunContinuationsAsynchronously);
+            request.Success += filename => tcs.TrySetResult(filename);
+            request.Failure += e =>
+            {
+                if (e is OperationCanceledException)
+                    tcs.TrySetCanceled();
+                else
+                {
+                    Logger.Log($@"Patchsu: downloading beatmap set {id} failed: {e.Message}");
+                    tcs.TrySetResult(null);
+                }
+            };
+
+            string? file;
+
+            await using (token.Register(request.Cancel))
+            {
+                api.Queue(request);
+                file = await tcs.Task.ConfigureAwait(false);
+            }
+
+            if (file == null)
+                return false;
+
+            // Imports and deletes the downloaded file, quietly (the per-beatmap import notification is what the downloader would show).
+            return await beatmapManager!.Import(new Database.ImportTask(file), cancellationToken: token).ConfigureAwait(false) != null;
+        }
+
+        /// <summary>
+        /// The imported beatmap each play is on: the same version (MD5), else the same beatmap ID (an updated version), never one pending deletion.
+        /// One query for all of them.
+        /// </summary>
+        private Dictionary<SoloScoreInfo, Guid> findBanchoBeatmaps(IReadOnlyList<SoloScoreInfo> plays)
+        {
+            var result = new Dictionary<SoloScoreInfo, Guid>();
+
+            if (plays.Count == 0 || beatmapManager == null)
+                return result;
+
+            var hashes = plays.Select(p => p.Beatmap!.Checksum).Where(h => !string.IsNullOrEmpty(h)).Distinct().ToArray();
+            var ids = plays.Select(p => p.BeatmapID).Where(id => id > 0).Distinct().ToArray();
+
+            var conditions = hashes.Select((_, i) => $@"{nameof(BeatmapInfo.MD5Hash)} == ${i}")
+                                   .Concat(ids.Select((_, i) => $@"{nameof(BeatmapInfo.OnlineID)} == ${hashes.Length + i}"))
+                                   .ToArray();
+
+            if (conditions.Length == 0)
+                return result;
+
+            var arguments = hashes.Select(h => (Realms.QueryArgument)h).Concat(ids.Select(id => (Realms.QueryArgument)id)).ToArray();
+
+            realm.Run(r =>
+            {
+                // A beatmap just imported on another thread may not be visible to the update thread's realm until its next refresh.
+                r.Refresh();
+
+                var byHash = new Dictionary<string, Guid>();
+                var byId = new Dictionary<int, Guid>();
+
+                foreach (var b in r.All<BeatmapInfo>().Filter(string.Join(@" OR ", conditions), arguments))
+                {
+                    if (b.BeatmapSet == null || b.BeatmapSet.DeletePending)
+                        continue;
+
+                    byHash.TryAdd(b.MD5Hash, b.ID);
+
+                    if (b.OnlineID > 0)
+                        byId.TryAdd(b.OnlineID, b.ID);
+                }
+
+                foreach (var play in plays)
+                {
+                    if (byHash.TryGetValue(play.Beatmap!.Checksum, out var id) || byId.TryGetValue(play.BeatmapID, out id))
+                        result[play] = id;
+                }
+            });
+
+            return result;
+        }
+
+        /// <summary>
+        /// Adds the plays to the profile as scores without replays. Plays already there (same beatmap, set within 2 s) are left out.
+        /// </summary>
+        private void addBanchoScores(BanchoImportRun run, IReadOnlyList<SoloScoreInfo> plays, IReadOnlyDictionary<SoloScoreInfo, Guid> beatmaps)
+        {
+            if (plays.Count == 0)
+                return;
+
+            var rulesetInstance = run.RulesetInstance ??= run.Ruleset.CreateInstance();
+            var profile = run.Profile;
+            var added = new List<Guid>();
+
+            realm.Write(r =>
+            {
+                var ruleset = r.Find<RulesetInfo>(run.Ruleset.ShortName);
+
+                if (ruleset == null)
+                    return;
+
+                // The profile's plays on these beatmaps, read once (only the beatmap and date are needed).
+                var beatmapIds = beatmaps.Where(kv => plays.Contains(kv.Key)).Select(kv => kv.Value).Distinct().ToArray();
+                var existing = new Dictionary<(Guid, long), Guid>();
+                // Plays whose replay was imported keep osu!'s score IDs (their replay's date can differ from the API's).
+                var byOnlineId = new Dictionary<long, Guid>();
+                var byLegacyId = new Dictionary<long, Guid>();
+
+                var own = r.All<ScoreInfo>()
+                           .Filter($@"{nameof(ScoreInfo.User)}.{nameof(Models.RealmUser.OnlineID)} == $0 AND {nameof(ScoreInfo.DeletePending)} == false", profile.UserId);
+
+                foreach (var s in own)
+                {
+                    if (s.BeatmapInfo == null || !beatmapIds.Contains(s.BeatmapInfo.ID))
+                        continue;
+
+                    existing.TryAdd((s.BeatmapInfo.ID, s.Date.ToUnixTimeSeconds()), s.ID);
+
+                    if (s.OnlineID > 0)
+                        byOnlineId.TryAdd(s.OnlineID, s.ID);
+
+                    if (s.LegacyOnlineID > 0)
+                        byLegacyId.TryAdd(s.LegacyOnlineID, s.ID);
+                }
+
+                foreach (var play in plays)
+                {
+                    if (!beatmaps.TryGetValue(play, out var beatmapId))
+                        continue;
+
+                    long seconds = play.EndedAt.ToUnixTimeSeconds();
+
+                    var match = Enumerable.Range(-2, 5).Select(d => (beatmapId, seconds + d)).FirstOrDefault(existing.ContainsKey);
+
+                    if ((play.OnlineID > 0 && byOnlineId.TryGetValue(play.OnlineID, out var found))
+                        || (play.LegacyScoreId is ulong legacyId && byLegacyId.TryGetValue((long)legacyId, out found))
+                        || (match != default && existing.TryGetValue(match, out found)))
+                    {
+                        run.Scores[play] = found;
+                        run.AlreadyThere++;
+                        continue;
+                    }
+
+                    var beatmap = r.Find<BeatmapInfo>(beatmapId);
+
+                    if (beatmap == null)
+                    {
+                        run.Unavailable++;
+                        continue;
+                    }
+
+                    var score = play.ToScoreInfo(play.Mods.Select(m => m.ToMod(rulesetInstance)).ToArray(), beatmap);
+
+                    // Only on this profile: no online ID (the results screen would offer to watch a replay that isn't there) and no online replay.
+                    score.OnlineID = -1;
+                    score.LegacyOnlineID = -1;
+                    score.HasOnlineReplay = false;
+                    score.Ruleset = ruleset;
+                    // The score only links to its beatmap while this matches the beatmap's file hash (PP, leaderboards, the profile).
+                    score.BeatmapHash = beatmap.Hash;
+                    score.User = profile.ToUser();
+                    score.Passed = true;
+                    score.StatisticsJson = JsonConvert.SerializeObject(score.Statistics);
+                    score.MaximumStatisticsJson = JsonConvert.SerializeObject(score.MaximumStatistics);
+
+                    r.Add(score);
+                    existing[(beatmapId, seconds)] = score.ID;
+                    run.Scores[play] = score.ID;
+                    run.Added++;
+                    added.Add(score.ID);
+                }
+            });
+
+            // Never recorded as attempts: each counts as one play from its score (play count, hits, play time), like synced plays.
+            Store.UpdateBanchoScores(profile.Id, added);
+            refreshScoreDisplays();
+        }
+
+        /// <summary>
+        /// Plays fetched by an earlier version were saved without <see cref="ScoreInfo.BeatmapHash"/>, so they had no beatmap (no PP,
+        /// not on the profile). Gives local profiles' scores missing it their beatmap's hash. Called once the manager is loaded.
+        /// </summary>
+        private void repairScoresWithoutBeatmapHash()
+        {
+            var profileUserIds = Store.GetProfiles().Select(p => p.UserId).ToHashSet();
+
+            bool any = realm.Run(r => r.All<ScoreInfo>().Filter($@"{nameof(ScoreInfo.BeatmapHash)} == ''").AsEnumerable()
+                                       .Any(s => s.BeatmapInfo != null && profileUserIds.Contains(s.RealmUser.OnlineID)));
+
+            if (!any)
+                return;
+
+            int repaired = 0;
+
+            realm.Write(r =>
+            {
+                foreach (var s in r.All<ScoreInfo>().Filter($@"{nameof(ScoreInfo.BeatmapHash)} == ''").ToList())
+                {
+                    if (s.BeatmapInfo == null || !profileUserIds.Contains(s.RealmUser.OnlineID))
+                        continue;
+
+                    s.BeatmapHash = s.BeatmapInfo.Hash;
+                    repaired++;
+                }
+            });
+
+            Logger.Log($@"Patchsu: gave {repaired} local profile score(s) their beatmap's hash.");
+            refreshScoreDisplays();
+        }
+
+        /// <summary>
+        /// Plays fetched by earlier versions without a replay counted no play, hits or play time (only the ones whose replay was
+        /// downloaded did, as synced plays). Marks them once, like newly fetched ones. They are the local profiles' scores that
+        /// have no replay file and no online ID: plays set here always save a replay. Called once the manager is loaded.
+        /// </summary>
+        private void migrateBanchoScores()
+        {
+            if (!Store.TakeMigration(2))
+                return;
+
+            var profiles = Store.GetProfiles();
+            var byUserId = profiles.ToDictionary(p => p.UserId, p => p.Id);
+            var found = new Dictionary<Guid, List<Guid>>();
+
+            realm.Run(r =>
+            {
+                foreach (var s in r.All<ScoreInfo>().Filter($@"{nameof(ScoreInfo.DeletePending)} == false AND {nameof(ScoreInfo.OnlineID)} <= 0 AND {nameof(ScoreInfo.Files)}.@count == 0"))
+                {
+                    if (!byUserId.TryGetValue(s.RealmUser.OnlineID, out var profileId))
+                        continue;
+
+                    if (!found.TryGetValue(profileId, out var list))
+                        found[profileId] = list = new List<Guid>();
+
+                    list.Add(s.ID);
+                }
+            });
+
+            foreach (var profile in profiles)
+            {
+                if (!found.TryGetValue(profile.Id, out var ids))
+                    continue;
+
+                var synced = profile.SyncedScores.Select(s => s.ScoreId).ToHashSet();
+                ids.RemoveAll(synced.Contains);
+
+                if (ids.Count == 0)
+                    continue;
+
+                Store.UpdateBanchoScores(profile.Id, ids);
+                Logger.Log($@"Patchsu: {ids.Count} play(s) fetched from osu! now count towards ""{profile.Name}""'s play count and play time.");
+            }
+        }
+
+        /// <summary>
+        /// The plays are in: downloads the replays osu! has for them (plays without one so far only), then completes. Update thread.
+        /// </summary>
+        private void finishBanchoImport(BanchoImportRun run, ProgressNotification notification)
+        {
+            var wanted = run.Scores.Where(kv => kv.Key.HasReplay && kv.Key.OnlineID > 0).ToList();
+            var ids = wanted.Select(kv => kv.Value).ToHashSet();
+            var withoutReplay = realm.Run(r => ids.Where(id => r.Find<ScoreInfo>(id) is ScoreInfo s && s.Files.Count == 0).ToHashSet());
+            var replays = wanted.Where(kv => withoutReplay.Contains(kv.Value)).ToList();
+
+            if (replays.Count == 0 || run.Token.IsCancellationRequested)
+            {
+                completeBanchoImport(run, notification);
+                return;
+            }
+
+            Task.Run(async () =>
+            {
+                try
+                {
+                    await downloadBanchoReplays(run, replays, notification).ConfigureAwait(false);
+                }
+                catch (Exception e)
+                {
+                    run.Done.TrySetException(e);
+                }
+            });
+        }
+
+        /// <summary>
+        /// Downloads the replays (a couple at a time) and imports them quietly under the fetch's notification. Each imported replay's
+        /// score takes its play's place on the profile (the play without a replay is removed).
+        /// </summary>
+        private async Task downloadBanchoReplays(BanchoImportRun run, List<KeyValuePair<SoloScoreInfo, Guid>> replays, ProgressNotification notification)
+        {
+            int downloaded = 0;
+            int failed = 0;
+            int next = -1;
+            var token = run.Token;
+
+            void updateNotification()
+            {
+                int done = Volatile.Read(ref downloaded);
+                int bad = Volatile.Read(ref failed);
+
+                notification.Text = $@"Downloading replays for the top plays of {run.Profile.Name}: {done:N0} downloaded, {replays.Count - done - bad:N0} left"
+                                    + (bad > 0 ? $@" ({bad:N0} failed)" : string.Empty);
+                notification.Progress = (float)(done + bad) / replays.Count;
+            }
+
+            updateNotification();
+
+            async Task worker()
+            {
+                int i;
+
+                while ((i = Interlocked.Increment(ref next)) < replays.Count && !token.IsCancellationRequested)
+                {
+                    var (play, placeholderId) = (replays[i].Key, replays[i].Value);
+                    Guid? importedId = null;
+
+                    try
+                    {
+                        importedId = await downloadBanchoReplay(play, token).ConfigureAwait(false);
+                    }
+                    catch (OperationCanceledException)
+                    {
+                        return;
+                    }
+                    catch (Exception e)
+                    {
+                        Logger.Error(e, $@"Patchsu: importing the replay of score {play.OnlineID} failed.");
+                    }
+
+                    var attached = new TaskCompletionSource<bool>(TaskCreationOptions.RunContinuationsAsynchronously);
+                    Schedule(() => attached.TrySetResult(importedId is Guid id && attachBanchoReplay(run, placeholderId, id)));
+
+                    bool ok = await attached.Task.ConfigureAwait(false);
+                    Interlocked.Increment(ref ok ? ref downloaded : ref failed);
+                    updateNotification();
+                }
+            }
+
+            await Task.WhenAll(Enumerable.Range(0, Math.Min(bancho_parallel_downloads, replays.Count)).Select(_ => Task.Run(worker))).ConfigureAwait(false);
+
+            int added = Volatile.Read(ref downloaded);
+            int notDownloaded = replays.Count - added - Volatile.Read(ref failed);
+
+            Schedule(() =>
+            {
+                run.ReplaysAdded += added;
+                run.ReplaysSkipped += notDownloaded;
+                completeBanchoImport(run, notification);
+            });
+        }
+
+        /// <summary>
+        /// Downloads one replay and imports it without a notification. The imported score's ID, or null.
+        /// </summary>
+        private async Task<Guid?> downloadBanchoReplay(SoloScoreInfo play, CancellationToken token)
+        {
+            var request = new DownloadReplayRequest(play);
+            var tcs = new TaskCompletionSource<string?>(TaskCreationOptions.RunContinuationsAsynchronously);
+
+            request.Success += filename => tcs.TrySetResult(filename);
+            request.Failure += e =>
+            {
+                if (e is OperationCanceledException)
+                    tcs.TrySetCanceled();
+                else
+                {
+                    Logger.Log($@"Patchsu: downloading the replay of score {play.OnlineID} failed: {e.Message}");
+                    tcs.TrySetResult(null);
+                }
+            };
+
+            string? file;
+
+            await using (token.Register(request.Cancel))
+            {
+                api.Queue(request);
+                file = await tcs.Task.ConfigureAwait(false);
+            }
+
+            if (file == null)
+                return null;
+
+            // A notification that is never posted: the import stays quiet (the fetch's notification counts it).
+            var imported = await scoreManager.Import(new ProgressNotification(), new[] { new Database.ImportTask(file) }).ConfigureAwait(false);
+            return imported.FirstOrDefault()?.ID;
+        }
+
+        /// <summary>
+        /// Moves the imported replay's score to the profile (like importing replays does) and removes the play it replaces.
+        /// False if the score is on another local profile (it stays there, and so does the play). Update thread.
+        /// </summary>
+        private bool attachBanchoReplay(BanchoImportRun run, Guid placeholderId, Guid importedId)
+        {
+            var profile = run.Profile;
+            var otherProfiles = Store.GetProfiles().Where(p => p.Id != profile.Id).Select(p => p.UserId).ToHashSet();
+            SyncedScore? synced = null;
+            bool attached = false;
+
+            realm.Write(r =>
+            {
+                var imported = r.Find<ScoreInfo>(importedId);
+                var placeholder = r.Find<ScoreInfo>(placeholderId);
+
+                if (imported == null || imported.ID == placeholderId || otherProfiles.Contains(imported.RealmUser.OnlineID))
+                    return;
+
+                if (imported.RealmUser.OnlineID != profile.UserId)
+                {
+                    synced = new SyncedScore
+                    {
+                        ScoreId = imported.ID,
+                        OriginalUserId = imported.RealmUser.OnlineID,
+                        OriginalUsername = imported.RealmUser.Username,
+                        OriginalCountry = imported.RealmUser.CountryCode,
+                    };
+
+                    imported.RealmUser = new Models.RealmUser
+                    {
+                        OnlineID = profile.UserId,
+                        Username = profile.Name,
+                        CountryCode = profile.Country,
+                    };
+                }
+
+                imported.DeletePending = false;
+
+                if (placeholder != null && placeholder.Files.Count == 0)
+                    placeholder.DeletePending = true;
+
+                attached = true;
+            });
+
+            // Like imported replays: "unsync" gives it back to the player named in the replay.
+            if (synced != null)
+                Store.AddSyncedScores(profile.Id, new[] { synced });
+
+            if (attached)
+            {
+                // The replay's score counts the play now (as a synced play), not the play it replaced.
+                Store.UpdateBanchoScores(profile.Id, Array.Empty<Guid>(), new[] { placeholderId });
+                refreshScoreDisplays();
+            }
+
+            return attached;
+        }
+
+        private void completeBanchoImport(BanchoImportRun run, ProgressNotification notification)
+        {
+            var parts = new List<string> { $@"Added {run.Added:N0} of {run.Total:N0} top plays of {run.Profile.Name} ({run.Ruleset.Name})." };
+
+            if (run.ReplaysAdded > 0)
+                parts.Add($@"{run.ReplaysAdded:N0} with their replay.");
+
+            if (run.ReplaysSkipped > 0)
+                parts.Add($@"{run.ReplaysSkipped:N0} replays not downloaded (cancelled).");
+
+            if (run.AlreadyThere > 0)
+                parts.Add($@"{run.AlreadyThere:N0} were already there.");
+
+            if (run.Skipped > 0)
+                parts.Add($@"{run.Skipped:N0} skipped (beatmap not downloaded).");
+
+            if (run.Unavailable > 0)
+                parts.Add($@"{run.Unavailable:N0} could not be added (beatmap unavailable or changed since).");
+
+            notification.CompletionText = string.Join(@" ", parts);
+            notification.Progress = 1;
+            notification.State = ProgressNotificationState.Completed;
+            run.Done.TrySetResult(true);
+        }
+
+        private class BanchoImportRun
+        {
+            public readonly LocalProfile Profile;
+            public readonly RulesetInfo Ruleset;
+            public readonly int Total;
+
+            public Ruleset? RulesetInstance;
+
+            public readonly CancellationToken Token;
+            public readonly TaskCompletionSource<bool> Done;
+
+            /// <summary>
+            /// Each play's score on the profile (added now or already there).
+            /// </summary>
+            public readonly Dictionary<SoloScoreInfo, Guid> Scores = new Dictionary<SoloScoreInfo, Guid>();
+
+            public int Added;
+            public int AlreadyThere;
+            public int Skipped;
+            public int Unavailable;
+            public int ReplaysAdded;
+            public int ReplaysSkipped;
+
+            public BanchoImportRun(LocalProfile profile, RulesetInfo ruleset, IReadOnlyList<SoloScoreInfo> plays, CancellationToken token, TaskCompletionSource<bool> done)
+            {
+                Profile = profile;
+                Ruleset = ruleset;
+                Total = plays.Count;
+                Token = token;
+                Done = done;
+            }
+        }
+
+        /// <summary>
+        /// The fetch's one notification. Unlike other progress notifications it can be swiped away (or clicked, or closed) while
+        /// it runs: that only moves it to the notification list, the fetch goes on. Closing it there cancels the fetch.
+        /// </summary>
+        private partial class BanchoFetchNotification : ProgressNotification
+        {
+            protected override bool AllowFlingDismiss => true;
+
+            public override void Close(bool runFlingAnimation)
+            {
+                if ((State == ProgressNotificationState.Active || State == ProgressNotificationState.Queued) && IsInToastTray)
+                {
+                    ForwardToOverlay?.Invoke();
+                    return;
+                }
+
+                base.Close(runFlingAnimation);
+            }
+        }
+
+        /// <summary>
+        /// Closing it without a button (Escape, clicking outside) presses the last one: skip.
+        /// </summary>
+        private partial class BanchoDownloadDialog : PopupDialog
+        {
+            public BanchoDownloadDialog(string name, int ready, int missing, int sets, Action download, Action skip)
+            {
+                Icon = FontAwesome.Solid.Download;
+                HeaderText = $@"Download {sets:N0} beatmap{(sets == 1 ? string.Empty : @"s")}?";
+                BodyText = $@"{missing:N0} of the top plays of {name} are on beatmaps you don't have"
+                           + (ready > 0 ? $@" ({ready:N0} others were added already)." : @".")
+                           + @" Download them to add those plays too? Each play is added as soon as its beatmap is imported.";
+
+                Buttons = new PopupDialogButton[]
+                {
+                    new PopupDialogOkButton
+                    {
+                        Text = $@"Yes, download {sets:N0} beatmap{(sets == 1 ? string.Empty : @"s")}",
+                        Action = download,
+                    },
+                    new PopupDialogCancelButton
+                    {
+                        Text = @"No, skip those plays",
+                        Action = skip,
+                    },
+                };
+            }
+        }
+    }
+}
diff --git a/osu.Game/LocalPriority/LocalProfileManager.Speedrun.cs b/osu.Game/LocalPriority/LocalProfileManager.Speedrun.cs
new file mode 100644
index 0000000000..008e03a7c3
--- /dev/null
+++ b/osu.Game/LocalPriority/LocalProfileManager.Speedrun.cs
@@ -0,0 +1,118 @@
+using System;
+using System.Diagnostics;
+using osu.Framework.Threading;
+using osu.Game.Rulesets;
+
+namespace osu.Game.LocalPriority
+{
+    public partial class LocalProfileManager
+    {
+        /// <summary>
+        /// A running Speedrun profile's time is saved this often (and on switching away or closing the game), so a crash loses little.
+        /// </summary>
+        private const double speedrun_save_interval = 60_000;
+
+        /// <summary>
+        /// The Speedrun profile whose time is running (the active one, until its goal is reached), or null.
+        /// </summary>
+        private Guid? speedrunProfileId;
+
+        private double speedrunSecondsBefore;
+        private readonly Stopwatch speedrunStopwatch = new Stopwatch();
+        private ScheduledDelegate? speedrunSaveLoop;
+
+        /// <summary>
+        /// A Speedrun profile reached its goal: its id and final time in seconds. Raised on the update thread.
+        /// </summary>
+        public event Action<Guid, double>? SpeedrunCompleted;
+
+        public LocalProfile CreateSpeedrunProfile(LocalSpeedrun goal) => Store.CreateSpeedrunProfile(goal);
+
+        public int GetSpeedrunProfileCount() => Store.GetSpeedrunProfileCount();
+
+        /// <summary>
+        /// Whether this profile's speedrun timer is running right now (cheap; the profile page asks every frame).
+        /// </summary>
+        public bool IsSpeedrunRunning(Guid id) => speedrunProfileId == id;
+
+        /// <summary>
+        /// The running speedrun's time so far, in seconds (only for the profile <see cref="IsSpeedrunRunning"/> is true for).
+        /// </summary>
+        public double RunningSpeedrunSeconds => speedrunSecondsBefore + speedrunStopwatch.Elapsed.TotalSeconds;
+
+        /// <summary>
+        /// Starts or stops the speedrun timer to follow the active profile. Time counts only while a Speedrun profile is active.
+        /// </summary>
+        private void updateSpeedrunTimer()
+        {
+            var profile = activeProfile.Value;
+            Guid? id = profile?.Speedrun != null && !profile.Died ? profile.Id : null;
+
+            if (id == speedrunProfileId)
+                return;
+
+            stopSpeedrunTimer();
+
+            if (id is not Guid newId)
+                return;
+
+            var run = Store.GetSpeedrun(newId);
+
+            if (run == null || run.Completed != null)
+                return;
+
+            speedrunProfileId = newId;
+            speedrunSecondsBefore = run.Seconds;
+            speedrunStopwatch.Restart();
+            speedrunSaveLoop = Scheduler.AddDelayed(saveSpeedrunTime, speedrun_save_interval, true);
+        }
+
+        private void saveSpeedrunTime()
+        {
+            if (speedrunProfileId is Guid id)
+                Store.SetSpeedrunTime(id, RunningSpeedrunSeconds, false);
+        }
+
+        private void stopSpeedrunTimer()
+        {
+            saveSpeedrunTime();
+            resetSpeedrunTimer();
+        }
+
+        private void resetSpeedrunTimer()
+        {
+            speedrunSaveLoop?.Cancel();
+            speedrunSaveLoop = null;
+            speedrunStopwatch.Reset();
+            speedrunProfileId = null;
+        }
+
+        /// <summary>
+        /// A profile's PP total for a ruleset is known (after a play, a deleted score, or from the profile page): when it is the running
+        /// Speedrun profile and its goal is reached, the run ends: the timer stops and a notification shows the time. Any thread.
+        /// </summary>
+        public void CheckSpeedrunGoal(Guid profileId, RulesetInfo ruleset, double pp)
+        {
+            string rulesetName = ruleset.ShortName;
+
+            Schedule(() =>
+            {
+                if (speedrunProfileId != profileId)
+                    return;
+
+                var run = Store.GetSpeedrun(profileId);
+
+                if (run == null || run.Completed != null || run.Ruleset != rulesetName || !run.IsReachedBy(pp))
+                    return;
+
+                double seconds = Math.Round(RunningSpeedrunSeconds, 2);
+
+                resetSpeedrunTimer();
+                Store.SetSpeedrunTime(profileId, seconds, true);
+                SpeedrunCompleted?.Invoke(profileId, seconds);
+
+                PostNotification?.Invoke(new LocalSpeedrunCompletedNotification(seconds));
+            });
+        }
+    }
+}
diff --git a/osu.Game/LocalPriority/LocalProfileManager.StatisticsUpdate.cs b/osu.Game/LocalPriority/LocalProfileManager.StatisticsUpdate.cs
new file mode 100644
index 0000000000..403c55e2bb
--- /dev/null
+++ b/osu.Game/LocalPriority/LocalProfileManager.StatisticsUpdate.cs
@@ -0,0 +1,244 @@
+using System;
+using System.Threading;
+using System.Threading.Tasks;
+using osu.Framework.Bindables;
+using osu.Framework.Logging;
+using osu.Game.Database;
+using osu.Game.Extensions;
+using osu.Game.Online;
+using osu.Game.Rulesets;
+using osu.Game.Scoring;
+using osu.Game.Users;
+
+namespace osu.Game.LocalPriority
+{
+    public partial class LocalProfileManager
+    {
+        /// <summary>
+        /// Patchsu: the local profile's PP and estimated global rank before and after a score was saved (or deleted / excluded from PP),
+        /// shown by the toolbar the same way the online account's statistics update is shown after a score is processed.
+        /// </summary>
+        public IBindable<ScoreBasedUserStatisticsUpdate?> LatestStatisticsUpdate => latestStatisticsUpdate;
+
+        private readonly Bindable<ScoreBasedUserStatisticsUpdate?> latestStatisticsUpdate = new Bindable<ScoreBasedUserStatisticsUpdate?>();
+
+        /// <summary>
+        /// Remembers which local profile a play is for. Nothing is calculated while it runs: once its score is saved, the statistics are
+        /// calculated with and without that score in one go. Returns null when no local profile is active.
+        /// </summary>
+        public LocalStatisticsUpdateTracker? BeginStatisticsUpdate(RulesetInfo ruleset)
+        {
+            var profile = activeProfile.Value;
+
+            if (profile == null || beatmapManager == null || !ruleset.IsLegacyRuleset())
+                return null;
+
+            return new LocalStatisticsUpdateTracker(profile.Id, profile.UserId, ruleset);
+        }
+
+        /// <summary>
+        /// Called once the score of a tracked play was saved: calculates the statistics with and without it and shows the change.
+        /// </summary>
+        public void CompleteStatisticsUpdate(LocalStatisticsUpdateTracker tracker, ScoreInfo score)
+        {
+            var beatmaps = beatmapManager;
+
+            if (score.UserID != tracker.UserId || beatmaps == null)
+                return;
+
+            Task.Run(async () =>
+            {
+                try
+                {
+                    var profile = activeProfile.Value;
+
+                    if (profile == null || profile.Id != tracker.ProfileId)
+                        return;
+
+                    var (ppBefore, ppAfter) = await LocalProfileStatistics.CalculatePerformanceChangeAsync(profile, tracker.Ruleset, realm, beatmaps, Store, score.ID)
+                                                                          .ConfigureAwait(false);
+
+                    var before = toUserStatistics(ppBefore, tracker.Ruleset);
+                    var after = toUserStatistics(ppAfter, tracker.Ruleset);
+
+                    CheckSpeedrunGoal(tracker.ProfileId, tracker.Ruleset, ppAfter);
+
+                    // Plays that give no PP (unranked mods, unranked maps, or simply not a new top play) change nothing: show nothing.
+                    if (after.PP == before.PP && after.GlobalRank == before.GlobalRank)
+                        return;
+
+                    Schedule(() =>
+                    {
+                        if (activeProfile.Value?.Id == tracker.ProfileId)
+                            latestStatisticsUpdate.Value = new ScoreBasedUserStatisticsUpdate(score, before, after);
+                    });
+                }
+                catch (Exception ex)
+                {
+                    Logger.Error(ex, @"Patchsu: could not calculate the local profile's statistics update.");
+                }
+            });
+        }
+
+        /// <summary>
+        /// Deletes a score; when it belongs to the active local profile, the toolbar shows how its PP and estimated rank changed.
+        /// <paramref name="delete"/> runs on the update thread.
+        /// </summary>
+        public void DeleteScoreShowingChange(ScoreInfo score, Action delete)
+        {
+            var profile = activeProfile.Value;
+
+            if (profile == null || score.UserID != profile.UserId)
+            {
+                delete();
+                return;
+            }
+
+            ApplyShowingStatisticsChange(delete, score.Ruleset, score);
+        }
+
+        /// <summary>
+        /// Excludes / includes a play, difficulty or beatmap set (every local profile); the toolbar shows how the active profile's
+        /// PP and estimated rank changed (current mode).
+        /// </summary>
+        public void SetExcludedFromPerformance(LocalPerformanceExclusionKind kind, Guid id, bool excluded) =>
+            ApplyShowingStatisticsChange(() => Store.SetExcludedFromPerformance(kind, id, excluded), gameRuleset.Value);
+
+        /// <summary>
+        /// Applies a change that can affect the active local profile's PP, then shows the difference on the toolbar (only if anything changed).
+        /// The current statistics are calculated first, so <paramref name="change"/> runs a moment later, on the update thread.
+        /// </summary>
+        public void ApplyShowingStatisticsChange(Action change, RulesetInfo? ruleset, ScoreInfo? score = null)
+        {
+            var profile = activeProfile.Value;
+
+            if (profile == null || beatmapManager == null || ruleset == null || !ruleset.IsLegacyRuleset())
+            {
+                change();
+                return;
+            }
+
+            ruleset = ruleset.Detach();
+
+            Task.Run(async () =>
+            {
+                var before = await calculateUserStatistics(profile, ruleset).ConfigureAwait(false);
+
+                var applied = new TaskCompletionSource();
+
+                Schedule(() =>
+                {
+                    try
+                    {
+                        change();
+                    }
+                    finally
+                    {
+                        applied.SetResult();
+                    }
+                });
+
+                await applied.Task.ConfigureAwait(false);
+
+                var current = activeProfile.Value;
+
+                if (before == null || current == null || current.Id != profile.Id)
+                    return;
+
+                var after = await calculateUserStatistics(current, ruleset).ConfigureAwait(false);
+
+                if (after != null)
+                    CheckSpeedrunGoal(current.Id, ruleset, (double)(after.PP ?? 0));
+
+                if (after == null || (after.PP == before.PP && after.GlobalRank == before.GlobalRank))
+                    return;
+
+                Schedule(() =>
+                {
+                    if (activeProfile.Value?.Id == profile.Id)
+                        latestStatisticsUpdate.Value = new ScoreBasedUserStatisticsUpdate(score ?? new ScoreInfo(), before, after);
+                });
+            });
+        }
+
+        /// <summary>
+        /// Shows on the toolbar how the active profile's PP and estimated rank changed after its ranking options (or Settings →
+        /// "Count everything as ranked") were changed. The change must already be saved; <paramref name="before"/> is the profile
+        /// as it was, and <paramref name="countEverythingBefore"/> the old global setting.
+        /// </summary>
+        public void ShowRankingChange(LocalProfile before, bool countEverythingBefore, RulesetInfo? ruleset)
+        {
+            var after = Store.ActiveProfile;
+            bool countEverythingAfter = Store.Options.CountEverythingAsRanked;
+
+            if (after == null || after.Id != before.Id || beatmapManager == null || ruleset == null || !ruleset.IsLegacyRuleset())
+                return;
+
+            ruleset = ruleset.Detach();
+
+            Task.Run(async () =>
+            {
+                var oldStatistics = await calculateUserStatistics(before, ruleset, countEverythingBefore).ConfigureAwait(false);
+                var newStatistics = await calculateUserStatistics(after, ruleset, countEverythingAfter).ConfigureAwait(false);
+
+                if (oldStatistics == null || newStatistics == null)
+                    return;
+
+                CheckSpeedrunGoal(after.Id, ruleset, (double)(newStatistics.PP ?? 0));
+
+                if (oldStatistics.PP == newStatistics.PP && oldStatistics.GlobalRank == newStatistics.GlobalRank)
+                    return;
+
+                Schedule(() =>
+                {
+                    if (activeProfile.Value?.Id == after.Id)
+                        latestStatisticsUpdate.Value = new ScoreBasedUserStatisticsUpdate(new ScoreInfo(), oldStatistics, newStatistics);
+                });
+            });
+        }
+
+        private async Task<UserStatistics?> calculateUserStatistics(LocalProfile profile, RulesetInfo ruleset, bool? countEverythingAsRanked = null)
+        {
+            if (beatmapManager == null)
+                return null;
+
+            try
+            {
+                double pp = await LocalProfileStatistics.CalculatePerformanceAsync(profile, ruleset, realm, beatmapManager, Store, CancellationToken.None,
+                                                                       countEverythingAsRanked)
+                                                        .ConfigureAwait(false);
+
+                return toUserStatistics(pp, ruleset);
+            }
+            catch (Exception ex)
+            {
+                Logger.Error(ex, @"Patchsu: could not calculate the local profile's statistics.");
+                return null;
+            }
+        }
+
+        private static UserStatistics toUserStatistics(double pp, RulesetInfo ruleset) => new UserStatistics
+        {
+            PP = (decimal)pp,
+            // Same estimate as the profile page: osu! standard only, and only once there is any PP.
+            GlobalRank = ruleset.ShortName == @"osu" && pp > 0 ? LocalPriorityPolicy.EstimateGlobalRank(pp) : null,
+        };
+    }
+
+    /// <summary>
+    /// The local profile a play is for, for <see cref="LocalProfileManager.CompleteStatisticsUpdate"/>.
+    /// </summary>
+    public class LocalStatisticsUpdateTracker
+    {
+        public Guid ProfileId { get; }
+        public int UserId { get; }
+        public RulesetInfo Ruleset { get; }
+
+        public LocalStatisticsUpdateTracker(Guid profileId, int userId, RulesetInfo ruleset)
+        {
+            ProfileId = profileId;
+            UserId = userId;
+            Ruleset = ruleset;
+        }
+    }
+}
diff --git a/osu.Game/LocalPriority/LocalProfileManager.cs b/osu.Game/LocalPriority/LocalProfileManager.cs
new file mode 100644
index 0000000000..44a34b7436
--- /dev/null
+++ b/osu.Game/LocalPriority/LocalProfileManager.cs
@@ -0,0 +1,1944 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Reflection;
+using osu.Framework.Allocation;
+using osu.Framework.Bindables;
+using osu.Framework.Development;
+using osu.Framework.Graphics;
+using osu.Framework.Graphics.Rendering;
+using osu.Framework.Graphics.Textures;
+using osu.Framework.IO.Stores;
+using osu.Framework.Platform;
+using osu.Framework.Threading;
+using osu.Game.Beatmaps;
+using osu.Game.Configuration;
+using osu.Game.Database;
+using osu.Game.Extensions;
+using osu.Game.Online.API;
+using osu.Game.Online.Leaderboards;
+using osu.Game.Overlays;
+using osu.Game.Rulesets;
+using osu.Game.Rulesets.Mods;
+using osu.Game.Scoring;
+using osu.Game.Utils;
+using Realms;
+using osu.Game.Users;
+
+namespace osu.Game.LocalPriority
+{
+    /// <summary>
+    /// Switches between the online account and local profiles, and keeps the UI informed about profile changes.
+    /// </summary>
+    public partial class LocalProfileManager : Component
+    {
+        public LocalProfileStore Store { get; }
+
+        /// <summary>
+        /// The active local profile, or null when the online account is in use. Updated on the update thread.
+        /// </summary>
+        public IBindable<LocalProfile?> ActiveProfile => activeProfile;
+
+        /// <summary>
+        /// Incremented (on the update thread) whenever any profile data changes. Bind to this to refresh displays.
+        /// </summary>
+        public IBindable<int> Revision => revision;
+
+        private readonly Bindable<LocalProfile?> activeProfile = new Bindable<LocalProfile?>();
+        private readonly BindableInt revision = new BindableInt();
+
+        /// <summary>
+        /// Incremented (on the update thread) when something that can change a local profile's PP changed: scores, PP options,
+        /// exclusions, ranking options, synced plays. Cosmetic changes (names, order, pictures, recorded attempts) leave it alone,
+        /// so PP that is already known can be shown again without recalculating it.
+        /// </summary>
+        public IBindable<int> PerformanceRevision => performanceRevision;
+
+        private readonly BindableInt performanceRevision = new BindableInt();
+
+        /// <summary>
+        /// For PP settings kept outside the store (other patches): PP is calculated again everywhere.
+        /// </summary>
+        public void InvalidatePerformance() => Schedule(() =>
+        {
+            performanceRevision.Value++;
+            revision.Value++;
+        });
+
+        private IDisposable? scoreSubscription;
+
+        private (LocalProfileOptions Options, LocalPerformanceExclusions Exclusions, (Guid, int, bool, bool, bool, object, object)[] Profiles)? lastPerformanceInputs;
+
+        /// <summary>
+        /// Bumps <see cref="PerformanceRevision"/> when a store change touched anything PP depends on.
+        /// </summary>
+        private void checkPerformanceInputs()
+        {
+            var options = Store.Options;
+            var exclusions = Store.PerformanceExclusions;
+            // Linked owners and synced plays are replaced (never changed in place) by the store, so comparing the lists themselves is enough.
+            var profiles = Store.GetProfiles()
+                                .Select(p => (p.Id, p.UserId, p.CountAllAsRanked, p.IncludeRelaxAutopilot, p.IgnoreUnrankedMods, (object)p.LinkedOwners, (object)p.SyncedScores))
+                                .ToArray();
+
+            if (lastPerformanceInputs is var (lastOptions, lastExclusions, lastProfiles)
+                && lastOptions.Equals(options)
+                && lastExclusions.Scores.SequenceEqual(exclusions.Scores)
+                && lastExclusions.Beatmaps.SequenceEqual(exclusions.Beatmaps)
+                && lastExclusions.BeatmapSets.SequenceEqual(exclusions.BeatmapSets)
+                && lastProfiles.SequenceEqual(profiles))
+                return;
+
+            lastPerformanceInputs = (options, exclusions, profiles);
+            performanceRevision.Value++;
+        }
+
+        /// <summary>
+        /// Settings → Patchsu: local profiles may use the signed-in online account for read-only lookups
+        /// (beatmaps, beatmap tags, leaderboards). Off by default. Scores are never submitted either way.
+        /// </summary>
+        public Bindable<bool> LocalProfilesUseOnlineAccount { get; } = new Bindable<bool>();
+
+        /// <summary>
+        /// Settings → Patchsu → Local profiles: "Delete profile (keep its scores)" without asking.
+        /// </summary>
+        public Bindable<bool> DeleteKeepingScoresWithoutAsking { get; } = new Bindable<bool>();
+
+        /// <summary>
+        /// Settings → Patchsu → Local profiles: "Delete profile and all its scores" without asking.
+        /// </summary>
+        public Bindable<bool> DeleteWithScoresWithoutAsking { get; } = new Bindable<bool>();
+
+        /// <summary>
+        /// Settings → Patchsu → Local profiles: suggest syncing plays saved under the same name after creating / renaming a profile.
+        /// </summary>
+        public Bindable<bool> SuggestSyncingSameNamePlays { get; } = new Bindable<bool>(true);
+
+        /// <summary>
+        /// Settings → Patchsu → Local profiles: show "new profile with mod rules" buttons.
+        /// </summary>
+        public Bindable<bool> ProfilesWithModRules { get; } = new Bindable<bool>(true);
+
+        /// <summary>
+        /// Settings → Profile Colors: tint profile pages with <see cref="ProfileColour"/> (not Sudden Death / Perfect Death ones, they keep red / amber).
+        /// </summary>
+        public Bindable<bool> ProfileColouring { get; } = new Bindable<bool>();
+
+        /// <summary>
+        /// Settings → Profile Colors: the colour profile pages are tinted with while <see cref="ProfileColouring"/> is on.
+        /// </summary>
+        public Bindable<Colour4> ProfileColour { get; } = new Bindable<Colour4>(Colour4.FromHex(LocalProfileOptions.DEFAULT_PROFILE_COLOUR));
+
+        private ScheduledDelegate? pendingProfileColourWrite;
+
+        /// <summary>
+        /// Settings → Patchsu: check auto-switch rules once more when a beatmap is started (without waiting for the 2 seconds).
+        /// </summary>
+        public Bindable<bool> SwitchOnBeatmapStart { get; } = new Bindable<bool>(true);
+
+        /// <summary>
+        /// Settings → Patchsu: calculate and show "Total Accuracy" (over every recorded hit) on the profile page.
+        /// </summary>
+        public Bindable<bool> ShowTotalAccuracy { get; } = new Bindable<bool>(true);
+
+        /// <summary>
+        /// Settings → Patchsu: plays on beatmaps marked LOCAL (changed in the editor) can give PP. When off, profiles leave them out entirely.
+        /// </summary>
+        public Bindable<bool> LocalMapsGivePerformance { get; } = new Bindable<bool>();
+
+        /// <summary>
+        /// Settings → Patchsu: every local profile counts every beatmap and mod as ranked (like each profile's own option).
+        /// </summary>
+        public Bindable<bool> CountEverythingAsRanked { get; } = new Bindable<bool>();
+
+        /// <summary>
+        /// Settings → Patchsu: scores that don't count for PP stay in the profile's best scores list (faded, not weighted).
+        /// </summary>
+        public Bindable<bool> ShowNonCountingScores { get; } = new Bindable<bool>(true);
+
+        /// <summary>
+        /// The game's selected mods (set by <see cref="OsuGameBase"/>), corrected to follow the active profile's mod rules.
+        /// </summary>
+        private Bindable<IReadOnlyList<Mod>>? gameMods;
+
+        private readonly IBindable<RulesetInfo> gameRuleset = new Bindable<RulesetInfo>();
+
+        /// <summary>
+        /// The active profile and its rules as last applied, to notice switches and rule edits.
+        /// </summary>
+        private string? appliedRulesKey;
+
+        [Resolved]
+        private IAPIProvider api { get; set; } = null!;
+
+        [Resolved]
+        private IBindable<RulesetInfo> rulesetBindable { get; set; } = null!;
+
+        [Resolved(canBeNull: true)]
+        private LeaderboardManager? leaderboardManager { get; set; }
+
+        [Resolved]
+        private RealmAccess realm { get; set; } = null!;
+
+        [Resolved]
+        private ScoreManager scoreManager { get; set; } = null!;
+
+        /// <summary>
+        /// Textures for local profile pictures (files in "patchsu-osu/avatars").
+        /// </summary>
+        public LargeTextureStore AvatarTextures { get; private set; } = null!;
+
+        private readonly Dictionary<string, Texture?> avatarTextureCache = new Dictionary<string, Texture?>();
+
+        /// <summary>
+        /// A profile picture's texture, decoded once and shared by every avatar showing it (leaderboard rows are recreated on every beatmap change).
+        /// Safe to call from background loading threads.
+        /// </summary>
+        public Texture? GetAvatarTexture(string file)
+        {
+            lock (avatarTextureCache)
+            {
+                // The cache keeps one reference alive, so the image is decoded and uploaded only once.
+                // Every avatar gets its own reference to the same upload: avatars release theirs when they go away,
+                // and handing the same reference to several of them freed it while others still drew it.
+                if (!avatarTextureCache.ContainsKey(file))
+                    avatarTextureCache[file] = AvatarTextures.Get(file);
+
+                return avatarTextureCache[file] == null ? null : AvatarTextures.Get(file);
+            }
+        }
+
+        [BackgroundDependencyLoader]
+        private void load(GameHost host, IRenderer renderer)
+        {
+            AvatarTextures = new LargeTextureStore(renderer, host.CreateTextureLoaderStore(new StorageBackedResourceStore(Store.AvatarStorage)));
+        }
+
+        public LocalProfileManager(LocalProfileStore store)
+        {
+            Store = store;
+            activeProfile.Value = store.ActiveProfile;
+            LocalProfilesUseOnlineAccount.Value = store.LocalProfilesUseOnlineAccount;
+            readOptions();
+        }
+
+        /// <summary>
+        /// Called by <see cref="OsuGameBase"/> with the game's selected mods, so profile mod rules can be applied to them.
+        /// </summary>
+        public void BindGameMods(Bindable<IReadOnlyList<Mod>> mods) => gameMods = mods;
+
+        protected override void LoadComplete()
+        {
+            base.LoadComplete();
+
+            repairScoresWithoutBeatmapHash();
+            migrateBanchoScores();
+
+            // Any change to scores (saved, deleted, transferred, imported) can change PP.
+            scoreSubscription = realm.RegisterForNotifications(r => r.All<ScoreInfo>(), (_, changes) =>
+            {
+                if (changes != null)
+                    performanceRevision.Value++;
+            });
+
+            Store.Changed += onStoreChanged;
+            Store.CalculationsFailed += onCalculationsFailed;
+            LocalProfilesUseOnlineAccount.BindValueChanged(v => Store.SetLocalProfilesUseOnlineAccount(v.NewValue));
+
+            DeleteKeepingScoresWithoutAsking.BindValueChanged(_ => writeOptions());
+            DeleteWithScoresWithoutAsking.BindValueChanged(_ => writeOptions());
+            SuggestSyncingSameNamePlays.BindValueChanged(_ => writeOptions());
+            ProfilesWithModRules.BindValueChanged(_ => writeOptions());
+            ProfileColouring.BindValueChanged(_ => writeProfileColours(true));
+            // The picker changes it every frame while dragged: save once it settles.
+            ProfileColour.BindValueChanged(_ => writeProfileColours(false));
+            AutoSwitchNotifications.BindValueChanged(_ => writeOptions());
+            LongerLastLook.BindValueChanged(_ => writeOptions());
+            SwitchOnBeatmapStart.BindValueChanged(_ => writeOptions());
+            ShowTotalAccuracy.BindValueChanged(_ => writeOptions());
+            LocalMapsGivePerformance.BindValueChanged(_ => writeOptions());
+            CountEverythingAsRanked.BindValueChanged(e =>
+            {
+                if (readingOptions)
+                    return;
+
+                var before = Store.ActiveProfile;
+                writeOptions();
+
+                if (before != null)
+                    ShowRankingChange(before, e.OldValue, gameRuleset.Value);
+            });
+            ShowNonCountingScores.BindValueChanged(_ => writeOptions());
+
+            if (api is APIAccess apiAccess)
+                apiAccess.OnlineAccountRequested += onOnlineAccountRequested;
+
+            gameRuleset.BindTo(rulesetBindable);
+
+            LocalPriorityDiagnostics.LogState();
+
+            // Profiles with auto-switch rules: check whenever another beatmap is selected.
+            if (!LocalPriorityDiagnostics.IsDisabled(@"autoswitch"))
+            {
+                selectedBeatmap.BindTo(gameBeatmap);
+                updateAutoSwitchActive();
+                selectedBeatmap.BindValueChanged(_ => scheduleAutoSwitchCheck());
+
+                // Rules with mods: changing the selected mods counts like selecting another beatmap.
+                gameMods?.BindValueChanged(_ => scheduleAutoSwitchCheck());
+                gameRuleset.BindValueChanged(_ => scheduleAutoSwitchCheck());
+            }
+
+            migrateLinkedOwners();
+            deleteDeadProfiles();
+
+            // Pictures saved at full size by older builds are scaled down once, off the update thread.
+            System.Threading.Tasks.Task.Run(Store.ShrinkOversizedAvatars);
+
+            if (gameMods != null && !LocalPriorityDiagnostics.IsDisabled(@"modrules"))
+            {
+                gameMods.BindValueChanged(_ => enforceModRules());
+                gameRuleset.BindValueChanged(_ => Scheduler.AddOnce(enforceModRules));
+            }
+
+            applyToApi();
+            applyModRulesIfChanged();
+            updateSpeedrunTimer();
+        }
