+using System.Collections.Generic;
+using System.Linq;
+using osu.Framework.Allocation;
+using osu.Framework.Bindables;
+using osu.Framework.Graphics;
+using osu.Framework.Localisation;
+using osu.Game.Graphics.UserInterfaceV2;
+using osu.Game.Overlays.Settings;
+
+namespace osu.Game.LocalPriority
+{
+    /// <summary>
+    /// Settings → Patchsu → "Patch 9. Ignore No Fail".
+    /// </summary>
+    public partial class LocalNoFailPerformanceSettings : PatchSettingsSubsection
+    {
+        public override int PatchNumber => 9;
+
+        protected override string Summary => @"Ignore No Fail";
+
+        public override IEnumerable<LocalisableString> FilterTerms => base.FilterTerms.Concat(new LocalisableString[] { @"no fail", @"nf", @"pp", @"performance" });
+
+        [Resolved]
+        private LocalProfileManager manager { get; set; } = null!;
+
+        private readonly Bindable<bool> ignoreNoFail = new Bindable<bool>();
+        private readonly Bindable<bool> ignoreNoFailScore = new Bindable<bool>();
+
+        [BackgroundDependencyLoader]
+        private void load()
+        {
+            ignoreNoFail.Value = LocalNoFailPerformance.Enabled;
+            ignoreNoFailScore.Value = LocalNoFailPerformance.ScoreEnabled;
+
+            Children = new Drawable[]
+            {
+                new SettingsItemV2(new FormCheckBox
+                {
+                    Caption = @"Remove 'No Fail' from PP calculation",
+                    HintText = @"Plays with No Fail give PP as if it wasn't selected. Applies to results, leaderboards and profiles.",
+                    Current = ignoreNoFail,
+                }),
+                new SettingsItemV2(new FormCheckBox
+                {
+                    Caption = @"Also remove 'No Fail' score reduction",
+                    HintText = @"Plays with No Fail show and sort by their score as if it wasn't selected (x2). Needs the option above.",
+                    Current = ignoreNoFailScore,
+                }),
+            };
+        }
+
+        protected override void LoadComplete()
+        {
+            base.LoadComplete();
+
+            ignoreNoFail.BindValueChanged(e =>
+            {
+                manager.SetIgnoreNoFailPerformance(e.NewValue);
+                ignoreNoFailScore.Disabled = !e.NewValue;
+            }, true);
+            ignoreNoFailScore.BindValueChanged(e => manager.SetIgnoreNoFailScore(e.NewValue));
+        }
+    }
+}
