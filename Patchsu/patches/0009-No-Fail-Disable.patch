+using System.Threading.Tasks;
+using osu.Game.Database;
+using osu.Game.Extensions;
+using osu.Game.Online;
+using osu.Game.Scoring;
+using osu.Game.Users;
+
+namespace osu.Game.LocalPriority
+{
+    public partial class LocalProfileManager
+    {
+        /// <summary>
+        /// Patch 9: turns "Also remove 'No Fail' score reduction" on or off. Leaderboards are fetched again and profile scores recalculated.
+        /// </summary>
+        public void SetIgnoreNoFailScore(bool ignore)
+        {
+            if (LocalNoFailPerformance.ScoreEnabled == ignore)
+                return;
+
+            LocalNoFailPerformance.SetScoreEnabled(ignore);
+
+            if (!LocalNoFailPerformance.Enabled)
+                return;
+
+            // Ranked / total score on the profile page and leaderboard scores (shown and sorted) change.
+            InvalidatePerformance();
+            refreshScoreDisplays();
+        }
+
+        /// <summary>
+        /// Patch 9: turns "Remove 'No Fail' from PP calculation" on or off. Profiles and leaderboards are recalculated, and the
+        /// active profile's PP / rank change shows on the toolbar (like the other PP options).
+        /// </summary>
+        public void SetIgnoreNoFailPerformance(bool ignore)
+        {
+            if (LocalNoFailPerformance.Enabled == ignore)
+                return;
+
+            var profile = Store.ActiveProfile;
+            var ruleset = gameRuleset.Value;
+
+            LocalNoFailPerformance.SetEnabled(ignore);
+
+            // The profile page and the other profiles' chips calculate again.
+            InvalidatePerformance();
+            refreshScoreDisplays();
+
+            if (profile == null || beatmapManager == null || ruleset == null || !ruleset.IsLegacyRuleset())
+                return;
+
+            ruleset = ruleset.Detach();
+
+            Task.Run(async () =>
+            {
+                UserStatistics? before = await LocalNoFailPerformance.RunWith(!ignore, () => calculateUserStatistics(profile, ruleset)).ConfigureAwait(false);
+                UserStatistics? after = await LocalNoFailPerformance.RunWith(ignore, () => calculateUserStatistics(profile, ruleset)).ConfigureAwait(false);
+
+                if (before == null || after == null || (before.PP == after.PP && before.GlobalRank == after.GlobalRank))
+                    return;
+
+                Schedule(() =>
+                {
+                    if (activeProfile.Value?.Id == profile.Id)
+                        latestStatisticsUpdate.Value = new ScoreBasedUserStatisticsUpdate(new ScoreInfo(), before, after);
+                });
+            });
+        }
+    }
+}
