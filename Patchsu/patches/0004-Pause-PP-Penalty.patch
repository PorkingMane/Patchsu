diff --git a/osu.Game/LocalPriority/LocalProfileManager.PausePenalty.cs b/osu.Game/LocalPriority/LocalProfileManager.PausePenalty.cs
new file mode 100644
index 0000000000..d7f4dcc18b
--- /dev/null
+++ b/osu.Game/LocalPriority/LocalProfileManager.PausePenalty.cs
@@ -0,0 +1,52 @@
+using System.Threading.Tasks;
+using osu.Game.Database;
+using osu.Game.Extensions;
+using osu.Game.Online;
+using osu.Game.Rulesets;
+using osu.Game.Scoring;
+
+namespace osu.Game.LocalPriority
+{
+    public partial class LocalProfileManager
+    {
+        /// <summary>
+        /// Patch 4: shows on the toolbar how the active profile's PP and estimated rank changed when "Reduce PP for pauses"
+        /// was turned on or off (the same animation as after a play), so the PP lost to pauses is visible.
+        /// The setting must already be saved; <paramref name="penaltyBefore"/> is its old value.
+        /// </summary>
+        private void showPausePenaltyChange(bool penaltyBefore, RulesetInfo? ruleset)
+        {
+            var profile = Store.ActiveProfile;
+            bool penaltyAfter = Store.Options.PausePenalty;
+
+            if (profile == null || penaltyBefore == penaltyAfter || beatmapManager == null || ruleset == null || !ruleset.IsLegacyRuleset())
+                return;
+
+            ruleset = ruleset.Detach();
+
+            Task.Run(async () =>
+            {
+                // The override flows into the statistics pass awaited right after it (and only there).
+                LocalPausePenalty.Override.Value = penaltyBefore;
+                var oldStatistics = await calculateUserStatistics(profile, ruleset).ConfigureAwait(false);
+
+                LocalPausePenalty.Override.Value = penaltyAfter;
+                var newStatistics = await calculateUserStatistics(profile, ruleset).ConfigureAwait(false);
+
+                LocalPausePenalty.Override.Value = null;
+
+                if (oldStatistics == null || newStatistics == null)
+                    return;
+
+                if (oldStatistics.PP == newStatistics.PP && oldStatistics.GlobalRank == newStatistics.GlobalRank)
+                    return;
+
+                Schedule(() =>
+                {
+                    if (activeProfile.Value?.Id == profile.Id)
+                        latestStatisticsUpdate.Value = new ScoreBasedUserStatisticsUpdate(new ScoreInfo(), oldStatistics, newStatistics);
+                });
+            });
+        }
+    }
+}
