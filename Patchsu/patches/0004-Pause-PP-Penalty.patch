diff --git a/osu.Game/LocalPriority/LocalPausePenalty.cs b/osu.Game/LocalPriority/LocalPausePenalty.cs
new file mode 100644
index 0000000000..47091a733b
--- /dev/null
+++ b/osu.Game/LocalPriority/LocalPausePenalty.cs
@@ -0,0 +1,60 @@
+// Added by Patchsu
+
+using System;
+using System.Threading;
+using osu.Game.Scoring;
+
+namespace osu.Game.LocalPriority
+{
+    /// <summary>
+    /// Patchsu: optional pause penalty (Settings → Patchsu → "Patch 4. Pause PP penalty"), taken from the Torii client.
+    /// Every pause during a play multiplies its PP by <see cref="MULTIPLIER_PER_PAUSE"/> (7% per pause, compounding).
+    /// Unlike Torii (where the server only penalises ranked plays) it applies to every beatmap, ranked or not.
+    /// Pauses are recorded on <see cref="ScoreInfo.Pauses"/> by <c>SubmittingPlayer.Pause()</c>.
+    /// </summary>
+    public static class LocalPausePenalty
+    {
+        /// <summary>
+        /// Multiplier applied to PP once per pause (the same value Torii uses).
+        /// </summary>
+        public const double MULTIPLIER_PER_PAUSE = 0.93;
+
+        /// <summary>
+        /// Whether the penalty is turned on (set from the Patchsu settings).
+        /// </summary>
+        public static bool Enabled { get; internal set; }
+
+        /// <summary>
+        /// Overrides the saved setting for the profile statistics calculated in the current async flow (null: use the setting),
+        /// to compare the PP before and after the setting changes.
+        /// </summary>
+        internal static readonly AsyncLocal<bool?> Override = new AsyncLocal<bool?>();
+
+        /// <summary>
+        /// Whether profile statistics apply the penalty, given the saved setting (<see cref="Override"/> wins when set).
+        /// </summary>
+        public static bool AppliesToStatistics(bool savedSetting) => Override.Value ?? savedSetting;
+
+        /// <summary>
+        /// The number of pauses that cost PP on this score (0 while the penalty is off).
+        /// </summary>
+        public static int GetPenalisedPauses(ScoreInfo score) => Enabled ? score.Pauses?.Count ?? 0 : 0;
+
+        /// <summary>
+        /// Applies the penalty for <paramref name="pauseCount"/> pauses to an unpenalised PP value.
+        /// </summary>
+        public static double Apply(double pp, int pauseCount)
+            => pauseCount <= 0 ? pp : pp * Math.Pow(MULTIPLIER_PER_PAUSE, pauseCount);
+
+        /// <summary>
+        /// Applies the penalty for the score's pauses (if turned on) to its unpenalised PP value.
+        /// </summary>
+        public static double Apply(double pp, ScoreInfo score) => Apply(pp, GetPenalisedPauses(score));
+
+        /// <summary>
+        /// The total percentage lost to pauses (7 for one pause, 13.5 for two, ...).
+        /// </summary>
+        public static double TotalPercentLost(int pauseCount)
+            => (1 - Math.Pow(MULTIPLIER_PER_PAUSE, pauseCount)) * 100;
+    }
+}
