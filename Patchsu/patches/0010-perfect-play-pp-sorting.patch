+        // Patchsu: perfect-play PP sorting (ported from Ritsu). Highest first; beatmaps without a value yet go last.
+        // compare() is static and every filter run sorts on its own thread, so the values for the current run are kept per thread.
+        [ThreadStatic]
+        private static Dictionary<Guid, double>? sortPerformance;
+
+        private static int comparePerformance(BeatmapInfo a, BeatmapInfo b)
+        {
+            if (sortPerformance == null)
+                return 0;
+
+            bool hasA = sortPerformance.TryGetValue(a.ID, out double valueA);
+            bool hasB = sortPerformance.TryGetValue(b.ID, out double valueB);
+
+            if (hasA && hasB)
+                return valueB.CompareTo(valueA);
+
+            return hasA ? -1 : hasB ? 1 : 0;
+        }
+
+        private static Dictionary<Guid, double> getPerformanceSortValues(IEnumerable<CarouselItem> items, FilterCriteria criteria, CancellationToken cancellationToken)
+        {
+            var values = new Dictionary<Guid, double>();
+            double rate = ModUtils.CalculateRateWithMods(criteria.Mods ?? Array.Empty<Mod>());
+
+            foreach (var item in items)
+            {
+                cancellationToken.ThrowIfCancellationRequested();
+
+                var beatmap = (BeatmapInfo)item.Model;
+                var result = criteria.GetPerfectPerformance(beatmap);
+
+                if (result.State != PerfectPerformanceState.Available)
+                    continue;
+
+                double? value = criteria.Sort == SortMode.Farmability
+                    ? CalculateFarmability(result.Value.Performance, beatmap.Length / 1000.0 / rate, result.Value.StarRating)
+                    : result.Value.Performance;
+
+                if (value != null)
+                    values[beatmap.ID] = value.Value;
+            }
+
+            return values;
+        }
+
+        /// <summary>
+        /// How much PP a beatmap gives for how long and hard it is: PP per second of play, divided by the star rating squared.
+        /// </summary>
+        internal static double? CalculateFarmability(double pp, double seconds, double stars)
+        {
+            if (!double.IsFinite(pp) || pp < 0 || !double.IsFinite(seconds) || seconds <= 0 || !double.IsFinite(stars) || stars <= 0)
+                return null;
+
+            double result = 1000 * pp / seconds / (stars * stars);
+            return double.IsFinite(result) ? result : null;
+        }
