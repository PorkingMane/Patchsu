diff --git a/osu.Game/Screens/Select/PerfectPerformanceCache.cs b/osu.Game/Screens/Select/PerfectPerformanceCache.cs
new file mode 100644
index 0000000000..84f3134876
--- /dev/null
+++ b/osu.Game/Screens/Select/PerfectPerformanceCache.cs
@@ -0,0 +1,396 @@
+// Added by Patchsu
+
+// Patchsu: perfect-play PP for song select (sorting by PP / farmability, PP groups, PP range filter).
+// Ported from Ritsu's perfect-play PP sorting (Ritsu contributors, MIT).
+
+using System;
+using System.Collections.Generic;
+using System.Globalization;
+using System.IO;
+using System.Linq;
+using System.Threading;
+using Newtonsoft.Json;
+using osu.Framework.Logging;
+using osu.Framework.Platform;
+using osu.Game.Beatmaps;
+using osu.Game.Online.API;
+using osu.Game.Rulesets;
+using osu.Game.Rulesets.Mods;
+
+namespace osu.Game.Screens.Select
+{
+    /// <summary>
+    /// The PP of a perfect play (SS, full combo) on a beatmap with a given set of mods, and the star rating with those mods.
+    /// </summary>
+    internal readonly record struct PerfectPerformanceValue(double Performance, double StarRating);
+
+    /// <summary>
+    /// Keeps calculated <see cref="PerfectPerformanceValue"/>s on disk, so they only have to be calculated once per beatmap, ruleset and mods.
+    /// </summary>
+    /// <remarks>
+    /// Values are grouped by setup (format, ruleset, difficulty calculator version, mods) and then keyed by beatmap hash, so the
+    /// setup isn't repeated for every beatmap. They are kept rounded (PP to 0.01, star rating to 0.001): nothing shows or sorts finer.
+    /// </remarks>
+    internal sealed class PerfectPerformanceCache
+    {
+        private const string directory = "osu-local";
+        private const string filename = "perfect-pp-cache-v2.json";
+
+        /// <summary>
+        /// The first version's file (one entry per beatmap and setup, full precision): converted once, then deleted.
+        /// </summary>
+        private const string old_filename = "perfect-pp-cache.json";
+
+        /// <summary>
+        /// Bump to drop every stored value (e.g. when the way values are calculated changes).
+        /// </summary>
+        private const int format_version = 1;
+
+        private const int save_delay = 5000;
+
+        private static readonly object instance_lock = new object();
+        private static PerfectPerformanceCache? instance;
+
+        /// <summary>
+        /// The cache stored in <paramref name="storage"/>. All song selects share it (loaded from disk once).
+        /// </summary>
+        public static PerfectPerformanceCache For(Storage storage)
+        {
+            lock (instance_lock)
+            {
+                if (instance == null || instance.gameStorage != storage)
+                    instance = new PerfectPerformanceCache(storage);
+
+                return instance;
+            }
+        }
+
+        private static readonly Dictionary<string, int> difficulty_versions = new Dictionary<string, int>();
+
+        /// <summary>
+        /// The ruleset's difficulty calculator version (values from older calculators are never used).
+        /// </summary>
+        private static int getDifficultyVersion(RulesetInfo rulesetInfo)
+        {
+            lock (difficulty_versions)
+            {
+                if (!difficulty_versions.TryGetValue(rulesetInfo.ShortName, out int version))
+                {
+                    try
+                    {
+                        version = rulesetInfo.CreateInstance().CreateDifficultyCalculator(new FlatWorkingBeatmap(new Beatmap())).Version;
+                    }
+                    catch
+                    {
+                        version = 0;
+                    }
+
+                    difficulty_versions[rulesetInfo.ShortName] = version;
+                }
+
+                return version;
+            }
+        }
+
+        /// <summary>
+        /// The part of the setup that comes from the mods. Every mod counts here (not only difficulty-changing ones):
+        /// e.g. Hidden and No Fail change the PP of a perfect play.
+        /// </summary>
+        public static string GetModsKey(IEnumerable<Mod>? mods)
+            => JsonConvert.SerializeObject((mods ?? Array.Empty<Mod>()).Select(m => new APIMod(m)).OrderBy(m => m.Acronym, StringComparer.Ordinal));
+
+        private readonly Storage gameStorage;
+        private readonly Storage storage;
+        private readonly object sync = new object();
+        private readonly object writeLock = new object();
+        private readonly Dictionary<string, Dictionary<string, PerfectPerformanceValue>> setups;
+        private readonly Timer saveTimer;
+        private bool dirty;
+        private bool deleteOldFile;
+
+        internal PerfectPerformanceCache(Storage storage)
+        {
+            gameStorage = storage;
+            this.storage = storage.GetStorageForDirectory(directory);
+            setups = load();
+            saveTimer = new Timer(_ => Save(), null, Timeout.Infinite, Timeout.Infinite);
+
+            // Converted from the old file: write the new one soon (the old one is deleted once that worked).
+            if (deleteOldFile)
+                saveTimer.Change(save_delay, Timeout.Infinite);
+        }
+
+        private Dictionary<string, Dictionary<string, PerfectPerformanceValue>> load()
+        {
+            var result = new Dictionary<string, Dictionary<string, PerfectPerformanceValue>>();
+
+            try
+            {
+                if (storage.Exists(filename))
+                {
+                    var stored = read<Dictionary<string, Dictionary<string, double[]>>>(filename);
+
+                    foreach (var (setup, values) in stored ?? new Dictionary<string, Dictionary<string, double[]>>())
+                    {
+                        var target = result[setup] = new Dictionary<string, PerfectPerformanceValue>(values.Count);
+
+                        foreach (var (hash, value) in values)
+                        {
+                            if (tryCreate(value, out var parsed))
+                                target[hash] = parsed;
+                        }
+                    }
+                }
+                else if (storage.Exists(old_filename))
+                {
+                    // "<format>|<ruleset>|<difficulty version>|<beatmap hash>|<mods>" → setup "<format>|<ruleset>|<difficulty version>|<mods>", then hash.
+                    var stored = read<Dictionary<string, double[]>>(old_filename);
+
+                    foreach (var (key, value) in stored ?? new Dictionary<string, double[]>())
+                    {
+                        string[] parts = key.Split('|', 5);
+
+                        if (parts.Length != 5 || !tryCreate(value, out var parsed))
+                            continue;
+
+                        string setup = $"{parts[0]}|{parts[1]}|{parts[2]}|{parts[4]}";
+
+                        if (!result.TryGetValue(setup, out var target))
+                            result[setup] = target = new Dictionary<string, PerfectPerformanceValue>();
+
+                        target[parts[3]] = parsed;
+                    }
+
+                    dirty = deleteOldFile = true;
+                    Logger.Log($"Perfect-play PP cache converted to the new format: {result.Sum(s => s.Value.Count)} entries");
+                }
+
+                Logger.Log($"Perfect-play PP cache loaded: {result.Sum(s => s.Value.Count)} entries");
+                return result;
+            }
+            catch (Exception e)
+            {
+                Logger.Error(e, "Failed to load the perfect-play PP cache, starting from scratch");
+                return new Dictionary<string, Dictionary<string, PerfectPerformanceValue>>();
+            }
+        }
+
+        private T? read<T>(string file)
+            where T : class
+        {
+            using var stream = storage.GetStream(file, FileAccess.Read, FileMode.Open);
+            using var reader = new StreamReader(stream);
+            using var json = new JsonTextReader(reader);
+
+            return JsonSerializer.CreateDefault().Deserialize<T>(json);
+        }
+
+        private static bool tryCreate(double[]? stored, out PerfectPerformanceValue value)
+        {
+            if (stored != null && stored.Length == 2 && isValid(stored[0]) && isValid(stored[1]))
+            {
+                value = round(new PerfectPerformanceValue(stored[0], stored[1]));
+                return true;
+            }
+
+            value = default;
+            return false;
+        }
+
+        private static PerfectPerformanceValue round(PerfectPerformanceValue value)
+            => new PerfectPerformanceValue(Math.Round(value.Performance, 2), Math.Round(value.StarRating, 3));
+
+        /// <summary>
+        /// The values of one setup (created empty when there are none yet). Only use it while holding <see cref="sync"/>.
+        /// </summary>
+        private Dictionary<string, PerfectPerformanceValue> getSetup(string setup)
+        {
+            lock (sync)
+            {
+                if (!setups.TryGetValue(setup, out var values))
+                    setups[setup] = values = new Dictionary<string, PerfectPerformanceValue>();
+
+                return values;
+            }
+        }
+
+        private bool tryGet(Dictionary<string, PerfectPerformanceValue> values, string hash, out PerfectPerformanceValue value)
+        {
+            lock (sync)
+                return values.TryGetValue(hash, out value);
+        }
+
+        private void set(Dictionary<string, PerfectPerformanceValue> values, string hash, PerfectPerformanceValue value)
+        {
+            if (!isValid(value.Performance) || !isValid(value.StarRating))
+                return;
+
+            lock (sync)
+            {
+                values[hash] = round(value);
+
+                if (!dirty)
+                {
+                    dirty = true;
+                    saveTimer.Change(save_delay, Timeout.Infinite);
+                }
+            }
+        }
+
+        /// <summary>
+        /// Writes pending changes to disk.
+        /// </summary>
+        public void Save()
+        {
+            lock (writeLock)
+            {
+                List<(string Setup, KeyValuePair<string, PerfectPerformanceValue>[] Values)> snapshot;
+
+                lock (sync)
+                {
+                    if (!dirty)
+                        return;
+
+                    dirty = false;
+                    saveTimer.Change(Timeout.Infinite, Timeout.Infinite);
+                    snapshot = setups.Where(s => s.Value.Count > 0).Select(s => (s.Key, s.Value.ToArray())).ToList();
+                }
+
+                try
+                {
+                    using (var stream = storage.CreateFileSafely(filename))
+                    using (var writer = new StreamWriter(stream))
+                        write(writer, snapshot);
+
+                    if (deleteOldFile)
+                    {
+                        deleteOldFile = false;
+                        storage.Delete(old_filename);
+                    }
+                }
+                catch (Exception e)
+                {
+                    Logger.Error(e, "Failed to save the perfect-play PP cache");
+                }
+            }
+        }
+
+        /// <summary>
+        /// Readable but compact: one line per beatmap.
+        /// </summary>
+        private static void write(TextWriter writer, List<(string Setup, KeyValuePair<string, PerfectPerformanceValue>[] Values)> snapshot)
+        {
+            writer.Write('{');
+
+            for (int i = 0; i < snapshot.Count; i++)
+            {
+                writer.Write(i == 0 ? "\n  " : ",\n  ");
+                writer.Write(JsonConvert.ToString(snapshot[i].Setup));
+                writer.Write(": {");
+
+                var values = snapshot[i].Values;
+
+                for (int j = 0; j < values.Length; j++)
+                {
+                    writer.Write(j == 0 ? "\n    " : ",\n    ");
+                    writer.Write(JsonConvert.ToString(values[j].Key));
+                    writer.Write(": [");
+                    writer.Write(values[j].Value.Performance.ToString("R", CultureInfo.InvariantCulture));
+                    writer.Write(", ");
+                    writer.Write(values[j].Value.StarRating.ToString("R", CultureInfo.InvariantCulture));
+                    writer.Write(']');
+                }
+
+                writer.Write("\n  }");
+            }
+
+            writer.Write("\n}\n");
+        }
+
+        private static bool isValid(double value) => double.IsFinite(value) && value >= 0;
+
+        public Lookup CreateLookup(BeatmapDifficultyCache difficultyCache, RulesetInfo? ruleset, IReadOnlyList<Mod>? mods) => new Lookup(this, difficultyCache, ruleset, mods);
+
+        /// <summary>
+        /// Looks up (or calculates) values for one ruleset and set of mods.
+        /// </summary>
+        internal sealed class Lookup
+        {
+            private readonly PerfectPerformanceCache cache;
+            private readonly BeatmapDifficultyCache difficultyCache;
+            private readonly RulesetInfo? ruleset;
+            private readonly Mod[] mods;
+            private readonly string modsKey;
+
+            /// <summary>
+            /// The setup's values per ruleset (only one, unless no ruleset was given and each beatmap uses its own).
+            /// </summary>
+            private readonly Dictionary<string, Dictionary<string, PerfectPerformanceValue>> setupValues = new Dictionary<string, Dictionary<string, PerfectPerformanceValue>>();
+
+            public Lookup(PerfectPerformanceCache cache, BeatmapDifficultyCache difficultyCache, RulesetInfo? ruleset, IReadOnlyList<Mod>? mods)
+            {
+                this.cache = cache;
+                this.difficultyCache = difficultyCache;
+                this.ruleset = ruleset;
+
+                this.mods = (mods ?? Array.Empty<Mod>()).Select(m => m.DeepClone()).ToArray();
+                modsKey = GetModsKey(this.mods);
+            }
+
+            private Dictionary<string, PerfectPerformanceValue>? getValues(BeatmapInfo beatmap)
+            {
+                if (string.IsNullOrEmpty(beatmap.Hash))
+                    return null;
+
+                RulesetInfo rulesetInfo = ruleset ?? beatmap.Ruleset;
+
+                lock (setupValues)
+                {
+                    if (!setupValues.TryGetValue(rulesetInfo.ShortName, out var values))
+                    {
+                        values = cache.getSetup($"{format_version}|{rulesetInfo.ShortName}|{getDifficultyVersion(rulesetInfo)}|{modsKey}");
+                        setupValues[rulesetInfo.ShortName] = values;
+                    }
+
+                    return values;
+                }
+            }
+
+            public bool TryGet(BeatmapInfo beatmap, out PerfectPerformanceValue value)
+            {
+                var values = getValues(beatmap);
+
+                if (values != null)
+                    return cache.tryGet(values, beatmap.Hash, out value);
+
+                value = default;
+                return false;
+            }
+
+            public PerfectPerformanceValue? Calculate(BeatmapInfo beatmap, CancellationToken cancellationToken)
+            {
+                cancellationToken.ThrowIfCancellationRequested();
+
+                if (TryGet(beatmap, out var cached))
+                    return cached;
+
+                var difficulty = difficultyCache.GetDifficultyAsync(beatmap, ruleset ?? beatmap.Ruleset, mods, cancellationToken).GetAwaiter().GetResult();
+
+                cancellationToken.ThrowIfCancellationRequested();
+
+                double? pp = difficulty?.PerformanceAttributes?.Total;
+
+                if (difficulty == null || pp == null || !isValid(pp.Value) || !isValid(difficulty.Value.Stars))
+                    return null;
+
+                var value = round(new PerfectPerformanceValue(pp.Value, difficulty.Value.Stars));
+
+                var values = getValues(beatmap);
+                if (values != null)
+                    cache.set(values, beatmap.Hash, value);
+
+                return value;
+            }
+        }
+    }
+}
diff --git a/osu.Game/Screens/Select/PerfectPerformanceSession.cs b/osu.Game/Screens/Select/PerfectPerformanceSession.cs
new file mode 100644
index 0000000000..40a20b6ffa
--- /dev/null
+++ b/osu.Game/Screens/Select/PerfectPerformanceSession.cs
@@ -0,0 +1,257 @@
+// Added by Patchsu
+
+// Patchsu: ported from Ritsu's PerfectPerformanceSession (Ritsu contributors, MIT).
+
+using System;
+using System.Collections.Generic;
+using System.Threading;
+using System.Threading.Tasks;
+using osu.Framework.Logging;
+using osu.Game.Beatmaps;
+
+namespace osu.Game.Screens.Select
+{
+    internal enum PerfectPerformanceState
+    {
+        /// <summary>
+        /// Queued for calculation.
+        /// </summary>
+        Pending,
+
+        Available,
+
+        /// <summary>
+        /// The calculation failed, or calculations are turned off and nothing was cached.
+        /// </summary>
+        Unavailable,
+    }
+
+    internal readonly record struct PerfectPerformanceResult(PerfectPerformanceState State, PerfectPerformanceValue Value = default)
+    {
+        public static readonly PerfectPerformanceResult UNAVAILABLE = new PerfectPerformanceResult(PerfectPerformanceState.Unavailable);
+    }
+
+    /// <summary>
+    /// Perfect-play PP for one filter setup (ruleset + mods). Values come from the cache straight away;
+    /// missing ones are calculated one by one in the background and reported through the <c>changed</c> callback.
+    /// </summary>
+    internal sealed class PerfectPerformanceSession : IDisposable
+    {
+        private readonly object sync = new object();
+        private readonly Dictionary<Guid, PerfectPerformanceResult> results = new Dictionary<Guid, PerfectPerformanceResult>();
+
+        /// <summary>
+        /// The beatmap file each result is for: the session lives across filter changes, so an edited beatmap is looked up again.
+        /// </summary>
+        private readonly Dictionary<Guid, string> resultHashes = new Dictionary<Guid, string>();
+        private readonly Queue<BeatmapInfo> queue = new Queue<BeatmapInfo>();
+        private readonly CancellationTokenSource cancellation = new CancellationTokenSource();
+
+        private readonly Func<BeatmapInfo, PerfectPerformanceValue?> tryCached;
+        private readonly Func<BeatmapInfo, CancellationToken, PerfectPerformanceValue?> calculate;
+        private readonly Action flush;
+        private readonly Action<PerfectPerformanceSession> changed;
+        private readonly bool allowCalculations;
+
+        private bool running;
+        private int completed;
+        private int failures;
+
+        public PerfectPerformanceSession(PerfectPerformanceCache.Lookup lookup, Action flush, Action<PerfectPerformanceSession> changed, bool allowCalculations)
+            : this(b => lookup.TryGet(b, out var value) ? value : null, lookup.Calculate, flush, changed, allowCalculations)
+        {
+        }
+
+        public PerfectPerformanceSession(Func<BeatmapInfo, PerfectPerformanceValue?> tryCached, Func<BeatmapInfo, CancellationToken, PerfectPerformanceValue?> calculate,
+                                         Action flush, Action<PerfectPerformanceSession> changed, bool allowCalculations)
+        {
+            this.tryCached = tryCached;
+            this.calculate = calculate;
+            this.flush = flush;
+            this.changed = changed;
+            this.allowCalculations = allowCalculations;
+        }
+
+        /// <summary>
+        /// Whether beatmaps are being calculated right now.
+        /// </summary>
+        public bool IsCalculating
+        {
+            get
+            {
+                lock (sync)
+                    return running;
+            }
+        }
+
+        /// <summary>
+        /// How many of the beatmaps asked for so far have a final result (available or not).
+        /// </summary>
+        public (int completed, int total) Progress
+        {
+            get
+            {
+                lock (sync)
+                    return (completed, results.Count);
+            }
+        }
+
+        public PerfectPerformanceResult Get(BeatmapInfo beatmap)
+        {
+            lock (sync)
+            {
+                if (results.TryGetValue(beatmap.ID, out var existing))
+                {
+                    if (existing.State == PerfectPerformanceState.Pending || resultHashes.GetValueOrDefault(beatmap.ID) == beatmap.Hash)
+                        return existing;
+
+                    // The beatmap changed since (edited and saved): look it up again.
+                    results.Remove(beatmap.ID);
+                    completed--;
+                }
+
+                resultHashes[beatmap.ID] = beatmap.Hash;
+
+                if (cancellation.IsCancellationRequested)
+                    return PerfectPerformanceResult.UNAVAILABLE;
+
+                PerfectPerformanceValue? cached;
+
+                try
+                {
+                    cached = tryCached(beatmap);
+                }
+                catch (Exception e)
+                {
+                    if (failures++ < 5)
+                        Logger.Error(e, $"Perfect-play PP cache lookup failed for beatmap {beatmap.ID}");
+
+                    cached = null;
+                }
+
+                if (cached != null)
+                {
+                    completed++;
+                    return results[beatmap.ID] = new PerfectPerformanceResult(PerfectPerformanceState.Available, cached.Value);
+                }
+
+                if (!allowCalculations)
+                {
+                    completed++;
+                    return results[beatmap.ID] = PerfectPerformanceResult.UNAVAILABLE;
+                }
+
+                var pending = new PerfectPerformanceResult(PerfectPerformanceState.Pending);
+                results[beatmap.ID] = pending;
+                queue.Enqueue(beatmap);
+
+                if (!running)
+                {
+                    running = true;
+                    changed(this);
+                    Task.Run(run);
+                }
+
+                return pending;
+            }
+        }
+
+        private void run()
+        {
+            int sinceLastReport = 0;
+
+            try
+            {
+                while (true)
+                {
+                    BeatmapInfo beatmap;
+
+                    lock (sync)
+                    {
+                        cancellation.Token.ThrowIfCancellationRequested();
+
+                        if (queue.Count == 0)
+                        {
+                            running = false;
+                            break;
+                        }
+
+                        beatmap = queue.Dequeue();
+                    }
+
+                    PerfectPerformanceValue? value;
+
+                    try
+                    {
+                        value = calculate(beatmap, cancellation.Token);
+                    }
+                    catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
+                    {
+                        throw;
+                    }
+                    catch (Exception e)
+                    {
+                        if (failures < 5 && e is not OperationCanceledException)
+                            Logger.Error(e, $"Perfect-play PP calculation failed for beatmap {beatmap.ID}");
+
+                        value = null;
+                    }
+
+                    lock (sync)
+                    {
+                        results[beatmap.ID] = value != null
+                            ? new PerfectPerformanceResult(PerfectPerformanceState.Available, value.Value)
+                            : PerfectPerformanceResult.UNAVAILABLE;
+
+                        completed++;
+                        if (value == null)
+                            failures++;
+                    }
+
+                    if (++sinceLastReport >= 5)
+                    {
+                        sinceLastReport = 0;
+                        changed(this);
+                    }
+                }
+
+                changed(this);
+            }
+            catch (OperationCanceledException)
+            {
+            }
+            catch (Exception e)
+            {
+                Logger.Error(e, "Perfect-play PP calculation stopped");
+
+                lock (sync)
+                {
+                    running = false;
+
+                    foreach (var id in new List<Guid>(results.Keys))
+                    {
+                        if (results[id].State != PerfectPerformanceState.Pending)
+                            continue;
+
+                        results[id] = PerfectPerformanceResult.UNAVAILABLE;
+                        completed++;
+                    }
+
+                    queue.Clear();
+                }
+
+                changed(this);
+            }
+            finally
+            {
+                flush();
+            }
+        }
+
+        public void Dispose()
+        {
+            cancellation.Cancel();
+            Task.Run(flush);
+        }
+    }
+}
