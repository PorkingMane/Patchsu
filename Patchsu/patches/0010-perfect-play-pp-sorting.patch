+namespace osu.Game.Screens.Select
+{
+    /// <summary>
+    /// Settings → Patchsu → "Patch 10. PP aware beatmap carousel".
+    /// </summary>
+    public partial class PerfectPerformanceSettings : PatchSettingsSubsection
+    {
+        public override int PatchNumber => 10;
+
+        protected override string Summary => @"PP aware beatmap carousel";
