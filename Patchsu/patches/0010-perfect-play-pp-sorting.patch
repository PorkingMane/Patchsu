+// Added by Patchsu
+
+// Patchsu: perfect-play PP options in song select ("PP max" range, "PP step", "PP calc"), ported from Ritsu.
+// The row is hidden until "Show converts" is right-clicked.
+
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using osu.Framework.Allocation;
+using osu.Framework.Bindables;
+using osu.Framework.Extensions.Color4Extensions;
+using osu.Framework.Graphics;
+using osu.Framework.Graphics.Colour;
+using osu.Framework.Graphics.Containers;
+using osu.Framework.Graphics.Primitives;
+using osu.Framework.Graphics.Shapes;
+using osu.Framework.Input.Events;
+using osu.Framework.Layout;
+using osu.Framework.Localisation;
+using osu.Framework.Threading;
+using osu.Framework.Utils;
+using osu.Game.Configuration;
+using osu.Game.Graphics;
+using osu.Game.Graphics.UserInterface;
+using osu.Game.Graphics.UserInterfaceV2;
+using osu.Game.Overlays;
+using osu.Game.Rulesets.Mods;
+using osu.Game.Screens.Select.Filter;
+using osu.Game.Utils;
+using osuTK.Graphics;
+using osuTK.Input;
+
+namespace osu.Game.Screens.Select
+{
+    public sealed partial class FilterControl
+    {
+        /// <summary>
+        /// The top of the "PP max" range, unless the cap is removed (Settings → Patchsu → Patch 10).
+        /// Above it, the top nub reads "1,000+" and PP groups end with one "1,000+ pp" group.
+        /// </summary>
+        private const double performance_cap = 1000;
+
+        private const double uncapped_max_performance = 3000;
+
+        private PerformanceOptionsRow performanceOptions = null!;
+        private PerformanceRangeSlider performanceRangeSlider = null!;
+        private ShearedDropdown<int> performanceIntervalDropdown = null!;
+        private PerformanceCalculationButton performanceCalculationToggle = null!;
+
+        private readonly BindableDouble minimumPerformance = new BindableDouble
+        {
+            MinValue = 0,
+            MaxValue = performance_cap,
+            Precision = 10,
+        };
+
+        private readonly BindableDouble maximumPerformance = new BindableDouble(performance_cap)
+        {
+            MinValue = 0,
+            MaxValue = performance_cap,
+            Precision = 10,
+        };
+
+        private readonly Bindable<bool> performanceUncapped = new Bindable<bool>();
+
+        private ModSettingChangeTracker? performanceModSettingTracker;
+        private ScheduledDelegate? performanceModSettingDebounce;
+
+        private bool performanceOptionsVisible => performanceOptions.State.Value == Visibility.Visible;
+
+        private bool performanceCriteriaActive => BeatmapCarousel.UsesPerfectPerformance(currentCriteria);
+
+        private Drawable createPerformanceOptions() => performanceOptions = new PerformanceOptionsRow
+        {
+            RelativeSizeAxes = Axes.X,
+            Shear = -OsuGame.SHEAR,
+            Child = new GridContainer
+            {
+                RelativeSizeAxes = Axes.X,
+                Height = PerformanceOptionsRow.ROW_HEIGHT,
+                ColumnDimensions = new[]
+                {
+                    new Dimension(),
+                    new Dimension(GridSizeMode.Absolute, 5),
+                    new Dimension(GridSizeMode.Absolute, 140),
+                    new Dimension(GridSizeMode.Absolute, 5),
+                    // As wide as "Show converts" above it, so both buttons sit on the same slanted lines.
+                    new Dimension(GridSizeMode.AutoSize),
+                },
+                Content = new[]
+                {
+                    new Drawable[]
+                    {
+                        performanceRangeSlider = new PerformanceRangeSlider
+                        {
+                            RelativeSizeAxes = Axes.X,
+                            LowerBound = minimumPerformance,
+                            UpperBound = maximumPerformance,
+                            MinRange = 10,
+                        },
+                        Empty(),
+                        performanceIntervalDropdown = new ShearedDropdown<int>("PP step")
+                        {
+                            RelativeSizeAxes = Axes.X,
+                            Items = new[] { 10, 20, 50, 100, 200, 500, 1000 },
+                        },
+                        Empty(),
+                        performanceCalculationToggle = new PerformanceCalculationButton
+                        {
+                            // Placed and sized like "Show converts" in its column.
+                            Anchor = Anchor.Centre,
+                            Origin = Anchor.Centre,
+                            AutoSizeAxes = Axes.X,
+                            Height = 30,
+                            Text = "PP calc",
+                            TooltipText = "Calculate perfect-play PP for beatmaps. When off, only already calculated values are used.",
+                        },
+                    },
+                },
+            },
+        };
+
+        private void togglePerformanceOptions()
+        {
+            performanceOptions.ToggleVisibility();
+
+            // the "PP max" range only applies while it is shown.
+            if (!minimumPerformance.IsDefault || !maximumPerformance.IsDefault)
+                updateCriteria();
+        }
+
+        private void bindPerformanceOptions(Action debouncedUpdateCriteria)
+        {
+            config.BindWith(OsuSetting.SongSelectPerformanceGroupInterval, performanceIntervalDropdown.Current);
+            config.BindWith(OsuSetting.SongSelectCalculatePerformance, performanceCalculationToggle.Active);
+            performanceCalculationToggle.WidthReference = (ShowConvertsButton)showConvertedBeatmapsButton;
+            config.BindWith(OsuSetting.SongSelectPerformanceUncapped, performanceUncapped);
+
+            applyPerformanceCap(performanceUncapped.Value);
+            performanceUncapped.BindValueChanged(u =>
+            {
+                applyPerformanceCap(u.NewValue);
+
+                if (currentCriteria.Group == GroupMode.PerformancePoints)
+                    updateCriteria();
+            });
+
+            minimumPerformance.BindValueChanged(_ => debouncedUpdateCriteria());
+            maximumPerformance.BindValueChanged(_ => debouncedUpdateCriteria());
+            performanceIntervalDropdown.Current.BindValueChanged(_ =>
+            {
+                if (currentCriteria.Group == GroupMode.PerformancePoints)
+                    updateCriteria();
+            });
+            performanceCalculationToggle.Active.BindValueChanged(_ =>
+            {
+                if (performanceCriteriaActive)
+                    updateCriteria();
+            });
+
+            // perfect-play PP depends on every mod (and its settings), not only the ones that change star rating.
+            mods.BindValueChanged(m =>
+            {
+                trackPerformanceModSettings(m.NewValue);
+
+                if (m.NewValue.SequenceEqual(m.OldValue) || !performanceCriteriaActive)
+                    return;
+
+                // already updated by the main mods handler.
+                if (currentCriteria.RulesetCriteria?.FilterMayChangeFromMods(currentCriteria, m) == true)
+                    return;
+
+                updateCriteria();
+            }, true);
+        }
+
+        private void applyPerformanceCap(bool uncapped)
+        {
+            double max = uncapped ? uncapped_max_performance : performance_cap;
+            bool upperWasDefault = maximumPerformance.IsDefault;
+
+            // lowering the maximum clamps both values (a range above the cap ends at it).
+            minimumPerformance.MaxValue = max;
+            maximumPerformance.MaxValue = max;
+            maximumPerformance.Default = max;
+
+            if (upperWasDefault)
+                maximumPerformance.SetDefault();
+
+            performanceRangeSlider.Capped = !uncapped;
+        }
+
+        private void trackPerformanceModSettings(IReadOnlyList<Mod> currentMods)
+        {
+            performanceModSettingTracker?.Dispose();
+            performanceModSettingTracker = new ModSettingChangeTracker(currentMods);
+            performanceModSettingTracker.SettingChanged += _ =>
+            {
+                if (!performanceCriteriaActive)
+                    return;
+
+                // settings can change very often (e.g. while dragging a rate slider).
+                performanceModSettingDebounce?.Cancel();
+                performanceModSettingDebounce = Scheduler.AddDelayed(() => updateCriteria(), 300);
+            };
+        }
+
+        private void applyPerformanceCriteria(FilterCriteria criteria)
+        {
+            criteria.PerformanceGroupInterval = performanceIntervalDropdown.Current.Value;
+            criteria.CalculateMapPerformance = performanceCalculationToggle.Active.Value;
+            criteria.PerformanceGroupCap = performanceUncapped.Value ? null : performance_cap;
+
+            if (!performanceOptionsVisible)
+                return;
+
+            if (!minimumPerformance.IsDefault)
+                criteria.UserPerformance.Min = minimumPerformance.Value;
+
+            if (!maximumPerformance.IsDefault)
+                criteria.UserPerformance.Max = maximumPerformance.Value;
+        }
+
+        private void disposePerformanceOptions()
+        {
+            performanceModSettingTracker?.Dispose();
+        }
+
+        /// <summary>
+        /// Slides open and closed (the rows below move with it) instead of jumping.
+        /// </summary>
+        private partial class PerformanceOptionsRow : VisibilityContainer
+        {
+            public const float ROW_HEIGHT = 30;
+
+            /// <summary>
+            /// The filter rows' spacing: the row starts this far up while closed, so it takes no room at all.
+            /// </summary>
+            private const float spacing = 5;
+
+            private const double duration = 300;
+
+            /// <summary>
+            /// How far the clip reaches past the row's sides, so the sheared ends (and the nubs' glow) aren't cut off while it moves.
+            /// </summary>
+            private const float side_bleed = 30;
+
+            private readonly Container clip;
+
+            protected override Container<Drawable> Content { get; }
+
+            public PerformanceOptionsRow()
+            {
+                // Stays in the flow while closed (at zero height), so opening and closing can be animated.
+                AlwaysPresent = true;
+                Height = 0;
+                Margin = new MarginPadding { Top = -spacing };
+
+                // Clips only top and bottom: as wide as the row plus some room on both sides (its width is set in Update:
+                // a negative margin moves a relatively sized container but doesn't widen it, which made the row 60 narrower).
+                InternalChild = clip = new Container
+                {
+                    RelativeSizeAxes = Axes.Y,
+                    X = -side_bleed,
+                    Padding = new MarginPadding { Horizontal = side_bleed },
+                    Child = Content = new Container
+                    {
+                        RelativeSizeAxes = Axes.X,
+                        AutoSizeAxes = Axes.Y,
+                        Padding = new MarginPadding { Top = spacing },
+                    },
+                };
+            }
+
+            // The filter flow takes each row's size from its bounding box, which is never negative. Under a quarter open,
+            // this row's layout height (its height minus the spacing pulled back by the margin) is negative,
+            // so it would count as a gap instead of taking the spacing back. Report the real (negative) height.
+            public override RectangleF BoundingBox
+            {
+                get
+                {
+                    RectangleF box = base.BoundingBox;
+                    return DrawHeight < spacing ? new RectangleF(box.X, box.Bottom, box.Width, -box.Height) : box;
+                }
+            }
+
+            protected override void Update()
+            {
+                base.Update();
+
+                float width = DrawWidth + side_bleed * 2;
+
+                if (clip.Width != width)
+                    clip.Width = width;
+            }
+
+            // Closed (even while fading out), it takes no clicks or keys.
+            public override bool PropagatePositionalInputSubTree => State.Value == Visibility.Visible && base.PropagatePositionalInputSubTree;
+
+            public override bool PropagateNonPositionalInputSubTree => State.Value == Visibility.Visible && base.PropagateNonPositionalInputSubTree;
+
+            protected override void PopIn()
+            {
+                // Clipped only while it moves, so the PP step dropdown can open past it.
+                clip.Masking = true;
+                this.ResizeHeightTo(ROW_HEIGHT + spacing, duration, Easing.OutQuint).OnComplete(_ => clip.Masking = false);
+                this.FadeIn(duration, Easing.OutQuint);
+            }
+
+            protected override void PopOut()
+            {
+                clip.Masking = true;
+                this.ResizeHeightTo(0, duration, Easing.OutQuint);
+                this.FadeOut(duration, Easing.OutQuint);
+            }
+        }
+
+        /// <summary>
+        /// "Show converts", which also opens the PP options on right-click.
+        /// </summary>
+        private partial class ShowConvertsButton : ShearedToggleButton
+        {
+            public Action? RightClickAction { get; init; }
+
+            /// <summary>
+            /// The width of the text and its margins, unscaled (pressing a sheared button scales it down).
+            /// </summary>
+            public float TextWidth => ButtonContent.DrawWidth;
+
+            public ShowConvertsButton()
+            {
+                TooltipText = "Right clickable";
+            }
+
+            protected override bool OnMouseDown(MouseDownEvent e)
+            {
+                if (e.Button == MouseButton.Right && RightClickAction != null)
+                {
+                    RightClickAction();
+                    return true;
+                }
+
+                return base.OnMouseDown(e);
+            }
+        }
+
+        /// <summary>
+        /// "PP calc": as wide as "Show converts" (whose text can be longer, e.g. in another language), and sized by its content like it,
+        /// so holding it down shrinks it with an ease and its column (the "PP max" range widens) follows, as with "Show converts".
+        /// </summary>
+        private partial class PerformanceCalculationButton : ShearedToggleButton
+        {
+            public ShowConvertsButton? WidthReference { get; set; }
+
+            protected override void Update()
+            {
+                base.Update();
+
+                if (WidthReference == null)
+                    return;
+
+                // Pads the text out to the reference's unscaled text width, so pressing either button doesn't resize the other.
+                float padding = Math.Max(0, WidthReference.TextWidth - (ButtonContent.DrawWidth - ButtonContent.Padding.TotalHorizontal)) / 2;
+
+                if (ButtonContent.Padding.Left != padding)
+                    ButtonContent.Padding = new MarginPadding { Horizontal = padding };
+            }
+        }
+
+        private partial class PerformanceRangeSlider : ShearedRangeSlider
+        {
+            // the star rating bar's colours, spread over the whole PP range.
+            private static readonly (float, Color4)[] spectrum = OsuColour.STAR_DIFFICULTY_SPECTRUM
+                                                                          .Skip(1)
+                                                                          .Prepend((0.0f, OsuColour.STAR_DIFFICULTY_SPECTRUM.ElementAt(1).Item2)).ToArray();
+
+            private Container borderContainer = null!;
+            private readonly LayoutValue drawSizeLayout = new LayoutValue(Invalidation.DrawSize);
+
+            private bool capped = true;
+
+            /// <summary>
+            /// Whether the top of the range is the 1,000 pp cap (the top nub then reads "1,000+" instead of "∞").
+            /// </summary>
+            public bool Capped
+            {
+                get => capped;
+                set
+                {
+                    if (capped == value)
+                        return;
+
+                    capped = value;
+
+                    if (IsLoaded)
+                        ((PerformanceBoundSliderBar)UpperBoundSlider).RefreshDisplay();
+                }
+            }
+
+            public PerformanceRangeSlider()
+                : base("PP max")
+            {
+                NubWidth = 62;
+                AddLayout(drawSizeLayout);
+            }
+
+            [BackgroundDependencyLoader]
+            private void load(OverlayColourProvider colourProvider)
+            {
+                SliderContainer.AddRange(new Drawable[]
+                {
+                    new Container
+                    {
+                        Depth = 1,
+                        RelativeSizeAxes = Axes.Both,
+                        Shear = OsuGame.SHEAR,
+                        CornerRadius = 5,
+                        Masking = true,
+                        ChildrenEnumerable = spectrum.Zip(spectrum.Skip(1))
+                                                     .Select(p => new Box
+                                                     {
+                                                         RelativePositionAxes = Axes.X,
+                                                         X = p.First.Item1 / 10f,
+                                                         RelativeSizeAxes = Axes.Both,
+                                                         Width = (p.Second.Item1 - p.First.Item1) / 10f,
+                                                         Colour = ColourInfo.GradientHorizontal(p.First.Item2, p.Second.Item2),
+                                                     }),
+                    },
+                    borderContainer = new Container
+                    {
+                        Depth = -1,
+                        RelativePositionAxes = Axes.X,
+                        RelativeSizeAxes = Axes.Both,
+                        Child = new Container
+                        {
+                            RelativeSizeAxes = Axes.Both,
+                            BorderColour = colourProvider.Highlight1,
+                            BorderThickness = 2,
+                            Masking = true,
+                            Shear = OsuGame.SHEAR,
+                            CornerRadius = 5,
+                            Child = new Box
+                            {
+                                Colour = Color4.Transparent,
+                                RelativeSizeAxes = Axes.Both,
+                            },
+                        },
+                    },
+                });
+            }
+
+            protected override void LoadComplete()
+            {
+                base.LoadComplete();
+
+                LowerBoundSlider.Current.ValueChanged += _ => updateBorder(false);
+                UpperBoundSlider.Current.ValueChanged += _ => updateBorder(false);
+            }
+
+            protected override void UpdateAfterChildren()
+            {
+                base.UpdateAfterChildren();
+
+                if (!drawSizeLayout.IsValid)
+                {
+                    updateBorder(true);
+                    drawSizeLayout.Validate();
+                }
+            }
+
+            private void updateBorder(bool instant)
+            {
+                if (LowerBoundSlider.DrawWidth <= 0 || UpperBoundSlider.DrawWidth <= 0)
+                    return;
+
+                float start = LowerBoundSlider.NormalizedValue * LowerBoundSlider.UsableWidth / LowerBoundSlider.DrawWidth;
+                float end = (UpperBoundSlider.NormalizedValue * UpperBoundSlider.UsableWidth + UpperBoundSlider.NubWidth) / UpperBoundSlider.DrawWidth;
+
+                borderContainer.MoveToX(start, instant ? 0 : 250, Easing.OutQuint);
+                borderContainer.ResizeWidthTo(end - start, instant ? 0 : 250, Easing.OutQuint);
+            }
+
+            protected override BoundSliderBar CreateBoundSlider(bool isUpper) => new PerformanceBoundSliderBar(this, isUpper);
+
+            private partial class PerformanceBoundSliderBar : BoundSliderBar
+            {
+                private readonly PerformanceRangeSlider slider;
+                private readonly bool isUpper;
+
+                protected override bool FocusIndicator => false;
+
+                private bool unlimited => Current.IsDefault && isUpper;
+
+                public override LocalisableString TooltipText => unlimited ? (slider.Capped ? $"No limit ({Current.Value:N0} pp and above)" : "No limit") : $"{Current.Value:N0} pp";
+
+                [Resolved]
+                private OsuColour colours { get; set; } = null!;
+
+                public PerformanceBoundSliderBar(PerformanceRangeSlider slider, bool isUpper)
+                    : base(slider, isUpper)
+                {
+                    this.slider = slider;
+                    this.isUpper = isUpper;
+                }
+
+                public void RefreshDisplay() => UpdateDisplay(Current.Value);
+
+                protected override void LoadComplete()
+                {
+                    base.LoadComplete();
+
+                    if (isUpper)
+                    {
+                        LeftBox.Colour = OsuColour.Gray(0.4f).Opacity(0.2f);
+                        RightBox.Colour = OsuColour.Gray(0.05f).Opacity(0.7f);
+                    }
+                    else
+                    {
+                        LeftBox.Colour = OsuColour.Gray(0.05f).Opacity(0.7f);
+                        RightBox.Colour = OsuColour.Gray(0.4f).Opacity(0.2f);
+                    }
+                }
+
+                protected override void UpdateDisplay(double value)
+                {
+                    // coloured like the star rating nubs: by where the nub sits on the bar.
+                    double maxValue = Current is BindableNumber<double> number ? number.MaxValue : performance_cap;
+                    double stars = maxValue > 0 ? value / maxValue * 10 : 0;
+
+                    Colour4 nubColour = ColourUtils.SampleFromLinearGradient(spectrum, (float)Math.Round(stars, 2, MidpointRounding.AwayFromZero));
+
+                    if (stars >= 7.5 && stars < 8.0)
+                        nubColour = Interpolation.ValueAt<Colour4>(stars, nubColour, colours.Gray4, 7.5, 8.0);
+                    else if (stars >= 8.0)
+                        nubColour = colours.Gray4;
+
+                    Nub.AccentColour = nubColour;
+                    Nub.GlowingAccentColour = nubColour.Lighten(0.1f);
+                    Nub.ShadowColour = Color4.Black.Opacity(0.2f);
+                    NubText.Colour = colours.ForStarDifficultyText(stars);
+
+                    base.UpdateDisplay(value);
+
+                    if (unlimited)
+                    {
+                        NubText.Text = slider.Capped ? $"{value:N0}+" : "∞";
+                        NubText.Colour = OsuColour.ForegroundTextColourFor(nubColour);
+                    }
+                    else
+                        NubText.Text = value.ToString("N0");
+                }
+            }
+        }
+    }
+}
