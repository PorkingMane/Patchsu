@@ -0,0 +1,169 @@
+// Added by Patchsu
+
+// Patchsu: perfect-play PP for sorting / grouping / filtering (ported from Ritsu).
+
+using System;
+using osu.Framework.Allocation;
+using osu.Framework.Platform;
+using osu.Framework.Threading;
+using osu.Game.Beatmaps;
+using osu.Game.Screens.Select.Filter;
+
+namespace osu.Game.Screens.Select
+{
+    public partial class BeatmapCarousel
+    {
+        [Resolved(CanBeNull = true)]
+        private BeatmapDifficultyCache? perfectPerformanceDifficultyCache { get; set; }
+
+        [Resolved(CanBeNull = true)]
+        private Storage? perfectPerformanceStorage { get; set; }
+
+        private PerfectPerformanceSession? performanceSession;
+
+        /// <summary>
+        /// What <see cref="performanceSession"/> calculates for (ruleset, mods, whether it may calculate): filter changes that keep these
+        /// (search text, ranges, collections, sorting) keep the session, with everything it already looked up or calculated.
+        /// </summary>
+        private string? performanceSessionSetup;
+
+        /// <summary>
+        /// While calculating, song select is sorted / grouped / filtered again with the new values at most this often.
+        /// </summary>
+        private const double performance_refresh_interval = 3000;
+        private ScheduledDelegate? performanceRefresh;
+        private bool performanceSuspended;
+
+        /// <summary>
+        /// Raised when the perfect-play PP calculation progress changes (see <see cref="PerformanceProgressText"/>).
+        /// </summary>
+        public event Action? PerformanceProgressChanged;
+
+        /// <summary>
+        /// A status line while perfect-play PP is being calculated, otherwise <c>null</c>.
+        /// </summary>
+        public string? PerformanceProgressText
+        {
+            get
+            {
+                if (performanceSession == null)
+                    return null;
+
+                var (completed, total) = performanceSession.Progress;
+                return total > completed ? $"Calculating PP: {completed:N0} / {total:N0}" : null;
+            }
+        }
+
+        internal static bool UsesPerfectPerformance(FilterCriteria criteria)
+            => criteria.Sort is SortMode.PerformancePoints or SortMode.Farmability
+               || criteria.Group == GroupMode.PerformancePoints
+               || criteria.UserPerformance.HasFilter;
+
+        /// <summary>
+        /// Replaces the perfect-play PP session for new criteria (called on every <see cref="Filter"/>).
+        /// </summary>
+        private void updatePerformanceSession(FilterCriteria criteria)
+        {
+            bool used = perfectPerformanceDifficultyCache != null && perfectPerformanceStorage != null && UsesPerfectPerformance(criteria);
+            string? setup = used ? $"{criteria.Ruleset?.ShortName}|{PerfectPerformanceCache.GetModsKey(criteria.Mods)}|{criteria.CalculateMapPerformance}" : null;
+
+            if (performanceSession != null && setup == performanceSessionSetup)
+            {
+                criteria.PerformanceSession = performanceSession;
+                return;
+            }
+
+            stopPerformanceSession();
+
+            if (used)
+            {
+                var cache = PerfectPerformanceCache.For(perfectPerformanceStorage!);
+                var lookup = cache.CreateLookup(perfectPerformanceDifficultyCache!, criteria.Ruleset, criteria.Mods);
+                performanceSession = new PerfectPerformanceSession(lookup, cache.Save, performanceChanged, criteria.CalculateMapPerformance);
+                performanceSessionSetup = setup;
+            }
+
+            criteria.PerformanceSession = performanceSession;
+            PerformanceProgressChanged?.Invoke();
+        }
+
+        private void stopPerformanceSession()
+        {
+            performanceSession?.Dispose();
+            performanceSession = null;
+            performanceSessionSetup = null;
+            performanceRefresh?.Cancel();
+            performanceRefresh = null;
+        }
+
+        /// <summary>
+        /// Stops calculating while song select isn't the current screen (e.g. during gameplay).
+        /// </summary>
+        public void SuspendPerformanceCalculations()
+        {
+            if (performanceSession == null)
+                return;
+
+            performanceSuspended = true;
+            stopPerformanceSession();
+
+            if (Criteria != null)
+                Criteria.PerformanceSession = null;
+
+            PerformanceProgressChanged?.Invoke();
+        }
+
+        public void ResumePerformanceCalculations()
+        {
+            if (!performanceSuspended)
+                return;
+
+            performanceSuspended = false;
+
+            if (Criteria != null && performanceSession == null)
+                Filter(Criteria);
+        }
+
+        private void performanceChanged(PerfectPerformanceSession session) => Schedule(() =>
+        {
+            if (session != performanceSession || IsDisposed)
+                return;
+
+            PerformanceProgressChanged?.Invoke();
+
+            if (!session.IsCalculating)
+            {
+                // Done: show the final order soon instead of waiting out the interval.
+                performanceRefresh?.Cancel();
+                performanceRefresh = Scheduler.AddDelayed(refreshPerformance, 250);
+                return;
+            }
+
+            performanceRefresh ??= Scheduler.AddDelayed(refreshPerformance, performance_refresh_interval);
+        });
+
+        private void refreshPerformance()
+        {
+            performanceRefresh = null;
+
+            if (performanceSession == null || IsDisposed)
+                return;
+
+            if (IsFiltering)
+            {
+                performanceRefresh = Scheduler.AddDelayed(refreshPerformance, 250);
+                return;
+            }
+
+            // re-run matching / sorting / grouping with the values calculated so far.
+            FilterAsync();
+            PerformanceProgressChanged?.Invoke();
+        }
+
+        protected override void Dispose(bool isDisposing)
+        {
+            stopPerformanceSession();
+            base.Dispose(isDisposing);
+        }
+    }
+}
