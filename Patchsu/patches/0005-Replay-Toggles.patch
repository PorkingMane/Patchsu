@@ -0,0 +1,47 @@
+// Added by Patchsu
+
+using osu.Framework.Bindables;
+using osu.Framework.Graphics;
+using osu.Framework.Input.Events;
+using osu.Game.Graphics.UserInterface;
+using osu.Game.Rulesets.Mods;
+using osu.Game.Rulesets.UI;
+using osuTK.Graphics;
+
+namespace osu.Game.Screens.Play.HUD
+{
+    /// <summary>
+    /// Patchsu: a mod icon shown while watching a replay. Clicking it switches the mod's visual / audio effects off or back on
+    /// (the same as the checkbox in the replay's "Mod effects" settings); it is greyed out while switched off.
+    /// </summary>
+    public partial class ReplayToggleableModIcon : ModIcon
+    {
+        private static readonly Color4 switched_off_colour = new Color4(0.45f, 0.45f, 0.45f, 1);
+
+        private readonly BindableBool effectsEnabled = new BindableBool(true);
+
+        public ReplayToggleableModIcon(Mod mod, BindableBool effectsEnabled, bool showExtendedInformation = true)
+            : base(mod, showExtendedInformation: showExtendedInformation)
+        {
+            this.effectsEnabled.BindTo(effectsEnabled);
+
+            AddInternal(new HoverClickSounds());
+        }
+
+        protected override void LoadComplete()
+        {
+            base.LoadComplete();
+
+            Colour = colourFor(effectsEnabled.Value);
+            effectsEnabled.BindValueChanged(e => this.FadeColour(colourFor(e.NewValue), 200, Easing.OutQuint));
+        }
+
+        private static Color4 colourFor(bool enabled) => enabled ? Color4.White : switched_off_colour;
+
+        protected override bool OnClick(ClickEvent e)
+        {
+            effectsEnabled.Toggle();
+            return true;
+        }
+    }
+}
