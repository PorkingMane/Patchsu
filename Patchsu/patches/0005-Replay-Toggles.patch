diff --git a/osu.Game/Rulesets/Mods/IToggleableInReplay.cs b/osu.Game/Rulesets/Mods/IToggleableInReplay.cs
new file mode 100644
index 0000000000..c442a73a07
--- /dev/null
+++ b/osu.Game/Rulesets/Mods/IToggleableInReplay.cs
@@ -0,0 +1,78 @@
+// Added by Patchsu
+
+using System;
+using System.Collections.Generic;
+using osu.Framework.Bindables;
+using osu.Game.Beatmaps;
+using osu.Game.Rulesets.UI;
+
+namespace osu.Game.Rulesets.Mods
+{
+    /// <summary>
+    /// Patchsu: a mod whose effects on what you see and hear can be switched off while watching a replay.
+    /// </summary>
+    /// <remarks>
+    /// Switching a mod off must only change presentation (visuals, audio, playback speed).
+    /// Judgements, scoring, the beatmap's hit objects and positions, and the replay itself are never touched,
+    /// so the replay still plays out exactly as it was recorded.
+    /// <para>
+    /// Mods that adjust the track (<see cref="IApplicableToTrack"/>) don't need to handle that part themselves:
+    /// the replay player cancels their speed and pitch changes on the track while they are switched off,
+    /// without touching the gameplay rate that judgements and spinners use.
+    /// </para>
+    /// </remarks>
+    public interface IToggleableInReplay : IApplicableMod
+    {
+        /// <summary>
+        /// Called on the update thread when the viewer switches the mod's effects on or off.
+        /// Every alive hit object has its state transforms refreshed right after this call.
+        /// </summary>
+        void SetReplayEffectsEnabled(bool enabled, ReplayModToggleContext context);
+    }
+
+    /// <summary>
+    /// Patchsu: provided (cached) by the replay player, so mod displays on screen can switch mod effects on and off.
+    /// </summary>
+    public interface IReplayModEffectToggles
+    {
+        /// <summary>
+        /// Whether <paramref name="mod"/>'s effects are switched on, or null if the mod can't be switched off.
+        /// Accepts the replay's own mod instances as well as any other instance of the same mod (e.g. from the global mod selection).
+        /// Setting the value switches the effects.
+        /// </summary>
+        BindableBool? GetEffectsEnabled(Mod mod);
+    }
+
+    /// <summary>
+    /// What a <see cref="IToggleableInReplay"/> mod can use while switching its effects.
+    /// </summary>
+    public sealed class ReplayModToggleContext
+    {
+        /// <summary>
+        /// The drawable ruleset playing the replay.
+        /// </summary>
+        public required DrawableRuleset DrawableRuleset { get; init; }
+
+        /// <summary>
+        /// The playable beatmap used for the replay (the same hit object instances the drawables use).
+        /// </summary>
+        public required IBeatmap PlayableBeatmap { get; init; }
+
+        /// <summary>
+        /// The mods of the replay (the gameplay instances).
+        /// </summary>
+        public required IReadOnlyList<Mod> Mods { get; init; }
+
+        /// <summary>
+        /// Whether a mod of the replay currently has its effects switched on.
+        /// </summary>
