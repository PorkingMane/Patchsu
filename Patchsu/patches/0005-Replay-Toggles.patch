diff --git a/osu.Game.Rulesets.Osu/Mods/OsuReplayHitObjectTiming.cs b/osu.Game.Rulesets.Osu/Mods/OsuReplayHitObjectTiming.cs
new file mode 100644
index 0000000000..8f684e4646
--- /dev/null
+++ b/osu.Game.Rulesets.Osu/Mods/OsuReplayHitObjectTiming.cs
@@ -0,0 +1,153 @@
+// Added by Patchsu
+
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Runtime.CompilerServices;
+using osu.Framework.Logging;
+using osu.Game.Beatmaps;
+using osu.Game.Rulesets.Mods;
+using osu.Game.Rulesets.Objects;
+using osu.Game.Rulesets.Osu.Objects;
+
+namespace osu.Game.Rulesets.Osu.Mods
+{
+    /// <summary>
+    /// Patchsu: a mod that changes how early hit objects appear or how fast they fade in (<see cref="OsuHitObject.TimePreempt"/> / <see cref="OsuHitObject.TimeFadeIn"/>).
+    /// When it is switched off in a replay, it calls <see cref="OsuReplayHitObjectTiming.Update"/> to put those values back.
+    /// </summary>
+    public interface IAdjustsOsuHitObjectTiming : IToggleableInReplay
+    {
+    }
+
+    /// <summary>
+    /// Patchsu: restores the approach timing of hit objects while mods that change it are switched off in a replay.
+    /// </summary>
+    /// <remarks>
+    /// The timing is looked up in a separate copy of the beatmap built without the switched-off mods, and copied onto the replay's hit objects.
+    /// Only <see cref="OsuHitObject.TimePreempt"/> and <see cref="OsuHitObject.TimeFadeIn"/> are copied: they only drive the drawables' transforms.
+    /// Positions (including stacking), hit windows and judgements are left exactly as they were, and object lifetimes keep their original
+    /// (earliest) start, so the same objects are alive and hittable as in the recorded play.
+    /// </remarks>
+    public static class OsuReplayHitObjectTiming
+    {
+        private static readonly ConditionalWeakTable<IBeatmap, State> states = new ConditionalWeakTable<IBeatmap, State>();
+
+        public static void Update(ReplayModToggleContext context)
+        {
+            var state = states.GetValue(context.PlayableBeatmap, b => new State(b));
+
+            var switchedOff = context.Mods.Where(m => m is IAdjustsOsuHitObjectTiming && !context.IsEnabled(m)).ToArray();
+
+            Timing[]? target;
+
+            if (switchedOff.Length == 0)
+                target = state.Original;
+            else
+            {
+                string key = string.Join(',', switchedOff.Select(m => m.Acronym));
+
+                if (!state.Cache.TryGetValue(key, out target))
+                {
+                    try
+                    {
+                        var beatmap = context.CreatePlayableBeatmap(context.Mods.Except(switchedOff));
+                        target = collect(beatmap, state);
+                    }
+                    catch (Exception e)
+                    {
+                        Logger.Error(e, "Could not compute hit object timing for the replay mod toggles.");
+                        target = null;
+                    }
+
+                    if (target == null)
+                        Logger.Log($"Replay mod toggles: hit object timing without {key} could not be matched to the replay's beatmap; keeping the current timing.");
+
+                    state.Cache[key] = target;
+                }
+            }
+
+            if (target == null)
+                return;
+
+            for (int i = 0; i < state.Objects.Length; i++)
+            {
+                state.Objects[i].TimePreempt = target[i].Preempt;
+                state.Objects[i].TimeFadeIn = target[i].FadeIn;
+            }
+        }
+
+        /// <summary>
+        /// Reads the timing of <paramref name="beatmap"/>'s objects for each of the replay's objects.
+        /// Top-level objects are matched by type and start time (so objects only one of the beatmaps has don't shift the rest),
+        /// nested objects by position within their parent. Objects without a match keep their original timing.
+        /// </summary>
+        private static Timing[]? collect(IBeatmap beatmap, State state)
+        {
+            var candidates = new Dictionary<(Type, long), Queue<OsuHitObject>>();
+
+            foreach (var h in beatmap.HitObjects.OfType<OsuHitObject>())
+            {
+                var key = (h.GetType(), (long)Math.Round(h.StartTime));
+                if (!candidates.TryGetValue(key, out var queue))
+                    candidates[key] = queue = new Queue<OsuHitObject>();
+                queue.Enqueue(h);
+            }
+
+            var timing = state.Original.ToArray();
+            int matched = 0;
+            int index = 0;
+
+            foreach (var h in state.TopLevel)
+            {
+                var replayObjects = flatten(new[] { h }).ToArray();
+
+                if (candidates.TryGetValue((h.GetType(), (long)Math.Round(h.StartTime)), out var queue) && queue.Count > 0)
+                {
+                    var other = flatten(new[] { queue.Dequeue() }).ToArray();
+
+                    if (other.Length == replayObjects.Length && other.Zip(replayObjects).All(p => p.First.GetType() == p.Second.GetType()))
+                    {
+                        for (int i = 0; i < other.Length; i++)
+                            timing[index + i] = new Timing(other[i].TimePreempt, other[i].TimeFadeIn);
+
+                        matched++;
+                    }
+                }
+
+                index += replayObjects.Length;
+            }
+
+            return matched == 0 ? null : timing;
+        }
+
+        private static IEnumerable<OsuHitObject> flatten(IEnumerable<HitObject> hitObjects)
+        {
+            foreach (var h in hitObjects)
+            {
+                if (h is OsuHitObject osuObject)
+                    yield return osuObject;
+
+                foreach (var nested in flatten(h.NestedHitObjects))
+                    yield return nested;
+            }
+        }
+
+        private readonly record struct Timing(double Preempt, double FadeIn);
+
+        private class State
+        {
+            public readonly OsuHitObject[] TopLevel;
+            public readonly OsuHitObject[] Objects;
+            public readonly Timing[] Original;
+            public readonly Dictionary<string, Timing[]?> Cache = new Dictionary<string, Timing[]?>();
+
+            public State(IBeatmap beatmap)
+            {
+                TopLevel = beatmap.HitObjects.OfType<OsuHitObject>().ToArray();
+                Objects = flatten(TopLevel).ToArray();
+                Original = Objects.Select(o => new Timing(o.TimePreempt, o.TimeFadeIn)).ToArray();
+            }
+        }
+    }
+}
