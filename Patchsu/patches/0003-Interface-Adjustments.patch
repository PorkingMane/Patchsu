+                }),
+                new SettingsItemV2(new FormCheckBox
+                {
+                    Caption = @"Swap middle and right click on the music button",
+                    HintText = @"By default, middle-clicking the toolbar music button mutes the music and right-clicking muffles it.",
+                    Current = GetSwapMusicButtonClicks(),
+                }),
+            };
+        }
+    }
+}
