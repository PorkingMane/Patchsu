+    /// <summary>
+    /// Settings → Patchsu → "Patch 3. Interface Improvements".
+    /// </summary>
+    public partial class LocalInterfaceSettings : PatchSettingsSubsection
+    {
+        public override int PatchNumber => 3;
+
+        protected override string Summary => @"Interface Improvements";
+
+        public override IEnumerable<LocalisableString> FilterTerms => base.FilterTerms.Concat(new LocalisableString[] { @"skip", @"break", @"music", @"mute", @"duck" });
