@@ -63,6 +63,65 @@ protected override void Update()
                 if (drawableItem is DrawableOsuMenuItem osuItem)
                     osuItem.ShowCheckbox.Value = showCheckboxes;
             }
+
+            updateSide();
+        }
+
+        /// <summary>
+        /// Patchsu: whether this submenu is shown to the left of the item that opened it.
+        /// </summary>
+        private bool openedLeft;
+
+        /// <summary>
+        /// Patchsu: the framework picks each submenu's side by itself (right, unless only the left fits), so a narrow submenu
+        /// opened from one that went left jumps back to the right over its parents. Keep going left while it fits there.
+        /// A submenu with nested items that leaves no room on its right for them (guessed as its own width) opens left from the start,
+        /// so the whole chain goes one way instead of the nested ones flipping back over it.
+        /// Only <see cref="Drawable.X"/> of this menu is moved, so the framework's own placement stays valid.
+        /// </summary>
+        private void updateSide()
+        {
+            if (State != MenuState.Open || Parent is not Container<Menu> submenuContainer || submenuContainer.Parent is not OsuMenu parentMenu
+                || parentMenu.Direction != Direction.Vertical)
+                return;
+
+            bool frameworkLeft = (submenuContainer.Origin & Anchor.x2) != 0;
+            float offset = 0;
+
+            if (!frameworkLeft && (parentMenu.openedLeft || hasNestedItems()))
+            {
+                DrawableMenuItem triggeringItem = null;
+
+                foreach (var item in parentMenu.ItemsContainer)
+                {
+                    if (item.State == MenuItemState.Selected)
+                    {
+                        triggeringItem = item;
+                        break;
+                    }
+                }
+
+                var inputManager = GetContainingInputManager();
+
+                if (triggeringItem != null && inputManager != null && triggeringItem.ToSpaceOfOtherDrawable(new Vector2(-DrawWidth, 0), inputManager).X > 0
+                    && (parentMenu.openedLeft
+                        || triggeringItem.ToSpaceOfOtherDrawable(new Vector2(triggeringItem.DrawWidth + DrawWidth * 2, 0), inputManager).X > inputManager.DrawWidth))
+                    offset = -(triggeringItem.DrawWidth + DrawWidth);
+            }
+
+            X = offset;
+            openedLeft = frameworkLeft || offset < 0;
+        }
+
+        private bool hasNestedItems()
+        {
+            foreach (var item in ItemsContainer)
+            {
+                if (item.Item.Items.Count > 0)
+                    return true;
+            }
+
+            return false;
         }
 
         protected override void AnimateOpen()
