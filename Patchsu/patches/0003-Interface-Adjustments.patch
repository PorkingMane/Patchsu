+        /// <summary>
+        /// Whether solo plays and replays show a skip button in breaks that have more than 3 seconds left.
+        /// </summary>
+        public static Bindable<bool> GetSkipBreaks() => PatchsuSettings.Current.GetBindable(@"Interface", @"SkipBreaks", true);
