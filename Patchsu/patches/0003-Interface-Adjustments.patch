+        /// <summary>
+        /// Whether the toolbar music button mutes on right-click and ducks on middle-click, instead of the other way around.
+        /// </summary>
+        public static Bindable<bool> GetSwapMusicButtonClicks() => PatchsuSettings.Current.GetBindable(@"Interface", @"SwapMusicButtonClicks", false);
