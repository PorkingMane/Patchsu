+// Added by Patchsu
+
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using osu.Framework.Graphics;
+using osu.Framework.Graphics.Sprites;
+using osu.Framework.Localisation;
+using osu.Game.Overlays.Settings;
+
+namespace osu.Game.LocalPriority
+{
+    /// <summary>
+    /// Settings → "Patchsu" (its own tab, right under Online). Every patch with settings adds its own "Patch N. …" subsection
+    /// (a <see cref="PatchSettingsSubsection"/> in one of its own files), so no patch has to edit this list.
+    /// They are shown in patch order. The tab is only added when at least one patch has settings.
+    /// </summary>
+    public partial class LocalPrioritySection : SettingsSection
+    {
+        private static readonly Type[] subsection_types = typeof(LocalPrioritySection).Assembly.GetTypes()
+                                                                                       .Where(t => t.IsSubclassOf(typeof(PatchSettingsSubsection)) && !t.IsAbstract)
+                                                                                       .ToArray();
+
+        /// <summary>
+        /// Whether any applied patch has settings here.
+        /// </summary>
+        public static bool HasSubsections => subsection_types.Length > 0;
+
+        public override LocalisableString Header => @"Patchsu";
+
+        public override IEnumerable<LocalisableString> FilterTerms => base.FilterTerms.Concat(new LocalisableString[] { @"local", @"offline", @"profile", @"patch" });
+
+        public override Drawable CreateIcon() => new SpriteIcon
+        {
+            Icon = FontAwesome.Solid.UserShield,
+        };
+
+        public LocalPrioritySection()
+        {
+            Children = subsection_types.Select(t => (PatchSettingsSubsection)Activator.CreateInstance(t)!)
+                                       .OrderBy(s => s.PatchNumber)
+                                       .ToArray();
+        }
+    }
+
+    /// <summary>
+    /// The subsection of Settings → Patchsu that belongs to one patch file, titled "Patch N. Summary".
+    /// Settings → Patchsu finds every subclass by itself, so a subclass only needs a public parameterless constructor.
+    /// </summary>
+    public abstract partial class PatchSettingsSubsection : SettingsSubsection
+    {
+        /// <summary>
+        /// The number of the patch file (0002 → 2).
+        /// </summary>
+        public abstract int PatchNumber { get; }
+
+        /// <summary>
+        /// What the patch does, in a few words.
+        /// </summary>
+        protected abstract string Summary { get; }
+
+        protected sealed override LocalisableString Header => $@"Patch {PatchNumber}. {Summary}";
+    }
+}
diff --git a/osu.Game/LocalPriority/PatchsuSettings.cs b/osu.Game/LocalPriority/PatchsuSettings.cs
new file mode 100644
index 0000000000..507d893adb
--- /dev/null
+++ b/osu.Game/LocalPriority/PatchsuSettings.cs
@@ -0,0 +1,353 @@
+// Added by Patchsu
+
+using System;
+using System.Collections.Generic;
+using System.Globalization;
+using System.IO;
+using System.Threading.Tasks;
+using Newtonsoft.Json;
+using Newtonsoft.Json.Linq;
+using osu.Framework.Bindables;
+using osu.Framework.Logging;
+using osu.Framework.Platform;
+
+namespace osu.Game.LocalPriority
+{
+    /// <summary>
+    /// Every Patchsu setting, kept in "patchsu-osu/PatchsuSettings.json" inside the osu! data folder: one section per patch
+    /// ("LocalProfiles", "Interface", …) holding only the values that differ from their defaults.
+    /// Patches read and change their values through <see cref="Current"/>, as bindables like osu!'s own settings.
+    /// </summary>
+    /// <remarks>
+    /// The folder used to be called "osu-local"; it is renamed on the first start. Settings that used to be in game.ini are taken
+    /// over from it on the first start (osu! drops the lines it doesn't know from game.ini by itself).
+    /// </remarks>
+    public sealed class PatchsuSettings
+    {
+        /// <summary>
+        /// The folder inside the osu! data folder with everything Patchsu keeps (settings, local profiles, caches).
+        /// </summary>
+        public const string DIRECTORY = @"patchsu-osu";
+
+        private const string old_directory = @"osu-local";
+        private const string filename = DIRECTORY + @"/PatchsuSettings.json";
+        private const string game_ini = @"game.ini";
+        private const int save_delay = 250;
+
+        private static PatchsuSettings? current;
+
+        /// <summary>
+        /// The running game's settings. Before a game has loaded them (e.g. in unit tests) these are defaults that are never saved.
+        /// </summary>
+        public static PatchsuSettings Current => current ??= new PatchsuSettings(null);
+
+        /// <summary>
+        /// Loads the settings of a game's data folder and makes them <see cref="Current"/>. Called before osu!'s own settings are created.
+        /// </summary>
+        public static PatchsuSettings Load(Storage storage)
+        {
+            current?.Flush();
+            return current = new PatchsuSettings(storage);
+        }
+
+        private readonly Storage? storage;
+        private readonly object sync = new object();
+        private readonly object writeLock = new object();
+        private readonly JObject root = new JObject();
+
+        /// <summary>
+        /// game.ini as it was before this file existed (empty afterwards).
+        /// </summary>
+        private readonly Dictionary<string, string> oldGameIni = new Dictionary<string, string>();
+
+        private readonly Dictionary<string, IBindable> bindables = new Dictionary<string, IBindable>();
+        private bool savePending;
+
+        private PatchsuSettings(Storage? storage)
+        {
+            this.storage = storage;
+
+            if (storage == null)
+                return;
+
+            moveOldDirectory(storage);
+
+            if (storage.Exists(filename))
+                root = read(storage) ?? new JObject();
+            else
+            {
+                oldGameIni = readGameIni(storage);
+
+                // Written straight away, so game.ini is only looked at on the very first start.
+                lock (sync)
+                    scheduleSave();
+            }
+        }
+
+        /// <summary>
+        /// A setting's value, kept in sync with every other bindable of the same setting.
+        /// </summary>
+        /// <param name="section">The patch's section, e.g. "Interface".</param>
+        /// <param name="key">The setting's name inside the section.</param>
+        /// <param name="defaultValue">Used while the file has no value (values equal to it aren't written).</param>
+        /// <param name="oldGameIniKey">The setting's name in game.ini, if it used to be kept there.</param>
+        public Bindable<T> GetBindable<T>(string section, string key, T defaultValue, string? oldGameIniKey = null)
+            => getOriginal(section, key, defaultValue, oldGameIniKey).GetBoundCopy();
+
+        /// <summary>
+        /// Binds <paramref name="bindable"/> to a setting (it takes the setting's value), like osu!'s <c>BindWith</c>.
+        /// </summary>
+        public void BindWith<T>(string section, string key, T defaultValue, Bindable<T> bindable, string? oldGameIniKey = null)
+            => bindable.BindTo(getOriginal(section, key, defaultValue, oldGameIniKey));
+
+        /// <summary>
+        /// A value kept as a whole (e.g. an options object), or null if the file has none.
+        /// </summary>
+        public T? Get<T>(string section, string key)
+            where T : class
+        {
+            lock (sync)
+            {
+                try
+                {
+                    return root[section]?[key]?.ToObject<T>();
+                }
+                catch (Exception e)
+                {
+                    Logger.Error(e, $@"Could not read {section}.{key} from {filename}; using the defaults");
+                    return null;
+                }
+            }
+        }
+
+        /// <summary>
+        /// Saves a value kept as a whole (<see cref="Get{T}"/>).
+        /// </summary>
+        public void Set<T>(string section, string key, T value)
+            where T : class
+        {
+            lock (sync)
+            {
+                getSection(section)[key] = JToken.FromObject(value);
+                scheduleSave();
+            }
+        }
+
+        /// <summary>
+        /// Writes pending changes now (also used when the game closes).
+        /// </summary>
+        public void Flush()
+        {
+            if (storage == null)
+                return;
+
+            lock (writeLock)
+            {
+                string text;
+
+                lock (sync)
+                {
+                    if (!savePending)
+                        return;
+
+                    savePending = false;
+                    text = root.ToString(Formatting.Indented);
+                }
+
+                try
+                {
+                    using (var stream = storage.CreateFileSafely(filename))
+                    using (var writer = new StreamWriter(stream))
+                        writer.Write(text);
+                }
+                catch (Exception e)
+                {
+                    Logger.Error(e, $@"Could not save {filename}");
+                }
+            }
+        }
+
+        private Bindable<T> getOriginal<T>(string section, string key, T defaultValue, string? oldGameIniKey)
+        {
+            lock (sync)
+            {
+                string id = section + @"/" + key;
+
+                if (bindables.TryGetValue(id, out var existing))
+                    return (Bindable<T>)existing;
+
+                var bindable = new Bindable<T>(defaultValue);
+
+                if (tryRead(section, key, out T value))
+                    bindable.Value = value;
+                else if (oldGameIniKey != null && oldGameIni.TryGetValue(oldGameIniKey, out string? text) && tryParse(text, out value))
+                {
+                    bindable.Value = value;
+                    store(section, key, value, defaultValue);
+                }
+
+                bindable.BindValueChanged(e =>
+                {
+                    lock (sync)
+                        store(section, key, e.NewValue, defaultValue);
+                });
+
+                bindables[id] = bindable;
+                return bindable;
+            }
+        }
+
+        /// <summary>
+        /// Call with the lock held.
+        /// </summary>
+        private bool tryRead<T>(string section, string key, out T value)
+        {
+            value = default!;
+
+            if (root[section]?[key] is not JToken token)
+                return false;
+
+            try
+            {
+                value = token.ToObject<T>()!;
+                return true;
+            }
+            catch (Exception e)
+            {
+                Logger.Error(e, $@"Could not read {section}.{key} from {filename}; using the default");
+                return false;
+            }
+        }
+
+        /// <summary>
+        /// Call with the lock held.
+        /// </summary>
+        private void store<T>(string section, string key, T value, T defaultValue)
+        {
+            if (EqualityComparer<T>.Default.Equals(value, defaultValue))
+            {
+                if (root[section] is not JObject existing || existing[key] == null)
+                    return;
+
+                existing.Remove(key);
+
+                if (!existing.HasValues)
+                    root.Remove(section);
+            }
+            else
+                getSection(section)[key] = value == null ? JValue.CreateNull() : JToken.FromObject(value);
+
+            scheduleSave();
+        }
+
+        /// <summary>
+        /// Call with the lock held.
+        /// </summary>
+        private JObject getSection(string section)
+        {
+            if (root[section] is JObject existing)
+                return existing;
+
+            var created = new JObject();
+            root[section] = created;
+            return created;
+        }
+
+        /// <summary>
+        /// Call with the lock held. Several changes in a row (e.g. dragging a slider) become one write.
+        /// </summary>
+        private void scheduleSave()
+        {
+            if (storage == null || savePending)
+                return;
+
+            savePending = true;
+            Task.Delay(save_delay).ContinueWith(_ => Flush());
+        }
+
+        private static JObject? read(Storage storage)
+        {
+            try
+            {
+                using (var stream = storage.GetStream(filename, FileAccess.Read, FileMode.Open))
+                using (var reader = new StreamReader(stream))
+                    return JObject.Parse(reader.ReadToEnd());
+            }
+            catch (Exception e)
+            {
+                Logger.Error(e, $@"Could not read {filename}; using the defaults. The broken file was kept as {filename}.broken");
+
+                try
+                {
+                    storage.Move(filename, filename + @".broken");
+                }
+                catch
+                {
+                    // ignore.
+                }
+
+                return null;
+            }
+        }
+
+        private static Dictionary<string, string> readGameIni(Storage storage)
+        {
+            var values = new Dictionary<string, string>();
+
+            try
+            {
+                if (!storage.Exists(game_ini))
+                    return values;
+
+                using (var stream = storage.GetStream(game_ini, FileAccess.Read, FileMode.Open))
+                using (var reader = new StreamReader(stream))
+                {
+                    while (reader.ReadLine() is string line)
+                    {
+                        int equals = line.IndexOf('=');
+
+                        if (equals > 0)
+                            values[line[..equals].Trim()] = line[(equals + 1)..].Trim();
+                    }
+                }
+            }
+            catch (Exception e)
+            {
+                Logger.Error(e, $@"Could not read the old Patchsu settings from {game_ini}");
+            }
+
+            return values;
+        }
+
+        private static bool tryParse<T>(string text, out T value)
+        {
+            try
+            {
+                var type = Nullable.GetUnderlyingType(typeof(T)) ?? typeof(T);
+                value = (T)(type.IsEnum ? Enum.Parse(type, text) : Convert.ChangeType(text, type, CultureInfo.InvariantCulture));
+                return true;
+            }
+            catch
+            {
+                value = default!;
+                return false;
+            }
+        }
+
+        private static void moveOldDirectory(Storage storage)
+        {
+            if (!storage.ExistsDirectory(old_directory) || storage.ExistsDirectory(DIRECTORY))
+                return;
+
+            try
+            {
+                Directory.Move(storage.GetFullPath(old_directory), storage.GetFullPath(DIRECTORY));
+                Logger.Log($@"Patchsu: moved ""{old_directory}"" to ""{DIRECTORY}"".");
+            }
+            catch (Exception e)
+            {
+                Logger.Error(e, $@"Could not rename ""{old_directory}"" to ""{DIRECTORY}""");
+            }
+        }
+    }
+}
