Patchsu patch 2b (optional, very early test): P2P multiplayer lobby, LAN only for now.

Needs 0002 (applies to plain osu!lazer 8cb6e6e68d + 0001 + 0002).

- Main menu -> Play -> "multi" opens Multiplayer · P2P (0001 removed the online multiplayer buttons).
- Entering the screen opens a lobby on this machine (TCP port 13381). "Create Code" shows its 8 symbol code
  (XXXX-XXXX, the machine's local IPv4 address with a checksum) and copies it; "Connect via Code" joins someone else's lobby.
- Everyone else in the lobby floats around your own avatar, moving like the avatars in ranked play's queue.
  Local profiles send their profile picture (at most 512 KB); online accounts show their osu! avatar.
- No gameplay yet: this only tests connecting. Both players have to be on the same network (or VPN).
- No new dependencies (plain .NET sockets, Newtonsoft.Json from osu!).

diff --git a/osu.Game/Online/P2P/P2PLobby.cs b/osu.Game/Online/P2P/P2PLobby.cs
new file mode 100644
index 0000000000..75fb68a90e
--- /dev/null
+++ b/osu.Game/Online/P2P/P2PLobby.cs
@@ -0,0 +1,433 @@
+using System;
+using System.Buffers.Binary;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Net;
+using System.Net.NetworkInformation;
+using System.Net.Sockets;
+using System.Text;
+using System.Threading;
+using System.Threading.Tasks;
+using Newtonsoft.Json;
+
+namespace osu.Game.Online.P2P
+{
+    /// <summary>
+    /// A member of a P2P lobby.
+    /// </summary>
+    public class P2PPeer
+    {
+        /// <summary>
+        /// Given by the host when joining (the host itself is 0).
+        /// </summary>
+        [JsonProperty("id")]
+        public int Id;
+
+        [JsonProperty("username")]
+        public string Username = string.Empty;
+
+        /// <summary>
+        /// The osu! user ID (local profiles have negative IDs).
+        /// </summary>
+        [JsonProperty("user_id")]
+        public int UserId;
+
+        /// <summary>
+        /// A local profile's picture file (at most <see cref="P2PLobby.MAX_AVATAR_SIZE"/> bytes), or null.
+        /// </summary>
+        [JsonProperty("avatar")]
+        public byte[]? Avatar;
+    }
+
+    /// <summary>
+    /// Patchsu: a LAN-only P2P lobby. The host listens on <see cref="PORT"/>; guests join with an 8 symbol code made from the host's local IPv4 address.
+    /// Messages are a 4 byte length followed by JSON.
+    /// </summary>
+    public class P2PLobby : IDisposable
+    {
+        public const int PORT = 13381;
+        public const int MAX_AVATAR_SIZE = 512 * 1024;
+
+        private const int protocol_version = 1;
+        private const int max_message_size = 4 * 1024 * 1024;
+
+        /// <summary>
+        /// The other members of the lobby changed. Invoked on a background thread.
+        /// </summary>
+        public event Action<P2PPeer[]>? PeersChanged;
+
+        /// <summary>
+        /// A guest lost the connection to its host. Invoked on a background thread.
+        /// </summary>
+        public event Action? Disconnected;
+
+        public bool IsHost => listener != null;
+
+        private readonly P2PPeer self;
+        private readonly CancellationTokenSource cancellation = new CancellationTokenSource();
+
+        private TcpListener? listener;
+        private readonly List<Guest> guests = new List<Guest>();
+        private int lastGuestId;
+
+        private TcpClient? host;
+
+        private P2PLobby(P2PPeer self)
+        {
+            this.self = self;
+        }
+
+        /// <summary>
+        /// Opens a lobby on this machine.
+        /// </summary>
+        /// <exception cref="SocketException">The port is already in use.</exception>
+        public static P2PLobby Host(P2PPeer self)
+        {
+            var lobby = new P2PLobby(self);
+
+            lobby.listener = new TcpListener(IPAddress.Any, PORT);
+            lobby.listener.Start();
+            _ = lobby.acceptGuests();
+
+            return lobby;
+        }
+
+        /// <summary>
+        /// Joins the lobby a code points to.
+        /// </summary>
+        public static async Task<P2PLobby> JoinAsync(string code, P2PPeer self)
+        {
+            if (!TryDecodeCode(code, out var address))
+                throw new ArgumentException("This code is not valid.");
+
+            var lobby = new P2PLobby(self);
+            var client = lobby.host = new TcpClient { NoDelay = true, SendTimeout = 5000 };
+
+            try
+            {
+                using (var timeout = new CancellationTokenSource(5000))
+                    await client.ConnectAsync(address, PORT, timeout.Token).ConfigureAwait(false);
+
+                send(client.GetStream(), new Message { Type = @"hello", Version = protocol_version, Peer = self });
+            }
+            catch
+            {
+                lobby.Dispose();
+                throw;
+            }
+
+            _ = lobby.readHost(client);
+            return lobby;
+        }
+
+        private async Task acceptGuests()
+        {
+            try
+            {
+                while (true)
+                    _ = handleGuest(await listener!.AcceptTcpClientAsync(cancellation.Token).ConfigureAwait(false));
+            }
+            catch
+            {
+                // Lobby closed.
+            }
+        }
+
+        private async Task handleGuest(TcpClient client)
+        {
+            Guest? guest = null;
+
+            try
+            {
+                client.NoDelay = true;
+                client.SendTimeout = 5000;
+
+                var stream = client.GetStream();
+
+                Message? hello;
+
+                using (var timeout = CancellationTokenSource.CreateLinkedTokenSource(cancellation.Token))
+                {
+                    timeout.CancelAfter(10000);
+                    hello = await receive(stream, timeout.Token).ConfigureAwait(false);
+                }
+
+                if (hello?.Type != @"hello" || hello.Version != protocol_version || hello.Peer == null)
+                    return;
+
+                hello.Peer.Id = Interlocked.Increment(ref lastGuestId);
+                if (hello.Peer.Avatar?.Length > MAX_AVATAR_SIZE)
+                    hello.Peer.Avatar = null;
+
+                guest = new Guest(client, hello.Peer);
+
+                lock (guests)
+                    guests.Add(guest);
+
+                broadcastPeers();
+
+                // Nothing else is sent by guests yet; reading only notices when they leave.
+                while (true)
+                    await receive(stream, cancellation.Token).ConfigureAwait(false);
+            }
+            catch
+            {
+                // Guest left.
+            }
+            finally
+            {
+                client.Dispose();
+
+                bool removed;
+
+                lock (guests)
+                    removed = guest != null && guests.Remove(guest);
+
+                if (removed && !cancellation.IsCancellationRequested)
+                    broadcastPeers();
+            }
+        }
+
+        private void broadcastPeers()
+        {
+            lock (guests)
+            {
+                foreach (var guest in guests)
+                {
+                    var others = guests.Where(g => g != guest).Select(g => g.Peer).Prepend(self).ToArray();
+
+                    try
+                    {
+                        send(guest.Client.GetStream(), new Message { Type = @"peers", Peers = others });
+                    }
+                    catch
+                    {
+                        // Its read loop removes it.
+                        guest.Client.Dispose();
+                    }
+                }
+
+                PeersChanged?.Invoke(guests.Select(g => g.Peer).ToArray());
+            }
+        }
+
+        private async Task readHost(TcpClient client)
+        {
+            try
+            {
+                var stream = client.GetStream();
+
+                while (true)
+                {
+                    var message = await receive(stream, cancellation.Token).ConfigureAwait(false);
+
+                    if (message?.Type == @"peers" && message.Peers != null)
+                        PeersChanged?.Invoke(message.Peers);
+                }
+            }
+            catch
+            {
+                if (!cancellation.IsCancellationRequested)
+                    Disconnected?.Invoke();
+            }
+        }
+
+        private static void send(Stream stream, Message message)
+        {
+            byte[] json = Encoding.UTF8.GetBytes(JsonConvert.SerializeObject(message));
+            byte[] frame = new byte[4 + json.Length];
+
+            BinaryPrimitives.WriteInt32LittleEndian(frame, json.Length);
+            json.CopyTo(frame, 4);
+
+            lock (stream)
+                stream.Write(frame);
+        }
+
+        private static async Task<Message?> receive(Stream stream, CancellationToken cancellationToken)
+        {
+            byte[] length = new byte[4];
+            await stream.ReadExactlyAsync(length, cancellationToken).ConfigureAwait(false);
+
+            int size = BinaryPrimitives.ReadInt32LittleEndian(length);
+            if (size <= 0 || size > max_message_size)
+                throw new InvalidDataException();
+
+            byte[] json = new byte[size];
+            await stream.ReadExactlyAsync(json, cancellationToken).ConfigureAwait(false);
+
+            return JsonConvert.DeserializeObject<Message>(Encoding.UTF8.GetString(json));
+        }
+
+        public void Dispose()
+        {
+            if (cancellation.IsCancellationRequested)
+                return;
+
+            PeersChanged = null;
+            Disconnected = null;
+
+            cancellation.Cancel();
+            listener?.Stop();
+            host?.Dispose();
+
+            lock (guests)
+            {
+                foreach (var guest in guests)
+                    guest.Client.Dispose();
+            }
+        }
+
+        #region Codes
+
+        // Crockford's base32: no I, L, O or U.
+        private const string code_alphabet = @"0123456789ABCDEFGHJKMNPQRSTVWXYZ";
+
+        /// <summary>
+        /// This machine's code ("XXXX-XXXX"), or null when it has no network.
+        /// </summary>
+        public static string? CreateCode()
+        {
+            var address = findLanAddress();
+            return address == null ? null : EncodeCode(address);
+        }
+
+        /// <summary>
+        /// The code ("XXXX-XXXX") of an IPv4 address.
+        /// </summary>
+        public static string EncodeCode(IPAddress address)
+        {
+            uint value = BinaryPrimitives.ReadUInt32BigEndian(address.GetAddressBytes());
+            int[] digits = new int[8];
+
+            for (int i = 6; i >= 0; i--)
+            {
+                digits[i] = (int)(value & 31);
+                value >>= 5;
+            }
+
+            digits[7] = checksum(digits);
+
+            var code = new StringBuilder(9);
+
+            for (int i = 0; i < 8; i++)
+            {
+                if (i == 4)
+                    code.Append('-');
+                code.Append(code_alphabet[digits[i]]);
+            }
+
+            return code.ToString();
+        }
+
+        public static bool TryDecodeCode(string code, out IPAddress address)
+        {
+            address = IPAddress.None;
+
+            var digits = new List<int>(8);
+
+            foreach (char c in code.ToUpperInvariant())
+            {
+                if (c == '-' || char.IsWhiteSpace(c))
+                    continue;
+
+                int digit = code_alphabet.IndexOf(c switch
+                {
+                    'O' => '0',
+                    'I' or 'L' => '1',
+                    _ => c
+                });
+
+                if (digit < 0)
+                    return false;
+
+                digits.Add(digit);
+            }
+
+            if (digits.Count != 8 || checksum(digits) != digits[7])
+                return false;
+
+            ulong value = 0;
+            for (int i = 0; i < 7; i++)
+                value = (value << 5) | (uint)digits[i];
+
+            if (value > uint.MaxValue)
+                return false;
+
+            byte[] bytes = new byte[4];
+            BinaryPrimitives.WriteUInt32BigEndian(bytes, (uint)value);
+            address = new IPAddress(bytes);
+            return true;
+        }
+
+        private static int checksum(IReadOnlyList<int> digits)
+        {
+            int sum = 0;
+            for (int i = 0; i < 7; i++)
+                sum += digits[i] * (i + 1);
+            return sum % 32;
+        }
+
+        /// <summary>
+        /// The IPv4 address of the network adapter with a default gateway (the one connected to the router), preferring private addresses.
+        /// </summary>
+        private static IPAddress? findLanAddress()
+        {
+            try
+            {
+                return NetworkInterface.GetAllNetworkInterfaces()
+                                       .Where(n => n.OperationalStatus == OperationalStatus.Up
+                                                   && n.NetworkInterfaceType != NetworkInterfaceType.Loopback
+                                                   && n.NetworkInterfaceType != NetworkInterfaceType.Tunnel)
+                                       .Select(n => n.GetIPProperties())
+                                       .SelectMany(p => p.UnicastAddresses
+                                                         .Where(a => a.Address.AddressFamily == AddressFamily.InterNetwork && !IPAddress.IsLoopback(a.Address))
+                                                         .Select(a => (address: a.Address, hasGateway: p.GatewayAddresses.Any(g => g.Address.AddressFamily == AddressFamily.InterNetwork))))
+                                       .OrderByDescending(a => a.hasGateway)
+                                       .ThenByDescending(a => isPrivate(a.address))
+                                       .Select(a => a.address)
+                                       .FirstOrDefault();
+            }
+            catch
+            {
+                return null;
+            }
+        }
+
+        private static bool isPrivate(IPAddress address)
+        {
+            byte[] b = address.GetAddressBytes();
+            return b[0] == 10 || (b[0] == 172 && b[1] >= 16 && b[1] < 32) || (b[0] == 192 && b[1] == 168);
+        }
+
+        #endregion
+
+        private class Guest
+        {
+            public readonly TcpClient Client;
+            public readonly P2PPeer Peer;
+
+            public Guest(TcpClient client, P2PPeer peer)
+            {
+                Client = client;
+                Peer = peer;
+            }
+        }
+
+        private class Message
+        {
+            [JsonProperty("type")]
+            public string Type = string.Empty;
+
+            [JsonProperty("version")]
+            public int Version;
+
+            [JsonProperty("peer")]
+            public P2PPeer? Peer;
+
+            [JsonProperty("peers")]
+            public P2PPeer[]? Peers;
+        }
+    }
+}
