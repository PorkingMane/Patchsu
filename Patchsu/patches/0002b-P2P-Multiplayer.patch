diff --git a/osu.Game/Screens/OnlinePlay/P2P/P2PFloatingAvatar.cs b/osu.Game/Screens/OnlinePlay/P2P/P2PFloatingAvatar.cs
new file mode 100644
index 0000000000..878ab2bedd
--- /dev/null
+++ b/osu.Game/Screens/OnlinePlay/P2P/P2PFloatingAvatar.cs
@@ -0,0 +1,168 @@
+using System;
+using System.IO;
+using osu.Framework.Allocation;
+using osu.Framework.Audio;
+using osu.Framework.Audio.Sample;
+using osu.Framework.Graphics;
+using osu.Framework.Graphics.Containers;
+using osu.Framework.Graphics.Cursor;
+using osu.Framework.Graphics.Rendering;
+using osu.Framework.Graphics.Shapes;
+using osu.Framework.Graphics.Sprites;
+using osu.Framework.Graphics.Textures;
+using osu.Framework.Localisation;
+using osu.Framework.Utils;
+using osu.Game.Online.API.Requests.Responses;
+using osu.Game.Online.P2P;
+using osu.Game.Screens.OnlinePlay.Matchmaking.Match;
+using osu.Game.Users.Drawables;
+using osuTK;
+using osuTK.Graphics;
+using SixLabors.ImageSharp.PixelFormats;
+using Image = SixLabors.ImageSharp.Image;
+using ImageFormatException = SixLabors.ImageSharp.ImageFormatException;
+
+namespace osu.Game.Screens.OnlinePlay.P2P
+{
+    /// <summary>
+    /// A lobby member floating around the centre, moving like the avatars in ranked play's queue.
+    /// Shows the member's own local profile picture when it sent one.
+    /// </summary>
+    public partial class P2PFloatingAvatar : CompositeDrawable, IHasTooltip
+    {
+        private const float safe_radius = 0.2f;
+        private const int num_appear_samples = 6;
+
+        private readonly P2PPeer peer;
+
+        private Texture? texture;
+        private Sample? appearSample;
+
+        private float angle;
+        private float radius;
+        private float targetScale;
+        private float targetAlpha;
+
+        public LocalisableString TooltipText => peer.Username;
+
+        public P2PFloatingAvatar(P2PPeer peer)
+        {
+            this.peer = peer;
+
+            Size = MatchmakingAvatar.SIZE;
+            RelativePositionAxes = Axes.Both;
+            Anchor = Anchor.Centre;
+            Origin = Anchor.Centre;
+        }
+
+        [BackgroundDependencyLoader]
+        private void load(IRenderer renderer, AudioManager audio)
+        {
+            texture = createTexture(renderer, peer.Avatar);
+
+            InternalChild = new CircularContainer
+            {
+                RelativeSizeAxes = Axes.Both,
+                Masking = true,
+                Children = new Drawable[]
+                {
+                    new Box
+                    {
+                        RelativeSizeAxes = Axes.Both,
+                        Colour = Color4.LightSlateGray,
+                    },
+                    texture != null
+                        ? new Sprite
+                        {
+                            RelativeSizeAxes = Axes.Both,
+                            FillMode = FillMode.Fill,
+                            Anchor = Anchor.Centre,
+                            Origin = Anchor.Centre,
+                            Texture = texture,
+                        }
+                        // Online accounts show their osu! avatar; other local profiles (whose IDs mean nothing here) the guest one.
+                        : new UpdateableAvatar(new APIUser { Id = peer.UserId > 1 ? peer.UserId : 0, Username = peer.Username }, isInteractive: false)
+                        {
+                            RelativeSizeAxes = Axes.Both,
+                        },
+                }
+            };
+
+            appearSample = audio.Samples.Get($@"Multiplayer/Matchmaking/Cloud/appear-{RNG.Next(0, num_appear_samples)}");
+        }
+
+        private static Texture? createTexture(IRenderer renderer, byte[]? data)
+        {
+            if (data == null)
+                return null;
+
+            try
+            {
+                // Profile pictures are at most 256 px; refuse anything big before decoding it.
+                var info = Image.Identify(data);
+                if (info.Width > 1024 || info.Height > 1024)
+                    return null;
+
+                var upload = new TextureUpload(Image.Load<Rgba32>(data));
+                var result = renderer.CreateTexture(upload.Width, upload.Height);
+                result.SetData(upload);
+                return result;
+            }
+            catch (Exception e) when (e is ImageFormatException or InvalidDataException or NotSupportedException)
+            {
+                return null;
+            }
+        }
+
+        protected override void LoadComplete()
+        {
+            base.LoadComplete();
+
+            updateParams();
+
+            angle = RNG.NextSingle(0f, MathF.Tau);
+            radius = RNG.NextSingle(safe_radius, 0.5f);
+            Scale = new Vector2(targetScale);
+
+            Alpha = 0;
+            this.FadeTo(targetAlpha, 2000, Easing.OutQuint);
+
+            var channel = appearSample?.GetChannel();
+
+            if (channel != null)
+            {
+                channel.Frequency.Value = 0.5f + RNG.NextDouble(1.5f);
+                channel.Balance.Value = MathF.Cos(angle) * OsuGameBase.SFX_STEREO_STRENGTH;
+                channel.Play();
+            }
+        }
+
+        private void updateParams()
+        {
+            targetScale = RNG.NextSingle(1.5f, 3f);
+            targetAlpha = RNG.NextSingle(0.7f, 1f);
+
+            Scheduler.AddDelayed(updateParams, RNG.Next(500, 5000));
+        }
+
+        protected override void Update()
+        {
+            base.Update();
+
+            float elapsed = (float)Math.Min(20, Time.Elapsed) / 1000;
+
+            Scale = new Vector2((float)Interpolation.Lerp(Scale.X, targetScale, elapsed / 100));
+            Alpha = (float)Interpolation.Lerp(Alpha, targetAlpha, elapsed / 100);
+
+            angle += radius * elapsed * 0.5f;
+
+            Position = new Vector2(MathF.Cos(angle), MathF.Sin(angle)) * radius;
+        }
+
+        protected override void Dispose(bool isDisposing)
+        {
+            base.Dispose(isDisposing);
+            texture?.Dispose();
+        }
+    }
+}
