+        private void setShownCode(string code)
+        {
+            shownCode = code;
+            codeBox.Current.Value = code;
+        }
+
+        private P2PPeer createSelf()
+        {
+            var user = api.LocalUser.Value;
+            byte[]? avatar = null;
+
+            if (localProfiles != null && user.Id <= LocalPriorityPolicy.LOCAL_PROFILE_ID_CEILING)
+            {
+                try
+                {
+                    string? file = localProfiles.Store.GetAvatarFile(user.Id);
+
+                    if (file != null)
+                    {
+                        using var stream = localProfiles.Store.AvatarStorage.GetStream(file);
+
+                        if (stream != null && stream.Length <= P2PLobby.MAX_AVATAR_SIZE)
+                        {
+                            using var memory = new MemoryStream();
+                            stream.CopyTo(memory);
+                            avatar = memory.ToArray();
+                        }
+                    }
+                }
+                catch (Exception e)
+                {
+                    Logger.Error(e, "P2P: couldn't read the profile picture");
+                }
+            }
+
+            return new P2PPeer { Username = user.Username, UserId = user.Id, Avatar = avatar };
+        }
+
+        private void startHosting()
+        {
+            hostCode = null;
+            setShownCode(string.Empty);
+
+            try
+            {
+                setLobby(P2PLobby.Host(createSelf()));
+                hostCode = P2PLobby.CreateCode();
+            }
+            catch (SocketException e)
+            {
+                setLobby(null);
+                notifications?.Post(new SimpleErrorNotification { Text = $"Couldn't open a P2P lobby on port {P2PLobby.PORT}: {e.Message}" });
+            }
+        }
+
+        private void showCode()
+        {
+            if (lobby?.IsHost != true)
+                startHosting();
+
+            if (hostCode == null)
+            {
+                notifications?.Post(new SimpleErrorNotification { Text = "Couldn't find your local network address." });
+                return;
+            }
+
+            setShownCode(hostCode);
+            clipboard.SetText(hostCode);
+        }
+
+        private void connect()
+        {
+            string code = joinBox.Current.Value;
+
+            if (!P2PLobby.TryDecodeCode(code, out _))
+            {
+                notifications?.Post(new SimpleErrorNotification { Text = "This code is not valid." });
+                return;
+            }
+
+            setLobby(null);
+            connectButton.Enabled.Value = false;
+            setShownCode(string.Empty);
+
+            P2PLobby.JoinAsync(code, createSelf()).ContinueWith(t => Schedule(() =>
+            {
+                connectButton.Enabled.Value = true;
+
+                if (t.IsCompletedSuccessfully)
+                {
+                    if (this.IsCurrentScreen())
+                        setLobby(t.GetResultSafely());
+                    else
+                        t.GetResultSafely().Dispose();
+
+                    return;
+                }
+
+                notifications?.Post(new SimpleErrorNotification { Text = $"Couldn't connect: {t.Exception?.GetBaseException().Message}" });
+                startHosting();
+            }));
+        }
+
+        private void setLobby(P2PLobby? newLobby)
+        {
+            lobby?.Dispose();
+            lobby = newLobby;
+
+            updatePeers(Array.Empty<P2PPeer>());
+
+            if (newLobby == null)
+                return;
+
+            newLobby.PeersChanged += peers => Schedule(() =>
+            {
+                if (lobby == newLobby)
+                    updatePeers(peers);
+            });
+
+            newLobby.Disconnected += () => Schedule(() =>
+            {
+                if (lobby != newLobby)
+                    return;
+
+                notifications?.Post(new SimpleNotification { Text = "Lost the connection to the lobby." });
+                startHosting();
+            });
+        }
+
+        private void updatePeers(IReadOnlyCollection<P2PPeer> peers)
+        {
+            foreach (int id in peerAvatars.Keys.Where(id => peers.All(p => p.Id != id)).ToArray())
+            {
+                // Ones still loading are dropped when they finish.
+                if (peerAvatars[id].IsLoaded)
+                    peerAvatars[id].FadeOut(500).Expire();
+
+                peerAvatars.Remove(id);
+            }
+
+            foreach (var peer in peers.Where(p => !peerAvatars.ContainsKey(p.Id)))
+            {
+                var avatar = peerAvatars[peer.Id] = new P2PFloatingAvatar(peer);
+
+                LoadComponentAsync(avatar, loaded =>
+                {
+                    if (peerAvatars.ContainsValue(loaded))
+                        peersContainer.Add(loaded);
+                    else
+                        loaded.Dispose();
+                });
+            }
+        }
