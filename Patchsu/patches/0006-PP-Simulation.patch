+    /// <summary>
+    /// Patchsu: a results screen whose numbers can be typed into, to see what PP a play would give.
+    /// Opened from song select's options menu (the selected beatmap and mods, starting at SS) or a leaderboard score's right-click menu (that score).
+    /// </summary>
+    public partial class PerformanceSimulationScreen : ScreenWithBeatmapBackground, IKeepsSharedFooterButtons
+    {
+        private const float background_blur = 10;
+
+        public override bool DisallowExternalBeatmapRulesetChanges => true;
+
+        public override bool? AllowGlobalTrackControl => true;
+
+        [Cached]
