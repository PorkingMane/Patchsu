+using osuTK;
+using osuTK.Input;
+
+namespace osu.Game.Screens.Ranking.Simulation
+{
+    /// <summary>
+    /// Patchsu: the middle of the PP simulation panel. Laid out like <see cref="ExpandedPanelMiddleContent"/>,
+    /// but accuracy, combo, PP, judgements, slider ticks and slider ends can be typed into.
+    /// </summary>
+    public partial class SimulationPanelMiddleContent : CompositeDrawable
+    {
+        private const float padding = 10;
+
+        private PerformanceSimulation simulation;
+        private readonly StarDifficulty? starDifficulty;
+
+        private readonly List<EditableStatistic> editableStatistics = new List<EditableStatistic>();
+        private readonly List<StatisticDisplay> statisticDisplays = new List<StatisticDisplay>();
+
+        private EditableStatistic performance = null!;
+        private StarRatingDisplay starRatingDisplay = null!;
+        private ModDisplay modDisplay = null!;
+
+        private bool scoreAppeared;
+        private bool perfectShown;
+        private bool perfectVisible;
+
+        private Container accuracyCircleContainer = null!;
+        private RollingCounter<long> scoreCounter = null!;
+        private Drawable perfectText = null!;
+
+        private readonly Bindable<ScoringMode> scoringMode = new Bindable<ScoringMode>();
+
+        private ScheduledDelegate? accuracyCircleUpdate;
+        private (double accuracy, ScoreRank rank)? shownAccuracyCircle;
+
+        /// <summary>
+        /// Show everything at once, without the results screen's entrance (when the panel takes over one already on screen).
+        /// </summary>
+        public bool Instant { get; init; }
+
+        public SimulationPanelMiddleContent(PerformanceSimulation simulation, StarDifficulty? starDifficulty)
+        {
+            this.simulation = simulation;
+            this.starDifficulty = starDifficulty;
+
+            RelativeSizeAxes = Axes.Both;
+            Masking = true;
+
+            Padding = new MarginPadding(padding);
+        }
+
+        [BackgroundDependencyLoader]
+        private void load(OsuConfigManager config, OsuColour colours)
+        {
+            var score = simulation.Score;
+            var beatmap = score.BeatmapInfo!;
+            var metadata = beatmap.BeatmapSet?.Metadata ?? beatmap.Metadata;
+            string creator = metadata.Author.Username;
+
+            config.BindWith(OsuSetting.ScoreDisplayMode, scoringMode);
+
+            var accuracy = new EditableStatistic(BeatmapsetsStrings.ShowScoreboardHeadersAccuracy)
+            {
+                IsAccuracy = true,
+                Value = () => simulation.Accuracy,
+                // the results screen cuts the accuracy off at two decimals (never rounds it up), so the box starts from the same number.
+                EditText = () => (Math.Floor(simulation.Accuracy * 10000 + 1e-9) / 100).ToString("0.00", CultureInfo.InvariantCulture),
+                Typed = text =>
+                {
+                    if (tryParse(text, out double value))
+                        simulation.SetAccuracy(value / 100);
+                },
+            };
+
+            var combo = new EditableStatistic(BeatmapsetsStrings.ShowScoreboardHeadersCombo)
+            {
+                Value = () => simulation.Combo,
+                EditText = () => simulation.Combo.ToString(CultureInfo.InvariantCulture),
+                SuffixText = () => $"/{simulation.MaximumCombo}",
+                Extra = perfectText = new OsuSpriteText
+                {
+                    Text = "PERFECT",
+                    Font = OsuFont.Torus.With(size: 11, weight: FontWeight.SemiBold),
+                    Colour = ColourInfo.GradientVertical(Color4Extensions.FromHex("#66FFCC"), Color4Extensions.FromHex("#FF9AD7")),
+                    Alpha = 0,
+                    UseFullGlyphHeight = false,
+                },
+            };
+
+            combo.Typed = text =>
+            {
+                if (!int.TryParse(text, NumberStyles.None, CultureInfo.InvariantCulture, out int value))
+                    return;
+
+                int applied = simulation.SetCombo(value);
+
+                // show the limit right away instead of a combo that can't happen.
+                if (applied != value)
+                    combo.SetText(applied.ToString(CultureInfo.InvariantCulture));
+            };
+
+            performance = new EditableStatistic(BeatmapsetsStrings.ShowScoreboardHeaderspp)
+            {
+                AllowDecimal = true,
+                Value = () => simulation.Performance ?? 0,
+                EditText = () => Math.Round(simulation.Performance ?? 0, MidpointRounding.AwayFromZero).ToString(CultureInfo.InvariantCulture),
+                Typed = text =>
+                {
+                    if (tryParse(text, out double value))
+                        simulation.SetPerformance(value);
+                },
+            };
+
+            applyPerformanceDimming(performance, score);
+
+            var topStatistics = new List<StatisticDisplay> { accuracy, combo, performance };
+
+            editableStatistics.AddRange(new[] { accuracy, combo, performance });
+
+            var bottomStatistics = new List<StatisticDisplay>();
+
+            foreach (var result in score.Ruleset.CreateInstance().GetHitResultsForDisplay())
+            {
+                HitResult type = result.result;
+
+                if (simulation.BasicResults.Contains(type))
+                    bottomStatistics.Add(createCountStatistic(type, result.displayName, colours, false));
+                else if (simulation.TickResults.Contains(type))
+                    bottomStatistics.Add(createCountStatistic(type, result.displayName, colours, true));
+                else if (type.IsBonus() && simulation.GetMaximum(type) > 0)
+                {
+                    // spinner values are only shown, not edited.
+                    bottomStatistics.Add(new HitResultStatistic(new HitResultDisplayStatistic(type, simulation.Get(type), simulation.GetMaximum(type), result.displayName)));
+                }
+            }
+
+            AddInternal(new FillFlowContainer
+            {
+                RelativeSizeAxes = Axes.Both,
+                Direction = FillDirection.Vertical,
+                Spacing = new Vector2(20),
+                Children = new Drawable[]
+                {
+                    new FillFlowContainer
+                    {
+                        Anchor = Anchor.TopCentre,
+                        Origin = Anchor.TopCentre,
+                        RelativeSizeAxes = Axes.X,
+                        AutoSizeAxes = Axes.Y,
+                        Direction = FillDirection.Vertical,
+                        Children = new Drawable[]
+                        {
+                            new ExpandedPanelMiddleContent.ClickableMetadata(beatmap.OnlineID, metadata),
+                            accuracyCircleContainer = new Container
+                            {
+                                Anchor = Anchor.TopCentre,
+                                Origin = Anchor.TopCentre,
+                                Margin = new MarginPadding { Top = 40 },
+                                RelativeSizeAxes = Axes.X,
+                                Height = 230,
+                            },
+                            scoreCounter = new TotalScoreCounter
+                            {
+                                Margin = new MarginPadding { Top = 0, Bottom = 5 },
+                                Current = { Value = 0 },
+                                Alpha = 0,
+                                AlwaysPresent = true
+                            },
+                            new FillFlowContainer
+                            {
+                                Anchor = Anchor.TopCentre,
+                                Origin = Anchor.TopCentre,
+                                AutoSizeAxes = Axes.Both,
+                                Spacing = new Vector2(5, 0),
+                                Children = new Drawable[]
+                                {
+                                    starRatingDisplay = new StarRatingDisplay(starDifficulty ?? new StarDifficulty(beatmap.StarRating, 0))
+                                    {
+                                        Anchor = Anchor.CentreLeft,
+                                        Origin = Anchor.CentreLeft
+                                    },
+                                    new DifficultyIcon(beatmap, score.Ruleset)
+                                    {
+                                        Anchor = Anchor.CentreLeft,
+                                        Origin = Anchor.CentreLeft,
+                                        Size = new Vector2(20),
+                                        TooltipType = DifficultyIconTooltipType.Extended,
+                                    },
+                                    modDisplay = new ModDisplay
+                                    {
+                                        Anchor = Anchor.CentreLeft,
+                                        Origin = Anchor.CentreLeft,
+                                        ExpansionMode = ExpansionMode.AlwaysExpanded,
+                                        Scale = new Vector2(0.5f),
+                                        Current = { Value = score.Mods }
+                                    }
+                                }
+                            },
+                            new FillFlowContainer
+                            {
+                                Anchor = Anchor.TopCentre,
+                                Origin = Anchor.TopCentre,
+                                Direction = FillDirection.Vertical,
+                                AutoSizeAxes = Axes.Both,
+                                Children = new Drawable[]
+                                {
+                                    new TruncatingSpriteText
+                                    {
+                                        Anchor = Anchor.TopCentre,
+                                        Origin = Anchor.TopCentre,
+                                        Text = beatmap.DifficultyName,
+                                        Font = OsuFont.Torus.With(size: 16, weight: FontWeight.SemiBold),
+                                        MaxWidth = ScorePanel.EXPANDED_WIDTH - padding * 2,
+                                    },
+                                    new OsuTextFlowContainer(s => s.Font = OsuFont.Torus.With(size: 12))
+                                    {
+                                        Anchor = Anchor.TopCentre,
+                                        Origin = Anchor.TopCentre,
+                                        AutoSizeAxes = Axes.Both,
+                                        Direction = FillDirection.Horizontal,
+                                    }.With(t =>
+                                    {
+                                        if (!string.IsNullOrEmpty(creator))
+                                        {
+                                            t.AddText("mapped by ");
+                                            t.AddText(creator, s => s.Font = s.Font.With(weight: FontWeight.SemiBold));
+                                        }
+                                    })
+                                }
+                            },
+                        }
+                    },
+                    new FillFlowContainer
+                    {
+                        RelativeSizeAxes = Axes.X,
+                        AutoSizeAxes = Axes.Y,
+                        Direction = FillDirection.Vertical,
+                        Spacing = new Vector2(0, 5),
+                        Children = new Drawable[]
+                        {
+                            createRow(topStatistics),
+                            createRow(bottomStatistics.Where(s => resultOf(s) <= HitResult.Perfect)),
+                            createRow(bottomStatistics.Where(s => resultOf(s) > HitResult.Perfect)),
+                        }
+                    }
+                }
+            });
+
+            statisticDisplays.AddRange(topStatistics);
+            statisticDisplays.AddRange(bottomStatistics);
+
+            // Tab / Shift+Tab walk through the boxes in reading order.
+            foreach (var stat in editableStatistics)
+            {
+                stat.Box.TabPressed = (box, direction) =>
+                {
+                    int index = editableStatistics.FindIndex(s => s.Box == box);
+                    var next = editableStatistics[(index + direction + editableStatistics.Count) % editableStatistics.Count];
+                    GetContainingFocusManager()?.ChangeFocus(next.Box);
+                };
+            }
+
+            if (!simulation.CanCalculatePerformance)
+                performance.Box.Current.Disabled = true;
+        }
+
+        protected override void LoadComplete()
+        {
+            base.LoadComplete();
+
+            simulation.Changed += onChanged;
+            scoringMode.BindValueChanged(_ => updateScore());
+
+            updateAccuracyCircle(!Instant);
+
+            if (Instant)
+            {
+                // already on screen as the results panel: everything shows its final value right away.
+                ScheduleAfterChildren(() =>
+                {
+                    scoreCounter.FadeIn();
+
+                    foreach (var stat in statisticDisplays)
+                        stat.Appear();
+
+                    scoreAppeared = true;
+                    perfectShown = true;
+                    updateScore();
+
+                    FinishTransforms(true);
+                });
+
+                return;
+            }
+
+            // the same entrance as the results screen: the score, then each statistic 200 ms after the previous one.
+            ScheduleAfterChildren(() =>
+            {
+                using (BeginDelayedSequence(AccuracyCircle.ACCURACY_TRANSFORM_DELAY))
+                {
+                    scoreCounter.FadeIn();
+
+                    double delay = 0;
+
+                    foreach (var stat in statisticDisplays)
+                    {
+                        using (BeginDelayedSequence(delay))
+                            stat.Appear();
+
+                        delay += 200;
+                    }
+                }
+
+                Scheduler.AddDelayed(() =>
+                {
+                    scoreAppeared = true;
+                    updateScore();
+                }, AccuracyCircle.ACCURACY_TRANSFORM_DELAY);
+
+                // ComboStatistic's "PERFECT" comes in halfway through its roll.
+                Scheduler.AddDelayed(() => perfectShown = true, AccuracyCircle.ACCURACY_TRANSFORM_DELAY + 200 + AccuracyCircle.ACCURACY_TRANSFORM_DURATION / 2);
+            });
+        }
+
+        protected override bool OnKeyDown(KeyDownEvent e)
+        {
+            // Tab with nothing being edited starts at the accuracy (Shift+Tab at the last number).
+            if (e.Key == Key.Tab && !e.ControlPressed && !e.AltPressed && editableStatistics.Count > 0
+                && GetContainingInputManager()?.FocusedDrawable is not TextBox)
+            {
+                var target = e.ShiftPressed ? editableStatistics[^1] : editableStatistics[0];
+                GetContainingFocusManager()?.ChangeFocus(target.Box);
+                return true;
+            }
+
+            return base.OnKeyDown(e);
+        }
+
+        /// <summary>
+        /// Shows another simulation of the same beatmap (other mods) in place: the numbers roll to the new values
+        /// instead of the whole panel being built and animated again.
+        /// </summary>
+        /// <returns>Whether it could; not if the new mods show different judgement rows.</returns>
+        public bool TrySetSimulation(PerformanceSimulation newSimulation, StarDifficulty? difficulty)
+        {
+            if (!newSimulation.BasicResults.SequenceEqual(simulation.BasicResults) || !newSimulation.TickResults.SequenceEqual(simulation.TickResults))
+                return false;
+
+            simulation.Changed -= onChanged;
+            simulation = newSimulation;
+            simulation.Changed += onChanged;
+
+            var beatmap = simulation.Score.BeatmapInfo!;
+            starRatingDisplay.Current.Value = difficulty ?? new StarDifficulty(beatmap.StarRating, 0);
+            modDisplay.Current.Value = simulation.Score.Mods;
+
+            performance.Alpha = 1;
+            performance.TooltipText = default;
+            applyPerformanceDimming(performance, simulation.Score);
+            performance.Box.Current.Disabled = !simulation.CanCalculatePerformance;
+
+            onChanged();
+            return true;
+        }
+
+        private void applyPerformanceDimming(EditableStatistic performance, ScoreInfo score)
+        {
+            // as PerformanceStatistic does for scores that don't give PP.
+            if (score.BeatmapInfo?.Status.GrantsPerformancePoints() == false)
+            {
+                performance.Alpha = 0.5f;
+                performance.TooltipText = ResultsScreenStrings.NoPPForUnrankedBeatmaps;
+            }
+            else if (score.Mods.Where(m => !score.IsLegacyScore || m is not ModClassic).Any(m => !m.Ranked))
+            {
+                performance.Alpha = 0.5f;
+                performance.TooltipText = ResultsScreenStrings.NoPPForUnrankedMods;
+            }
+        }
+
+        private void onChanged()
+        {
+            foreach (var stat in editableStatistics)
+                stat.Refresh();
+
+            updateScore();
+
+            // rebuilding the circle on every keystroke is wasteful, it only needs to catch up once typing pauses.
+            accuracyCircleUpdate?.Cancel();
+            accuracyCircleUpdate = Scheduler.AddDelayed(() => updateAccuracyCircle(false), 100);
+        }
+
+        protected override void Update()
+        {
+            base.Update();
+
+            bool perfect = perfectShown && simulation.Combo >= simulation.MaximumCombo;
+
+            if (perfect == perfectVisible)
+                return;
+
+            perfectVisible = perfect;
+            perfectText.FadeTo(perfect ? 1 : 0, 50);
+        }
+
+        private void updateScore()
+        {
+            if (scoreAppeared)
+                scoreCounter.Current.Value = simulation.Score.GetDisplayScore(scoringMode.Value);
+        }
+
+        private void updateAccuracyCircle(bool animate)
+        {
+            var state = (simulation.Accuracy, simulation.Score.Rank);
+
+            if (shownAccuracyCircle == state)
+                return;
+
+            shownAccuracyCircle = state;
+
+            // AccuracyCircle reads the score when it loads, so it gets its own copy of the values.
+            var snapshot = new ScoreInfo(simulation.Score.BeatmapInfo, simulation.Score.Ruleset)
+            {
+                Mods = simulation.Score.Mods,
+                Accuracy = simulation.Accuracy,
+                Rank = simulation.Score.Rank,
+            };
+
+            var circle = new AccuracyCircle(snapshot)
+            {
+                Anchor = Anchor.Centre,
+                Origin = Anchor.Centre,
+                RelativeSizeAxes = Axes.Both,
+                FillMode = FillMode.Fit,
+            };
+
+            if (!animate)
+                circle.OnLoadComplete += d => d.FinishTransforms(true);
+
+            accuracyCircleContainer.Child = circle;
+        }
+
+        private EditableStatistic createCountStatistic(HitResult type, Framework.Localisation.LocalisableString name, OsuColour colours, bool showMaximum)
+        {
+            var stat = new EditableStatistic(name)
+            {
+                Value = () => simulation.Get(type),
+                EditText = () => simulation.Get(type).ToString(CultureInfo.InvariantCulture),
+                SuffixText = showMaximum ? () => $"/{simulation.GetMaximum(type)}" : null,
+                HeaderColour = colours.ForHitResult(type),
+            };
+
+            stat.Typed = text =>
+            {
+                if (!int.TryParse(text, NumberStyles.None, CultureInfo.InvariantCulture, out int value))
+                    return;
+
+                int applied = simulation.SetCount(type, value);
+
+                if (applied != value)
+                    stat.SetText(applied.ToString(CultureInfo.InvariantCulture));
+            };
+
+            editableStatistics.Add(stat);
+            resultTypes[stat] = type;
+            return stat;
+        }
+
+        private readonly Dictionary<StatisticDisplay, HitResult> resultTypes = new Dictionary<StatisticDisplay, HitResult>();
+
+        private HitResult resultOf(StatisticDisplay statistic) => statistic is HitResultStatistic h ? h.Result : resultTypes.GetValueOrDefault(statistic);
+
+        private static GridContainer createRow(IEnumerable<StatisticDisplay> statistics) => new GridContainer
+        {
+            RelativeSizeAxes = Axes.X,
+            AutoSizeAxes = Axes.Y,
+            Content = new[] { statistics.Cast<Drawable>().ToArray() },
+            RowDimensions = new[]
+            {
+                new Dimension(GridSizeMode.AutoSize),
+            }
+        };
+
+        private static bool tryParse(string text, out double value)
+            => double.TryParse(text.Replace(',', '.'), NumberStyles.AllowDecimalPoint, CultureInfo.InvariantCulture, out value);
+
+        protected override void Dispose(bool isDisposing)
+        {
+            simulation.Changed -= onChanged;
+            base.Dispose(isDisposing);
+        }
+    }
+}
