+
+        [Resolved]
+        private ScoreManager scoreManager { get; set; } = null!;
+
+        [Resolved]
+        private IAPIProvider api { get; set; } = null!;
+
+        [Resolved]
+        private IOverlayManager? overlayManager { get; set; }
+
+        private readonly BeatmapInfo beatmapInfo;
+        private readonly ScoreInfo? sourceScore;
+
+        /// <summary>
+        /// Where the results screen's panel was (screen space) when this was opened from it, so this panel can take over from it.
+        /// </summary>
+        private readonly Quad? arrivingFrom;
+
+        private RulesetInfo rulesetInfo = null!;
+
+        private PerformanceSimulation? simulation;
+
+        /// <summary>
+        /// The mods being simulated. Separate from the game's selected mods, which song select keeps.
+        /// </summary>
+        private readonly Bindable<IReadOnlyList<Mod>> simulationMods = new Bindable<IReadOnlyList<Mod>>(Array.Empty<Mod>());
+
+        /// <summary>
+        /// The mods of the simulation shown. Whether they match the score's own mods is kept up to date here
+        /// (the footer buttons are updated every frame, without comparing mods each time).
+        /// </summary>
+        private Mod[] simulatedMods
+        {
+            get => simulatedModsValue;
+            set
+            {
+                simulatedModsValue = value;
+                simulatedModsAreScoreMods = sourceScore != null && sameModsAndSettings(value, sourceMods);
+            }
+        }
+
+        private Mod[] simulatedModsValue = Array.Empty<Mod>();
+        private bool simulatedModsAreScoreMods;
+
+        /// <summary>
+        /// The score's mods, built once (reading <see cref="ScoreInfo.Mods"/> of a detached score builds new mod instances every time).
+        /// </summary>
+        private readonly Mod[] sourceMods;
+
+        private ModSelectOverlay modSelectOverlay = null!;
+        private IDisposable? modSelectOverlayRegistration;
+        private ModSettingChangeTracker? modSettingChangeTracker;
+        private ScheduledDelegate? modSettingRebuild;
+
+        private Container panelContainer = null!;
+
+        private ShearedButton? resetToScoreButton;
+        private ShearedButton? fixChokeButton;
+        private ShearedButton? resetToPerfectButton;
+
+        private CancellationTokenSource? rebuildCancellation;
+
+        /// <summary>
+        /// The simulation's rules (judgement counts, slider ticks / ends) are written for osu!.
+        /// </summary>
+        public static bool IsSupported(IRulesetInfo? ruleset) => ruleset?.OnlineID == 0;
+
+        /// <param name="beatmapInfo">The beatmap to simulate a play on.</param>
+        /// <param name="score">A score to start from, or <see langword="null"/> to start from SS with the selected mods.</param>
+        /// <param name="arrivingFrom">The screen-space quad of the results panel showing <paramref name="score"/>, when opened from the
+        /// results screen: the panel then starts there with its values shown and only slides into place (no entrance animation).</param>
+        public PerformanceSimulationScreen(BeatmapInfo beatmapInfo, ScoreInfo? score = null, Quad? arrivingFrom = null)
+        {
+            this.arrivingFrom = arrivingFrom;
+
+            // the screen loads on a background thread, so it can't hold on to live realm objects.
+            this.beatmapInfo = beatmapInfo.Detach();
+            sourceScore = score?.Detach();
+            sourceMods = sourceScore?.Mods ?? Array.Empty<Mod>();
+
+            FooterContent.Value = ScreenFooterContent.Argon(leftButtons: createLeftButtons, rightButtons: createRightButtons);
+        }
+
+        [BackgroundDependencyLoader]
+        private void load()
+        {
+            rulesetInfo = sourceScore?.Ruleset ?? Ruleset.Value;
+            simulatedMods = (sourceScore != null ? sourceMods : Mods.Value.ToArray()).Select(m => m.DeepClone()).ToArray();
+            simulationMods.Value = simulatedMods;
+
+            StarDifficulty? difficulty = difficultyCache.GetDifficultyAsync(beatmapInfo, rulesetInfo, simulatedMods).GetResultSafely();
+            simulation = createSimulation(simulatedMods, difficulty);
+
+            LoadComponent(modSelectOverlay = new UserModSelectOverlay { ShowPresets = true });
+
+            InternalChild = new Container
+            {
+                RelativeSizeAxes = Axes.Both,
+                Padding = new MarginPadding { Bottom = ScreenFooter.HEIGHT },
+                Child = new OsuScrollContainer
+                {
+                    RelativeSizeAxes = Axes.Both,
+                    ScrollbarVisible = false,
+                    Child = new Container
+                    {
+                        RelativeSizeAxes = Axes.X,
+                        Height = 768 - ScreenFooter.HEIGHT,
+                        Child = panelContainer = new Container
+                        {
+                            RelativeSizeAxes = Axes.Both,
+                            Child = createPanel(simulation, difficulty, arrivingFrom != null),
+                        }
+                    }
+                }
+            };
+        }
+
+        protected override void LoadComplete()
+        {
+            base.LoadComplete();
+
+            modSelectOverlayRegistration = overlayManager?.RegisterBlockingOverlay(modSelectOverlay);
+
+            if (arrivingFrom is Quad from && panelContainer.Child is Drawable panel)
+            {
+                // take over from the results panel: start where it was and slide to this screen's spot (the panels differ in height).
+                ScheduleAfterChildren(() =>
+                {
+                    panel.Position = panelContainer.ToLocalSpace(from.TopLeft) - panelContainer.ToLocalSpace(panel.ScreenSpaceDrawQuad.TopLeft);
+                    panel.MoveTo(Vector2.Zero, 400, Easing.OutQuint);
+                });
+            }
+
+            simulationMods.BindValueChanged(mods =>
+            {
+                modSettingChangeTracker?.Dispose();
+                modSettingChangeTracker = new ModSettingChangeTracker(mods.NewValue)
+                {
+                    // a slider being dragged changes the setting many times, the simulation only needs the final value.
+                    SettingChanged = _ =>
+                    {
+                        modSettingRebuild?.Cancel();
+                        modSettingRebuild = Scheduler.AddDelayed(() => rebuild(simulationMods.Value, false), 300);
+                    }
+                };
+
+                rebuild(mods.NewValue, false);
+            }, true);
+        }
+
+        private IEnumerable<ScreenFooterButton> createLeftButtons() =>
+        [
+            new FooterButtonMods(modSelectOverlay)
+            {
+                Hotkey = GlobalAction.ToggleModSelection,
+                Mods = simulationMods,
+                Ruleset = Ruleset,
+                RequestDeselectAllMods = () =>
+                {
+                    if (modSelectOverlay.State.Value == Visibility.Visible)
+                        modSelectOverlay.DeselectAll();
+                    else
+                        simulationMods.Value = Array.Empty<Mod>();
+                }
+            },
+        ];
+
+        private IEnumerable<ShearedButton> createRightButtons()
+        {
+            if (sourceScore != null)
+            {
+                yield return resetToScoreButton = new ShearedButtonWithIcon
+                {
+                    Width = 180,
+                    Text = "Reset to score",
+                    Icon = FontAwesome.Solid.Undo,
+                    Action = resetToScore,
+                };
+            }
+
+            yield return fixChokeButton = new FixChokeButton
+            {
+                Width = 150,
+                Text = "Fix choke",
+                Icon = FontAwesome.Solid.Wrench,
+                FixChoke = missesBecomeGreat => simulation?.FixChoke(missesBecomeGreat),
+            };
+
+            yield return resetToPerfectButton = new ShearedButtonWithIcon
+            {
+                Width = 160,
+                Text = "Reset to SS",
+                Icon = FontAwesome.Solid.Star,
+                Action = () => simulation?.SetPerfect(),
+            };
+
+            yield return new HintButton("Tab moves to the next one");
+        }
+
+        protected override void Update()
+        {
+            base.Update();
+
+            // the footer turns its buttons on whenever it shows them, so their state is kept here.
+            if (resetToScoreButton != null && resetToScoreButton.Enabled.Value != canResetToScore)
+                resetToScoreButton.Enabled.Value = canResetToScore;
+
+            bool canFixChoke = simulation?.IsChokeFixed == false;
+
+            if (fixChokeButton != null && fixChokeButton.Enabled.Value != canFixChoke)
+                fixChokeButton.Enabled.Value = canFixChoke;
+
+            bool canResetToPerfect = simulation?.IsPerfect == false;
+
+            if (resetToPerfectButton != null && resetToPerfectButton.Enabled.Value != canResetToPerfect)
+                resetToPerfectButton.Enabled.Value = canResetToPerfect;
+        }
+
+        private bool canResetToScore => sourceScore != null && simulation != null && (simulation.IsModified || !simulatedModsAreScoreMods);
+
+        private void resetToScore()
+        {
+            if (sourceScore == null || simulation == null)
+                return;
+
+            if (sameModsAndSettings(simulationMods.Value, sourceMods))
+            {
+                // the mods are back, but the simulation may still be one built while they were different.
+                if (simulatedModsAreScoreMods)
+                    simulation.Reset();
+                else
+                    rebuild(simulationMods.Value, true);
+
+                return;
+            }
+
+            simulationMods.Value = sourceMods.Select(m => m.DeepClone()).ToArray();
+            rebuild(simulationMods.Value, true);
+        }
+
+        /// <summary>
+        /// Builds the simulation again for other mods, keeping the typed values (or starting over from the score).
+        /// </summary>
+        private void rebuild(IReadOnlyList<Mod> mods, bool fromScore)
+        {
+            modSettingRebuild?.Cancel();
+
+            Mod[] newMods = mods.Select(m => m.DeepClone()).ToArray();
+
+            if (!fromScore && simulation != null && sameModsAndSettings(newMods, simulatedMods))
+                return;
+
+            rebuildCancellation?.Cancel();
+            var cancellation = rebuildCancellation = new CancellationTokenSource();
+            var previous = simulation;
+
+            Task.Run(async () =>
+            {
+                StarDifficulty? difficulty = await difficultyCache.GetDifficultyAsync(beatmapInfo, rulesetInfo, newMods, cancellation.Token).ConfigureAwait(false);
+                cancellation.Token.ThrowIfCancellationRequested();
+
+                var newSimulation = createSimulation(newMods, difficulty);
+
+                if (!fromScore && previous != null)
+                    newSimulation.CopyFrom(previous);
+
+                Schedule(() =>
+                {
+                    if (cancellation.IsCancellationRequested)
+                        return;
+
+                    // normally the shown panel just takes the new numbers (they roll to them), without the entrance animation again.
+                    if (panelContainer.Child is SimulationScorePanel shown && shown.TrySetSimulation(newSimulation, difficulty))
+                    {
+                        simulation = newSimulation;
+                        simulatedMods = newMods;
+                        return;
+                    }
+
+                    LoadComponentAsync(createPanel(newSimulation, difficulty), loaded =>
+                    {
+                        if (cancellation.IsCancellationRequested)
+                            return;
+
+                        simulation = newSimulation;
+                        simulatedMods = newMods;
+                        panelContainer.Child = loaded;
+                    }, cancellation.Token);
+                });
+            }, cancellation.Token).ContinueWith(t =>
+            {
+                if (t.Exception != null)
+                    Logger.Error(t.Exception, "PP simulation could not be updated for these mods.");
+            }, TaskContinuationOptions.OnlyOnFaulted);
+        }
+
+        private PerformanceSimulation createSimulation(Mod[] mods, StarDifficulty? difficulty)
+        {
+            ScoreInfo template;
+            Dictionary<HitResult, int> maximum;
+
+            bool fromScore = sourceScore != null;
+            bool scoreMods = sourceScore != null && sameModsAndSettings(mods, sourceMods);
+
+            try
+            {
+                if (sourceScore != null)
+                {
+                    template = sourceScore.DeepClone();
+
+                    if (template.MaximumStatistics.Sum(kvp => kvp.Value) == 0)
+                        scoreManager.PopulateMaximumStatistics(template);
+
+                    if (!scoreMods)
+                    {
+                        // the score's real total doesn't belong to other mods, so the score is estimated like any edited one.
+                        template.Mods = mods;
+                        template.MaximumStatistics = getPerfectStatistics(beatmaps.GetWorkingBeatmap(beatmapInfo), rulesetInfo, mods);
+                        template.TotalScore = 0;
+                        template.LegacyTotalScore = null;
+                    }
+
+                    maximum = new Dictionary<HitResult, int>(template.MaximumStatistics);
+                }
+                else
+                {
+                    maximum = getPerfectStatistics(beatmaps.GetWorkingBeatmap(beatmapInfo), rulesetInfo, mods);
+                    template = createPerfectScore(rulesetInfo, mods, maximum, api.LocalUser.Value);
+                }
+            }
+            catch (Exception e)
+            {
+                Logger.Error(e, "PP simulation could not be opened for this beatmap.");
+                template = new ScoreInfo(beatmapInfo, rulesetInfo) { Mods = mods };
+                maximum = new Dictionary<HitResult, int>();
+            }
+
+            return new PerformanceSimulation(template, maximum, difficulty?.DifficultyAttributes, calibrateScore: fromScore && scoreMods);
+        }
+
+        private static SimulationScorePanel createPanel(PerformanceSimulation simulation, StarDifficulty? difficulty, bool instant = false) => new SimulationScorePanel(simulation, difficulty, instant)
+        {
+            Anchor = Anchor.Centre,
+            Origin = Anchor.Centre,
+        };
+
+        private static bool sameModsAndSettings(IReadOnlyList<Mod> a, IReadOnlyList<Mod> b)
+            => a.Count == b.Count && a.All(m => b.Any(o => o.Equals(m)));
+
+        public override void OnEntering(ScreenTransitionEvent e)
+        {
+            base.OnEntering(e);
+
+            ApplyToBackground(b =>
+            {
+                b.BlurAmount.Value = background_blur;
+                b.FadeColour(OsuColour.Gray(0.5f), 250);
+            });
+
+            onArriving();
+        }
+
+        public override void OnResuming(ScreenTransitionEvent e)
+        {
+            base.OnResuming(e);
+            onArriving();
+        }
+
+        public override void OnSuspending(ScreenTransitionEvent e)
+        {
+            onLeaving();
+            base.OnSuspending(e);
+        }
+
+        public override bool OnExiting(ScreenExitEvent e)
+        {
+            if (base.OnExiting(e))
+                return true;
+
+            onLeaving();
+            this.FadeOut(100);
+            return false;
+        }
+
+        private void onArriving()
+        {
+            modSelectOverlay.Beatmap.BindTo(Beatmap);
+            modSelectOverlay.Ruleset.BindTo(Ruleset);
+            // required due to https://github.com/ppy/osu-framework/issues/3218
+            modSelectOverlay.SelectedMods.Disabled = false;
+            modSelectOverlay.SelectedMods.BindTo(simulationMods);
+        }
+
+        private void onLeaving()
+        {
+            modSelectOverlay.SelectedMods.UnbindFrom(simulationMods);
+            modSelectOverlay.Ruleset.UnbindFrom(Ruleset);
+            modSelectOverlay.Beatmap.UnbindFrom(Beatmap);
+            modSelectOverlay.Hide();
+        }
+
+        protected override void Dispose(bool isDisposing)
+        {
+            rebuildCancellation?.Cancel();
+            modSettingChangeTracker?.Dispose();
+            modSelectOverlayRegistration?.Dispose();
+
+            base.Dispose(isDisposing);
+        }
+
+        /// <summary>
+        /// The judgements of a perfect play, from playing the beatmap through a score processor.
+        /// </summary>
+        private static Dictionary<HitResult, int> getPerfectStatistics(IWorkingBeatmap working, RulesetInfo rulesetInfo, Mod[] mods)
+        {
+            var ruleset = rulesetInfo.CreateInstance();
+            var playable = working.GetPlayableBeatmap(rulesetInfo, mods);
+
+            var processor = ruleset.CreateScoreProcessor();
+            processor.Mods.Value = mods;
+            processor.ApplyBeatmap(playable);
+
+            return processor.MaximumStatistics;
+        }
+
+        private ScoreInfo createPerfectScore(RulesetInfo rulesetInfo, Mod[] mods, Dictionary<HitResult, int> maximum, Online.API.Requests.Responses.APIUser user)
+        {
+            var statistics = new Dictionary<HitResult, int>();
+
+            foreach ((HitResult result, int count) in maximum)
+            {
+                // spinner bonus can't be edited and isn't part of a "perfect" play, so it starts (and stays) at zero.
+                if (result.IsBonus())
+                    continue;
+
+                statistics[result] = count;
+            }
+
+            return new ScoreInfo(beatmapInfo, rulesetInfo)
+            {
+                User = user,
+                Mods = mods,
+                Statistics = statistics,
+                MaximumStatistics = new Dictionary<HitResult, int>(maximum),
+                MaxCombo = maximum.Where(kvp => kvp.Key.AffectsCombo()).Sum(kvp => kvp.Value),
+                Accuracy = 1,
+                Rank = ScoreRank.X,
+                Date = DateTimeOffset.Now,
+            };
+        }
+
+        /// <summary>
+        /// A footer "button" that is only text, for the hint in the footer's right corner.
+        /// </summary>
+        /// <summary>
+        /// Left click turns the misses into 100s, right click into 300s.
+        /// </summary>
+        private partial class FixChokeButton : ShearedButtonWithIcon
+        {
+            public Action<bool>? FixChoke;
+
+            private bool rightClick;
+
+            public FixChokeButton()
+            {
+                Action = () => FixChoke?.Invoke(rightClick);
+            }
+
+            protected override void OnMouseUp(MouseUpEvent e)
+            {
+                base.OnMouseUp(e);
+
+                // the framework only sends clicks for the left button.
+                if (e.Button != MouseButton.Right || !Enabled.Value || !IsHovered)
+                    return;
+
+                rightClick = true;
+                TriggerClickWithSound();
+                rightClick = false;
+            }
+        }
+
+        private partial class HintButton : ShearedButton
+        {
+            public HintButton(LocalisableString text)
+            {
+                Text = text;
+
+                // the footer lifts its right buttons off the bottom edge; the text is centred on the bar instead.
+                ButtonContent.Y = OsuGame.SCREEN_EDGE_MARGIN + DEFAULT_HEIGHT / 2 - ScreenFooter.HEIGHT / 2f;
+                DarkerColour = Colour4.Transparent;
+                LighterColour = Colour4.Transparent;
+                TextColour = Colour4.White;
+            }
+
+            protected override void Update()
+            {
+                base.Update();
+                Width = ButtonContent.DrawWidth;
+            }
+
+            public override bool ReceivePositionalInputAt(Vector2 screenSpacePos) => false;
+
+            protected override bool OnMouseDown(MouseDownEvent e) => false;
+        }
+
+        /// <summary>
+        /// The expanded results panel (same shape, colours and top part), holding <see cref="SimulationPanelMiddleContent"/>.
+        /// </summary>
+        private partial class SimulationScorePanel : CompositeDrawable
+        {
+            private const float expanded_height = 586;
+
+            private static readonly ColourInfo top_layer_colour = ColourInfo.GradientVertical(Color4Extensions.FromHex("#444"), Color4Extensions.FromHex("#333"));
+            private static readonly ColourInfo middle_layer_colour = ColourInfo.GradientVertical(Color4Extensions.FromHex("#555"), Color4Extensions.FromHex("#333"));
+
+            private readonly PerformanceSimulation simulation;
+
+            private SimulationPanelMiddleContent middleContent = null!;
+
+            public bool TrySetSimulation(PerformanceSimulation newSimulation, StarDifficulty? difficulty)
+                => middleContent.IsLoaded && middleContent.TrySetSimulation(newSimulation, difficulty);
+            private readonly StarDifficulty? difficulty;
+            private readonly bool instant;
+
+            public SimulationScorePanel(PerformanceSimulation simulation, StarDifficulty? difficulty, bool instant)
+            {
+                this.simulation = simulation;
+                this.difficulty = difficulty;
+                this.instant = instant;
+
+                Size = new Vector2(ScorePanel.EXPANDED_WIDTH, expanded_height);
+            }
+
+            [BackgroundDependencyLoader]
+            private void load()
+            {
+                InternalChildren = new Drawable[]
+                {
+                    new Container
+                    {
+                        Name = "Top layer",
+                        RelativeSizeAxes = Axes.X,
+                        Height = 120,
+                        Y = -ScorePanel.EXPANDED_TOP_LAYER_HEIGHT / 2,
+                        Children = new Drawable[]
+                        {
+                            new Container
+                            {
+                                RelativeSizeAxes = Axes.Both,
+                                CornerRadius = 20,
+                                CornerExponent = 2.5f,
+                                Masking = true,
+                                Child = new Box
+                                {
+                                    RelativeSizeAxes = Axes.Both,
+                                    Colour = top_layer_colour,
+                                }
+                            },
+                            new Container
+                            {
+                                RelativeSizeAxes = Axes.Both,
+                                Child = new ExpandedPanelTopContent(simulation.Score.User),
+                            }
+                        }
+                    },
+                    new Container
+                    {
+                        Name = "Middle layer",
+                        RelativeSizeAxes = Axes.Both,
+                        Y = ScorePanel.EXPANDED_TOP_LAYER_HEIGHT / 2,
+                        Children = new Drawable[]
+                        {
+                            new Container
+                            {
+                                RelativeSizeAxes = Axes.Both,
+                                CornerRadius = 20,
+                                CornerExponent = 2.5f,
+                                Masking = true,
+                                Children = new Drawable[]
+                                {
+                                    new Box
+                                    {
+                                        RelativeSizeAxes = Axes.Both,
+                                        Colour = middle_layer_colour,
+                                    },
+                                    new CoverBackground
+                                    {
+                                        RelativeSizeAxes = Axes.Both,
+                                        Model = simulation.Score.User,
+                                        Colour = ColourInfo.GradientVertical(Color4.White.Opacity(0.5f), Color4Extensions.FromHex("#444").Opacity(0))
+                                    }
+                                }
+                            },
+                            middleContent = new SimulationPanelMiddleContent(simulation, difficulty) { Instant = instant },
+                        }
+                    },
+                };
+            }
+        }
+    }
+}
