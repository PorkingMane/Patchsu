diff --git a/osu.Game/Screens/Ranking/Simulation/EditableStatistic.cs b/osu.Game/Screens/Ranking/Simulation/EditableStatistic.cs
new file mode 100644
index 0000000000..36293b47ae
--- /dev/null
+++ b/osu.Game/Screens/Ranking/Simulation/EditableStatistic.cs
@@ -0,0 +1,380 @@
+// Added by Patchsu
+
+using System;
+using osu.Framework.Allocation;
+using osu.Framework.Extensions.Color4Extensions;
+using osu.Framework.Graphics;
+using osu.Framework.Graphics.Containers;
+using osu.Framework.Graphics.Cursor;
+using osu.Framework.Graphics.Sprites;
+using osu.Framework.Input;
+using osu.Framework.Input.Events;
+using osu.Framework.Localisation;
+using osu.Game.Graphics;
+using osu.Game.Graphics.Sprites;
+using osu.Game.Graphics.UserInterface;
+using osu.Game.Screens.Ranking.Expanded.Accuracy;
+using osu.Game.Screens.Ranking.Expanded.Statistics;
+using osu.Game.Utils;
+using osuTK;
+using osuTK.Graphics;
+using osuTK.Input;
+
+namespace osu.Game.Screens.Ranking.Simulation
+{
+    /// <summary>
+    /// Patchsu: a results screen statistic that can be typed into.
+    /// It shows the results screen's own rolling counter (same font, format and roll); clicking it (or Tab) swaps in a text box until focus leaves.
+    /// </summary>
+    public partial class EditableStatistic : StatisticDisplay, IHasTooltip
+    {
+        /// <summary>
+        /// Called with the text on every keystroke.
+        /// </summary>
+        public Action<string>? Typed;
+
+        /// <summary>
+        /// The value the counter rolls to.
+        /// </summary>
+        public Func<double> Value = () => 0;
+
+        /// <summary>
+        /// The text put into the box when editing starts.
+        /// </summary>
+        public Func<string> EditText = () => string.Empty;
+
+        /// <summary>
+        /// Text after the counter, like the results screen's "/123" maximums.
+        /// </summary>
+        public Func<string?>? SuffixText;
+
+        /// <summary>
+        /// Shows the value like the results screen's accuracy ("98.76%", not rounded up), and allows decimals.
+        /// </summary>
+        public bool IsAccuracy { get; init; }
+
+        public bool AllowDecimal { get; init; }
+
+        public Color4? HeaderColour { get; init; }
+
+        public LocalisableString TooltipText { get; set; }
+
+        public SimulationNumberBox Box { get; private set; } = null!;
+
+        private Drawable display = null!;
+        private Drawable counterDrawable = null!;
+        private OsuSpriteText? suffix;
+        private Drawable? extra;
+
+        private Action<double> setCounter = null!;
+        private bool appeared;
+        private bool updatingText;
+
+        public EditableStatistic(LocalisableString header)
+            : base(header)
+        {
+        }
+
+        /// <summary>
+        /// Something shown after the counter (like the combo's "PERFECT").
+        /// </summary>
+        public Drawable? Extra
+        {
+            init => extra = value;
+        }
+
+        protected override Drawable CreateContent()
+        {
+            Drawable counter;
+
+            if (IsAccuracy)
+            {
+                var accuracyCounter = new AccuracyCounter { Anchor = Anchor.TopCentre, Origin = Anchor.TopCentre };
+                setCounter = v => accuracyCounter.Current.Value = v;
+                counter = accuracyCounter;
+            }
+            else
+            {
+                var intCounter = new StatisticCounter { Anchor = Anchor.TopCentre, Origin = Anchor.TopCentre };
+                setCounter = v => intCounter.Current.Value = (int)Math.Round(v, MidpointRounding.AwayFromZero);
+                counter = intCounter;
+            }
+
+            // laid out like CounterStatistic / ComboStatistic.
+            var counterFlow = new FillFlowContainer
+            {
+                AutoSizeAxes = Axes.Both,
+                Direction = FillDirection.Horizontal,
+                Child = counterDrawable = counter,
+            };
+
+            if (SuffixText != null)
+            {
+                counterFlow.Add(suffix = new OsuSpriteText
+                {
+                    Anchor = Anchor.BottomCentre,
+                    Origin = Anchor.BottomCentre,
+                    Font = OsuFont.Torus.With(size: 12, fixedWidth: true),
+                    Spacing = new Vector2(-2, 0),
+                });
+            }
+
+            if (extra != null)
+            {
+                counterFlow.Anchor = counterFlow.Origin = Anchor.CentreLeft;
+                extra.Anchor = extra.Origin = Anchor.CentreLeft;
+
+                display = new FillFlowContainer
+                {
+                    AutoSizeAxes = Axes.Both,
+                    Direction = FillDirection.Horizontal,
+                    Spacing = new Vector2(10, 0),
+                    Children = new[] { counterFlow, extra },
+                };
+            }
+            else
+                display = counterFlow;
+
+            // only the number hides behind the box (the "/max" and PERFECT stay visible), and it stays laid out so nothing moves.
+            display.AlwaysPresent = true;
+            counter.AlwaysPresent = true;
+
+            return new Container
+            {
+                AutoSizeAxes = Axes.Both,
+                Children = new[]
+                {
+                    display,
+                    Box = new SimulationNumberBox(AllowDecimal || IsAccuracy)
+                    {
+                        // positioned in Update so its text sits exactly on the counter's text.
+                        Anchor = Anchor.TopLeft,
+                        Origin = Anchor.TopLeft,
+                        BypassAutoSizeAxes = Axes.Both,
+                        Alpha = 0,
+                        AlwaysPresent = true,
+                    },
+                }
+            };
+        }
+
+        protected override void LoadComplete()
+        {
+            base.LoadComplete();
+
+            if (HeaderColour != null)
+                HeaderText.Colour = HeaderColour.Value;
+
+            Box.Current.BindValueChanged(text =>
+            {
+                if (updatingText || !Box.HasFocus)
+                    return;
+
+                Typed?.Invoke(text.NewValue);
+            });
+
+            Box.Focused = () =>
+            {
+                SetText(EditText());
+                Box.Alpha = 1;
+                counterDrawable.Alpha = 0;
+            };
+
+            Box.FocusLost = () =>
+            {
+                Box.Alpha = 0;
+                counterDrawable.Alpha = 1;
+                Refresh();
+            };
+
+            Refresh();
+        }
+
+        protected override void Update()
+        {
+            base.Update();
+
+            // the typed number starts exactly where the counter's number starts (and grows to the right).
+            var counterTopLeft = counterDrawable.ToSpaceOfOtherDrawable(Vector2.Zero, Box.Parent!);
+            Box.X = counterTopLeft.X - Box.TextLeft;
+            Box.Y = counterTopLeft.Y - Box.TextTop;
+
+            // the box (and a typed number longer than the counter's) pushes the "/max" along instead of covering it.
+            if (suffix != null)
+            {
+                float push = Box.HasFocus ? Math.Max(0, Box.TextWidth - counterDrawable.DrawWidth) + Box.TextLeft : 0;
+
+                if (suffix.Margin.Left != push)
+                    suffix.Margin = new MarginPadding { Left = push };
+            }
+        }
+
+        protected override bool OnClick(ClickEvent e)
+        {
+            // anywhere on the statistic (like the "/max" part) starts editing too.
+            if (!Box.HasFocus && !Box.Current.Disabled)
+                GetContainingFocusManager()?.ChangeFocus(Box);
+
+            return true;
+        }
+
+        public override void Appear()
+        {
+            base.Appear();
+
+            appeared = true;
+            Refresh();
+        }
+
+        /// <summary>
+        /// Rolls the counter to the current value (once the statistic has appeared, like on the results screen).
+        /// </summary>
+        public void Refresh()
+        {
+            if (suffix != null)
+                suffix.Text = SuffixText?.Invoke() ?? string.Empty;
+
+            if (appeared)
+                setCounter(Value());
+        }
+
+        /// <summary>
+        /// Replaces the box's text without it counting as typing.
+        /// </summary>
+        public void SetText(string text)
+        {
+            if (Box.Text == text)
+                return;
+
+            updatingText = true;
+            Box.Text = text;
+            updatingText = false;
+        }
+
+        /// <summary>
+        /// The results screen's accuracy counter (<see cref="AccuracyStatistic"/>'s).
+        /// </summary>
+        private partial class AccuracyCounter : RollingCounter<double>
+        {
+            protected override double RollingDuration => AccuracyCircle.ACCURACY_TRANSFORM_DURATION / 2;
+            protected override Easing RollingEasing => Easing.OutQuad;
+
+            protected override LocalisableString FormatCount(double count) => count.FormatAccuracy();
+
+            protected override OsuSpriteText CreateSpriteText() => base.CreateSpriteText().With(s =>
+            {
+                s.Font = OsuFont.Torus.With(size: 20, fixedWidth: true);
+                s.Spacing = new Vector2(-2, 0);
+            });
+        }
+    }
+
+    /// <summary>
+    /// Patchsu: the text box of an <see cref="EditableStatistic"/>, in the results screen's number font. It sizes itself to its text.
+    /// </summary>
+    public partial class SimulationNumberBox : OsuTextBox
+    {
+        private const float font_size = 20;
+
+        private readonly bool allowDecimal;
+
+        /// <summary>
+        /// Called when Tab (or Shift+Tab) is pressed, with +1 or -1.
+        /// </summary>
+        public Action<SimulationNumberBox, int>? TabPressed;
+
+        public Action? Focused;
+
+        public Action? FocusLost;
+
+        /// <summary>
+        /// Where the text starts, from the top of the box.
+        /// </summary>
+        public float TextTop => (DrawHeight - TextContainer.DrawHeight) / 2;
+
+        /// <summary>
+        /// Where the text starts, from the left of the box.
+        /// </summary>
+        public float TextLeft => LeftRightPadding;
+
+        /// <summary>
+        /// The width of the typed text.
+        /// </summary>
+        public float TextWidth => measure.DrawWidth;
+
+        private OsuSpriteText measure = null!;
+
+        public SimulationNumberBox(bool allowDecimal = false)
+        {
+            this.allowDecimal = allowDecimal;
+
+            DrawBorder = false;
+            Height = font_size + 2;
+            TextContainer.Height = font_size / (font_size + 2);
+            CornerRadius = 4;
+            LengthLimit = 9;
+            SelectAllOnFocus = true;
+            CommitOnFocusLost = true;
+            // "Decimal" only accepts the system locale's separator, so decimals use plain text and CanAddCharacter does the filtering.
+            InputProperties = new TextInputProperties(allowDecimal ? TextInputType.Text : TextInputType.Number, false);
+            Width = 30;
+        }
+
+        protected override float LeftRightPadding => 4;
+
+        protected override FontUsage Font => OsuFont.Torus.With(size: font_size, fixedWidth: true);
+
+        protected override bool CanAddCharacter(char character) => char.IsAsciiDigit(character) || (allowDecimal && (character == '.' || character == ','));
+
+        [BackgroundDependencyLoader]
+        private void load()
+        {
+            BackgroundUnfocused = Color4.Black.Opacity(0);
+            BackgroundFocused = Color4.Black.Opacity(0.35f);
+            BackgroundCommit = Color4.White.Opacity(0.2f);
+
+            TextFlow.Spacing = new Vector2(-2, 0);
+
+            AddInternal(measure = new OsuSpriteText
+            {
+                Font = Font,
+                Spacing = new Vector2(-2, 0),
+                Alpha = 0,
+                AlwaysPresent = true,
+                BypassAutoSizeAxes = Axes.Both,
+            });
+        }
+
+        protected override void Update()
+        {
+            base.Update();
+
+            measure.Text = string.IsNullOrEmpty(Text) ? "0" : Text;
+            Width = measure.DrawWidth + LeftRightPadding * 2;
+        }
+
+        protected override bool OnKeyDown(KeyDownEvent e)
+        {
+            if (e.Key == Key.Tab && TabPressed != null)
+            {
+                TabPressed(this, e.ShiftPressed ? -1 : 1);
+                return true;
+            }
+
+            return base.OnKeyDown(e);
+        }
+
+        protected override void OnFocus(FocusEvent e)
+        {
+            // the text is set before the base selects all of it.
+            Focused?.Invoke();
+            base.OnFocus(e);
+        }
+
+        protected override void OnFocusLost(FocusLostEvent e)
+        {
+            base.OnFocusLost(e);
+            FocusLost?.Invoke();
+        }
+    }
+}
diff --git a/osu.Game/Screens/Ranking/Simulation/PerformanceSimulation.cs b/osu.Game/Screens/Ranking/Simulation/PerformanceSimulation.cs
new file mode 100644
index 0000000000..f5580b2ba9
--- /dev/null
+++ b/osu.Game/Screens/Ranking/Simulation/PerformanceSimulation.cs
@@ -0,0 +1,568 @@
+// Added by Patchsu
+
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using osu.Framework.Logging;
+using osu.Game.Database;
+using osu.Game.Rulesets;
+using osu.Game.Rulesets.Difficulty;
+using osu.Game.Rulesets.Scoring;
+using osu.Game.Scoring;
+
+namespace osu.Game.Screens.Ranking.Simulation
+{
+    /// <summary>
+    /// Patchsu: the numbers behind the PP simulation screen.
+    /// Every edit goes through here, which keeps the judgements consistent with each other and recomputes accuracy, rank, score and PP.
+    /// </summary>
+    /// <remarks>
+    /// The rules (osu! ruleset):
+    /// <list type="bullet">
+    /// <item>Judgements (300 / 100 / 50 / miss) always add up to the number of objects. Changing one moves the difference to or from the 300s.</item>
+    /// <item>Judgements never change the combo, the slider ticks or the slider ends, but every miss lowers the highest possible combo by 1.</item>
+    /// <item>Every missed slider tick lowers the highest possible combo by 2, every missed slider end by 1.</item>
+    /// <item>Once a change leaves no misses and no missed slider ticks, the combo becomes the highest possible
+    /// (the max combo minus the dropped slider ends), so fixing a choke is one edit.</item>
+    /// <item>Typing an accuracy or a PP value keeps misses, slider ticks, slider ends and combo, and turns 300s into 100s
+    /// (and, if 100s alone can't go low enough, 100s into 50s) until the value is reached.</item>
+    /// </list>
+    /// </remarks>
+    public class PerformanceSimulation
+    {
+        /// <summary>
+        /// Raised after any value changed.
+        /// </summary>
+        public event Action? Changed;
+
+        /// <summary>
+        /// The simulated score. Its statistics, combo, accuracy, rank, total score and PP are kept up to date.
+        /// </summary>
+        public readonly ScoreInfo Score;
+
+        /// <summary>
+        /// The judgement counts of a perfect play on this beatmap with these mods.
+        /// </summary>
+        public readonly IReadOnlyDictionary<HitResult, int> Maximum;
+
+        /// <summary>
+        /// The highest combo the beatmap allows.
+        /// </summary>
+        public readonly int MaximumCombo;
+
+        /// <summary>
+        /// The number of basic judgements (300 / 100 / 50 / miss) in the beatmap.
+        /// </summary>
+        public readonly int BasicTotal;
+
+        /// <summary>
+        /// The basic judgements, best first (300, 100, 50, miss).
+        /// </summary>
+        public readonly IReadOnlyList<HitResult> BasicResults;
+
+        /// <summary>
+        /// The slider tick / slider end results present in this beatmap.
+        /// </summary>
+        public readonly IReadOnlyList<HitResult> TickResults;
+
+        /// <summary>
+        /// The calculated PP, or <see langword="null"/> if it can't be calculated (no difficulty attributes).
+        /// </summary>
+        public double? Performance { get; private set; }
+
+        public bool CanCalculatePerformance => performanceCalculator != null && attributes != null;
+
+        private readonly ScoreProcessor processor;
+        private readonly PerformanceCalculator? performanceCalculator;
+        private readonly DifficultyAttributes? attributes;
+        private readonly double scoreMultiplier;
+
+        private readonly HitResult topResult;
+        private readonly HitResult secondResult;
+        private readonly HitResult thirdResult;
+
+        private readonly Dictionary<HitResult, int> initialStatistics;
+        private readonly int initialCombo;
+        private readonly long initialTotalScore;
+        private readonly long? initialLegacyTotalScore;
+        private readonly double comboCalibration = 1;
+
+        /// <param name="template">The starting score (a saved score, or a perfect play). It is not modified.</param>
+        /// <param name="maximum">The judgement counts of a perfect play.</param>
+        /// <param name="attributes">The difficulty attributes for the beatmap and mods, used for PP.</param>
+        /// <param name="calibrateScore">Whether <paramref name="template"/>'s total score is a real one that the score estimate can be calibrated against.</param>
+        public PerformanceSimulation(ScoreInfo template, IReadOnlyDictionary<HitResult, int> maximum, DifficultyAttributes? attributes, bool calibrateScore)
+        {
+            Score = template.DeepClone();
+
+            // Cloning drops the score's built mods: without this, every read of Score.Mods (the PP calculator alone reads them many times
+            // per calculation) would build new mod instances.
+            Score.Mods = Score.Mods;
+            Maximum = new Dictionary<HitResult, int>(maximum);
+
+            Ruleset ruleset = Score.Ruleset.CreateInstance();
+
+            processor = ruleset.CreateScoreProcessor();
+            performanceCalculator = ruleset.CreatePerformanceCalculator();
+            this.attributes = attributes;
+
+            scoreMultiplier = Score.BeatmapInfo == null
+                ? 1
+                : ruleset.CreateScoreMultiplierCalculator(new ScoreMultiplierContext(Score.BeatmapInfo.Difficulty)).CalculateFor(Score.Mods);
+
+            MaximumCombo = Maximum.Where(kvp => kvp.Key.AffectsCombo()).Sum(kvp => kvp.Value);
+            BasicTotal = Maximum.Where(kvp => kvp.Key.IsBasic()).Sum(kvp => kvp.Value);
+
+            BasicResults = ruleset.GetHitResultsForDisplay()
+                                  .Select(r => r.result)
+                                  .Where(r => r.IsBasic())
+                                  .OrderByDescending(r => r.IsHit())
+                                  .ThenByDescending(processor.GetBaseScoreForResult)
+                                  .ToArray();
+
+            TickResults = ruleset.GetHitResultsForDisplay()
+                                 .Select(r => r.result)
+                                 .Where(r => missResultFor(r) != null && Maximum.GetValueOrDefault(r) > 0)
+                                 .ToArray();
+
+            var hits = BasicResults.Where(r => r.IsHit()).ToArray();
+            topResult = hits.ElementAtOrDefault(0);
+            secondResult = hits.ElementAtOrDefault(1);
+            thirdResult = hits.ElementAtOrDefault(2);
+
+            initialStatistics = new Dictionary<HitResult, int>(Score.Statistics);
+            initialCombo = Score.MaxCombo;
+            initialTotalScore = Score.TotalScore;
+            initialLegacyTotalScore = Score.LegacyTotalScore;
+
+            if (calibrateScore && !Score.IsLegacyScore && Score.TotalScore > 0 && scoreMultiplier > 0)
+            {
+                // Lazer's score depends on where in the map the combo breaks happened, which a list of counts can't tell.
+                // The estimate below is calibrated so the score's own statistics give back its real total score.
+                double accuracy = computeAccuracy();
+                double realComboProgress = (Score.TotalScore / scoreMultiplier - bonusPortion() - 500000 * Math.Pow(accuracy, 5)) / (500000 * accuracy);
+                double estimatedComboProgress = estimateComboProgress();
+
+                if (accuracy > 0 && estimatedComboProgress > 0 && realComboProgress > 0)
+                    comboCalibration = Math.Clamp(realComboProgress / estimatedComboProgress, 0.5, 2);
+            }
+
+            recalculate(notify: false);
+        }
+
+        public int Get(HitResult result) => Score.Statistics.GetValueOrDefault(result);
+
+        public int GetMaximum(HitResult result) => Maximum.GetValueOrDefault(result);
+
+        public int Combo => Score.MaxCombo;
+
+        public double Accuracy => Score.Accuracy;
+
+        public bool IsModified => Score.MaxCombo != initialCombo || !statisticsEqual(Score.Statistics, initialStatistics);
+
+        /// <summary>
+        /// The highest combo still possible with the current misses, slider tick misses and slider end misses.
+        /// </summary>
+        public int ComboCap
+        {
+            get
+            {
+                int loss = Get(HitResult.Miss);
+
+                foreach (var tick in TickResults)
+                    loss += (GetMaximum(tick) - Get(tick)) * (tick == HitResult.LargeTickHit ? 2 : 1);
+
+                return Math.Max(0, MaximumCombo - loss);
+            }
+        }
+
+        /// <summary>
+        /// Whether nothing breaks the combo: no misses and no missed slider ticks (dropped slider ends don't break it).
+        /// </summary>
+        public bool HasNoComboBreaks => Get(HitResult.Miss) == 0 && Get(HitResult.LargeTickHit) >= GetMaximum(HitResult.LargeTickHit);
+
+        /// <summary>
+        /// Sets a judgement count (300 / 100 / 50 / miss) or a slider tick / slider end hit count.
+        /// </summary>
+        /// <returns>The value that was actually applied after clamping.</returns>
+        public int SetCount(HitResult result, int value)
+        {
+            if (BasicResults.Contains(result))
+                changeKeepingCombo(() => setBasic(result, value));
+            else if (TickResults.Contains(result))
+                changeKeepingCombo(() => setTick(result, value));
+
+            return Get(result);
+        }
+
+        /// <returns>The value that was actually applied after clamping.</returns>
+        public int SetCombo(int value)
+        {
+            Score.MaxCombo = Math.Clamp(value, 0, ComboCap);
+            recalculate();
+            return Score.MaxCombo;
+        }
+
+        /// <summary>
+        /// Moves 300s / 100s / 50s until the accuracy is as close as possible to <paramref name="accuracy"/> (0..1).
+        /// </summary>
+        public void SetAccuracy(double accuracy)
+        {
+            accuracy = Math.Clamp(accuracy, 0, 1);
+            distribute(computeAccuracy, accuracy);
+        }
+
+        /// <summary>
+        /// Moves 300s / 100s / 50s until the PP is as close as possible to <paramref name="performance"/>.
+        /// </summary>
+        public void SetPerformance(double performance)
+        {
+            if (!CanCalculatePerformance)
+                return;
+
+            distribute(() => computePerformance() ?? 0, Math.Max(0, performance));
+        }
+
+        /// <summary>
+        /// Goes back to the starting values.
+        /// </summary>
+        public void Reset()
+        {
+            Score.Statistics = new Dictionary<HitResult, int>(initialStatistics);
+            Score.MaxCombo = initialCombo;
+            recalculate();
+        }
+
+        /// <summary>
+        /// Whether every judgement, slider tick and slider end is perfect and the combo is full.
+        /// </summary>
+        public bool IsPerfect => Score.MaxCombo >= MaximumCombo
+                                 && (topResult == default || Get(topResult) >= BasicTotal)
+                                 && TickResults.All(t => Get(t) >= GetMaximum(t));
+
+        /// <summary>
+        /// Sets everything to a perfect play (spinner bonus is left as it is).
+        /// </summary>
+        public void SetPerfect()
+        {
+            foreach (var tick in TickResults)
+                setTick(tick, GetMaximum(tick));
+
+            if (topResult != default)
+                setBasic(topResult, BasicTotal);
+
+            Score.MaxCombo = MaximumCombo;
+            recalculate();
+        }
+
+        /// <summary>
+        /// Whether there is nothing left for <see cref="FixChoke"/> to fix: no misses, every slider tick hit and the combo at its limit.
+        /// </summary>
+        public bool IsChokeFixed => Get(HitResult.Miss) == 0
+                                    && Get(HitResult.LargeTickHit) >= GetMaximum(HitResult.LargeTickHit)
+                                    && Score.MaxCombo >= ComboCap;
+
+        /// <summary>
+        /// The play without its chokes: every miss becomes a 100 (or a 300 with <paramref name="missesBecomeGreat"/>),
+        /// every slider tick is hit and the combo goes to its limit. 100s, 50s and slider ends stay as they are.
+        /// </summary>
+        public void FixChoke(bool missesBecomeGreat)
+        {
+            if (TickResults.Contains(HitResult.LargeTickHit))
+                setTick(HitResult.LargeTickHit, GetMaximum(HitResult.LargeTickHit));
+
+            int misses = Get(HitResult.Miss);
+
+            if (topResult != default && misses > 0 && BasicResults.Contains(HitResult.Miss))
+            {
+                // the misses go to the 300s first; as 100s they're then taken back from there.
+                setBasic(HitResult.Miss, 0);
+
+                if (!missesBecomeGreat && secondResult != default)
+                    setBasic(secondResult, Get(secondResult) + misses);
+            }
+
+            Score.MaxCombo = ComboCap;
+            recalculate();
+        }
+
+        /// <summary>
+        /// Copies the judgements, slider ticks, slider ends and combo of another simulation of the same beatmap (with other mods),
+        /// as far as they fit this one.
+        /// </summary>
+        public void CopyFrom(PerformanceSimulation other)
+        {
+            foreach (var tick in TickResults)
+                setTick(tick, other.GetMaximum(tick) > 0 ? other.Get(tick) : GetMaximum(tick));
+
+            foreach (var result in BasicResults.Where(r => r != topResult))
+                setBasic(result, other.Get(result));
+
+            Score.MaxCombo = other.Combo >= other.ComboCap ? ComboCap : Math.Clamp(other.Combo, 0, ComboCap);
+            recalculate();
+        }
+
+        private void setBasic(HitResult result, int value)
+        {
+            var statistics = Score.Statistics;
+
+            if (result == topResult)
+            {
+                value = Math.Clamp(value, 0, BasicTotal);
+                int diff = value - Get(topResult);
+
+                if (diff > 0)
+                {
+                    // More 300s: take them from the 100s first, then the 50s, then the misses.
+                    foreach (var other in BasicResults.Where(r => r != topResult))
+                    {
+                        int take = Math.Min(diff, Get(other));
+                        statistics[other] = Get(other) - take;
+                        diff -= take;
+                    }
+                }
+                else if (diff < 0)
+                {
+                    // Fewer 300s: they become 100s.
+                    HitResult target = secondResult != default ? secondResult : BasicResults.Last();
+                    statistics[target] = Get(target) - diff;
+                }
+
+                statistics[topResult] = value;
+                return;
+            }
+
+            int others = BasicResults.Where(r => r != topResult && r != result).Sum(Get);
+            value = Math.Clamp(value, 0, Math.Max(0, BasicTotal - others));
+
+            statistics[result] = value;
+            statistics[topResult] = BasicTotal - others - value;
+        }
+
+        private void setTick(HitResult result, int value)
+        {
+            int max = GetMaximum(result);
+            value = Math.Clamp(value, 0, max);
+
+            Score.Statistics[result] = value;
+
+            HitResult? miss = missResultFor(result);
+
+            if (miss != null && miss != HitResult.IgnoreMiss)
+                Score.Statistics[miss.Value] = max - value;
+        }
+
+        /// <summary>
+        /// Applies a change, then limits the combo to the new <see cref="ComboCap"/>.
+        /// A combo that was at the cap follows it (so removing a miss again gives the combo back),
+        /// and with nothing left that breaks the combo it goes to the cap (fixing a choke).
+        /// </summary>
+        private void changeKeepingCombo(Action change)
+        {
+            int capBefore = ComboCap;
+            bool atCap = Score.MaxCombo >= capBefore;
+
+            change();
+
+            int cap = ComboCap;
+            Score.MaxCombo = atCap || HasNoComboBreaks ? cap : Math.Min(Score.MaxCombo, cap);
+
+            recalculate();
+        }
+
+        /// <summary>
+        /// Keeps misses, ticks, slider ends and combo, and finds the split of the remaining judgements into 300s / 100s / 50s
+        /// whose <paramref name="metric"/> is closest to <paramref name="target"/>.
+        /// </summary>
+        /// <remarks>
+        /// Step k (0..2n, n = judgements that aren't misses): k ≤ n gives k 100s, k &gt; n gives no 300s and k - n 50s (the rest 100s).
+        /// The metric only goes down as k goes up, so a binary search finds it.
+        /// </remarks>
+        private void distribute(Func<double> metric, double target)
+        {
+            if (topResult == default)
+                return;
+
+            // the real-score slider break guess of stable scores doesn't apply to changed judgements.
+            Score.LegacyTotalScore = null;
+
+            int misses = BasicResults.Where(r => !r.IsHit()).Sum(Get);
+            int n = Math.Max(0, BasicTotal - misses);
+            int maxStep = secondResult == default ? 0 : thirdResult == default ? n : 2 * n;
+
+            double valueAt(int k)
+            {
+                applyStep(k, n);
+                Score.Accuracy = computeAccuracy();
+                return metric();
+            }
+
+            int step;
+
+            if (valueAt(0) <= target)
+                step = 0;
+            else if (valueAt(maxStep) >= target)
+                step = maxStep;
+            else
+            {
+                // smallest k with value <= target.
+                int lo = 0, hi = maxStep;
+
+                while (hi - lo > 1)
+                {
+                    int mid = (lo + hi) / 2;
+
+                    if (valueAt(mid) <= target)
+                        hi = mid;
+                    else
+                        lo = mid;
+                }
+
+                step = Math.Abs(valueAt(lo) - target) <= Math.Abs(valueAt(hi) - target) ? lo : hi;
+            }
+
+            applyStep(step, n);
+            recalculate();
+        }
+
+        private void applyStep(int k, int n)
+        {
+            int ok = k <= n ? k : 2 * n - k;
+            int meh = k <= n ? 0 : k - n;
+
+            Score.Statistics[topResult] = n - ok - meh;
+
+            if (secondResult != default)
+                Score.Statistics[secondResult] = ok;
+
+            if (thirdResult != default)
+                Score.Statistics[thirdResult] = meh;
+        }
+
+        private void recalculate(bool notify = true)
+        {
+            bool modified = IsModified;
+
+            Score.Accuracy = computeAccuracy();
+            Score.Rank = StandardisedScoreMigrationTools.ComputeRank(Score.Accuracy, Score.Statistics, Score.Mods, processor);
+            Score.Passed = true;
+
+            // A stable score's PP uses its real score to guess the slider breaks; that only fits while nothing was changed.
+            Score.LegacyTotalScore = modified ? null : initialLegacyTotalScore;
+            Score.TotalScore = modified || initialTotalScore <= 0 ? estimateTotalScore() : initialTotalScore;
+
+            Performance = computePerformance();
+            Score.PP = Performance;
+
+            if (notify)
+                Changed?.Invoke();
+        }
+
+        private double computeAccuracy() => StandardisedScoreMigrationTools.ComputeAccuracy(Score.Statistics, Maximum, processor);
+
+        private double? computePerformance()
+        {
+            if (performanceCalculator == null || attributes == null)
+                return null;
+
+            try
+            {
+                double pp = performanceCalculator.Calculate(Score, attributes).Total;
+                return double.IsFinite(pp) ? pp : null;
+            }
+            catch (Exception e)
+            {
+                Logger.Log($"PP simulation: performance calculation failed ({e.Message})", LoggingTarget.Runtime, LogLevel.Debug);
+                return null;
+            }
+        }
+
+        private double bonusPortion() => Score.Statistics.Where(kvp => kvp.Key.IsBonus()).Sum(kvp => (double)kvp.Value * processor.GetBaseScoreForResult(kvp.Key));
+
+        /// <summary>
+        /// Lazer's standardised score: 500,000 × accuracy × combo progress + 500,000 × accuracy⁵ + bonus, times the mod multiplier.
+        /// The combo progress is estimated from the max combo and the number of combo breaks.
+        /// </summary>
+        private long estimateTotalScore()
+        {
+            double accuracy = Score.Accuracy;
+            double comboProgress = Math.Clamp(estimateComboProgress() * comboCalibration, 0, 1);
+
+            if (Score.MaxCombo >= MaximumCombo)
+                comboProgress = 1;
+
+            double total = 500000 * accuracy * comboProgress + 500000 * Math.Pow(accuracy, 5) + bonusPortion();
+            return (long)Math.Round(total * scoreMultiplier);
+        }
+
+        /// <summary>
+        /// The combo part of the score is the sum of √combo over every object. This assumes one stretch at the max combo
+        /// and the other objects split evenly between the combo breaks.
+        /// </summary>
+        private double estimateComboProgress()
+        {
+            int total = MaximumCombo;
+
+            if (total <= 0)
+                return 1;
+
+            int maxCombo = Math.Clamp(Score.MaxCombo, 0, total);
+
+            int breaks = Get(HitResult.Miss) + Get(HitResult.LargeTickMiss);
+            int lost = MaximumCombo - ComboCap - Get(HitResult.LargeTickMiss); // objects that give no combo (a tick miss counts once here)
+            int rest = Math.Max(0, total - maxCombo - Math.Max(0, lost));
+
+            double sum = sqrtSum(maxCombo);
+
+            if (rest > 0)
+            {
+                int segments = Math.Max(1, breaks);
+                double length = Math.Max(1, Math.Min((double)rest / segments, Math.Max(1, maxCombo)));
+                sum += sqrtSum(length) * (rest / length);
+            }
+
+            return Math.Clamp(sum / sqrtSum(total), 0, 1);
+        }
+
+        /// <summary>
+        /// ≈ √1 + √2 + … + √n.
+        /// </summary>
+        private static double sqrtSum(double n) => n <= 0 ? 0 : Math.Max(0, 2.0 / 3 * Math.Pow(n, 1.5) + 0.5 * Math.Sqrt(n) - 0.2079);
+
+        private static HitResult? missResultFor(HitResult result)
+        {
+            switch (result)
+            {
+                case HitResult.LargeTickHit:
+                    return HitResult.LargeTickMiss;
+
+                case HitResult.SmallTickHit:
+                    return HitResult.SmallTickMiss;
+
+                case HitResult.SliderTailHit:
+                    return HitResult.IgnoreMiss;
+
+                default:
+                    return null;
+            }
+        }
+
+        private static bool statisticsEqual(Dictionary<HitResult, int> a, Dictionary<HitResult, int> b)
+        {
+            // Read every frame (footer buttons), so without allocating.
+            foreach (var (key, value) in a)
+            {
+                if (b.GetValueOrDefault(key) != value)
+                    return false;
+            }
+
+            foreach (var (key, value) in b)
+            {
+                if (a.GetValueOrDefault(key) != value)
+                    return false;
+            }
+
+            return true;
+        }
+    }
+}
