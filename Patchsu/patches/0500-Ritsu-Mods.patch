@@ -0,0 +1,50 @@
+// Copyright (c) ppy Pty Ltd <contact@ppy.sh>. Licensed under the MIT Licence.
+// See the LICENCE file in the repository root for full licence text.
+
+using osu.Game.Graphics;
+using osu.Framework.Graphics.Sprites;
+using osu.Game.Rulesets.Mods;
+using System.Collections.Generic;
+using System;
+using osu.Framework.Localisation;
+using osu.Game.Rulesets.Osu.Beatmaps;
+using osu.Game.Rulesets.Osu.Objects;
+
+namespace osu.Game.Rulesets.Osu.Mods
+{
+    public class OsuModHalfStream : OsuModBeatmapVariant
+    {
+        public override string Name => "Streamline";
+        public override ModType Type => ModType.DifficultyReduction;
+        public override IconUsage? Icon => OsuIcon.ModStreamline;
+        public override string Acronym => "SL";
+        public override LocalisableString Description => "Streams are... No more?";
+
+        protected override void ApplyVariant(OsuBeatmap beatmap)
+        {
+            var objects = beatmap.HitObjects;
+            var kept = new List<OsuHitObject>(objects.Count);
+            for (int start = 0; start < objects.Count;)
+            {
+                int end = start + 1;
+                if (objects[start] is HitCircle)
+                {
+                    var timing = beatmap.ControlPointInfo.TimingPointAt(objects[start].StartTime);
+                    while (end < objects.Count && objects[end] is HitCircle && beatmap.ControlPointInfo.TimingPointAt(objects[end].StartTime) == timing &&
+                           Math.Abs(objects[end].StartTime - objects[end - 1].StartTime - timing.BeatLength / 4) <= 1)
+                        end++;
+                }
+
+                for (int i = start; i < end; i++)
+                {
+                    if (end - start < 7 || i == end - 1 || objects[i].NewCombo || (i - start) % 2 == 0)
+                        kept.Add(objects[i]);
+                }
+
+                start = end;
+            }
+
+            beatmap.HitObjects = kept;
+        }
+    }
+}
diff --git a/osu.Game.Rulesets.Osu/Mods/OsuModMetronome.cs b/osu.Game.Rulesets.Osu/Mods/OsuModMetronome.cs
new file mode 100644
index 0000000000..6f9c21dd79
--- /dev/null
+++ b/osu.Game.Rulesets.Osu/Mods/OsuModMetronome.cs
@@ -0,0 +1,134 @@
+// Adapted from Modosu (Azuuryy), derived from MOsu (p-720), GPL-3.0.
+// See LICENCE-Modosu.txt in the distribution.
+using System.Linq;
+using osu.Framework.Audio;
+using osu.Framework.Audio.Track;
+using osu.Framework.Bindables;
+using osu.Framework.Graphics.Sprites;
+using osu.Framework.Graphics;
+using osu.Framework.Localisation;
+using osu.Game.Configuration;
+using osu.Game.Beatmaps.ControlPoints;
+using osu.Game.Beatmaps.Timing;
+using osu.Game.Graphics;
+using osu.Game.Graphics.UserInterface;
+using osu.Game.Overlays.Settings;
+using osu.Game.Rulesets.Mods;
+using osu.Game.Rulesets.Osu.Objects;
+using osu.Game.Rulesets.UI;
+
+namespace osu.Game.Rulesets.Osu.Mods
+{
+    public partial class OsuModMetronome : Mod, IApplicableToDrawableRuleset<OsuHitObject>, IModosuMod
+#if PATCHSU_REPLAY_MOD_TOGGLES
+        , IToggleableInReplay
+#endif
+    {
+        public override bool Ranked => false;
+        public override bool AlwaysValidForSubmission => false;
+        public override bool ValidForMultiplayer => false;
+        public override bool ValidForMultiplayerAsFreeMod => false;
+
+        public override string Name => "Metronome";
+
+        public override LocalisableString Description =>
+            "Plays metronome ticks at a configurable rate relative to the beatmap BPM, with a higher-pitched accent on the downbeat.";
+
+        public override string Acronym => "ME";
+
+        public override ModType Type => ModType.Fun;
+
+        public override IconUsage? Icon => OsuIcon.Metronome;
+
+        [SettingSource(
+            "Tempo scale",
+            "Choose the metronome rate relative to the beatmap BPM.",
+            SettingControlType = typeof(MetronomeScaleSetting))]
+        public BindableInt TempoScale { get; } = new BindableInt(4)
+        {
+            MinValue = 1,
+            MaxValue = 16,
+            Default = 4,
+        };
+
+#if PATCHSU_REPLAY_MOD_TOGGLES
+        // Patchsu (replay mod toggles, built when 0005 is applied): silences the ticks while the mod is switched off in a replay.
+        private readonly BindableDouble replayVolume = new BindableDouble(1);
+
+        public void SetReplayEffectsEnabled(bool enabled, ReplayModToggleContext context) => replayVolume.Value = enabled ? 1 : 0;
+#endif
+
+        public void ApplyToDrawableRuleset(DrawableRuleset<OsuHitObject> drawableRuleset)
+        {
+            double firstHitTime = drawableRuleset.Beatmap.HitObjects.FirstOrDefault()?.StartTime ?? 0;
+            var beat = new DividedMetronomeBeat(firstHitTime, TempoScale.Value);
+#if PATCHSU_REPLAY_MOD_TOGGLES
+            beat.AddAdjustment(AdjustableProperty.Volume, replayVolume);
+#endif
+            drawableRuleset.Overlays.Add(beat);
+        }
+
+        public partial class MetronomeScaleSetting : SettingsDropdown<int>
+        {
+            public MetronomeScaleSetting() => Items = new[] { 1, 2, 4, 8, 12 };
+
+            protected override OsuDropdown<int> CreateDropdown() => new MetronomeScaleDropdown();
+        }
+
+        public partial class MetronomeScaleDropdown : OsuDropdown<int>
+        {
+            public MetronomeScaleDropdown() => RelativeSizeAxes = Axes.X;
+
+            protected override LocalisableString GenerateItemText(int item) => $"{item / 4.0:0.##}x";
+        }
+
+        private sealed partial class DividedMetronomeBeat : MetronomeBeat
+        {
+            private readonly int beatsPerTick;
+
+            public DividedMetronomeBeat(double firstHitTime, int tempoScale)
+                : base(firstHitTime)
+            {
+                // Retain quarter-beat units for existing scores and presets.
+                // Use the fewest subdivisions possible, so no unnecessary beats are skipped.
+                int commonFactor = greatestCommonDivisor(tempoScale, 4);
+                Divisor = tempoScale / commonFactor;
+                beatsPerTick = 4 / commonFactor;
+                MinimumBeatLength = 0;
+            }
+
+            private static int greatestCommonDivisor(int a, int b)
+            {
+                while (b != 0)
+                    (a, b) = (b, a % b);
+                return a;
+            }
+
+            protected override void OnNewBeat(
+                int beatIndex,
+                TimingControlPoint timingPoint,
+                EffectControlPoint effectPoint,
+                ChannelAmplitudes amplitudes)
+            {
+                if (beatIndex % beatsPerTick != 0)
+                    return;
+
+                if (Divisor == 1)
+                {
+                    base.OnNewBeat(beatIndex, timingPoint, effectPoint, amplitudes);
+                    return;
+                }
+
+                // BeatSyncedContainer counts each subdivision as a beat. Scale the time signature
+                // so accents still correspond to beatmap downbeats.
+                var scaledTimingPoint = new TimingControlPoint();
+                scaledTimingPoint.CopyFrom(timingPoint);
+                scaledTimingPoint.TimeSignature =
+                    new TimeSignature(timingPoint.TimeSignature.Numerator * Divisor);
+                scaledTimingPoint.BeatLength = timingPoint.BeatLength / Divisor;
+
+                base.OnNewBeat(beatIndex, scaledTimingPoint, effectPoint, amplitudes);
+            }
+        }
+    }
+}
diff --git a/osu.Game.Rulesets.Osu/Mods/OsuModMissChallenge.cs b/osu.Game.Rulesets.Osu/Mods/OsuModMissChallenge.cs
new file mode 100644
index 0000000000..d6fc82c92b
--- /dev/null
+++ b/osu.Game.Rulesets.Osu/Mods/OsuModMissChallenge.cs
@@ -0,0 +1,119 @@
+// Adapted from Modosu (Azuuryy), derived from MOsu (p-720), GPL-3.0.
+// See LICENCE-Modosu.txt in the distribution.
+using osu.Game.Graphics;
+using osu.Framework.Graphics.Sprites;
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using osu.Framework.Bindables;
+using osu.Framework.Localisation;
+using osu.Game.Configuration;
+using osu.Game.Database;
+using osu.Game.Online.API;
+using osu.Game.Overlays.Settings;
+using osu.Game.Rulesets.Judgements;
+using osu.Game.Rulesets.Mods;
+using osu.Game.Rulesets.Scoring;
+using osu.Game.Scoring;
+using Realms;
+using osu.Game.Screens.Play;
+
+namespace osu.Game.Rulesets.Osu.Mods
+{
+    public class OsuModMissChallenge : ModFailCondition, IApplicableToPlayer, IModosuMod
+    {
+        public override string Name => "Miss Challenge";
+        public override IconUsage? Icon => OsuIcon.ModMissChallenge;
+        public override string Acronym => "MC";
+        public override LocalisableString Description => "Fail if the miss limit is exceeded.";
+        public override ModType Type => ModType.DifficultyIncrease;
+        public override bool Ranked => false;
+        public override bool AlwaysValidForSubmission => false;
+        public override bool ValidForMultiplayer => false;
+        public override bool ValidForMultiplayerAsFreeMod => false;
+        public override Type[] IncompatibleMods => base.IncompatibleMods.Concat(new[] { typeof(ModPerfect) }).ToArray();
+
+        [SettingSource("Use best local score", "Use the active profile's (Patchsu) best miss count for this map and matching mods.")]
+        public BindableBool UseBestLocalScore { get; } = new BindableBool();
+
+        [SettingSource("Max misses", "Fail once the miss count exceeds this limit.", SettingControlType = typeof(MissLimitSlider))]
+        public BindableInt MaxMisses { get; } = new BindableInt(10) { MinValue = 1, MaxValue = 100, Default = 10 };
+
+        private int missCount;
+
+        public override IEnumerable<(LocalisableString setting, LocalisableString value)> SettingDescription
+        {
+            get
+            {
+                if (UseBestLocalScore.Value) yield return ("Use best local score", "On");
+                if (!MaxMisses.IsDefault) yield return ("Max misses", MaxMisses.Value.ToString());
+                if (!Restart.IsDefault) yield return ("Restart on fail", "On");
+            }
+        }
+
+        public void ApplyToPlayer(Player player)
+        {
+            if (!UseBestLocalScore.Value || player.Dependencies.Get(typeof(RealmAccess)) is not RealmAccess realm)
+                return;
+
+            // The player's scores: with Patchsu's local profiles (0002) the active local profile is the API's local user,
+            // otherwise the signed-in account. Read through the API only, so this patch doesn't need 0002.
+            if (player.Dependencies.Get(typeof(IAPIProvider)) is not IAPIProvider api)
+                return;
+
+            int userId = api.LocalUser.Value.OnlineID;
+
+            static string modKey(Mod mod)
+            {
+                if (mod is ModRateAdjust rate)
+                    return $"{mod.GetType().Name}:{rate.SpeedChange.Value:F2}";
+                if (mod is OsuModDifficultyAdjust difficulty)
+                {
+                    var parts = new List<string> { mod.GetType().Name };
+                    if (!difficulty.CircleSize.IsDefault) parts.Add($"CS:{difficulty.CircleSize.Value:F1}");
+                    if (!difficulty.ApproachRate.IsDefault) parts.Add($"AR:{difficulty.ApproachRate.Value:F1}");
+                    return string.Join(",", parts);
+                }
+                return mod.GetType().Name;
+            }
+
+            static string[] keys(IEnumerable<Mod> mods) => mods.Where(m => m is not OsuModMissChallenge && m is not ModNoFail).Select(modKey).OrderBy(k => k).ToArray();
+
+            var activeMods = keys(player.Mods.Value);
+            string beatmapHash = player.Beatmap.Value.BeatmapInfo.Hash;
+            string rulesetName = player.Ruleset.Value.ShortName;
+            var scores = realm.Run(r => r.All<ScoreInfo>()
+                                         .Filter($@"{nameof(ScoreInfo.User)}.{nameof(Models.RealmUser.OnlineID)} == $0 AND {nameof(ScoreInfo.BeatmapInfo)}.{nameof(osu.Game.Beatmaps.BeatmapInfo.Hash)} == $1 AND {nameof(ScoreInfo.Ruleset)}.{nameof(RulesetInfo.ShortName)} == $2 AND {nameof(ScoreInfo.DeletePending)} == false",
+                                             userId, beatmapHash, rulesetName)
+                                         .AsEnumerable()
+                                         .Select(s => s.Detach())
+                                         .ToArray())
+                              .Where(s => keys(s.Mods).SequenceEqual(activeMods))
+                              .ToArray();
+            if (scores.Length > 0)
+            {
+                int best = scores.Min(s => s.Statistics.GetValueOrDefault(HitResult.Miss, int.MaxValue));
+                MaxMisses.Value = Math.Clamp(best, MaxMisses.MinValue, MaxMisses.MaxValue);
+            }
+        }
+
+        protected override bool FailCondition(HealthProcessor healthProcessor, JudgementResult result)
+            => result.Type == HitResult.Miss && ++missCount > MaxMisses.Value;
+
+        public override void ResetSettingsToDefaults()
+        {
+            base.ResetSettingsToDefaults();
+            missCount = 0;
+        }
+    }
+
+    public partial class MissLimitSlider : SettingsSlider<int>
+    {
+        protected override void LoadComplete()
+        {
+            base.LoadComplete();
+            if (SettingSourceObject is OsuModMissChallenge mod)
+                mod.UseBestLocalScore.BindValueChanged(e => { if (e.NewValue) Hide(); else Show(); }, true);
+        }
+    }
+}
diff --git a/osu.Game.Rulesets.Osu/Mods/OsuModNoSliding.cs b/osu.Game.Rulesets.Osu/Mods/OsuModNoSliding.cs
new file mode 100644
index 0000000000..7be438499c
--- /dev/null
+++ b/osu.Game.Rulesets.Osu/Mods/OsuModNoSliding.cs
@@ -0,0 +1,325 @@
+// Copyright (c) ppy Pty Ltd <contact@ppy.sh>. Licensed under the MIT Licence.
+// See the LICENCE file in the repository root for full licence text.
+
+using osu.Game.Graphics;
+using osu.Framework.Graphics.Sprites;
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using osu.Framework.Bindables;
+using osu.Framework.Localisation;
+using osu.Framework.Utils;
+using osu.Game.Beatmaps;
+using osu.Game.Beatmaps.ControlPoints;
+using osu.Game.Configuration;
+using osu.Game.Rulesets.Mods;
+using osu.Game.Rulesets.Objects;
+using osu.Game.Rulesets.Osu.Beatmaps;
+using osu.Game.Rulesets.Osu.Mods;
+using osu.Game.Rulesets.Osu.Objects;
+using osu.Game.Rulesets.Osu.Replays;
+using osu.Game.Rulesets.Osu.Skinning.Argon;
+using osu.Game.Rulesets.Modosu.Utils;
+using osuTK;
+
+namespace osu.Game.Rulesets.Osu.Mods
+{
+    public class OsuModNoSliding : Mod, IApplicableAfterBeatmapConversion, IModosuMod, IBeatmapVariant
+    {
+        [SettingSource("Transformation version", HideInSettings = true)]
+        public BindableInt TransformationVersion { get; } = new BindableInt();
+
+        public override bool Ranked => false;
+        public override bool AlwaysValidForSubmission => false;
+        public override bool ValidForMultiplayer => false;
+        public override bool ValidForMultiplayerAsFreeMod => false;
+
+        private const int deathstream_length = 16;
+
+        public override string Name => "No Sliding";
+
+        public override IconUsage? Icon => OsuIcon.ModNoSliding;
+        public override string Acronym => "NL";
+
+
+        public override LocalisableString Description => @"Turn sliders into circles.";
+
+        public override ModType Type => ModType.DifficultyIncrease;
+
+        public override Type[] IncompatibleMods => new[]
+        {
+            typeof(OsuModTargetPractice),
+            typeof(OsuModStrictTracking),
+        };
+
+        public enum SliderTarget
+        {
+            All,
+            Short,
+            Long,
+            Repeats
+        }
+
+        public enum SliderConversion
+        {
+            Streams,
+            HeadOnly,
+            HeadAndTail
+        }
+
+        [SettingSource("Sliders to convert")]
+        public Bindable<SliderTarget> Target { get; } = new Bindable<SliderTarget>(SliderTarget.All);
+
+        [SettingSource("Conversion")]
+        public Bindable<SliderConversion> Conversion { get; } = new Bindable<SliderConversion>(SliderConversion.Streams);
+
+        [SettingSource("Short slider threshold (ms)")]
+        public BindableDouble ShortSliderThreshold { get; } = new BindableDouble(400)
+        {
+            MinValue = 50,
+            MaxValue = 5000,
+            Precision = 10
+        };
+
+        /// <summary>
+        /// The last tick of <see cref="StopConvertingThreshold"/>, meaning "No threshold".
+        /// </summary>
+        public const double NO_THRESHOLD = 5010;
+
+        [SettingSource("Stop converting past threshold (ms)", "Sliders longer than this are not converted. The last tick means no threshold.",
+            SettingControlType = typeof(NoSlidingStopThresholdSlider))]
+        public BindableDouble StopConvertingThreshold { get; } = new BindableDouble(NO_THRESHOLD)
+        {
+            MinValue = 50,
+            MaxValue = NO_THRESHOLD,
+            Precision = 10
+        };
+
+        public override IEnumerable<(LocalisableString setting, LocalisableString value)> SettingDescription
+        {
+            get
+            {
+                foreach (var description in base.SettingDescription)
+                {
+                    // The stop threshold only applies when converting all sliders.
+                    if (Target.Value != SliderTarget.All && description.setting.ToString() == "Stop converting past threshold (ms)")
+                        continue;
+
+                    yield return description;
+                }
+            }
+        }
+
+        [SettingSource("Beat divisor")]
+        public BindableInt BeatDivisor { get; } = new BindableInt(4)
+        {
+            MinValue = 1,
+            MaxValue = 8
+        };
+
+        [SettingSource("Slow down too long streams")]
+        public BindableBool DeathstreamsSlowingDown { get; } = new BindableBool(true);
+
+        [SettingSource("Slow down too fast parts")]
+        public BindableBool FastPartsSlowingDown { get; } = new BindableBool(true);
+
+        public void ApplyToBeatmap(IBeatmap beatmap)
+        {
+            var osuBeatmap = (OsuBeatmap)beatmap;
+            var newObjects = new List<OsuHitObject>();
+
+            var points = beatmap.ControlPointInfo.TimingPoints.OrderByDescending(c => c.BeatLength);
+            double minAllowedBeatLength = (points.FirstOrDefault() ?? TimingControlPoint.DEFAULT).BeatLength / 1.5d;
+
+            foreach (var hitObject in osuBeatmap.HitObjects)
+            {
+                if (hitObject is not Slider s)
+                {
+                    newObjects.Add(hitObject);
+                    continue;
+                }
+
+                var point = beatmap.ControlPointInfo.TimingPointAt(s.StartTime);
+                s.ApplyDefaults(beatmap.ControlPointInfo, beatmap.Difficulty);
+
+                bool selected = Target.Value switch
+                {
+                    SliderTarget.Short => s.Duration <= ShortSliderThreshold.Value,
+                    SliderTarget.Long => s.Duration > ShortSliderThreshold.Value,
+                    SliderTarget.Repeats => s.RepeatCount > 0,
+                    _ => true
+                };
+
+                if (Target.Value == SliderTarget.All && StopConvertingThreshold.Value < NO_THRESHOLD && s.Duration > StopConvertingThreshold.Value)
+                    selected = false;
+
+                if (!selected)
+                {
+                    newObjects.Add(s);
+                    continue;
+                }
+
+                if (Conversion.Value != SliderConversion.Streams)
+                {
+                    newObjects.Add(new HitCircle
+                    {
+                        StartTime = s.StartTime,
+                        Position = s.Position,
+                        NewCombo = s.NewCombo,
+                        Samples = s.HeadCircle.Samples.Select(sample => sample.With()).ToList()
+                    });
+
+                    if (Conversion.Value == SliderConversion.HeadAndTail && s.GetEndTime() > s.StartTime)
+                    {
+                        newObjects.Add(new HitCircle
+                        {
+                            StartTime = s.GetEndTime(),
+                            Position = s.EndPosition,
+                            Samples = s.TailSamples.Select(sample => sample.With()).ToList()
+                        });
+                    }
+
+                    continue;
+                }
+
+                if (FastPartsSlowingDown.Value && point.BeatLength < minAllowedBeatLength)
+                {
+                    double beatLength = point.BeatLength;
+                    while (beatLength < minAllowedBeatLength)
+                        beatLength *= 2;
+
+                    point = (TimingControlPoint)point.DeepClone();
+                    point.BeatLength = beatLength;
+                }
+
+                // this will be true if span is going to be converted into 1, 2, or 3 circles.
+                bool spanTooShort = s.SpanDuration <= point.BeatLength * 4d / BeatDivisor.Value;
+                // an attempt to fix too fast turns. I chose 250ms by eye, but if it is still going to be a problem this can be calculated based on AR.
+                bool spanTooFast = s.SpanDuration <= 250d;
+
+                double divisor = BeatDivisor.Value;
+                // dur/BL*div is always lower than actual note count by 1, so using >=, not >.
+                if (s.Duration / point.BeatLength * divisor >= deathstream_length && DeathstreamsSlowingDown.Value)
+                    divisor /= 2d; // making stream slower twice, if it's longer than the limit.
+
+                if ((spanTooShort || spanTooFast) && s.RepeatCount > 0)
+                {
+                    // regular conversion won't work well, using other methods
+
+                    double streamSpacing = point.BeatLength / divisor;
+
+                    if (s.RepeatCount >= 7)
+                    {
+                        // repeat is long, creating square pattern
+                        convertSliderToSquare(s, streamSpacing, newObjects);
+                    }
+                    else if (s.RepeatCount % 2 == 1)
+                    {
+                        // slider head and tail are in the same place - creating a stack.
+                        convertSliderToStack(s, streamSpacing, newObjects);
+                    }
+                    else
+                    {
+                        // slider head and tail are different - creating a compressed stream
+                        newObjects.AddRange(ModosuHitObjectGenerationUtils.ConvertSliderToStreamIgnoringRepeats(s, streamSpacing));
+                    }
+                }
+                else
+                {
+                    // regular conversion as editor does
+                    newObjects.AddRange(ModosuHitObjectGenerationUtils.ConvertSliderToStream(s, point, divisor));
+                }
+            }
+
+            // guard from overlapping sliders
+
+            newObjects.Sort((a, b) => a.StartTime.CompareTo(b.StartTime));
+
+            if (Target.Value == SliderTarget.All && Conversion.Value == SliderConversion.Streams)
+            {
+                for (int i = newObjects.Count - 1; i > 0; i--)
+                {
+                    if (Precision.AlmostEquals(newObjects[i].StartTime, newObjects[i - 1].StartTime, 1d))
+                        newObjects.RemoveAt(i);
+                }
+            }
+
+            osuBeatmap.HitObjects = newObjects;
+        }
+
+        private static void convertSliderToStack(Slider slider, double streamSpacing, List<OsuHitObject> list)
+        {
+            int i = 0;
+            double time = slider.StartTime;
+
+            while (!Precision.DefinitelyBigger(time, slider.GetEndTime(), 1))
+            {
+                // var samplePoint = (SampleControlPoint)slider.Path.ControlPoints.SampleControlPoint.DeepClone();
+                // samplePoint.Time = time;
+
+                list.Add(new HitCircle
+                {
+                    StartTime = time,
+                    Position = slider.Position,
+                    NewCombo = i == 0 && slider.NewCombo,
+                    // SampleControlPoint = samplePoint,
+                    Samples = slider.HeadCircle.Samples.Select(s => s.With()).ToList()
+                });
+
+                i += 1;
+                time = slider.StartTime + i * streamSpacing;
+            }
+        }
+
+        private static void convertSliderToSquare(Slider slider, double streamSpacing, List<OsuHitObject> list)
+        {
+            int i = 0;
+            double time = slider.StartTime;
+            Vector2 len = slider.Path.PositionAt(1);
+            Vector2 lenHalf = len / 2;
+            Vector2 start = slider.Position;
+            Vector2[] points =
+            {
+                start,
+                start + lenHalf + lenHalf.PerpendicularLeft,
+                start + len,
+                start + lenHalf + lenHalf.PerpendicularRight
+            };
+
+            while (!Precision.DefinitelyBigger(time, slider.GetEndTime(), 1))
+            {
+                // var samplePoint = (SampleControlPoint)slider.SampleControlPoint.DeepClone();
+                // samplePoint.Time = time;
+
+                list.Add(new HitCircle
+                {
+                    StartTime = time,
+                    Position = ModosuHitObjectGenerationUtils.ClampToPlayfieldWithPadding(points[i % 4], (float)slider.Radius),
+                    NewCombo = i == 0 && slider.NewCombo,
+                    // SampleControlPoint = samplePoint,
+                    Samples = slider.HeadCircle.Samples.Select(s => s.With()).ToList()
+                });
+
+                i += 1;
+                time = slider.StartTime + i * streamSpacing;
+            }
+        }
+    }
+
+    /// <summary>Only shown while all sliders are converted; the last tick reads "No threshold".</summary>
+    public partial class NoSlidingStopThresholdSlider : osu.Game.Overlays.Settings.SettingsSlider<double, NoSlidingStopThresholdSlider.ThresholdSliderBar>
+    {
+        protected override void LoadComplete()
+        {
+            base.LoadComplete();
+
+            if (SettingSourceObject is OsuModNoSliding mod)
+                mod.Target.BindValueChanged(t => Alpha = t.NewValue == OsuModNoSliding.SliderTarget.All ? 1 : 0, true);
+        }
+
+        public partial class ThresholdSliderBar : osu.Game.Graphics.UserInterface.RoundedSliderBar<double>
+        {
+            public override LocalisableString TooltipText => Current.Value >= OsuModNoSliding.NO_THRESHOLD ? "No threshold" : base.TooltipText;
+        }
+    }
+}
