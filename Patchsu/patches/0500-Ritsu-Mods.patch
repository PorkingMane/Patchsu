+    /// <summary>
+    /// What a <see cref="CirclePreviewTooltip"/> shows. Built once per settings change and reused while hovering.
+    /// </summary>
+    public sealed class CirclePreview
+    {
+        public const float CIRCLE_SIZE = 22;
+
+        public readonly string Description;
+        public readonly Vector2 Size;
+        public readonly PreviewCircle[] Circles;
+        public readonly PreviewLabel[] Labels;
+
+        public CirclePreview(string description, Vector2 size, PreviewCircle[] circles, PreviewLabel[]? labels = null)
+        {
+            Description = description;
+            Size = size;
+            Circles = circles;
+            Labels = labels ?? Array.Empty<PreviewLabel>();
+        }
+
+        public static CirclePreview Fit(string description, Vector2[] points, Color4 colour, Vector2 maxSize)
+        {
+            var colours = new Color4[points.Length];
+            Array.Fill(colours, colour);
+            return Fit(description, points, colours, maxSize, points.Length);
+        }
+
+        /// <summary>
+        /// Scales <paramref name="points"/> to fit <paramref name="maxSize"/>, numbered and connected in order, restarting every <paramref name="groupSize"/> points.
+        /// </summary>
+        public static CirclePreview Fit(string description, Vector2[] points, Color4[] colours, Vector2 maxSize, int groupSize)
+        {
+            Vector2 min = points[0], max = points[0];
+
+            foreach (var p in points)
+            {
+                min = Vector2.ComponentMin(min, p);
+                max = Vector2.ComponentMax(max, p);
+            }
+
+            Vector2 extent = Vector2.ComponentMax(max - min, new Vector2(0.001f));
+            float scale = Math.Min(70, Math.Min((maxSize.X - CIRCLE_SIZE) / extent.X, (maxSize.Y - CIRCLE_SIZE) / extent.Y));
+            var circles = new PreviewCircle[points.Length];
+
+            for (int i = 0; i < points.Length; i++)
+            {
+                circles[i] = new PreviewCircle((points[i] - min) * scale + new Vector2(CIRCLE_SIZE / 2), (i % groupSize + 1).ToString(), colours[i],
+                    i % groupSize != 0);
+            }
+
+            return new CirclePreview(description, (max - min) * scale + new Vector2(CIRCLE_SIZE), circles);
+        }
+    }
+
+    /// <summary>
+    /// Tooltip with a description and a few hit circles. Circles move to their new places when the content changes while it is shown.
+    /// </summary>
+    public partial class CirclePreviewTooltip : VisibilityContainer, ITooltip
+    {
+        private const float min_text_width = 240;
+        private const double transition_duration = 200;
+        private const float line_alpha = 0.35f;
+
+        private TextFlowContainer description = null!;
+        private Container area = null!;
+        private Container<PreviewLine> lines = null!;
+        private Container<OsuSpriteText> labels = null!;
+        private Container<StaticCirclePiece> circles = null!;
+
+        private CirclePreview? current;
+
+        // Shown pieces in preview order. Pieces that are fading out are no longer listed but stay in their containers until they expire.
+        private readonly List<StaticCirclePiece> activeCircles = new List<StaticCirclePiece>();
+
+        // activeLines[i - 1] joins circle i - 1 to circle i, hidden when that pair isn't connected.
+        private readonly List<PreviewLine> activeLines = new List<PreviewLine>();
+        private readonly List<OsuSpriteText> activeLabels = new List<OsuSpriteText>();
+
+        [BackgroundDependencyLoader]
+        private void load(OsuColour colours)
+        {
+            AutoSizeAxes = Axes.Both;
+            Masking = true;
+            CornerRadius = 5;
+
+            Children = new Drawable[]
+            {
+                new Box
+                {
+                    RelativeSizeAxes = Axes.Both,
+                    Colour = colours.Gray3,
+                    Alpha = 0.9f,
+                },
+                new FillFlowContainer
+                {
+                    AutoSizeAxes = Axes.Both,
+                    Direction = FillDirection.Vertical,
+                    Padding = new MarginPadding(10),
+                    Spacing = new Vector2(8),
+                    Children = new Drawable[]
+                    {
+                        description = new OsuTextFlowContainer(f => f.Font = OsuFont.GetFont(size: 14))
+                        {
+                            AutoSizeAxes = Axes.Y,
+                        },
+                        area = new Container
+                        {
+                            Anchor = Anchor.TopCentre,
+                            Origin = Anchor.TopCentre,
+                            Children = new Drawable[]
+                            {
+                                lines = new Container<PreviewLine> { RelativeSizeAxes = Axes.Both },
+                                labels = new Container<OsuSpriteText> { RelativeSizeAxes = Axes.Both },
+                                circles = new Container<StaticCirclePiece> { RelativeSizeAxes = Axes.Both },
+                            },
+                        },
+                    },
+                },
+            };
+        }
+
+        public void SetContent(object content)
+        {
+            if (content is not CirclePreview preview || preview == current)
+                return;
+
+            // Only animate while visible; a tooltip that appears again starts from its new content.
+            double duration = current != null && IsPresent ? transition_duration : 0;
+
+            if (duration == 0)
+            {
+                circles.Clear();
+                lines.Clear();
+                labels.Clear();
+                activeCircles.Clear();
+                activeLines.Clear();
+                activeLabels.Clear();
+            }
+
+            if (current?.Description != preview.Description)
+                description.Text = preview.Description;
+
+            description.ResizeWidthTo(Math.Max(min_text_width, preview.Size.X), duration, Easing.OutQuint);
+            area.ResizeTo(preview.Size, duration, Easing.OutQuint);
+
+            updateCircles(preview.Circles, duration);
+            updateLabels(preview.Labels, duration);
+
+            current = preview;
+        }
+
+        private void updateCircles(PreviewCircle[] targets, double duration)
+        {
+            // New circles grow out of the last shown one, leaving circles shrink into the last remaining one.
+            Vector2 spawn = activeCircles.Count > 0 ? activeCircles[^1].Position : Vector2.Zero;
+
+            for (int i = 0; i < targets.Length; i++)
+            {
+                var target = targets[i];
+                StaticCirclePiece piece;
+
+                if (i < activeCircles.Count)
+                {
+                    piece = activeCircles[i];
+                    piece.Number = target.Text;
+                    piece.Accent = target.Colour;
+                    piece.MoveTo(target.Position, duration, Easing.OutQuint);
+                }
+                else
+                {
+                    bool grow = duration > 0;
+
+                    circles.Add(piece = new StaticCirclePiece(target.Text, target.Colour)
+                    {
+                        Anchor = Anchor.TopLeft,
+                        Size = new Vector2(CirclePreview.CIRCLE_SIZE),
+                        Position = grow ? spawn : target.Position,
+                        Scale = new Vector2(grow ? 0.5f : 1),
+                        Alpha = grow ? 0 : 1,
+                    });
+                    activeCircles.Add(piece);
+
+                    piece.MoveTo(target.Position, duration, Easing.OutQuint);
+                    piece.ScaleTo(1, duration, Easing.OutQuint);
+                    piece.FadeIn(duration, Easing.OutQuint);
+                }
+
+                if (i == 0)
+                    continue;
+
+                if (i > activeLines.Count)
+                {
+                    var line = new PreviewLine(activeCircles[i - 1], piece) { Alpha = 0 };
+                    lines.Add(line);
+                    activeLines.Add(line);
+                }
+
+                activeLines[i - 1].FadeTo(target.ConnectToPrevious ? line_alpha : 0, duration, Easing.OutQuint);
+            }
+
+            Vector2 sink = targets.Length > 0 ? targets[^1].Position : Vector2.Zero;
+
+            for (int i = activeCircles.Count - 1; i >= targets.Length; i--)
+            {
+                var piece = activeCircles[i];
+                piece.MoveTo(sink, duration, Easing.OutQuint);
+                piece.ScaleTo(0.5f, duration, Easing.OutQuint);
+                piece.FadeOut(duration, Easing.OutQuint).Expire();
+                activeCircles.RemoveAt(i);
+
+                if (i > 0)
+                {
+                    activeLines[i - 1].FadeOut(duration, Easing.OutQuint).Expire();
+                    activeLines.RemoveAt(i - 1);
+                }
+            }
+        }
+
+        private void updateLabels(PreviewLabel[] targets, double duration)
+        {
+            for (int i = 0; i < targets.Length; i++)
+            {
+                var target = targets[i];
+
+                if (i < activeLabels.Count)
+                {
+                    var existing = activeLabels[i];
+
+                    if (existing.Text.ToString() == target.Text)
+                    {
+                        existing.MoveTo(target.Position, duration, Easing.OutQuint);
+                        continue;
+                    }
+
+                    existing.FadeOut(duration, Easing.OutQuint).Expire();
+                }
+
+                var label = new OsuSpriteText
+                {
+                    Origin = Anchor.CentreLeft,
+                    Position = target.Position,
+                    Text = target.Text,
+                    Font = OsuFont.GetFont(size: 13, weight: FontWeight.SemiBold),
+                    Alpha = duration > 0 ? 0 : 1,
+                };
+
+                labels.Add(label);
+                label.FadeIn(duration, Easing.OutQuint);
+
+                if (i < activeLabels.Count)
+                    activeLabels[i] = label;
+                else
+                    activeLabels.Add(label);
+            }
+
+            for (int i = activeLabels.Count - 1; i >= targets.Length; i--)
+            {
+                activeLabels[i].FadeOut(duration, Easing.OutQuint).Expire();
+                activeLabels.RemoveAt(i);
+            }
+        }
+
+        protected override void UpdateAfterChildren()
+        {
+            base.UpdateAfterChildren();
+
+            // Lines follow their circles while they move, including ones that are fading out.
+            foreach (var line in lines)
+            {
+                Vector2 from = line.From.Position;
+                Vector2 diff = line.To.Position - from;
+                line.Position = from;
+                line.Width = diff.Length;
+                line.Rotation = MathHelper.RadiansToDegrees(MathF.Atan2(diff.Y, diff.X));
+            }
+        }
+
+        protected override void PopIn() => this.FadeIn(200, Easing.OutQuint);
+
+        protected override void PopOut() => this.FadeOut(200, Easing.OutQuint);
+
+        public void Move(Vector2 pos) => Position = pos;
+    }
+
+    /// <summary>
+    /// A line between two preview circles, kept in place by <see cref="CirclePreviewTooltip"/>.
+    /// </summary>
+    public partial class PreviewLine : Box
+    {
+        public readonly Drawable From;
+        public readonly Drawable To;
+
+        public PreviewLine(Drawable from, Drawable to)
+        {
+            From = from;
+            To = to;
+            Origin = Anchor.CentreLeft;
+            Height = 3;
+            EdgeSmoothness = new Vector2(1);
+        }
+    }
+
+    /// <summary>
+    /// Slider bar that shows its setting's preview tooltip instead of the plain value, so the preview follows the value while dragging.
+    /// </summary>
+    public partial class PreviewSliderBar<T> : RoundedSliderBar<T>, IHasCustomTooltip
+        where T : struct, System.Numerics.INumber<T>, System.Numerics.IMinMaxValue<T>
+    {
+        public IHasCustomTooltip? Owner { get; set; }
+
+        public ITooltip GetCustomTooltip() => Owner?.GetCustomTooltip() ?? new CirclePreviewTooltip();
+
+        public object? TooltipContent => Owner?.TooltipContent;
+    }
+
+    // --- Shared UI pieces ---
+
+    public partial class StaticCirclePiece : Container
+    {
+        private string number;
+        private Color4 accent;
+
+        private OsuSpriteText text = null!;
+
+        private Circle outer = null!;
+        private Circle ring = null!;
+        private Circle inner = null!;
+        private Circle centre = null!;
+
+        public StaticCirclePiece(string number, Color4 accent)
+        {
+            this.number = number;
+            this.accent = accent;
+            Anchor = Anchor.Centre;
+            Origin = Anchor.Centre;
+        }
+
+        public string Number
+        {
+            set
+            {
+                if (number == value)
+                    return;
+
+                number = value;
+                if (IsLoaded)
+                    text.Text = value;
+            }
+        }
+
+        /// <summary>
+        /// Recolours the circle (e.g. when a row switches between jump and stream).
+        /// </summary>
+        public Color4 Accent
+        {
+            set
+            {
+                if (accent == value)
+                    return;
+
+                accent = value;
+                if (IsLoaded)
+                    applyAccent();
+            }
+        }
+
+        [BackgroundDependencyLoader]
+        private void load()
+        {
+            // argon-style hit circle: dark fill, accent gradient rings, white border
+            InternalChildren = new Drawable[]
+            {
+                outer = new Circle
+                {
+                    RelativeSizeAxes = Axes.Both,
+                },
+                ring = new Circle
+                {
+                    RelativeSizeAxes = Axes.Both,
+                    Size = new Vector2(0.862f),
+                    Anchor = Anchor.Centre,
+                    Origin = Anchor.Centre,
+                },
+                inner = new Circle
+                {
+                    RelativeSizeAxes = Axes.Both,
+                    Size = new Vector2(0.69f),
+                    Anchor = Anchor.Centre,
+                    Origin = Anchor.Centre,
+                },
+                centre = new Circle
+                {
+                    RelativeSizeAxes = Axes.Both,
+                    Size = new Vector2(0.517f),
+                    Anchor = Anchor.Centre,
+                    Origin = Anchor.Centre,
+                },
+                text = new OsuSpriteText
+                {
+                    Anchor = Anchor.Centre,
+                    Origin = Anchor.Centre,
+                    Text = number,
+                    Font = OsuFont.GetFont(size: 13, weight: FontWeight.Bold),
+                    UseFullGlyphHeight = false,
+                },
+                new ExpoCircleContainer
+                {
+                    RelativeSizeAxes = Axes.Both,
+                    BorderThickness = 2f,
+                    BorderColour = Color4.White,
+                    Child = new Box
+                    {
+                        AlwaysPresent = true,
+                        Alpha = 0,
+                        RelativeSizeAxes = Axes.Both,
+                    },
+                },
+            };
+
+            applyAccent();
+        }
+
+        private void applyAccent()
+        {
+            outer.Colour = accent.Darken(4);
+            ring.Colour = ColourInfo.GradientVertical(accent, accent.Darken(0.1f));
+            inner.Colour = ColourInfo.GradientVertical(accent.Darken(0.5f), accent.Darken(0.6f));
+            centre.Colour = accent.Darken(4);
+        }
+    }
+
+    /// <summary>
+    /// A circle-masked container (exponent 2). Named apart from osu.Framework's CircularContainer: in this namespace the old name
+    /// replaced the framework class for every other mod too (osu!'s Bubbles drew its bubbles with it).
+    /// </summary>
+    public partial class ExpoCircleContainer : Container
+    {
+        public ExpoCircleContainer()
+        {
+            Masking = true;
+            CornerExponent = 2;
+        }
+
+        protected override void UpdateAfterChildren()
+        {
+            base.UpdateAfterChildren();
+            CornerRadius = MathF.Min(DrawWidth, DrawHeight) / 2;
+        }
+    }
+}
