+            {
+                get => current;
+                set
+                {
+                    current.UnbindBindings();
+                    current.BindTo(value);
+                }
+            }
+
+            public PatternCheckboxes()
+            {
+                RelativeSizeAxes = Axes.X;
+                AutoSizeAxes = Axes.Y;
+                Direction = FillDirection.Full;
+
+                foreach (var pattern in patterns)
+                {
+                    var checkbox = new PatternCheckbox(pattern)
+                    {
+                        Width = 0.5f,
+                        // Padding instead of flow spacing, so there are no gaps that show the "Patterns" tooltip between checkboxes.
