+        /// <summary>
+        /// One row per rhythm, spaced the way the current settings space it. Pink rows count as streams, blue rows as jumps.
+        /// </summary>
+        internal CirclePreview CreateSpacingPreview(string description)
+        {
+            const int circles_per_row = 4;
+            const float label_width = 90;
+            const float row_height = 30;
+            const float max_row_width = 300;
+
+            Span<float> gaps = stackalloc float[spacing_rows.Length];
+            Span<bool> streams = stackalloc bool[spacing_rows.Length];
+            float longest = 1;
+
+            for (int r = 0; r < spacing_rows.Length; r++)
+            {
+                // Same check as isStream (ignoring its 1ms leniency).
+                bool stream = spacing_rows[r].Beats * Divisor.Value < 1;
+                float distance = spacing_rows[r].Distance;
+
+                if (stream)
+                    distance = ExpoStreams.Value ? getExpoJumpsDistance(distance, StreamDistanceMultiplier.Value) : distance * StreamDistanceMultiplier.Value;
+                else
+                    distance = ExpoJumps.Value ? getExpoJumpsDistance(distance, AimDistanceMultiplier.Value) : distance * MathF.Pow(AimDistanceMultiplier.Value, 1f - distance / 640f);
+
+                gaps[r] = distance;
+                streams[r] = stream;
+                longest = Math.Max(longest, distance * (circles_per_row - 1));
+            }
+
+            // Fixed scale until a row gets too long, so spacing changes stay visible.
+            float scale = Math.Min(0.45f, max_row_width / longest);
+            var circles = new PreviewCircle[spacing_rows.Length * circles_per_row];
+            var labels = new PreviewLabel[spacing_rows.Length];
+
+            for (int r = 0; r < spacing_rows.Length; r++)
+            {
+                float y = r * row_height + row_height / 2;
+                labels[r] = new PreviewLabel(new Vector2(0, y), $"{spacing_rows[r].Name} {(streams[r] ? "stream" : "jump")}");
+
+                for (int i = 0; i < circles_per_row; i++)
+                {
+                    circles[r * circles_per_row + i] = new PreviewCircle(new Vector2(label_width + CirclePreview.CIRCLE_SIZE / 2 + i * gaps[r] * scale, y),
+                        (i + 1).ToString(), streams[r] ? stream_colour : jump_colour);
+                }
+            }
+
+            return new CirclePreview(description, new Vector2(label_width + max_row_width + CirclePreview.CIRCLE_SIZE, spacing_rows.Length * row_height), circles, labels);
+        }
