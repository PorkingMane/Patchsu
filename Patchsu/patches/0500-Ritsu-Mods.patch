@@ -0,0 +1,148 @@
+// Copyright (c) ppy Pty Ltd <contact@ppy.sh>. Licensed under the MIT Licence.
+// See the LICENCE file in the repository root for full licence text.
+
+using osu.Framework.Bindables;
+using osu.Framework.Graphics;
+using osu.Framework.Graphics.Containers;
+using osu.Framework.Graphics.Shapes;
+using osu.Game.Rulesets.Objects.Drawables;
+using osu.Game.Rulesets.Osu.Skinning.Default;
+using osu.Game.Rulesets.Scoring;
+using osu.Game.Skinning;
+using osuTK;
+
+namespace osu.Game.Rulesets.Osu.Objects.Drawables
+{
+    public partial class DrawableDecoyCircle : DrawableHitCircle
+    {
+        private readonly Bindable<DecoyCircleStyle> style = new Bindable<DecoyCircleStyle>();
+        private readonly BindableBool showCross = new BindableBool(true);
+
+        /// <summary>
+        /// Whether a circle piece drawn for <paramref name="drawableObject"/> should leave out its combo number
+        /// (decoys marked with a cross). Decided per play, so evaluating it once when a piece loads is enough.
+        /// </summary>
+        public static bool HidesComboNumber(DrawableHitObject? drawableObject)
+            => drawableObject is DrawableDecoyCircle decoy && (decoy.HitObject as DecoyCircle)?.DisplayNumber == null;
+
+        public override bool DisplayResult => Result?.Type == HitResult.Miss;
+
+        protected override OsuSkinComponents CirclePieceComponent => OsuSkinComponents.DecoyCircle;
+
+        protected override Drawable CreateDefaultCirclePiece() => new DecoyMarker(style, showCross);
+
+        protected override void OnApply()
+        {
+            base.OnApply();
+            var decoy = (DecoyCircle)HitObject;
+            style.Value = decoy.Style;
+            showCross.Value = decoy.DisplayNumber == null;
+        }
+
+        protected override void UpdateHitStateTransforms(ArmedState state)
+        {
+            if (Result?.Type != HitResult.IgnoreMiss)
+            {
+                base.UpdateHitStateTransforms(state);
+                return;
+            }
+
+            this.FadeOut(60);
+            Expire();
+        }
+
+        /// <summary>
+        /// The circle with its cross. Drawn through a framebuffer only for the Grayscale style (which needs one to lose its colour);
+        /// "Real Fake" decoys are drawn directly.
+        /// </summary>
+        private partial class DecoyMarker : CompositeDrawable
+        {
+            private readonly Bindable<DecoyCircleStyle> style;
+            private readonly IBindable<bool> showCross;
+            private readonly Container cross;
+            private readonly Container content;
+            private BufferedContainer? greyscale;
+
+            public DecoyMarker(Bindable<DecoyCircleStyle> style, IBindable<bool> showCross)
+            {
+                this.style = style.GetBoundCopy();
+                this.showCross = showCross.GetBoundCopy();
+                Size = OsuHitObject.OBJECT_DIMENSIONS * 2;
+                InternalChild = content = new Container
+                {
+                    RelativeSizeAxes = Axes.Both,
+                    Children = new Drawable[]
+                {
+                    new SkinnableDrawable(new OsuSkinComponentLookup(OsuSkinComponents.HitCircle), _ => new MainCirclePiece()),
+                    cross = new Container
+                    {
+                        RelativeSizeAxes = Axes.Both,
+                        Children = new Drawable[]
+                        {
+                            new Box
+                            {
+                                Anchor = Anchor.Centre,
+                                Origin = Anchor.Centre,
+                                Size = new Vector2(42, 7),
+                                Rotation = 45,
+                            },
+                            new Box
+                            {
+                                Anchor = Anchor.Centre,
+                                Origin = Anchor.Centre,
+                                Size = new Vector2(42, 7),
+                                Rotation = -45,
+                            },
+                        },
+                    },
+                    },
+                };
+            }
+
+            protected override void LoadComplete()
+            {
+                base.LoadComplete();
+                style.BindValueChanged(value => setGreyscale(value.NewValue == DecoyCircleStyle.Grayscale), true);
+                showCross.BindValueChanged(value => cross.Alpha = value.NewValue ? 1 : 0, true);
+            }
+
+            private void setGreyscale(bool grey)
+            {
+                if (grey == (greyscale != null))
+                    return;
+
+                if (grey)
+                {
+                    RemoveInternal(content, false);
+                    AddInternal(greyscale = new BufferedContainer
+                    {
+                        RelativeSizeAxes = Axes.Both,
+                        GrayscaleStrength = 1,
+                        Child = content,
+                    });
+                }
+                else
+                {
+                    greyscale!.Remove(content, false);
+                    RemoveInternal(greyscale, true);
+                    greyscale = null;
+                    AddInternal(content);
+                }
+            }
+        }
+
+        protected override void CheckForResult(bool userTriggered, double timeOffset)
+        {
+            if (!userTriggered)
+            {
+                if (!HitObject.HitWindows!.CanBeHit(timeOffset))
+                    ApplyMinResult();
+                return;
+            }
+
+            var result = ResultFor(timeOffset);
+            if (result != HitResult.None)
+                ApplyResult(static (judgement, _) => judgement.Type = HitResult.Miss, 0);
+        }
+    }
+}
