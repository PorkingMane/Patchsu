diff --git a/osu.Game/Overlays/Mods/RitsuModPlaque.cs b/osu.Game/Overlays/Mods/RitsuModPlaque.cs
new file mode 100644
index 0000000000..a458343fa4
--- /dev/null
+++ b/osu.Game/Overlays/Mods/RitsuModPlaque.cs
@@ -0,0 +1,106 @@
+// Copyright (c) 2026 Ritsu contributors. Licensed under the MIT Licence.
+// See the LICENCE file in the repository root for full licence text.
+
+using osu.Framework.Bindables;
+using osu.Framework.Graphics;
+using osu.Framework.Graphics.Containers;
+using osu.Framework.Graphics.Shapes;
+using osu.Framework.Graphics.Sprites;
+using osu.Framework.Graphics.Textures;
+using osu.Framework.Localisation;
+using osu.Game.Graphics;
+using osu.Game.Graphics.Sprites;
+using osu.Game.Rulesets.Mods;
+using osuTK;
+using osuTK.Graphics;
+
+namespace osu.Game.Overlays.Mods
+{
+    /// <summary>
+    /// The "from Modosu" / "from Ritsu" plaque in the top-right corner of a mod panel (Patchsu patch 0500).
+    /// </summary>
+    public static class RitsuModPlaque
+    {
+        private static readonly Color4 modosu_gold = new Color4(217, 175, 79, 255);
+        private static readonly Color4 modosu_badge_active = new Color4(72, 50, 20, 255);
+        private static readonly Color4 ritsu_blue = new Color4(158, 203, 248, 255);
+        private static readonly Color4 ritsu_badge_active = new Color4(35, 48, 85, 255);
+
+        private const double transition_duration = 150;
+
+        public static void TryAttach(Mod mod, Container target, IBindable<bool> active, TextureStore textures)
+        {
+            switch (mod)
+            {
+                case IModosuMod:
+                    attach(target, active, "from Modosu", createModosuIcon(), false, modosu_gold, modosu_badge_active);
+                    break;
+
+                case IRitsuExclusiveMod:
+                    attach(target, active, "from Ritsu", new Sprite { Texture = textures.Get("Ritsu/logo"), Size = new Vector2(16) }, false, ritsu_blue, ritsu_badge_active);
+                    break;
+            }
+        }
+
+        private static Drawable createModosuIcon() => new Container
+        {
+            Size = new Vector2(9),
+            Children = new Drawable[]
+            {
+                new Circle
+                {
+                    RelativeSizeAxes = Axes.Both,
+                    Colour = Color4.White,
+                },
+                new OsuSpriteText
+                {
+                    Anchor = Anchor.Centre,
+                    Origin = Anchor.Centre,
+                    Colour = Color4.Black,
+                    Text = "M",
+                    Font = OsuFont.Default.With(size: 7, weight: FontWeight.Bold)
+                }
+            }
+        };
+
+        private static void attach(Container target, IBindable<bool> active, LocalisableString label, Drawable icon, bool tintIcon, Color4 idleColour, Color4 activeColour)
+        {
+            icon.Anchor = Anchor.CentreLeft;
+            icon.Origin = Anchor.CentreLeft;
+
+            var text = new OsuSpriteText
+            {
+                Text = label,
+                Font = OsuFont.Default.With(size: 9, weight: FontWeight.SemiBold),
+                Colour = idleColour,
+                Anchor = Anchor.CentreLeft,
+                Origin = Anchor.CentreLeft,
+            };
+
+            target.Add(new Container
+            {
+                Anchor = Anchor.TopRight,
+                Origin = Anchor.TopRight,
+                AutoSizeAxes = Axes.Both,
+                Margin = new MarginPadding { Right = 6, Top = 5 },
+                Shear = -OsuGame.SHEAR,
+                Child = new FillFlowContainer
+                {
+                    AutoSizeAxes = Axes.Both,
+                    Direction = FillDirection.Horizontal,
+                    Spacing = new Vector2(3, 0),
+                    Children = new[] { icon, text },
+                },
+            });
+
+            // Bind to the panel's own Active: a GetBoundCopy() is only weakly referenced, gets garbage collected and the colour then stops following selection.
+            active.BindValueChanged(a =>
+            {
+                Color4 colour = a.NewValue ? activeColour : idleColour;
+                text.FadeColour(colour, transition_duration, Easing.OutQuint);
+                if (tintIcon)
+                    icon.FadeColour(colour, transition_duration, Easing.OutQuint);
+            }, true);
+        }
+    }
+}
