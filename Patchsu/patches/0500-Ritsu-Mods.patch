+        /// <summary>
+        /// A short run of notes that keeps turning by <paramref name="relativeAngle"/>, like one flow section of the mod.
+        /// </summary>
+        internal static CirclePreview CreateTurnPreview(string description, float relativeAngle)
+        {
+            var points = new Vector2[6];
+            float direction = 0;
+            int count = 1;
+
+            // Stop before a note would land on an earlier one (a square closes after 4 notes).
+            for (; count < points.Length; count++)
+            {
+                Vector2 next = points[count - 1] + new Vector2(MathF.Cos(direction), MathF.Sin(direction));
+                if (landsOnEarlier(points, count - 1, next))
+                    break;
+
+                points[count] = next;
+                direction += relativeAngle;
+            }
+
+            return CirclePreview.Fit(description, points[..count], jump_colour, new Vector2(200, 110));
+        }
