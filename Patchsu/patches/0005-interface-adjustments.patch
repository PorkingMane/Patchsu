diff --git a/osu.Game/Graphics/UserInterfaceV2/ReversibleShearedDropdown.cs b/osu.Game/Graphics/UserInterfaceV2/ReversibleShearedDropdown.cs
new file mode 100644
index 0000000000..4662580743
--- /dev/null
+++ b/osu.Game/Graphics/UserInterfaceV2/ReversibleShearedDropdown.cs
@@ -0,0 +1,150 @@
+// Patched for fun and personal needs. I suggest playing osu!lazer instead of this client. All modifications are done with AI from personal interest.
+// Peppy openly stated that he does not like using AI and we completely respect it. I only do it for research purposes and to see what features I would love in lazer.
+// To use it you'll need to compile it on your PC using provided .sh / .cmd files.
+// This client modification does not break any osu! rules or terms of service and do not conflict with osu! rules for account banning
+// However, I do not take any liablity if your account will be banned for accessing beatmap, leaderboard and metadata downloading
+// Use responsibly and preferably local-only.
+
+using System.Linq;
+using osu.Framework.Bindables;
+using osu.Framework.Graphics;
+using osu.Framework.Graphics.Sprites;
+using osu.Framework.Graphics.UserInterface;
+using osu.Framework.Input.Events;
+using osu.Framework.Localisation;
+using osuTK;
+using osuTK.Input;
+
+namespace osu.Game.Graphics.UserInterfaceV2
+{
+    /// <summary>
+    /// Patchsu: a sort dropdown whose order can be reversed with the right mouse button.
+    /// Right-clicking the header flips the current order; right-clicking an item selects it in reverse
+    /// (left-clicking an item selects it in its normal order).
+    /// </summary>
+    public partial class ReversibleShearedDropdown<T> : ShearedDropdown<T>
+    {
+        /// <summary>
+        /// Whether the selected sort should be applied in reverse.
+        /// </summary>
+        public BindableBool Reversed { get; } = new BindableBool();
+
+        public ReversibleShearedDropdown(LocalisableString label)
+            : base(label)
+        {
+        }
+
+        protected override void LoadComplete()
+        {
+            base.LoadComplete();
+
+            Reversed.BindValueChanged(r => (Header as ReversibleHeader)?.ShowReversed(r.NewValue), true);
+        }
+
+        protected override DropdownHeader CreateHeader() => new ReversibleHeader();
+
+        protected override DropdownMenu CreateMenu() => new ReversibleMenu();
+
+        private void select(T value, bool reversed)
+        {
+            if (Current.Disabled)
+                return;
+
+            Reversed.Value = reversed;
+            Current.Value = value;
+        }
+
+        private partial class ReversibleHeader : ShearedDropdownHeader
+        {
+            private const float icon_size = 9;
+            // the label text already ends in a little side spacing, so the icon needs no extra gap.
+            private const float icon_spacing = 0;
+
+            // the label's capitals sit a little below the box's centre (descender room), so lower the icon to match them.
+            private const float icon_y_offset = 1;
+
+            private readonly SpriteText? labelText;
+            private readonly MarginPadding labelMargin;
+            private readonly SpriteIcon reversedIcon;
+
+            public ReversibleHeader()
+            {
+                // a down arrow next to the label (e.g. "Sort ↓") while the order is reversed.
+                labelText = LabelContainer.OfType<SpriteText>().FirstOrDefault();
+                labelMargin = labelText?.Margin ?? new MarginPadding { Horizontal = 10f };
+
+                LabelContainer.Add(reversedIcon = new SpriteIcon
+                {
+                    Anchor = Anchor.CentreRight,
+                    Origin = Anchor.CentreRight,
+                    // positioned inside the label's right margin, which grows to make room for it.
+                    BypassAutoSizeAxes = Axes.Both,
+                    X = -labelMargin.Right,
+                    Y = icon_y_offset,
+                    Size = new Vector2(icon_size),
+                    Icon = FontAwesome.Solid.ArrowDown,
+                    Shear = -OsuGame.SHEAR,
+                    Alpha = 0,
+                });
+            }
+
+            public void ShowReversed(bool reversed)
+            {
+                if (labelText != null)
+                    labelText.Margin = reversed ? labelMargin with { Right = labelMargin.Right + icon_size + icon_spacing } : labelMargin;
+
+                reversedIcon.Alpha = reversed ? 1 : 0;
+            }
+
+            protected override bool OnMouseDown(MouseDownEvent e)
+            {
+                if (e.Button == MouseButton.Right && Enabled.Value && Dropdown is ReversibleShearedDropdown<T> dropdown)
+                {
+                    dropdown.Reversed.Toggle();
+                    return true;
+                }
+
+                return base.OnMouseDown(e);
+            }
+        }
+
+        private partial class ReversibleMenu : ShearedDropdownMenu
+        {
+            protected override DrawableDropdownMenuItem CreateDrawableDropdownMenuItem(MenuItem item) => new ReversibleMenuItem(item)
+            {
+                BackgroundColourHover = HoverColour,
+                BackgroundColourSelected = SelectionColour
+            };
+
+            private partial class ReversibleMenuItem : ShearedMenuItem
+            {
+                public ReversibleMenuItem(MenuItem item)
+                    : base(item)
+                {
+                }
+
+                private ReversibleShearedDropdown<T>? findDropdown() => this.FindClosestParent<ReversibleShearedDropdown<T>>();
+
+                protected override bool OnClick(ClickEvent e)
+                {
+                    if (Item is DropdownMenuItem<T> dropdownItem && findDropdown() is ReversibleShearedDropdown<T> dropdown)
+                        dropdown.select(dropdownItem.Value, false);
+
+                    return base.OnClick(e);
+                }
+
+                protected override bool OnMouseDown(MouseDownEvent e)
+                {
+                    if (e.Button == MouseButton.Right && Item is DropdownMenuItem<T> dropdownItem && findDropdown() is ReversibleShearedDropdown<T> dropdown)
+                    {
+                        dropdown.select(dropdownItem.Value, true);
+                        dropdown.Menu.Close();
+                        return true;
+                    }
+
+                    return base.OnMouseDown(e);
+                }
+            }
+        }
+    }
+}
