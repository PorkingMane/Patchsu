             }
+
+            // Patchsu: right-button drags belong to the range slider (it moves the furthest nub).
+            protected override bool OnDragStart(DragStartEvent e) => e.Button != MouseButton.Right && base.OnDragStart(e);
+
+            /// <summary>
+            /// Patchsu: moves this nub to the given screen-space position as a user change (with the usual tick sound).
+            /// </summary>
+            public void MoveTo(Vector2 screenSpacePosition, bool snap)
+            {
+                if (Current.Disabled || Current is not BindableNumber<double> current)
+                    return;
+
+                float localX = ToLocalSpace(screenSpacePosition).X;
+                float proportion = Math.Clamp((localX - RangePadding) / UsableWidth, 0, 1);
+
+                double previous = current.Value;
+                current.SetProportional(proportion, snap ? KeyboardStep : 0);
+
+                if (current.Value != previous)
+                    OnUserChange(current.Value);
+            }
         }
     }
