         protected virtual BoundSliderBar CreateBoundSlider(bool isUpper) => new BoundSliderBar(this, isUpper);
 
+        // Patchsu: right-clicking the bar brings the nub furthest from the cursor to it (holding keeps moving it).
+        // Middle-clicking resets the whole range.
+        private BoundSliderBar? rightClickTarget;
+
+        // same window the framework uses for left double-clicks.
+        private const double double_click_time = 250;
+
+        private BoundSliderBar? lastRightClickedNubSlider;
+        private double lastRightClickOnNubTime;
+
+        protected override bool OnMouseDown(MouseDownEvent e)
+        {
+            switch (e.Button)
+            {
+                case MouseButton.Middle:
+                    if (LowerBound.Disabled || UpperBound.Disabled)
+                        return true;
+
+                    LowerBound.SetDefault();
+                    UpperBound.SetDefault();
+                    return true;
+
+                case MouseButton.Right:
+                    if (!SliderContainer.ReceivePositionalInputAt(e.ScreenSpaceMousePosition))
+                        break;
+
+                    // like a left click, a right click on top of either nub doesn't move anything
+                    // (otherwise clicking twice in one spot would stack both nubs there),
+                    // but double right-clicking a nub resets it, like a left double-click does.
+                    // (the lower nub is drawn on top, so it wins where they overlap.)
+                    BoundSliderBar? clickedNubSlider = LowerBoundSlider.Nub.ScreenSpaceDrawQuad.Contains(e.ScreenSpaceMousePosition) ? LowerBoundSlider
+                        : UpperBoundSlider.Nub.ScreenSpaceDrawQuad.Contains(e.ScreenSpaceMousePosition) ? UpperBoundSlider
+                        : null;
+
+                    if (clickedNubSlider != null)
+                    {
+                        if (clickedNubSlider == lastRightClickedNubSlider && Time.Current - lastRightClickOnNubTime <= double_click_time)
+                        {
+                            if (!clickedNubSlider.Current.Disabled)
+                                clickedNubSlider.Current.SetDefault();
+
+                            lastRightClickedNubSlider = null;
+                        }
+                        else
+                        {
+                            lastRightClickedNubSlider = clickedNubSlider;
+                            lastRightClickOnNubTime = Time.Current;
+                        }
+
+                        return true;
+                    }
+
+                    float cursorX = e.ScreenSpaceMousePosition.X;
+                    float lowerDistance = Math.Abs(LowerBoundSlider.Nub.ScreenSpaceDrawQuad.Centre.X - cursorX);
+                    float upperDistance = Math.Abs(UpperBoundSlider.Nub.ScreenSpaceDrawQuad.Centre.X - cursorX);
+
+                    rightClickTarget = lowerDistance > upperDistance ? LowerBoundSlider : UpperBoundSlider;
+                    rightClickTarget.MoveTo(e.ScreenSpaceMousePosition, e.ShiftPressed);
+
+                    // the moved nub is now under the cursor: a quick second right-click resets it (as a left double-click would).
+                    lastRightClickedNubSlider = rightClickTarget;
+                    lastRightClickOnNubTime = Time.Current;
+                    return true;
+            }
+
+            return base.OnMouseDown(e);
+        }
+
+        // osu! enables right-button dragging (for absolute scrolling), so the drag has to be taken here:
+        // otherwise the nub under the cursor (the closest one) would start following it as well.
+        protected override bool OnDragStart(DragStartEvent e)
+        {
+            if (e.Button != MouseButton.Right)
+                return base.OnDragStart(e);
+
+            return rightClickTarget != null;
+        }
+
+        protected override void OnDrag(DragEvent e)
+        {
+            if (e.Button == MouseButton.Right)
+                rightClickTarget?.MoveTo(e.ScreenSpaceMousePosition, e.ShiftPressed);
+            else
+                base.OnDrag(e);
+        }
+
+        protected override void OnDragEnd(DragEndEvent e)
+        {
+            if (e.Button == MouseButton.Right)
+                rightClickTarget = null;
+            else
+                base.OnDragEnd(e);
+        }
+
+        protected override void OnMouseUp(MouseUpEvent e)
+        {
+            if (e.Button == MouseButton.Right)
+                rightClickTarget = null;
+
+            base.OnMouseUp(e);
+        }
+
         protected partial class BoundSliderBar : ShearedSliderBar<double>
         {
             private readonly ShearedRangeSlider rangeSlider;
@@ -273,6 +376,27 @@ protected override bool OnHover(HoverEvent e)
                 base.OnHover(e);
