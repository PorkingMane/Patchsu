+            };
+        }
+
+        protected override void LoadComplete()
+        {
+            base.LoadComplete();
+
+            Expanded.BindValueChanged(_ => onExpanded(), true);
+        }
+
+        private void onExpanded()
+        {
+            if (Expanded.Value)
+            {
+                chevronBackground.FadeIn(DURATION / 2, Easing.OutQuint);
+                chevronIcon.ResizeWidthTo(18, DURATION * 1.5f, Easing.OutElasticQuarter);
+                chevronIcon.FadeTo(1f, DURATION, Easing.OutQuint);
+            }
+            else
+            {
+                chevronBackground.FadeOut(DURATION, Easing.OutQuint);
+                chevronIcon.ResizeWidthTo(0f, DURATION, Easing.OutQuint);
+                chevronIcon.FadeTo(0f, DURATION, Easing.OutQuint);
+            }
+
+            folderIcon.Icon = Expanded.Value ? FontAwesome.Solid.FolderOpen : FontAwesome.Solid.Folder;
+            glow.FadeTo(Expanded.Value ? 1f : 0f, DURATION, Easing.OutQuint);
+        }
+
+        protected override void PrepareForUse()
+        {
+            base.PrepareForUse();
+
+            titleText.Text = folder.Title;
+            countText.Text = Item!.NestedItemCount.ToString("N0");
+        }
+
+        protected override void UpdateAfterChildren()
+        {
+            base.UpdateAfterChildren();
+
+            // Keep the count pill pinned to the screen regardless of the X position of TopLevelContent (see PanelGroup).
+            countPill.X = -TopLevelContent.X;
+        }
+
+        #region Context menu
+
+        public override MenuItem[] ContextMenuItems
+        {
+            get
+            {
+                if (Item == null)
+                    return Array.Empty<MenuItem>();
+
+                var current = folder;
+                var segments = current.Segments.ToArray();
+
+                var items = new List<MenuItem>
+                {
+                    new OsuMenuItem(Expanded.Value ? WebCommonStrings.ButtonsCollapse.ToSentence() : WebCommonStrings.ButtonsExpand.ToSentence(), MenuItemType.Highlighted, () => TriggerClick())
+                };
+
+                if (current.IsNotInCollection)
+                    return items.ToArray();
+
+                items.Add(new OsuMenuItemSpacer());
+
+                items.Add(new OsuMenuItem("New sub-collection...", MenuItemType.Standard,
+                    () => showNamePopover($"New sub-collection in \"{current.Title}\"", string.Empty, name => CollectionFolders.CreateCollection(realm, segments, name), true))
+                {
+                    Icon = FontAwesome.Solid.FolderPlus
+                });
+
+                items.Add(new OsuMenuItem("Rename...", MenuItemType.Standard,
+                    () => showNamePopover($"Rename \"{current.Title}\"", current.Title.ToString(), name => CollectionFolders.RenameFolder(realm, segments, name)))
+                {
+                    Icon = FontAwesome.Solid.PencilAlt
+                });
+
+                var moveTargets = createMoveTargets(segments);
+
+                if (moveTargets.Count > 0)
+                    items.Add(new OsuMenuItem("Move to") { Items = moveTargets });
+
+                // its beatmaps (sub-collections included) go into the parent collection.
+                if (segments.Length > 1)
+                {
+                    items.Add(new OsuMenuItem("Merge into parent", MenuItemType.Standard, () => CollectionFolders.MergeIntoParent(realm, segments))
+                    {
+                        Icon = FontAwesome.Solid.CompressArrowsAlt
+                    });
+                }
+
+                if (manageCollectionsDialog != null)
+                    items.Add(new OsuMenuItem("Manage collections...", MenuItemType.Standard, manageCollectionsDialog.Show));
+
+                items.Add(new OsuMenuItemSpacer());
+                items.Add(new OsuMenuItem(WebCommonStrings.ButtonsDelete, MenuItemType.Destructive, () => confirmDelete(segments)));
+
+                return items.ToArray();
+            }
+        }
+
+        private List<MenuItem> createMoveTargets(string[] segments)
+        {
+            var targets = new List<MenuItem>();
+
+            if (segments.Length > 1)
+                targets.Add(new OsuMenuItem("Top level", MenuItemType.Standard, () => CollectionFolders.MoveFolderInto(realm, segments, Array.Empty<string>())));
+
+            var folders = realm.Run(r => CollectionFolders.Flatten(CollectionFolders.BuildTree(r.All<BeatmapCollection>().OrderBy(c => c.Name).AsEnumerable()))
+                                                          .Select(n => n.Segments)
+                                                          .ToList());
+
+            foreach (string[] target in folders)
+            {
+                // can't move into itself, anything inside it, or where it already is.
+                if (CollectionFolders.IsSameOrInside(target, segments) || target.AsSpan().SequenceEqual(segments.AsSpan(0, segments.Length - 1)))
+                    continue;
+
+                targets.Add(new OsuMenuItem(string.Join(" / ", target), MenuItemType.Standard, () => CollectionFolders.MoveFolderInto(realm, segments, target)));
+            }
+
+            return targets;
+        }
+
+        private void confirmDelete(string[] segments)
+        {
+            var (collections, beatmaps) = CollectionFolders.CountFolder(realm, segments);
+
+            if (collections == 0)
+                return;
+
+            void delete() => CollectionFolders.DeleteFolder(realm, segments);
+
+            if (beatmaps == 0 && collections == 1)
+                delete();
+            else
+                dialogOverlay?.Push(new DeleteFolderDialog(CollectionFolders.Join(segments), collections, beatmaps, delete));
+        }
+
+        private partial class DeleteFolderDialog : DeletionDialog
+        {
+            public DeleteFolderDialog(string path, int collections, int beatmaps, Action deleteAction)
+            {
+                BodyText = collections > 1
+                    ? $"{path} and {collections - 1:N0} sub-collection{(collections == 2 ? string.Empty : "s")} ({beatmaps:N0} beatmap{(beatmaps == 1 ? string.Empty : "s")})"
+                    : $"{path} ({beatmaps:N0} beatmap{(beatmaps == 1 ? string.Empty : "s")})";
+                DangerousAction = deleteAction;
+            }
+        }
+
+        #endregion
+
+        #region Name popover
+
+        private Popover? pendingPopover;
+
+        private void showNamePopover(string title, string initialText, Action<string> commit, bool showsEmptyHint = false)
+        {
+            pendingPopover = new FolderNamePopover(title, initialText, commit, showsEmptyHint);
+            this.ShowPopover();
+        }
+
+        public Popover GetPopover() => pendingPopover ?? new FolderNamePopover(string.Empty, string.Empty, _ => { });
+
+        private partial class FolderNamePopover : OsuPopover
+        {
+            private readonly Action<string> commit;
+            private readonly OsuTextBox textBox;
+
+            public FolderNamePopover(string title, string initialText, Action<string> commit, bool showsEmptyHint = false)
+            {
+                this.commit = commit;
+
+                Child = new FillFlowContainer
+                {
+                    Width = 280,
+                    AutoSizeAxes = Axes.Y,
+                    Direction = FillDirection.Vertical,
+                    Spacing = new Vector2(0, 8),
+                    Children = new Drawable[]
+                    {
+                        new OsuSpriteText
+                        {
+                            Text = title,
+                            Font = OsuFont.Style.Body.With(weight: FontWeight.SemiBold),
+                        },
+                        textBox = new OsuTextBox
+                        {
+                            RelativeSizeAxes = Axes.X,
+                            Text = initialText,
+                            PlaceholderText = "Name",
+                            CommitOnFocusLost = false,
+                        },
+                        new OsuTextFlowContainer(s => s.Font = OsuFont.Style.Caption2)
+                        {
+                            RelativeSizeAxes = Axes.X,
+                            AutoSizeAxes = Axes.Y,
+                            Alpha = 0.6f,
+                            Text = showsEmptyHint
+                                ? $"Enter to confirm. \"{CollectionFolders.SEPARATOR}\" nests it deeper. It shows up here once it has a beatmap."
+                                : $"Enter to confirm. \"{CollectionFolders.SEPARATOR}\" nests it deeper.",
+                        },
+                    }
+                };
+            }
+
+            protected override void LoadComplete()
+            {
+                base.LoadComplete();
+
+                textBox.OnCommit += (_, _) =>
+                {
+                    string text = textBox.Text.Trim();
+
+                    if (text.Length > 0)
+                        commit(text);
+
+                    this.HidePopover();
+                };
+
+                ScheduleAfterChildren(() =>
+                {
+                    GetContainingFocusManager()?.ChangeFocus(textBox);
+                    textBox.SelectAll();
+                });
+            }
+
+            protected override bool OnKeyDown(KeyDownEvent e)
+            {
+                // Keep typing out of song select (e.g. the search box or carousel hotkeys).
+                if (e.Key == Key.Escape)
+                {
+                    this.HidePopover();
+                    return true;
+                }
+
+                return base.OnKeyDown(e);
+            }
+        }
+
+        #endregion
+    }
+}
