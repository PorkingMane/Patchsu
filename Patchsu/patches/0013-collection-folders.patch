+namespace osu.Game.Screens.Select
+{
+    /// <summary>
+    /// Patchsu patch 13: nested collection folders.
+    /// </summary>
+    /// <remarks>
+    /// Only one chain of folders is open at a time: <see cref="ExpandedGroup"/> is the deepest open folder and all of
+    /// its parents count as open too. Opening a folder elsewhere closes the chain, like vanilla groups.
+    /// The carousel item order is depth first, a folder's sub-folders before its own beatmaps
+    /// (see BeatmapCarouselFilterGrouping.CollectionFolders.cs).
+    /// </remarks>
+    public partial class BeatmapCarousel
+    {
+        /// <summary>
+        /// Extra X offset per folder level, for folder panels and everything inside them.
+        /// </summary>
+        public const float FOLDER_INDENT = 20;
+
+        private readonly DrawablePool<PanelCollectionFolder> folderPanelPool = new DrawablePool<PanelCollectionFolder>(50);
+
+        /// <summary>
+        /// Whether <paramref name="group"/> is a collection folder that is open (the expanded one or one of its parents).
+        /// Beatmaps without a folder (filtering to one collection) are always shown.
+        /// </summary>
+        private bool isFolderOpen(GroupDefinition? group)
+        {
+            if (group == null)
+                return grouping.UsesCollectionFolders;
+
+            return group is CollectionFolderGroupDefinition folder && folder.IsSelfOrAncestorOf(ExpandedGroup as CollectionFolderGroupDefinition);
+        }
+
+        /// <returns>Whether the activation was handled as a folder.</returns>
+        private bool activateFolder(GroupDefinition group)
+        {
+            if (group is not CollectionFolderGroupDefinition folder)
+                return false;
+
+            if (isFolderOpen(folder))
+            {
+                // Closing a folder closes everything open inside it too.
+                setExpandedGroup(folder.Parent);
+                return true;
+            }
+
+            setExpandedGroup(folder);
+
+            // If the active selection is directly within this folder, it should get keyboard focus immediately.
+            // (Not for selections in a parent folder: re-selecting those would close this folder again.)
+            // Folders with sub-folders keep the focus on their header, so group traversal (shift+arrows) steps into
+            // the sub-folders next instead of jumping past them.
+            if (CurrentSelectionItem?.IsVisible == true && CurrentSelection is GroupedBeatmap gb && folder.Equals(gb.Group) && !hasSubFolders(folder))
+                RequestSelection(gb);
+
+            return true;
+        }
+
+        private bool hasSubFolders(CollectionFolderGroupDefinition folder)
+            => GetCarouselItems()?.Any(i => i.Model is CollectionFolderGroupDefinition f && folder.Equals(f.Parent)) == true;
+
+        /// <summary>
+        /// Set traversal (arrow keys) from a folder header moves to the next or previous beatmap set instead of opening and
+        /// closing the folder. Selecting a set inside a closed folder opens it.
+        /// </summary>
+        protected override bool ShouldActivateKeyboardSelectionBeforeSetTraversal(CarouselItem keyboardItem)
+            => keyboardItem.Model is not CollectionFolderGroupDefinition;
+
+        /// <summary>
+        /// Selecting a beatmap in a folder which is already open keeps the open sub-folders open.
+        /// </summary>
+        private GroupDefinition? groupToExpandForSelection(GroupDefinition? group) => isFolderOpen(group) ? ExpandedGroup : group;
+
+        /// <summary>
+        /// Closed sub-folders are hidden and can't be reached by group traversal.
+        /// </summary>
+        private static bool isReachableGroup(CarouselItem item) => item.Model is not CollectionFolderGroupDefinition || item.IsVisible;
+
+        private void refreshFolderVisibility()
+        {
+            var items = GetCarouselItems();
+
+            if (items == null)
+                return;
+
+            var expanded = ExpandedGroup as CollectionFolderGroupDefinition;
+
+            foreach (var item in items)
+            {
+                switch (item.Model)
+                {
+                    case CollectionFolderGroupDefinition folder:
+                        item.IsExpanded = folder.IsSelfOrAncestorOf(expanded);
+                        item.IsVisible = folder.Parent == null || folder.Parent.IsSelfOrAncestorOf(expanded);
+                        break;
+
+                    case GroupedBeatmapSet groupedSet:
+                        bool open = isFolderOpen(groupedSet.Group);
+                        item.IsVisible = open;
+
+                        // difficulties follow the set's own expanded state.
+                        if (open)
+                            setExpansionStateOfSetItems(groupedSet, item.IsExpanded);
+                        break;
+
+                    case GroupedBeatmap groupedBeatmap:
+                        if (!isFolderOpen(groupedBeatmap.Group))
+                            item.IsVisible = false;
+                        else if (!grouping.BeatmapSetsGroupedTogether)
+                            item.IsVisible = true;
+                        break;
+                }
+            }
+        }
+
+        private float? getFolderSpacing(CarouselItem top, CarouselItem bottom)
+        {
+            // Folder rows are thin, so give them a small gap instead of the group panels' overlap.
+            if (top.Model is CollectionFolderGroupDefinition && bottom.Model is CollectionFolderGroupDefinition)
+                return SPACING;
+
+            return null;
+        }
+
+        private float getFolderIndent(Drawable panel)
+        {
+            if (!grouping.UsesCollectionFolders || panel is not Panel { Item: { } item })
+                return 0;
+
+            GroupDefinition? group = item.Model switch
+            {
+                CollectionFolderGroupDefinition f => f,
+                GroupedBeatmapSet s => s.Group,
+                GroupedBeatmap b => b.Group,
+                _ => null,
+            };
+
+            return group is CollectionFolderGroupDefinition folder ? folder.Depth * FOLDER_INDENT : 0;
+        }
+
+        protected override bool TryFindOwnGroupItem(CarouselItem item, out CarouselItem? groupItem)
+        {
+            groupItem = null;
+
+            if (!grouping.UsesCollectionFolders)
+                return false;
+
+            GroupDefinition? group = item.Model switch
+            {
+                GroupedBeatmapSet s => s.Group,
+                GroupedBeatmap b => b.Group,
+                _ => null,
+            };
+
+            // Inside a folder the closest header above may be a sibling sub-folder, so look the folder up directly.
+            // Beatmaps without a folder have no group to toggle.
+            if (group != null && grouping.ItemMap.TryGetValue(group, out var found))
+                groupItem = found.item;
+
+            return item.Model is not GroupDefinition;
+        }
+    }
+}
