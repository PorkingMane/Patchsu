+
+namespace osu.Game.Screens.Select
+{
+    /// <summary>
+    /// Patchsu patch 13: a thin collection folder row. Opens like a beatmap set (white strip with a chevron, pointing down).
+    /// </summary>
+    public partial class PanelCollectionFolder : Panel, IHasPopover
+    {
+        /// <summary>
+        /// As tall as the sort / group dropdowns above the carousel.
+        /// </summary>
+        public const float HEIGHT = 30;
+
+        /// <summary>
+        /// Folder rows stay put when closed, so the tree reads by indentation alone.
+        /// </summary>
+        protected override bool ShiftWhenCollapsed => false;
+
+        private Box chevronBackground = null!;
+        private Drawable chevronIcon = null!;
+        private SpriteIcon folderIcon = null!;
+        private OsuSpriteText titleText = null!;
+        private CircularContainer countPill = null!;
+        private OsuSpriteText countText = null!;
+        private Box glow = null!;
+
+        [Resolved]
+        private OverlayColourProvider colourProvider { get; set; } = null!;
+
+        [Resolved]
+        private RealmAccess realm { get; set; } = null!;
+
+        [Resolved]
+        private IDialogOverlay? dialogOverlay { get; set; }
+
+        [Resolved]
+        private ManageCollectionsDialog? manageCollectionsDialog { get; set; }
+
+        private CollectionFolderGroupDefinition folder
+        {
+            get
+            {
+                Debug.Assert(Item != null);
+                return (CollectionFolderGroupDefinition)Item.Model;
+            }
+        }
+
+        [BackgroundDependencyLoader]
+        private void load()
+        {
+            Height = HEIGHT;
+
+            Icon = chevronIcon = new Container
+            {
+                Size = new Vector2(0, HEIGHT),
+                Alpha = 0f,
+                Child = new SpriteIcon
+                {
+                    Anchor = Anchor.Centre,
+                    Origin = Anchor.Centre,
+                    Icon = FontAwesome.Solid.ChevronDown,
+                    Size = new Vector2(8),
+                    X = 1f,
+                    Colour = colourProvider.Background5,
+                },
+            };
+
+            Background = chevronBackground = new Box
+            {
+                RelativeSizeAxes = Axes.Both,
+                Colour = Color4.White,
+                Alpha = 0f,
+            };
+
+            AccentColour = colourProvider.Highlight1;
+
+            Content.Children = new Drawable[]
+            {
+                new Box
+                {
+                    RelativeSizeAxes = Axes.Both,
+                    Colour = colourProvider.Background4,
+                },
+                glow = new Box
+                {
+                    RelativeSizeAxes = Axes.Both,
+                    Width = 0.5f,
+                    Alpha = 0f,
+                    Colour = ColourInfo.GradientHorizontal(colourProvider.Highlight1.Opacity(0.5f), colourProvider.Highlight1.Opacity(0f)),
+                },
+                new FillFlowContainer
+                {
+                    Anchor = Anchor.CentreLeft,
+                    Origin = Anchor.CentreLeft,
+                    AutoSizeAxes = Axes.Both,
+                    Direction = FillDirection.Horizontal,
+                    Spacing = new Vector2(7, 0),
+                    X = 10f,
+                    Children = new Drawable[]
+                    {
+                        folderIcon = new SpriteIcon
+                        {
+                            Anchor = Anchor.CentreLeft,
+                            Origin = Anchor.CentreLeft,
+                            Size = new Vector2(14),
+                            Icon = FontAwesome.Solid.Folder,
+                            Colour = colourProvider.Content2,
+                        },
+                        titleText = new OsuSpriteText
+                        {
+                            Anchor = Anchor.CentreLeft,
+                            Origin = Anchor.CentreLeft,
+                            Font = OsuFont.Style.Heading2,
