@@ -0,0 +1,323 @@
+// Added by Patchsu
+
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Threading;
+using osu.Framework.Localisation;
+using osu.Game.Beatmaps;
+using osu.Game.Collections;
+using osu.Game.Graphics.Carousel;
+using osu.Game.Localisation;
+using osu.Game.Screens.Select.Filter;
+
+namespace osu.Game.Screens.Select
+{
+    // Patchsu patch 13: "Group by: Collections" shows nested collection folders instead of flat group headers.
+    public partial class BeatmapCarouselFilterGrouping
+    {
+        /// <summary>
+        /// Whether the last filter run produced collection folders (<see cref="CollectionFolderGroupDefinition"/> groups).
+        /// </summary>
+        public bool UsesCollectionFolders { get; private set; }
+
+        private class FolderBuild
+        {
+            public required CollectionFolderGroupDefinition Definition { get; init; }
+            public FolderBuild? BuildParent { get; init; }
+            public List<FolderBuild> Children { get; } = new List<FolderBuild>();
+            public HashSet<string> Hashes { get; } = new HashSet<string>();
+            public List<CarouselItem> Items { get; } = new List<CarouselItem>();
+            public int SubtreeItemCount;
+        }
+
+        /// <summary>
+        /// Whether to show folders for this filter: "Group by: Collections", or "Group by: None" while filtering to a
+        /// collection which has sub-collections (<see cref="FilterCriteria.CollectionFolder"/>).
+        /// </summary>
+        private static bool shouldUseCollectionFolders(FilterCriteria criteria)
+            => criteria.Group == GroupMode.Collections || (criteria.Group == GroupMode.None && criteria.CollectionFolder != null);
+
+        private int addCollectionFolders(List<CarouselItem> items, List<CarouselItem> newItems,
+                                         Dictionary<object, (CarouselItem, int)> newItemMap,
+                                         Dictionary<GroupedBeatmapSet, HashSet<CarouselItem>> newSetMap,
+                                         Dictionary<GroupDefinition, HashSet<CarouselItem>> newGroupMap,
+                                         FilterCriteria criteria,
+                                         CancellationToken cancellationToken)
+        {
+            // NOTE: the incoming order (realm side name sort) is significant, see `BeatmapCarousel.GetAllCollections()`.
+            var tree = CollectionFolders.BuildTree(GetCollections());
+
+            int order = 0;
+            List<FolderBuild> roots;
+
+            // Filtering to one collection: its sub-collections are the top level folders, and its own beatmaps follow
+            // them without a folder (like "Group by: None").
+            FolderBuild? filteredRoot = null;
+
+            if (criteria.Group != GroupMode.Collections && criteria.CollectionFolder != null)
+            {
+                var node = CollectionFolders.Flatten(tree).FirstOrDefault(n => n.Segments.SequenceEqual(criteria.CollectionFolder));
+
+                filteredRoot = new FolderBuild { Definition = new CollectionFolderGroupDefinition(order++, criteria.CollectionFolder, null) };
+
+                if (node != null)
+                {
+                    foreach (var collection in node.Collections)
+                        filteredRoot.Hashes.UnionWith(collection.BeatmapMD5Hashes);
+                }
+
+                roots = node?.Children.Select(n => createBuild(n, null, filteredRoot)).ToList() ?? new List<FolderBuild>();
+            }
+            else
+                roots = tree.Select(n => createBuild(n, null, null)).ToList();
+
+            FolderBuild createBuild(CollectionFolders.Node node, CollectionFolderGroupDefinition? parent, FolderBuild? parentBuild)
+            {
+                var build = new FolderBuild { Definition = new CollectionFolderGroupDefinition(order++, node.Segments, parent), BuildParent = parentBuild };
+
+                foreach (var collection in node.Collections)
+                    build.Hashes.UnionWith(collection.BeatmapMD5Hashes);
+
+                build.Children.AddRange(node.Children.Select(c => createBuild(c, build.Definition, build)));
+                return build;
+            }
+
+            var uncollected = new FolderBuild { Definition = CollectionFolderGroupDefinition.CreateNotInCollection() };
+
+            // MD5 → folders holding it directly (see `defineGroupsByCollection` for why this is pre-built).
+            var md5ToFolders = new Dictionary<string, List<FolderBuild>>();
+
+            foreach (var folder in roots.SelectMany(selfAndDescendants).Concat(filteredRoot == null ? [] : [filteredRoot]))
+            {
+                foreach (string md5 in folder.Hashes)
+                {
+                    if (!md5ToFolders.TryGetValue(md5, out var list))
+                        md5ToFolders[md5] = list = new List<FolderBuild>();
+
+                    list.Add(folder);
+                }
+            }
+
+            // A beatmap in a folder and one of its sub-folders is only listed in the outer one (it's visible there anyway).
+            foreach (var list in md5ToFolders.Values)
+            {
+                if (list.Count < 2)
+                    continue;
+
+                var all = list.ToHashSet();
+                list.RemoveAll(f => ancestors(f).Any(all.Contains));
+            }
+
+            foreach (var item in items)
+            {
+                var beatmap = (BeatmapInfo)item.Model;
+
+                if (string.IsNullOrEmpty(beatmap.MD5Hash))
+                    continue;
+
+                if (md5ToFolders.TryGetValue(beatmap.MD5Hash, out var folders))
+                {
+                    foreach (var folder in folders)
+                        folder.Items.Add(item);
+                }
+                else
+                    uncollected.Items.Add(item);
+            }
+
+            if (filteredRoot == null)
+                roots.Add(uncollected);
+
+            foreach (var root in roots)
+                countSubtree(root);
+
+            int displayedBeatmapsCount = 0;
+            var groupChain = new List<HashSet<CarouselItem>>();
+            var headerChain = new List<CarouselItem>();
+
+            if (filteredRoot != null)
+                emitContents(roots, filteredRoot, null);
+            else
+            {
+                foreach (var root in roots)
+                    emit(root);
+            }
+
+            return displayedBeatmapsCount;
+
+            void emit(FolderBuild folder)
+            {
+                // Folders with nothing in them (after filtering) are hidden, like vanilla's empty collection groups.
+                if (folder.SubtreeItemCount == 0)
+                    return;
+
+                cancellationToken.ThrowIfCancellationRequested();
+
+                var group = folder.Definition;
+
+                groupChain.Add(newGroupMap[group] = new HashSet<CarouselItem>());
+
+                var header = new CarouselItem(group)
+                {
+                    DrawHeight = PanelCollectionFolder.HEIGHT,
+                    DepthLayer = -2,
+                };
+
+                addItem(header, null);
+                header.IsVisible = group.Depth == 0;
+                headerChain.Add(header);
+
+                emitContents(folder.Children, folder, group);
+
+                groupChain.RemoveAt(groupChain.Count - 1);
+                headerChain.RemoveAt(headerChain.Count - 1);
+            }
+
+            // Sub-folders always come first (by name), then the folder's own beatmaps in the current sort.
+            void emitContents(List<FolderBuild> children, FolderBuild folder, CollectionFolderGroupDefinition? group)
+            {
+                foreach (var child in children)
+                    emit(child);
+
+                emitItems(folder.Items, group);
+            }
+
+            // Without a group (filtered root), sets are always shown, like "Group by: None".
+            void emitItems(List<CarouselItem> folderItems, CollectionFolderGroupDefinition? group)
+            {
+                BeatmapInfo? lastBeatmap = null;
+                HashSet<CarouselItem>? currentSetItems = null;
+
+                foreach (var item in folderItems)
+                {
+                    cancellationToken.ThrowIfCancellationRequested();
+
+                    var beatmap = (BeatmapInfo)item.Model;
+
+                    bool newBeatmapSet = lastBeatmap?.BeatmapSet!.ID != beatmap.BeatmapSet!.ID;
+                    var groupedBeatmapSet = new GroupedBeatmapSet(group, beatmap.BeatmapSet!);
+
+                    if (newBeatmapSet)
+                    {
+                        if (!newSetMap.TryGetValue(groupedBeatmapSet, out currentSetItems))
+                            newSetMap[groupedBeatmapSet] = currentSetItems = new HashSet<CarouselItem>();
+                    }
+
+                    if (!BeatmapSetsGroupedTogether || newBeatmapSet)
+                    {
+                        foreach (var h in headerChain)
+                            h.NestedItemCount++;
+                    }
+
+                    if (BeatmapSetsGroupedTogether && newBeatmapSet)
+                    {
+                        var setItem = new CarouselItem(groupedBeatmapSet)
+                        {
+                            DrawHeight = PanelBeatmapSet.HEIGHT,
+                            DepthLayer = -1
+                        };
+
+                        addItem(setItem, currentSetItems);
+                        setItem.IsVisible = group == null;
+                    }
+
+                    var beatmapItem = new CarouselItem(new GroupedBeatmap(group, beatmap))
+                    {
+                        DrawHeight = BeatmapSetsGroupedTogether ? PanelBeatmap.HEIGHT : PanelBeatmapStandalone.HEIGHT,
+                    };
+
+                    addItem(beatmapItem, currentSetItems);
+                    beatmapItem.IsVisible = group == null && !BeatmapSetsGroupedTogether;
+
+                    lastBeatmap = beatmap;
+                    displayedBeatmapsCount++;
+                }
+            }
+
+            void addItem(CarouselItem i, HashSet<CarouselItem>? setItems)
+            {
+                newItems.Add(i);
+                newItemMap[i.Model] = (i, newItems.Count - 1);
+
+                // A folder's group items cover everything inside it, sub-folders included.
+                foreach (var g in groupChain)
+                    g.Add(i);
+
+                setItems?.Add(i);
+                i.IsVisible = false;
+            }
+
+            static int countSubtree(FolderBuild folder)
+            {
+                folder.SubtreeItemCount = folder.Items.Count + folder.Children.Sum(countSubtree);
+                return folder.SubtreeItemCount;
+            }
+
+            static IEnumerable<FolderBuild> ancestors(FolderBuild folder)
+            {
+                for (var f = folder.BuildParent; f != null; f = f.BuildParent)
+                    yield return f;
+            }
+
+            static IEnumerable<FolderBuild> selfAndDescendants(FolderBuild folder) => folder.Children.SelectMany(selfAndDescendants).Prepend(folder);
+        }
+    }
+
+    /// <summary>
+    /// Patchsu patch 13: a collection folder in the carousel. Folders are nested by <see cref="Parent"/>.
+    /// </summary>
+    public sealed record CollectionFolderGroupDefinition : GroupDefinition
+    {
+        /// <summary>
+        /// The folder path segments (<c>["Parent", "Child"]</c>). Empty for "Not in collection".
+        /// </summary>
+        public IReadOnlyList<string> Segments { get; }
+
+        public string Path { get; }
+
+        public CollectionFolderGroupDefinition? Parent { get; }
+
+        public int Depth => Parent == null ? 0 : Parent.Depth + 1;
+
+        /// <summary>
+        /// The "Not in collection" folder, which isn't a real collection and can't be edited.
+        /// </summary>
+        public bool IsNotInCollection { get; }
+
+        public CollectionFolderGroupDefinition(int order, IReadOnlyList<string> segments, CollectionFolderGroupDefinition? parent)
+            : this(order, segments.Count > 0 ? segments[^1] : string.Empty, segments, parent, false)
+        {
+        }
+
+        private CollectionFolderGroupDefinition(int order, LocalisableString title, IReadOnlyList<string> segments, CollectionFolderGroupDefinition? parent, bool notInCollection)
+            : base(order, title)
+        {
+            Segments = segments;
+            Path = CollectionFolders.Join(segments);
+            Parent = parent;
+            IsNotInCollection = notInCollection;
+        }
+
+        public static CollectionFolderGroupDefinition CreateNotInCollection()
+            => new CollectionFolderGroupDefinition(int.MaxValue, BeatmapCarouselFilterGroupingStrings.NotInCollection, Array.Empty<string>(), null, true);
+
+        /// <summary>
+        /// Whether this folder is <paramref name="other"/> or one of its parents.
+        /// </summary>
+        public bool IsSelfOrAncestorOf(CollectionFolderGroupDefinition? other)
+        {
+            for (var f = other; f != null; f = f.Parent)
+            {
+                if (Equals(f))
+                    return true;
+            }
+
+            return false;
+        }
+
+        public bool Equals(CollectionFolderGroupDefinition? other)
+            => other != null && IsNotInCollection == other.IsNotInCollection && string.Equals(Path, other.Path, StringComparison.Ordinal);
+
+        public override int GetHashCode() => HashCode.Combine(Path, IsNotInCollection);
+    }
+}
