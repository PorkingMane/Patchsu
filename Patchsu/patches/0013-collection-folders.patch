@@ -0,0 +1,56 @@
+// Added by Patchsu
+
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using osu.Game.Collections;
+
+namespace osu.Game.Screens.Select
+{
+    // Patchsu patch 13: filtering by a collection includes its sub-collections.
+    public sealed partial class FilterControl
+    {
+        /// <param name="collectionId">The collection picked in the collection dropdown.</param>
+        /// <param name="folder">The collection's folder path, when it has sub-collections (otherwise null).</param>
+        /// <returns>The beatmap hashes of the collection and everything inside it, or null if it doesn't exist.</returns>
+        private IEnumerable<string>? getCollectionFilterHashes(Guid collectionId, out string[]? folder)
+        {
+            string[]? foundFolder = null;
+
+            var hashes = realm.Run(r =>
+            {
+                var collection = r.Find<BeatmapCollection>(collectionId);
+
+                if (collection == null)
+                    return null;
+
+                string[] path = CollectionFolders.Split(collection.Name);
+                var result = new HashSet<string>(collection.BeatmapMD5Hashes);
+                bool hasSubCollections = false;
+
+                foreach (var other in r.All<BeatmapCollection>())
+                {
+                    if (other.ID == collectionId)
+                        continue;
+
+                    string[] otherPath = CollectionFolders.Split(other.Name);
+
+                    // same path (a duplicate name) counts as the same folder.
+                    if (!CollectionFolders.IsSameOrInside(otherPath, path))
+                        continue;
+
+                    hasSubCollections |= otherPath.Length > path.Length;
+                    result.UnionWith(other.BeatmapMD5Hashes);
+                }
+
+                if (hasSubCollections)
+                    foundFolder = path;
+
+                return result;
+            });
+
+            folder = foundFolder;
+            return hashes;
+        }
+    }
+}
