diff --git a/osu.Game/Screens/Select/Filter/ScoreWithModFilter.cs b/osu.Game/Screens/Select/Filter/ScoreWithModFilter.cs
new file mode 100644
index 0000000000..c57ad81f31
--- /dev/null
+++ b/osu.Game/Screens/Select/Filter/ScoreWithModFilter.cs
@@ -0,0 +1,202 @@
+// Copyright (c) ppy Pty Ltd <contact@ppy.sh>. Licensed under the MIT Licence.
+// See the LICENCE file in the repository root for full licence text.
+
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Text;
+using System.Text.RegularExpressions;
+using Newtonsoft.Json;
+using osu.Game.Online.API;
+using osu.Game.Rulesets;
+
+namespace osu.Game.Screens.Select.Filter
+{
+    /// <summary>
+    /// Patchsu (patch 5b): the "scorewithmod" search keyword. Keeps beatmaps that have a local score of the current user
+    /// (in the selected ruleset) set with the given mods.
+    /// </summary>
+    /// <remarks>
+    /// <list type="bullet">
+    /// <item><c>scorewithmod=HD</c>: a mod acronym (or a one-word mod name, like <c>scorewithmod=hidden</c>).</item>
+    /// <item><c>scorewithmod='Wind Up'</c> (or <c>"Wind Up"</c>): an exact mod name, ignoring case.</item>
+    /// <item><c>scorewithmod=HD,DT</c> / <c>scorewithmod=HD+DT</c> / <c>scorewithmod=HD scorewithmod=DT</c>: one score has every listed mod.</item>
+    /// <item><c>scorewithmod!=DT</c>: the score doesn't have this mod.</item>
+    /// <item><c>scorewithmod=NM</c>: a score without mods (Classic doesn't count).</item>
+    /// </list>
+    /// Other mods on the score and mod settings (e.g. a custom rate) don't matter.
+    /// <c>scoreswithmod</c> and <c>playwithmod</c> are the same keyword.
+    /// </remarks>
+    public class ScoreWithModFilter
+    {
+        /// <summary>
+        /// The keyword's own syntax (quoted names with spaces, lists) doesn't fit the generic query syntax, so it is read first.
+        /// A quote left open at the end of the query runs to the end (for typing).
+        /// </summary>
+        private static readonly Regex keyword_regex = new Regex(
+            @"\b(?:scorewithmod|scoreswithmod|playwithmod)(?<op>!?[:=])(?<value>(?:'[^']*(?:'|$)|""[^""]*(?:""|$)|[^\s'""])+)",
+            RegexOptions.Compiled | RegexOptions.IgnoreCase);
+
+        private const string no_mod = @"NM";
+
+        private const string classic_acronym = @"CL";
+
+        private readonly List<Term> required = new List<Term>();
+        private readonly List<Term> excluded = new List<Term>();
+
+        /// <summary>
+        /// Identifies what this filter matches (for caching results).
+        /// </summary>
+        public string Key => string.Join(' ', required.Select(t => "+" + t).Concat(excluded.Select(t => "-" + t)));
+
+        /// <summary>
+        /// Takes every "scorewithmod" keyword out of <paramref name="query"/> into <see cref="FilterCriteria.ScoreWithMods"/>.
+        /// </summary>
+        /// <returns>The query without those keywords.</returns>
+        public static string Extract(FilterCriteria criteria, string query)
+        {
+            foreach (Match match in keyword_regex.Matches(query))
+            {
+                var terms = parseTerms(match.Groups["value"].Value);
+
+                if (terms.Count == 0)
+                    continue;
+
+                criteria.ScoreWithMods ??= new ScoreWithModFilter();
+                (match.Groups["op"].Value.StartsWith('!') ? criteria.ScoreWithMods.excluded : criteria.ScoreWithMods.required).AddRange(terms);
+
+                query = query.Replace(match.Value, string.Empty);
+            }
+
+            return query;
+        }
+
+        private static List<Term> parseTerms(string value)
+        {
+            var terms = new List<Term>();
+            var current = new StringBuilder();
+            char? quote = null;
+            bool quoted = false;
+
+            foreach (char c in value)
+            {
+                if (quote != null)
+                {
+                    if (c == quote)
+                        quote = null;
+                    else
+                        current.Append(c);
+                }
+                else if (c is '\'' or '"')
+                {
+                    quote = c;
+                    quoted = true;
+                }
+                else if (c is ',' or '+')
+                    finishTerm();
+                else
+                    current.Append(c);
+            }
+
+            finishTerm();
+            return terms;
+
+            void finishTerm()
+            {
+                string text = current.ToString().Trim();
+
+                if (text.Length > 0)
+                    terms.Add(new Term(text, quoted));
+
+                current.Clear();
+                quoted = false;
+            }
+        }
+
+        /// <summary>
+        /// Resolves mod names for <paramref name="ruleset"/> and returns a check for a score's mods (its <c>ModsJson</c>).
+        /// The check remembers its answer per distinct <c>ModsJson</c>, so use one per scan (not thread-safe).
+        /// </summary>
+        public Func<string, bool> CreateMatcher(Ruleset? ruleset)
+        {
+            var allMods = ruleset?.CreateAllMods().ToArray() ?? [];
+
+            var requiredAcronyms = new List<string>();
+            var excludedAcronyms = new List<string>();
+            bool requireNoMod = false;
+            bool excludeNoMod = false;
+
+            foreach (var term in required)
+            {
+                if (term.IsNoMod)
+                    requireNoMod = true;
+                else if (resolve(term) is string acronym)
+                    requiredAcronyms.Add(acronym);
+                else
+                    return _ => false; // no such mod, so no score has it.
+            }
+
+            foreach (var term in excluded)
+            {
+                if (term.IsNoMod)
+                    excludeNoMod = true;
+                else if (resolve(term) is string acronym)
+                    excludedAcronyms.Add(acronym);
+            }
+
+            var results = new Dictionary<string, bool>();
+
+            return modsJson =>
+            {
+                if (!results.TryGetValue(modsJson, out bool result))
+                    results[modsJson] = result = matches(readAcronyms(modsJson));
+
+                return result;
+            };
+
+            bool matches(string[] acronyms)
+            {
+                bool hasMods = acronyms.Any(a => !a.Equals(classic_acronym, StringComparison.OrdinalIgnoreCase));
+
+                if ((requireNoMod && hasMods) || (excludeNoMod && !hasMods))
+                    return false;
+
+                return requiredAcronyms.All(r => acronyms.Contains(r, StringComparer.OrdinalIgnoreCase))
+                       && !excludedAcronyms.Any(e => acronyms.Contains(e, StringComparer.OrdinalIgnoreCase));
+            }
+
+            string? resolve(Term term)
+            {
+                if (term.Quoted)
+                    return allMods.FirstOrDefault(m => m.Name.Equals(term.Text, StringComparison.OrdinalIgnoreCase))?.Acronym;
+
+                return allMods.FirstOrDefault(m => m.Acronym.Equals(term.Text, StringComparison.OrdinalIgnoreCase))?.Acronym
+                       ?? allMods.FirstOrDefault(m => m.Name.Equals(term.Text, StringComparison.OrdinalIgnoreCase))?.Acronym
+                       // not a mod of this ruleset (or no ruleset): compare the acronym as typed.
+                       ?? term.Text;
+            }
+        }
+
+        private static string[] readAcronyms(string modsJson)
+        {
+            if (string.IsNullOrEmpty(modsJson))
+                return [];
+
+            try
+            {
+                return JsonConvert.DeserializeObject<APIMod[]>(modsJson)?.Select(m => m.Acronym).ToArray() ?? [];
+            }
+            catch (JsonException)
+            {
+                return [];
+            }
+        }
+
+        private readonly record struct Term(string Text, bool Quoted)
+        {
+            public bool IsNoMod => !Quoted && Text.Equals(no_mod, StringComparison.OrdinalIgnoreCase);
+
+            public override string ToString() => Quoted ? $"'{Text.ToLowerInvariant()}'" : Text.ToUpperInvariant();
+        }
+    }
+}
