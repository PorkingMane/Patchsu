diff --git a/osu.Game/Screens/Select/FilterQueryParser.cs b/osu.Game/Screens/Select/FilterQueryParser.cs
index f0d630cdb8..f5df9daf23 100644
--- a/osu.Game/Screens/Select/FilterQueryParser.cs
