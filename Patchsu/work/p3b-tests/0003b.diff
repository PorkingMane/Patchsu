diff --git a/osu.Game/Screens/Select/BeatmapCarousel.LocalScoreFilter.cs b/osu.Game/Screens/Select/BeatmapCarousel.LocalScoreFilter.cs
new file mode 100644
index 0000000000..402d871345
--- /dev/null
+++ b/osu.Game/Screens/Select/BeatmapCarousel.LocalScoreFilter.cs
@@ -0,0 +1,156 @@
+// Added by Patchsu
+
+// Patchsu (patch 3b): the "scorewithmod" and "playdate" search keywords. Uses the local scores osu! already keeps (no cache of its own on disk).
+
+using System;
+using System.Collections.Generic;
+using System.Diagnostics;
+using System.Threading;
+using osu.Framework.Allocation;
+using osu.Framework.Graphics;
+using osu.Framework.Threading;
+using osu.Game.Beatmaps;
+using osu.Game.Database;
+using osu.Game.Models;
+using osu.Game.Rulesets;
+using osu.Game.Scoring;
+using osu.Game.Screens.Select.Filter;
+using Realms;
+
+namespace osu.Game.Screens.Select
+{
+    public partial class BeatmapCarousel
+    {
+        /// <summary>
+        /// The last result, reused while the user, ruleset and keywords stay the same (other search text can change freely).
+        /// Dropped whenever a local score is added or deleted, and after a minute with "playdate" (its ages move with the clock).
+        /// </summary>
+        private volatile LocalScoreFilterResult? localScoreFilterResult;
+
+        private int localScoreFilterVersion;
+
+        private ScoreChangeWatcher? scoreChangeWatcher;
+
+        private ScheduledDelegate? localScoreFilterRefilter;
+
+        /// <summary>
+        /// The beatmaps that have a local score matching both <see cref="FilterCriteria.ScoreWithMods"/> and <see cref="FilterCriteria.ScoreDate"/>
+        /// (the same score has to match both). Called from the filter thread.
+        /// </summary>
+        protected virtual IReadOnlySet<Guid> GetBeatmapsWithMatchingScore(FilterCriteria criteria)
+        {
+            Debug.Assert(criteria.HasLocalScoreFilter);
+
+            if (scoreChangeWatcher == null)
+                Schedule(watchScoreChanges);
+
+            // The local user is read from the API (not criteria.LocalUserId, which is only set for online accounts),
+            // so offline local profiles (with 0002) only see their own scores.
+            int userId = api.LocalUser.Value.Id;
+            var now = DateTimeOffset.Now;
+            string key = $@"{userId} {criteria.Ruleset?.ShortName} {criteria.ScoreWithMods?.Key} | {criteria.ScoreDate?.Key}";
+            int version = Volatile.Read(ref localScoreFilterVersion);
+
+            var cached = localScoreFilterResult;
+            if (cached != null && cached.Version == version && cached.Key == key && (criteria.ScoreDate == null || now - cached.Time < TimeSpan.FromMinutes(1)))
+                return cached.Beatmaps;
+
+            var modMatcher = criteria.ScoreWithMods?.CreateMatcher(criteria.Ruleset?.CreateInstance());
+            var dateMatcher = criteria.ScoreDate?.CreateMatcher(now);
+
+            var beatmaps = realm.Run(r =>
+            {
+                var result = new HashSet<Guid>();
+
+                // Same scores as "Group by: Rank achieved" (the user's plays and offline plays), but only the profile's own with a local profile.
+                var scores = userId < 0
+                    ? r.All<ScoreInfo>().Filter($@"{nameof(ScoreInfo.User)}.{nameof(RealmUser.OnlineID)} == $0"
+                                                + $@" && {nameof(ScoreInfo.BeatmapInfo)}.{nameof(BeatmapInfo.Hash)} == {nameof(ScoreInfo.BeatmapHash)}"
+                                                + $@" && {nameof(ScoreInfo.DeletePending)} == false", userId)
+                    : r.GetAllLocalScoresForUser(userId > 1 ? userId : null);
+
+                scores = scores.Filter($@"{nameof(ScoreInfo.Ruleset)}.{nameof(RulesetInfo.ShortName)} == $0", criteria.Ruleset?.ShortName);
+
+                foreach (var score in scores)
+                {
+                    // only the fields needed are read (no detaching).
+                    if (dateMatcher?.Invoke(score.Date) == false)
+                        continue;
+
+                    if (modMatcher?.Invoke(score.ModsJson) == false)
+                        continue;
+
+                    result.Add(score.BeatmapInfo!.ID);
+                }
+
+                return result;
+            });
+
+            localScoreFilterResult = new LocalScoreFilterResult(key, version, now, beatmaps);
+            return beatmaps;
+        }
+
+        private void watchScoreChanges()
+        {
+            if (scoreChangeWatcher != null)
+                return;
+
+            AddInternal(scoreChangeWatcher = new ScoreChangeWatcher(onScoresChanged));
+        }
+
+        private void onScoresChanged()
+        {
+            Interlocked.Increment(ref localScoreFilterVersion);
+            localScoreFilterResult = null;
+
+            // e.g. a new play: show its beatmap if it matches now. Runs once song select is shown again.
+            localScoreFilterRefilter?.Cancel();
+            localScoreFilterRefilter = Scheduler.AddDelayed(() =>
+            {
+                if (Criteria?.HasLocalScoreFilter == true)
+                    Filter(Criteria);
+            }, 500);
+        }
+
+        /// <summary>
+        /// Reports added and removed local scores. Soft-deleted scores leave the query, so deleting a score counts as a removal.
+        /// Changes to existing scores (e.g. PP being recalculated in the background) are ignored: their mods and dates don't change.
+        /// </summary>
+        private partial class ScoreChangeWatcher : Component
+        {
+            private readonly Action onChanged;
+
+            private IDisposable? subscription;
+
+            [Resolved]
+            private RealmAccess realm { get; set; } = null!;
+
+            public ScoreChangeWatcher(Action onChanged)
+            {
+                this.onChanged = onChanged;
+            }
+
+            protected override void LoadComplete()
+            {
+                base.LoadComplete();
+
+                subscription = realm.RegisterForNotifications(r => r.All<ScoreInfo>().Filter($@"{nameof(ScoreInfo.DeletePending)} == false"), (_, changes) =>
+                {
+                    // the first callback (and realm resets) carry no changes.
+                    if (changes == null || (changes.InsertedIndices.Length == 0 && changes.DeletedIndices.Length == 0))
+                        return;
+
+                    onChanged();
+                });
+            }
+
+            protected override void Dispose(bool isDisposing)
+            {
+                base.Dispose(isDisposing);
+                subscription?.Dispose();
+            }
+        }
+
+        private record LocalScoreFilterResult(string Key, int Version, DateTimeOffset Time, IReadOnlySet<Guid> Beatmaps);
+    }
+}
