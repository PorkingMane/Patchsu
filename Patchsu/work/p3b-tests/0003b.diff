diff --git a/osu.Game/Screens/Select/Filter/ScoreDateFilter.cs b/osu.Game/Screens/Select/Filter/ScoreDateFilter.cs
new file mode 100644
index 0000000000..2aff272bf2
--- /dev/null
+++ b/osu.Game/Screens/Select/Filter/ScoreDateFilter.cs
@@ -0,0 +1,239 @@
+// Added by Patchsu
+
+using System;
+using System.Collections.Generic;
+using System.Globalization;
+using System.Linq;
+using System.Text.RegularExpressions;
+
+namespace osu.Game.Screens.Select.Filter
+{
+    /// <summary>
+    /// Patchsu (patch 3b): the "playdate" search keyword. Keeps beatmaps that have a local score of the current user
+    /// (in the selected ruleset) set a given amount of time ago.
+    /// </summary>
+    /// <remarks>
+    /// The value is an amount of time back from now: <c>y</c> years, <c>M</c>/<c>mo</c> months, <c>w</c> weeks, <c>d</c> days,
+    /// <c>h</c> hours, <c>m</c> minutes, <c>s</c> seconds, combinable (<c>1y6M</c>, <c>2w3d</c>). A plain number is days.
+    /// <list type="bullet">
+    /// <item><c>playdate&lt;=180d</c>: a score set at most 180 days ago.</item>
+    /// <item><c>playdate&gt;4w</c>: a score set more than 4 weeks ago.</item>
+    /// <item><c>playdate=3d</c>: a score set 3 days ago, counted in the smallest unit given (from 3 up to 4 days ago).</item>
+    /// <item><c>playdate!=3d</c>: a score not set 3 days ago (the opposite of <c>=</c>).</item>
+    /// </list>
+    /// Several conditions must all hold for the same score (<c>playdate&gt;1w playdate&lt;4w</c>), and they also have to hold for the
+    /// same score as <c>scorewithmod</c>. <c>scoredate</c> and <c>datescore</c> are the same keyword.
+    /// </remarks>
+    public class ScoreDateFilter
+    {
+        private static readonly Regex keyword_regex = new Regex(
+            @"\b(?:playdate|scoredate|datescore)(?<op>!?[:=]|[<>][:=]?)(?<value>\S*)",
+            RegexOptions.Compiled | RegexOptions.IgnoreCase);
+
+        private static readonly Regex value_regex = new Regex(
+            @"^(?:(?<y>\d+)y)?(?:(?<mo>\d+)(?:M|mo))?(?:(?<w>\d+(?:\.\d+)?)w)?(?:(?<d>\d+(?:\.\d+)?)d)?(?:(?<h>\d+(?:\.\d+)?)h)?(?:(?<m>\d+(?:\.\d+)?)m)?(?:(?<s>\d+(?:\.\d+)?)s)?$",
+            RegexOptions.Compiled);
+
+        private readonly List<Condition> conditions = new List<Condition>();
+
+        /// <summary>
+        /// Identifies what this filter matches (for caching results). Doesn't include the current time.
+        /// </summary>
+        public string Key => string.Join(' ', conditions.Select(c => c.ToString()));
+
+        /// <summary>
+        /// Takes every "playdate" keyword out of <paramref name="query"/> into <see cref="FilterCriteria.ScoreDate"/>.
+        /// A keyword with a value that can't be read is left in the query (like other keywords).
+        /// </summary>
+        /// <returns>The query without those keywords.</returns>
+        public static string Extract(FilterCriteria criteria, string query)
+        {
+            foreach (Match match in keyword_regex.Matches(query))
+            {
+                if (!tryParseAge(match.Groups["value"].Value, out var age))
+                    continue;
+
+                criteria.ScoreDate ??= new ScoreDateFilter();
+                criteria.ScoreDate.conditions.Add(new Condition(parseOperator(match.Groups["op"].Value), age));
+
+                query = query.Replace(match.Value, string.Empty);
+            }
+
+            return query;
+        }
+
+        /// <summary>
+        /// Returns a check for a score's <c>Date</c>, with ages counted back from <paramref name="now"/>.
+        /// </summary>
+        public Func<DateTimeOffset, bool> CreateMatcher(DateTimeOffset now)
+        {
+            var ranges = conditions.Select(c => c.CreateCheck(now)).ToArray();
+            return date => ranges.All(check => check(date));
+        }
+
+        private static Operator parseOperator(string op)
+        {
+            switch (op)
+            {
+                case "!=":
+                case "!:":
+                    return Operator.NotEqual;
+
+                case "<":
+                    return Operator.Less;
+
+                case "<=":
+                case "<:":
+                    return Operator.LessOrEqual;
+
+                case ">":
+                    return Operator.Greater;
+
+                case ">=":
+                case ">:":
+                    return Operator.GreaterOrEqual;
+
+                default:
+                    return Operator.Equal;
+            }
+        }
+
+        private static bool tryParseAge(string value, out Age age)
+        {
+            age = default;
+
+            if (value.Length == 0)
+                return false;
+
+            if (double.TryParse(value, NumberStyles.AllowDecimalPoint, CultureInfo.InvariantCulture, out double plainDays))
+            {
+                age = new Age(0, TimeSpan.FromDays(plainDays), TimeSpan.FromDays(1), value + "d");
+                return true;
+            }
+
+            var match = value_regex.Match(value);
+
+            if (!match.Success)
+                return false;
+
+            int months = 0;
+            var time = TimeSpan.Zero;
+            TimeSpan? step = null;
+            bool monthStep = false;
+
+            // largest unit first, so the last one found is the smallest (the step for "=").
+            foreach (string unit in new[] { "y", "mo", "w", "d", "h", "m", "s" })
+            {
+                var group = match.Groups[unit];
+
+                if (!group.Success)
+                    continue;
+
+                double amount = double.Parse(group.Value, CultureInfo.InvariantCulture);
+
+                switch (unit)
+                {
+                    case "y":
+                        months += (int)amount * 12;
+                        monthStep = true;
+                        step = TimeSpan.FromDays(365);
+                        break;
+
+                    case "mo":
+                        months += (int)amount;
+                        monthStep = true;
+                        step = TimeSpan.FromDays(30);
+                        break;
+
+                    default:
+                        var unitLength = unit switch
+                        {
+                            "w" => TimeSpan.FromDays(7),
+                            "d" => TimeSpan.FromDays(1),
+                            "h" => TimeSpan.FromHours(1),
+                            "m" => TimeSpan.FromMinutes(1),
+                            _ => TimeSpan.FromSeconds(1),
+                        };
+
+                        time += unitLength * amount;
+                        monthStep = false;
+                        step = unitLength;
+                        break;
+                }
+            }
+
+            if (step == null)
+                return false;
+
+            age = new Age(months, time, monthStep ? null : step, value);
+            return true;
+        }
+
+        /// <summary>
+        /// An amount of time back from now. Months and years are calendar months (not a fixed length).
+        /// </summary>
+        /// <param name="Months">Calendar months back.</param>
+        /// <param name="Time">Fixed-length time back (after the months).</param>
+        /// <param name="Step">The smallest unit given, used by "=". Null when it is a month or a year (see <see cref="StepMonths"/>).</param>
+        /// <param name="Text">The value as typed.</param>
+        private readonly record struct Age(int Months, TimeSpan Time, TimeSpan? Step, string Text)
+        {
+            public DateTimeOffset Before(DateTimeOffset now) => now.AddMonths(-Months) - Time;
+
+            /// <summary>
+            /// The start of the "=" span: one more of the smallest unit back.
+            /// </summary>
+            public DateTimeOffset StepBefore(DateTimeOffset now)
+            {
+                if (Step is TimeSpan step)
+                    return Before(now) - step;
+
+                return now.AddMonths(-(Months + StepMonths)) - Time;
+            }
+
+            /// <summary>
+            /// When the smallest unit given is a year or a month: how many months it is.
+            /// </summary>
+            private int StepMonths => Text.EndsWith('y') ? 12 : 1;
+        }
+
+        private readonly record struct Condition(Operator Op, Age Age)
+        {
+            public Func<DateTimeOffset, bool> CreateCheck(DateTimeOffset now)
+            {
+                // a score's age is compared, so "<" (younger) means a later date.
+                var edge = Age.Before(now);
+
+                switch (Op)
+                {
+                    case Operator.Less:
+                        return d => d > edge;
+
+                    case Operator.LessOrEqual:
+                        return d => d >= edge;
+
+                    case Operator.Greater:
+                        return d => d < edge;
+
+                    case Operator.GreaterOrEqual:
+                        return d => d <= edge;
+
+                    default:
+                        var start = Age.StepBefore(now);
+                        bool equal = Op == Operator.Equal;
+                        return d => (d > start && d <= edge) == equal;
+                }
+            }
+
+            public override string ToString() => Op switch
+            {
+                Operator.NotEqual => "!=",
+                Operator.Less => "<",
+                Operator.LessOrEqual => "<=",
+                Operator.Greater => ">",
+                Operator.GreaterOrEqual => ">=",
+                _ => "=",
+            } + Age.Text;
+        }
+    }
+}
diff --git a/osu.Game/Screens/Select/Filter/ScoreWithModFilter.cs b/osu.Game/Screens/Select/Filter/ScoreWithModFilter.cs
new file mode 100644
index 0000000000..8da3f1342f
--- /dev/null
+++ b/osu.Game/Screens/Select/Filter/ScoreWithModFilter.cs
@@ -0,0 +1,201 @@
+// Added by Patchsu
+
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Text;
+using System.Text.RegularExpressions;
+using Newtonsoft.Json;
+using osu.Game.Online.API;
+using osu.Game.Rulesets;
+
+namespace osu.Game.Screens.Select.Filter
+{
+    /// <summary>
+    /// Patchsu (patch 3b): the "scorewithmod" search keyword. Keeps beatmaps that have a local score of the current user
+    /// (in the selected ruleset) set with the given mods.
+    /// </summary>
+    /// <remarks>
+    /// <list type="bullet">
+    /// <item><c>scorewithmod=HD</c>: a mod acronym (or a one-word mod name, like <c>scorewithmod=hidden</c>).</item>
+    /// <item><c>scorewithmod='Wind Up'</c> (or <c>"Wind Up"</c>): an exact mod name, ignoring case.</item>
+    /// <item><c>scorewithmod=HD,DT</c> / <c>scorewithmod=HD+DT</c> / <c>scorewithmod=HD scorewithmod=DT</c>: one score has every listed mod.</item>
+    /// <item><c>scorewithmod!=DT</c>: the score doesn't have this mod.</item>
+    /// <item><c>scorewithmod=NM</c>: a score without mods (Classic doesn't count).</item>
+    /// </list>
+    /// Other mods on the score and mod settings (e.g. a custom rate) don't matter.
+    /// <c>scoreswithmod</c> and <c>playwithmod</c> are the same keyword.
+    /// </remarks>
+    public class ScoreWithModFilter
+    {
+        /// <summary>
+        /// The keyword's own syntax (quoted names with spaces, lists) doesn't fit the generic query syntax, so it is read first.
+        /// A quote left open at the end of the query runs to the end (for typing).
+        /// </summary>
+        private static readonly Regex keyword_regex = new Regex(
+            @"\b(?:scorewithmod|scoreswithmod|playwithmod|playswithmod)(?<op>!?[:=])(?<value>(?:'[^']*(?:'|$)|""[^""]*(?:""|$)|[^\s'""])+)",
+            RegexOptions.Compiled | RegexOptions.IgnoreCase);
+
+        private const string no_mod = @"NM";
+
+        private const string classic_acronym = @"CL";
+
+        private readonly List<Term> required = new List<Term>();
+        private readonly List<Term> excluded = new List<Term>();
+
+        /// <summary>
+        /// Identifies what this filter matches (for caching results).
+        /// </summary>
+        public string Key => string.Join(' ', required.Select(t => "+" + t).Concat(excluded.Select(t => "-" + t)));
+
+        /// <summary>
+        /// Takes every "scorewithmod" keyword out of <paramref name="query"/> into <see cref="FilterCriteria.ScoreWithMods"/>.
+        /// </summary>
+        /// <returns>The query without those keywords.</returns>
+        public static string Extract(FilterCriteria criteria, string query)
+        {
+            foreach (Match match in keyword_regex.Matches(query))
+            {
+                var terms = parseTerms(match.Groups["value"].Value);
+
+                if (terms.Count == 0)
+                    continue;
+
+                criteria.ScoreWithMods ??= new ScoreWithModFilter();
+                (match.Groups["op"].Value.StartsWith('!') ? criteria.ScoreWithMods.excluded : criteria.ScoreWithMods.required).AddRange(terms);
+
+                query = query.Replace(match.Value, string.Empty);
+            }
+
+            return query;
+        }
+
+        private static List<Term> parseTerms(string value)
+        {
+            var terms = new List<Term>();
+            var current = new StringBuilder();
+            char? quote = null;
+            bool quoted = false;
+
+            foreach (char c in value)
+            {
+                if (quote != null)
+                {
+                    if (c == quote)
+                        quote = null;
+                    else
+                        current.Append(c);
+                }
+                else if (c is '\'' or '"')
+                {
+                    quote = c;
+                    quoted = true;
+                }
+                else if (c is ',' or '+')
+                    finishTerm();
+                else
+                    current.Append(c);
+            }
+
+            finishTerm();
+            return terms;
+
+            void finishTerm()
+            {
+                string text = current.ToString().Trim();
+
+                if (text.Length > 0)
+                    terms.Add(new Term(text, quoted));
+
+                current.Clear();
+                quoted = false;
+            }
+        }
+
+        /// <summary>
+        /// Resolves mod names for <paramref name="ruleset"/> and returns a check for a score's mods (its <c>ModsJson</c>).
+        /// The check remembers its answer per distinct <c>ModsJson</c>, so use one per scan (not thread-safe).
+        /// </summary>
+        public Func<string, bool> CreateMatcher(Ruleset? ruleset)
+        {
+            var allMods = ruleset?.CreateAllMods().ToArray() ?? [];
+
+            var requiredAcronyms = new List<string>();
+            var excludedAcronyms = new List<string>();
+            bool requireNoMod = false;
+            bool excludeNoMod = false;
+
+            foreach (var term in required)
+            {
+                if (term.IsNoMod)
+                    requireNoMod = true;
+                else if (resolve(term) is string acronym)
+                    requiredAcronyms.Add(acronym);
+                else
+                    return _ => false; // no such mod, so no score has it.
+            }
+
+            foreach (var term in excluded)
+            {
+                if (term.IsNoMod)
+                    excludeNoMod = true;
+                else if (resolve(term) is string acronym)
+                    excludedAcronyms.Add(acronym);
+            }
+
+            var results = new Dictionary<string, bool>();
+
+            return modsJson =>
+            {
+                if (!results.TryGetValue(modsJson, out bool result))
+                    results[modsJson] = result = matches(readAcronyms(modsJson));
+
+                return result;
+            };
+
+            bool matches(string[] acronyms)
+            {
+                bool hasMods = acronyms.Any(a => !a.Equals(classic_acronym, StringComparison.OrdinalIgnoreCase));
+
+                if ((requireNoMod && hasMods) || (excludeNoMod && !hasMods))
+                    return false;
+
+                return requiredAcronyms.All(r => acronyms.Contains(r, StringComparer.OrdinalIgnoreCase))
+                       && !excludedAcronyms.Any(e => acronyms.Contains(e, StringComparer.OrdinalIgnoreCase));
+            }
+
+            string? resolve(Term term)
+            {
+                if (term.Quoted)
+                    return allMods.FirstOrDefault(m => m.Name.Equals(term.Text, StringComparison.OrdinalIgnoreCase))?.Acronym;
+
+                return allMods.FirstOrDefault(m => m.Acronym.Equals(term.Text, StringComparison.OrdinalIgnoreCase))?.Acronym
+                       ?? allMods.FirstOrDefault(m => m.Name.Equals(term.Text, StringComparison.OrdinalIgnoreCase))?.Acronym
+                       // not a mod of this ruleset (or no ruleset): compare the acronym as typed.
+                       ?? term.Text;
+            }
+        }
+
+        private static string[] readAcronyms(string modsJson)
+        {
+            if (string.IsNullOrEmpty(modsJson))
+                return [];
+
+            try
+            {
+                return JsonConvert.DeserializeObject<APIMod[]>(modsJson)?.Select(m => m.Acronym).ToArray() ?? [];
+            }
+            catch (JsonException)
+            {
+                return [];
+            }
+        }
+
+        private readonly record struct Term(string Text, bool Quoted)
+        {
+            public bool IsNoMod => !Quoted && Text.Equals(no_mod, StringComparison.OrdinalIgnoreCase);
+
+            public override string ToString() => Quoted ? $"'{Text.ToLowerInvariant()}'" : Text.ToUpperInvariant();
+        }
+    }
+}
